/proc/filters(x)
	world.log << filter(type = "wave", flags = WAVE_SIDEWAYS)
	world.log << filter(type = "wave", flags = WAVE_SIDEWAYS | WAVE_BOUNDED)
	world.log << filter(type = "wave", flags = NORTH)
	world.log << filter(type = "wave", flags = 0)
	world.log << filter(type = "wave", flags = 64)
	world.log << filter(type = "wave", flags = -WAVE_SIDEWAYS)
	world.log << filter(type = "wave", flags = x ? 1 : 2)
	world.log << filter(type = "blur", size = 1)
	world.log << filter(type = "blur", bogus = 1)
	world.log << filter(type = "nope")
	world.log << filter(type = 5)
	world.log << filter(size = 1)
	world.log << filter(arglist(x))
	world.log << filter(type = "layer", blend_mode = BLEND_ADD)
	world.log << filter(type = "layer", blend_mode = BLEND_ADD | BLEND_MULTIPLY)
	world.log << filter(type = "alpha", flags = MASK_INVERSE | MASK_SWAP)
	world.log << filter(type = "rays", flags = FILTER_OVERLAY | FILTER_UNDERLAY)
	world.log << filter(type = "outline", flags = OUTLINE_SHARP)
	world.log << filter(type = "outline", flags = OUTLINE_SQUARE | NORTH)
#define MY_FLAG WAVE_BOUNDED
/proc/filter_macro()
	world.log << filter(type = "wave", flags = MY_FLAG)
