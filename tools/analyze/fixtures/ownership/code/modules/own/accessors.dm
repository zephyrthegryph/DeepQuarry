// Accessor usage: unknown_var, string_name, contradiction and matrix.
/obj/holder/proc/good_accessors(obj/item/arg_item, X)
	own_set(src, nameof(held), arg_item)
	own_take(src, nameof(held))
	own_clear(src, nameof(stuff))
	rel_add(src, nameof(rel_good), arg_item)
	proto_set(src, nameof(proto_thing), arg_item)
	shared_set(src, nameof(shared_item), arg_item)
	own_set(src, nameof(subvar), arg_item)
	own_set(X, nameof(held), arg_item)
	own_set(src, nameof(src.held), arg_item)
	own_set(src, nameof(/obj/holder::held), arg_item)
	own_transfer(src, nameof(held), X, nameof(stuff))
	own_transfer(src, nameof(held), src, nameof(roster))

/obj/holder/proc/unknown_vars(X, mob/M)
	own_set(src, "ghost", src)
	own_set(src, nameof(ghost_two), src)
	own_set(X, "ghost3", src)
	own_set(X, nameof(ghost4), src)
	own_set(M, nameof(ghost5), src)
	rel_set(M, nameof(held), src)
	own_set(src.thing, nameof(ghost6), src)
	own_transfer(src, nameof(held), X, nameof(ghost7))
	own_transfer(src, nameof(held), M, nameof(ghost8))
	// own_set(src, "ghost9", src)
	var/s = "own_set(src, nameof(ghost10), src)"
	own_set(src, nameof(held), src) // own_set(src, nameof(ghost11), src)

/obj/holder/proc/string_names(obj/item/arg_item, X)
	own_set(src, "held", arg_item)
	own_take(src, "held")
	rel_add(src, "rel_good", arg_item)
	proto_set(src, "proto_thing", arg_item)
	shared_set(src, "shared_item", arg_item)
	own_take_all(src, "stuff")
	own_values(src, "stuff")
	rel_targets(src, "stuff")
	rel_names(src, "stuff")
	proto_replace(src, "proto_thing", arg_item)
	proto_is_private(src, "proto_thing")
	keyed_set_id(src, "stuff", arg_item)
	own_move(src, X, "held")
	own_move(src, X, nameof(held))
	own_set(src, nameof(held), arg_item) // own_set(src, "held", arg_item)
	// own_set(src, "held", arg_item)
	to_chat(usr, "own_set(src, "held")")
	own_set(src, (1 + 2), "held")
	own_set(src, nameof(held), "held")
	own_set(src, "held", arg_item) // ALLOW(ownership): the fixture keeps this string name
	// ALLOW(ownership): the comment line above keeps the next string name
	own_set(src, "held", arg_item)
	own_set(src, "held", arg_item) // ALLOW(scheduler): not the ownership lint's annotation
	xown_set(src, "held", arg_item)
	own_set(
		src, "held", arg_item)
	own_set(src, "held", arg_item); own_set(src, "stuff", arg_item)

/obj/holder/proc/contradictions()
	own_set(src, nameof(mixed), src)

/obj/holder/proc/contradictions_two()
	rel_set(src, nameof(mixed), src)
	rel_set(src, nameof(owned_decl), src)
	own_set(src, nameof(rel_decl), src)
	own_set(src, nameof(shared_item), src)
	rel_set(src, nameof(shared_item), src)
	own_set(src, nameof(shared_thing), src)
	own_set(src, nameof(proto_thing), src)
	rel_set(src, nameof(air), src)
	own_set(src, nameof(air), src)
	rel_set(src, nameof(rel_owned), src)
	own_set(src, nameof(rel_owned), src)
	rel_set(src, nameof(rel_proto), src)
	own_set(src, nameof(rel_proto), src)

/obj/kinds_base/proc/touch()
	own_set(src, nameof(kv), src)
	rel_set(src, nameof(kv), src)

/obj/other/proc/same_name_other_type()
	rel_set(src, nameof(label), src)
	own_set(src, nameof(label), src)
