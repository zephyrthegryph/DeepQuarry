/obj/relcase/Initialize(mapload)
	rel_set(src, "rchild", new /obj/x)
	rel_add(src, nameof(rchild2), new /obj/y())
	rel_set(other, "rchild3", new /obj/z)
	rel_set(src, "rchild4", null)
	rel_link(src, "rchild5", new /obj/z)
	rel_set(src, "r_owned", 1)
/obj/relcase/on_destroy(force)
	rel_clear(src, "rname")
	rel_clear(other, "rname2")
	qdel(r_owned)
	qdel(r_not_owned)
