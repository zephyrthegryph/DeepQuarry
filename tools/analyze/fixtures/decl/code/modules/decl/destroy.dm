/obj/thing/on_destroy(force)
	..()
	dump_contents()
	dump_contents ()
	for(var/obj/O in contents)
		O.forceMove(loc)
	for(var/obj/item/I in src.contents)
		I.forceMove(loc)
	for(var/obj/O in contents_of(src))
		O.forceMove(loc)
	for(var/obj/O in other.contents)
		O.forceMove(loc)
	registry_leave(REGISTRY_THINGS, src)
	GLOB.thing_list -= src
	GLOB.thing_list -= other
	om_task_periodic_stop(src, PERIODIC_X)
	STOP_PROCESSING(SSobj, src)
	disconnect_from_network()
	vg_thing_unbind(src)
	vg_unbind(src)
	visible_message("it breaks")
	playsound(src, 'x.ogg', 50)
	new /obj/debris(loc)
	new /obj/debris/big(src.loc)
	new /obj/debris(get_turf(src))
	new /obj/debris(T)
	new /obj/debris(somewhere)
	new /obj/debris(loc, 5)
	new /datum/thing(loc)
	own_clear(src, "name_a")
	own_take(src, nameof(name_b))
	own_take_all(src, "name_c")
	own_take(other, "name_d")
	qdel(owned_a)
	qdel(src.owned_b)
	qdel(owned_c)
	qdel(owned_d)
	qdel(owned_e)
	qdel(not_owned_f)
	qdel(src)
	qdel(commented_ref)
	qdel(owned_a.sub)
	qdel(ut_owned)
	qdel(hid_owned)
	qdel(dot_owned)
	qdel(owned_a) // ALLOW(decl): the fixture keeps this one on the line
	// ALLOW(decl): the fixture keeps the next line from the comment above
	qdel(owned_b)
	// ALLOW(decl)
	qdel(owned_c)
	qdel(owned_d) // ALLOW(other): another lint's name does not keep it
	qdel(owned_e) // ALLOW(decl, other): two names, one of them ours, keep it
	visible_message("a"); playsound(src, 'x.ogg', 50) // ALLOW(decl): one question keeps both hits of the line
	x = 1 // ALLOW(decl): nothing to keep here, the line has no hit
	if(visible_message("x") && playsound(src, 'y.ogg', 1))
		qdel(not_owned_f)
	return ..()
/obj/thing/on_destroy()
	visible_message("no space")
/obj/thing/proc/on_destroy(force)
	visible_message("proc form")
/obj/thing/on_destroy ()
	visible_message("space before paren")
/obj/thing/on_destroyed()
	visible_message("not the header")
/obj/thing/other_proc()
	visible_message("outside any lifecycle proc")
	qdel(owned_a)
