/obj/machinery/pump/proc/act_edge(mob/user)
	// add_fingerprint(user) in a comment
	to_chat(user, "log_game( in a string")
	var/x = "[add_fingerprint(user)]"
	user.add_fingerprint(user)
	log_and_message_admins("x")
	log_admin("y") // ALLOW(sys_dx_manual_fingerprint_log): fixture keeps this one
	// ALLOW(sys_dx_manual_fingerprint_log): fixture keeps the next one
	message_admins("z")
	/* log_game("block") */
	src.log_game("member")
	log_game ("spaced")
	var/s = "[log_admin("embedded")]"
/proc/act_global()
	log_game("global act")
/obj/machinery/pump/proc/glob_handler()
	log_game("global handler")
/obj/machinery/pump/proc/capabilities2()
	. += cap_use_on("Use", TOOL_X, PROC_REF(use_it))
	. += cap_insert("Ins", /obj/item/x, handler = GLOBAL_PROC_REF(glob_handler2))
	. += cap_entry("E", 1, VERB_REF(verb_x), foo = 1)
	. += cap_tool("T", TOOL_Y, TYPE_VERB_REF(/obj/machinery, tv))
	. += cap_hand("Multi",
		PROC_REF(multi_line))
	. += cap_hand("Named", handler = PROC_REF(named_one), other = 2)
	. += cap_hand("Nothing")
	. += cap_hand("Weird", WEIRD(thing))
	. += cap_hand("Type", TYPE_PROC_REF(/obj/item/other, use_it))
	. += cap_tool("T2", TOOL_Z, GLOBAL_PROC_REF(glob_handler))
/obj/machinery/pump/proc/use_it()
	add_fingerprint(usr)
/proc/glob_handler2()
	add_fingerprint(usr)
/obj/machinery/pump/proc/verb_x()
	log_game("v")
/obj/machinery/proc/tv()
	log_game("tv")
/obj/item/unrelated/proc/use_it()
	add_fingerprint(usr)
/obj/item/other/proc/use_it()
	add_fingerprint(usr)
/obj/machinery/pump/proc/multi_line()
	log_game("not detected: call spans lines")
/obj/machinery/pump/proc/named_one()
	log_game("named handler")
/obj/machinery/pump/sub/proc/use_it()
	add_fingerprint(usr)
/obj/machinery/proc/use_it()
	add_fingerprint(usr)
/obj/machinery/pump/proc/act_long(
		mob/user, a)
	add_fingerprint(user)
	if(a)
		log_game("nested")

	log_game("after a blank line")
/obj/machinery/pump/proc/after_body()
	return
/proc/glob_handler()
	log_game("global glob_handler, matched by GLOBAL_PROC_REF")
