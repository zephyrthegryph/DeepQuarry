CAPABILITY_DEF(cover, CAP_COVER, key = tag, level = 1)
CAPABILITY_TYPE(powered, CAP_POWERED, /datum/capability/powered)
cap_keys(CAP_COVER, OPEN = FALSE, ON)
STAGE_DEF(work, start)
SOURCE_DEF(hand)
STATE_GRAPH(GRAPH_WORK, stage(STAGE_WORK_START))
CAPABILITIES(/datum/holder)
    section(main, "doc")
    ref_one(nameof(target), /datum/target, by = nameof(id), weak = TRUE)
    ref_many(nameof(targets), /datum/target, weak = TRUE)
    param(nameof(health), /number, 3)
    rolls(HEALTH)
    loot("coin")
    configure(CAP_COVER, "slot", level = 2)
    links(/datum/holder::target, /datum/target::owner)
    adjusts(packet.amount, 2)
    on_change(nameof(target.charge), ANY, cover())
    section(empty)
    accidental = 3
    section(main)
    op("run", powered())
