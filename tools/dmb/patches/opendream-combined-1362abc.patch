+    private static Color NativeHueColor(float hue, float saturation, float value, byte alpha, bool hsl) {
+        // BYOND wraps hue and rounds converted RGB channels to the nearest byte.
+        float sector = hue / 60;
+        sector -= MathF.Floor(sector / 6) * 6;
