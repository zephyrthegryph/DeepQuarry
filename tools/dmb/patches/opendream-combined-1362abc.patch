+        NativeEllipsis = 0x21 // Authored \...; native stores FF12, distinct from Roman.
+    }
+
+    // Native-only literal escape. Doubling the prefix also preserves an authored prefix.
+    public const char NativeLiteralPrefix = '\uff5e';
+    public static void AppendLiteral(StringBuilder output, char value) {
+        if (value >= '\uff00' && value <= NativeLiteralPrefix) output.Append(NativeLiteralPrefix);
+        output.Append(value);
+    }
+    public static string EncodeLiteral(string value) {
+        var output = new StringBuilder(value.Length);
+        foreach (char character in value) AppendLiteral(output, character);
+        return output.ToString();
+    }
+
+    public static bool TryDecodeLiteral(string value, out string literal) {
+        var output = new StringBuilder(value.Length);
+        for (int index = 0; index < value.Length; index++) {
+            char character = value[index];
+            if (character == NativeLiteralPrefix && index + 1 < value.Length &&
+                value[index + 1] >= '\uff00' && value[index + 1] <= NativeLiteralPrefix) {
+                output.Append(value[++index]);
+            } else if (character >= '\uff00' && character <= NativeLiteralPrefix) {
+                literal = string.Empty;
+                return false; // A format macro requires native control-byte conversion.
+            } else output.Append(character);
+        }
+        literal = output.ToString();
+        return true;
     }
 
