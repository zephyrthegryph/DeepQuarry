+        double x = c * (1 - Math.Abs(h % 2 - 1));
+        double m = hsl ? v - c / 2 : v - c;
+        (double r, double g, double b) = h switch {
+            < 1 => (c, x, 0d),
+            < 2 => (x, c, 0d),
+            < 3 => (0d, c, x),
+            < 4 => (0d, x, c),
+            < 5 => (x, 0d, c),
+            _ => (c, 0d, x)
+        };
+        byte Channel(double component) => (byte)Math.Clamp(Math.Floor((component + m) * 255 + 0.5), 0, 255);
