/datum/debug_value/proc/probe()
    set SpacemanDMM_should_call_parent = 2
    set SpacemanDMM_should_call_parent = "plain"
    set SpacemanDMM_should_call_parent = "a[value+1]b"
    set SpacemanDMM_should_call_parent = list(1, named=2)
    set SpacemanDMM_should_call_parent = new /datum
    set SpacemanDMM_should_call_parent = as(())
    set SpacemanDMM_should_call_parent = 1 <=> 2
    set SpacemanDMM_should_call_parent = &value
    set SpacemanDMM_should_call_parent = ::value
    set SpacemanDMM_should_call_parent = .child/type
    set SpacemanDMM_should_call_parent = FALSE
    return 0
