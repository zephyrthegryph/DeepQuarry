/datum/static_target
    var/value=0
    proc/work()
        return 0
/proc/probe(datum/static_target/typed)
    typed::value
    var/path=/datum/static_target
    path::value
    var/empty
    empty::value
    var/number=5
    number::value
    path::absent
    typed::absent_proc(doesnotexist)
    typed::work(doesnotexist)
    filter(type=typed::work(doesnotexist))
