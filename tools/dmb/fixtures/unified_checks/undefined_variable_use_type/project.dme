var/missing/root_value
/datum/declared_type_probe
    var/missing/field_value
    var/datum/healthy
    proc/bare()
        return field_value
/proc/explicit()
    return ::root_value
/proc/field(datum/declared_type_probe/holder)
    return holder.field_value
/proc/static_field()
    return /datum/declared_type_probe::field_value
/proc/healthy(datum/declared_type_probe/holder)
    return holder.healthy
/proc/chained(datum/declared_type_probe/holder)
    var/missing/earlier
    return holder.field_value.name
