/datum/not_iterable
/datum/odd_atom
    parent_type=/obj
/proc/probe(datum/general,datum/not_iterable/specific,obj/real_atom,world/world_value,list/list_value,alist/alist_value,callee/frame)
    for(var/a in general)
        continue
    for(var/b in specific)
        continue
    for(var/c in real_atom)
        continue
    for(var/d in world_value)
        continue
    for(var/e in list_value)
        continue
    for(var/f in alist_value)
        continue
    for(var/g in frame.proc)
        continue
    for(var/key,value in specific)
        continue
    for(var/i=0 to 0)
        continue
    for(var/j=2 to 1)
        continue
