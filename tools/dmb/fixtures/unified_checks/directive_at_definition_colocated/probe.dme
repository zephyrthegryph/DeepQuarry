#define BOTH /datum/colocated/proc/probe() { set SpacemanDMM_can_be_redefined = TRUE; return 0; }; /datum/colocated/probe() { set SpacemanDMM_private_proc = TRUE; return 0; }
BOTH
/datum/definition_gate/proc/probe()
    set SpacemanDMM_can_be_redefined = TRUE
    return 0
/datum/definition_gate/probe()
    set SpacemanDMM_private_proc = 2
