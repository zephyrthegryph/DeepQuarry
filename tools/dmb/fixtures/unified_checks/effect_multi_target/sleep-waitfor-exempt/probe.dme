/proc/shared()
    sleep(1)
/proc/exempt()
    set SpacemanDMM_allowed_to_sleep=1
    sleep(1)
/proc/asynchronous()
    set waitfor=0
    sleep(1)
/proc/first()
    set SpacemanDMM_should_not_sleep=1
    exempt()
    asynchronous()
    shared()
/proc/second()
    set SpacemanDMM_should_not_sleep=1
    sleep(1)
    shared()
/proc/own_exempt()
    set SpacemanDMM_should_not_sleep=1
    set SpacemanDMM_allowed_to_sleep=1
    sleep(1)
/proc/own_waitfor()
    set SpacemanDMM_should_not_sleep=1
    set waitfor=0
    sleep(1)
