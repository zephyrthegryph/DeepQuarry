/proc/ai_value(x)
    return x
/proc/an_named(a,x,cond)
    animate(a,alpha=cond?ai_value(2):x,time=ai_value(3),easing=1,loop=0,flags=0,pixel_x=4,pixel_y=5)
/proc/an_continue(t)
    animate(alpha=128,time=t)
/proc/an_arglist(var/list/L)
    animate(arglist(L))
/proc/an_single(a)
    animate(a)
/proc/an_positional(a,t)
    animate(a,t)
/proc/an_return(a)
    return animate(a)
/proc/ic_named(file,state,cond)
    return icon(file,icon_state=cond?ai_value(state):null,dir=ai_value(2))
/proc/ic_cond(file,cond)
    return icon(cond?ai_value(file):null)
/proc/ic_arglist(var/list/L)
    return icon(arglist(L))
/proc/an_positional_effect(a,t)
    animate(a,ai_value(t))
/proc/an_mixedpos(a,t)
    animate(a,ai_value(t),alpha=2)
/proc/an_three(a,t,f)
    animate(a,t,f)