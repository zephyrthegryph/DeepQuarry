/proc/b_ceiling(x)
    return ceil(x)
/proc/b_floor(x)
    return floor(x)
/proc/b_text2file(t,f)
    return text2file(t,f)
/proc/b_step_rand(x)
    return step_rand(x)
/proc/b_walk_to(x,y)
    walk_to(x,y)
/proc/b_walk_towards(x,y)
    walk_towards(x,y)
/proc/b_get_step_to(x,y)
    return get_step_to(x,y)
/proc/b_ohearers(x,y)
    return ohearers(x,y)
/proc/b_winshow(c,id,show)
    winshow(c,id,show)
/proc/b_generator(a,b,c,d)
    return generator(a,b,c,d)
/proc/b_alert(a,b,c,d,e)
    return alert(a,b,c,d,e)
/proc/b_alert_short(a)
    return alert(a)
/proc/b_alert_user(mob/u,a,b,c,d,e)
    return alert(u,a,b,c,d,e)
