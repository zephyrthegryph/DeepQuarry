/datum/token_target
/obj/first
    var/list/one = list(1,2)
    var/list/two = list(1,2)
    var/list/other = list(1,3)
    var/sound/snd_a = sound(null, 1)
    var/sound/snd_b = sound(null, 1)
    var/sound/snd_c = sound(null, 0)
    var/matrix/mat_a = matrix(1,0,0,0,1,0)
    var/matrix/mat_b = matrix(1,0,0,0,1,0)
    var/matrix/mat_c = matrix(2,0,0,0,1,0)
    var/datum/token_target/new_a = new /datum/token_target()
    var/datum/token_target/new_b = new /datum/token_target()
/obj/first/same
    one = list(1,2)
    two = list(1,2)
    snd_a = sound(null, 1)
    mat_a = matrix(1,0,0,0,1,0)
    new_a = new /datum/token_target()
/obj/first/different
    one = list(1,3)
    two = list(1,4)
/obj/second
    var/list/one = list(1,2)
var/global/list/global_one = list(1,2)
var/global/call_global = make_token(1)
/proc/make_token(x)
    return list(x)
/proc/same_defaults(obj/first/A)
    return initial(A.one) == initial(A.two)
/proc/different_defaults(obj/first/A)
    return initial(A.one) == initial(A.other)
/proc/cross_defaults(obj/first/A,obj/second/B)
    return initial(A.one) == initial(B.one)
/proc/global_default()
    return initial(global_one)
/proc/static_tokens()
    var/static/list/a = list(1,2)
    var/static/list/b = list(1,2)
    return initial(a) == initial(b)
