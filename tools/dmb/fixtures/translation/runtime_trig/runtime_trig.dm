/var/list/force_516 = alist()
/proc/runtime_sin(angle)
    return sin(angle)
/proc/runtime_cos(angle)
    return cos(angle)
/proc/runtime_tan(angle)
    return tan(angle)
/proc/runtime_arcsin(value)
    return arcsin(value)
/proc/runtime_arccos(value)
    return arccos(value)
/proc/runtime_arctan(value)
    return arctan(value)
/proc/runtime_arctan2(y,x)
    return arctan(y,x)
/proc/runtime_trig_arguments(angle)
    return list(sin(angle),cos(angle))
