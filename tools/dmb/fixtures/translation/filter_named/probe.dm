/proc/probe_ismob(a)
    return ismob(a)
/proc/probe_isarea(a)
    return isarea(a)
/proc/probe_isturf(a)
    return isturf(a)
/proc/probe_isloc(a)
    return isloc(a)
/proc/probe_ismovable(a)
    return ismovable(a)
/proc/probe_isicon(a)
    return isicon(a)
/proc/probe_time2text(a)
    return time2text(a)
/proc/probe_time2text2(a,b)
    return time2text(a,b)
/proc/probe_time2text3(a,b,c)
    return time2text(a,b,c)
/proc/probe_timestamp()
    return time2text()
/proc/probe_matrix(a,b,c,d,e,f)
    return matrix(a,b,c,d,e,f)
/proc/probe_filter(a,b)
    return filter(type=a,size=b)
/proc/probe_sha1(a)
    return sha1(a)

