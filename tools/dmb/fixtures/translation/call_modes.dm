/proc/m_json(data,flags)
    return json_encode(data,flags)
/proc/m_num(value,digits)
    return num2text(value,digits)
/proc/m_image(a,b,c,d,e)
    return image(a,b,c,d,e)
/proc/m_sound(a,b)
    return sound(volume=a,repeat=b)
/proc/m_sound_pos(a,b)
    return sound(a,b)
/proc/m_image_named(a,b)
    return image(icon=a,layer=b)
/proc/stub_json(data,flags)
    return json_encode(data,flags)
/proc/m_sound_mixed(a,b)
    return sound(a,volume=b)
/proc/m_sound_null(b)
    return sound(null,repeat=b)
