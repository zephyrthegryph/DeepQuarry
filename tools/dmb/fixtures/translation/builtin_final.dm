/proc/bf_sha1(x)
    return sha1(x)
/proc/bf_winclone(c, id, clone)
    winclone(c, id, clone)
/proc/bf_gen3(a,b,c)
    return generator(a,b,c)
/proc/bf_genlist(L)
    return generator(arglist(L))
/proc/bf_maxlist(L)
    return max(arglist(L))
/proc/bf_minlist(L)
    return min(arglist(L))
/proc/bf_splice(a,b,c,d)
    return splicetext_char(a,b,c,d)
/proc/bf_url(a)
    return url_decode(a)
/proc/bf_walk(a,b,c)
    walk_rand(a,b,c)
/proc/bf_walk2(a,b)
    walk_rand(a,b)
/proc/bf_self()
    return .()
