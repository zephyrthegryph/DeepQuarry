/proc/probe_call(fn,list/L)
    return call(fn)(arglist(L))
/proc/probe_ext(fn,list/L)
    return call_ext(fn)(arglist(L))
/proc/probe_filter(list/L)
    return filter(arglist(L))
/proc/probe_member(target,name,list/L)
    return call(target,name)(arglist(L))
/proc/probe_ext_member(target,name,list/L)
    return call_ext(target,name)(arglist(L))
