/var/list/force_516 = alist()
/proc/gradient_variable(list/colors, index)
    return gradient(colors, index)
/proc/gradient_seven()
    return gradient(0, "red", 0.5, "green", 1, "blue", 0.96)
/proc/gradient_named(a, b, index)
    return gradient(a, b, space=COLORSPACE_HSV, index)
/proc/gradient_arglist(list/arguments)
    return gradient(arglist(arguments))
/proc/gradient_literal()
    return gradient(list("red", "blue"), 0.5)
