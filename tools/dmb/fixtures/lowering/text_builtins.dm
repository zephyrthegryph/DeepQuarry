/var/list/force_516 = alist()
/var/calls = 0
/proc/text_probe(value)
    calls++
    return value
/proc/text_cmp_pair(a, b)
    return cmptext(a, b)
/proc/text_cmp_sensitive(a, b)
    return cmptextEx(a, b)
/proc/text_cmp_three(a, b, c)
    return cmptext(a, b, c)
/proc/text_cmp_sideeffects()
    return cmptext(text_probe("a"), text_probe("b"), text_probe("c"))
/proc/text_cmp_conditional(a, b)
    if(cmptext(a, b))
        return 1
    return 0
/proc/text_span(a, b, start)
    return spantext(a, b, start)
/proc/text_span_default(a, b)
    return spantext(a, b)
/proc/text_span_char(a, b, start)
    return spantext_char(a, b, start)
/proc/text_nonspan(a, b, start)
    return nonspantext(a, b, start)
/proc/text_nonspan_char(a, b, start)
    return nonspantext_char(a, b, start)
/proc/text_splice(a, start, end, replacement)
    return splicetext(a, start, end, replacement)
/proc/text_ascii_char(a, index)
    return text2ascii_char(a, index)
/proc/text_ascii_char_default(a)
    return text2ascii_char(a)
/proc/text_values_under(list/a, value)
    return values_cut_under(a, value)
/proc/text_values_over(list/a, value)
    return values_cut_over(a, value)
/proc/text_cmp_loop(list/a)
    var/total = 0
    for(var/value in a)
        total += cmptext(value, "x", "X")
    return total
/proc/text_splice_two(a, start)
    return splicetext(a, start)
/proc/text_splice_three(a, start, end)
    return splicetext(a, start, end)
/proc/text_splice_char_two(a, start)
    return splicetext_char(a, start)
/proc/text_splice_char_three(a, start, end)
    return splicetext_char(a, start, end)
/proc/text_findlast_three(a, needle, start)
    return findlasttext(a, needle, start)
/proc/text_findlast_four(a, needle, start, end)
    return findlasttext(a, needle, start, end)
/proc/text_trunc(value)
    return trunc(value)
/proc/text_fract(value)
    return fract(value)
/proc/text_empty_sound()
    return sound()
/proc/text_cmp_branch_first(flag, a, b, c)
    return cmptext(flag ? a : b, b, c)
/proc/text_cmp_branch_last(flag, a, b, c)
    return cmptext(a, b, flag ? b : c)
/proc/text_cmp_shortcircuit(a, b, c)
    return cmptext(a, b, b || text_probe(c))
/proc/text_cmp_nested_branch(flag, a, b, c)
    return cmptext(a, flag ? (a || b) : c, text_probe(c))
