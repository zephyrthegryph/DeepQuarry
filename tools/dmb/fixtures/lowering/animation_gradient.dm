/proc/gradient_two()
    return gradient(list("#ff0000", "#0000ff"), 0.5)
/proc/gradient_four()
    return gradient("#ff0000", "#00ff00", "#0000ff", 0.5)
/proc/animate_one_named(var/atom/movable/a)
    animate(a, alpha=128)
/proc/animate_three_named(var/atom/movable/a)
    animate(a, alpha=128, time=2, loop=1)
/proc/use_gradient()
    return gradient("#ff0000", "#0000ff", 0.5)
/proc/use_animate(var/atom/movable/a)
    animate(a, alpha=128, time=2)
/proc/use_animate_simple(var/atom/movable/a)
    animate(a)
