/world
/proc/initial_key(a,list/L,k,j)
    return initial(L[a ? k : j])
/proc/initial_owner(a,list/A,list/B,k)
    return initial((a ? A : B)[k])
/proc/initial_both(a,list/A,list/B,k,j)
    return initial((a ? A : B)[a ? k : j])
/proc/initial_short(a,list/L,k)
    return initial(L[a || k])
/proc/saved_key(a,list/L,k,j)
    return issaved(L[a ? k : j])
/proc/saved_owner(a,list/A,list/B,k)
    return issaved((a ? A : B)[k])
/proc/saved_both(a,list/A,list/B,k,j)
    return issaved((a ? A : B)[a ? k : j])
/proc/saved_short(a,list/L,k)
    return issaved(L[a || k])
