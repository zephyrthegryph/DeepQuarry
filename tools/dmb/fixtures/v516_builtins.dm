/proc/dmb_fixture_arithmetic(a, b, c)
    var/sum = values_sum(a)
    var/product = values_product(a)
    var/dot = values_dot(a, b)
    var/under = values_cut_under(a, b, c)
    var/over = values_cut_over(a, b, c)
    var/signed = sign(b)
    var/interpolated = lerp(a, b, c)
    return list(sum, product, dot, under, over, signed, interpolated)

/proc/dmb_fixture_spatial(a, b)
    var/vector/v = vector(a, b)
    var/pixloc/p = pixloc(a, b, 1)
    var/pixloc/q = bound_pixloc(src, 1)
    return list(v, p, q)
