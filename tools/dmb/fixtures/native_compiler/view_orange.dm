/proc/probe_view_zero()
    return view()
/proc/probe_view_one()
    return view(6)
/proc/probe_view_two(atom/A)
    return view(6, A)
/proc/probe_orange_zero()
    return orange()
/proc/probe_orange_one()
    return orange(6)
/proc/probe_orange_two(atom/A)
    return orange(6, A)
/proc/probe_turf_in_orange()
    return pick(/turf in orange(6))
