/proc/probe_generator_num(a,b)
    return generator("num", a, b)
/proc/probe_generator_four(a,b,c)
    return generator("circle", a, b, c)
/proc/probe_generator_vector(a,b)
    return generator("vector", a, b)
/proc/probe_generator_named(a,b)
    return generator("num", min = a, max = b)
/proc/probe_alist_pairs(a,b)
    return alist("a" = a, "b" = b)
/proc/probe_alist_empty()
    return alist()
