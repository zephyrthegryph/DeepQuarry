macro "default"


window "mainwindow"
	elem "mainwindow"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 281,0
		size = 640x440
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-default = true
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "CHOMPStation"
		is-maximized = true
		statusbar = false
		icon = 'icons/ss13_64.png'
		macro = "default"	// bindings are added per client with winset (code/modules/keybindings)
	elem "asset_cache_browser"
		type = BROWSER
		pos = 0,0
		size = 200x200
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		saved-params = ""
	elem "tgui_shock"
		type = BROWSER
		pos = 0,0
		size = 200x200
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		saved-params = ""
	// hotkey_toggle element deleted; non-hotkey mode is disabled.
	elem "mainvsplit"
		type = CHILD
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0	// was 3,0; removed left padding
		size = 640x440	// was 634x400; expanded to cover the removed bottom bars + left padding
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = ""	// not saved: a stale share must not squeeze the map on the next connect
		splitter = 70
		show-splitter = false	// no bar between the map and the column: the column pages draw the live handle (MapSplitHandle)
		right = "rpane"
		is-vert = true
	// input, status_bar, and saybutton elements deleted (non-hotkey
	// mode is disabled in this fork; the input + status row served only that).
	// is-visible = false left them taking layout space; full deletion gives
	// us the freed pixels back. mainvsplit was already resized to 634x440
	// (above) to fill where they used to be.
	elem "commandbar_spy"
		type = BROWSER
		is-default = false
		pos = 0,0
		size = 200x200
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		saved-params = ""

window "mapwindow"
	elem "mapwindow"
		type = MAIN
		pos = 281,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
		on-status = ".winset \"status_bar.text=[[*]]\" "
	elem "map"
		type = MAP
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		font-family = "Grand9K Pixel"
		font-size = 7
		text-color = none
		is-default = true
		saved-params = "icon-size"
		on-show = ".winset\"mainwindow.mainvsplit.left=mapwindow\""
		on-hide = ".winset\"mainwindow.mainvsplit.left=\""
		style = ".center { text-align: center; } .runechatdiv {background-color: #20202070} .black_outline { -dm-text-outline: 1px black } .bold { font-weight: bold; } .maptext { font-family: 'Grand9K Pixel'; font-size: 6pt; -dm-text-outline: 1px black; color: white; line-height: 1.0; } .command_headset { font-weight: bold;\tfont-size: 8px; } .small { font-size: 6px; } .very_small { font-size: 5px;} .big { font-size: 8px; } .reallybig { font-size: 8px; } .extremelybig { font-size: 8px; } .greentext { color: #00FF00; font-size: 7px; } .redtext { color: #FF0000; font-size: 7px; } .clown { color: #FF69Bf; font-size: 7px;  font-weight: bold; } .his_grace { color: #15D512; } .hypnophrase { color: #0d0d0d; font-weight: bold; } .yell { font-weight: bold; } .italics { font-size: 7px; font-style: italic; }"
	elem "lobby_browser"
		type = BROWSER
		pos = 0,0
		size = 640,480
		anchor1 = 0,0
		anchor2 = 100,100
		is-visible = false
		is-disabled = true
		background-color = #222222
	// DQAdd Start — belly overlay child of mapwindow.
	// inner-background-color=none (BYOND 516.1680+) tells the BROWSER's
	// WebView2 surface to composite against the parent control instead of
	// a solid backdrop, which lets the underlying MAP show through where
	// the page renders transparent pixels.
	elem "belly_overlay"
		type = BROWSER
		pos = 0,0
		size = 640,480
		anchor1 = 0,0
		anchor2 = 100,100
		is-visible = false
		inner-background-color = #00000000
	// DQAdd End
	// DQ: in-game hover tooltip. Must be a mapwindow child (like belly_overlay
	// above) — a mainwindow-level BROWSER composites its transparent pixels
	// against mainwindow's backdrop (grey), not the embedded map pane. As a
	// mapwindow child anchored over the map it shows the map through instead.
	elem "tooltip"
		type = BROWSER
		pos = 0,0
		size = 8,8
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		inner-background-color = #00000000

window "outputwindow"
	elem "outputwindow"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "legacy_output_selector"
		type = CHILD
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = "splitter"
		left = "output_legacy"
		is-vert = false

window "output_legacy"
	elem "output_legacy"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "output"
		type = OUTPUT
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		background-color = #151515
		text-color = #B3CCE6
		is-default = true
		saved-params = "max-lines"
		style = ".system {color:#FF0000;}"
		enable-http-images = true

window "output_browser"
	elem "output_browser"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
		//outer-size = 656x538
		//inner-size = 640x499
	elem "browseroutput"
		type = BROWSER
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = ""

window "popupwindow"
	elem "popupwindow"
		type = MAIN
		pos = 281,0
		size = 120x120
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		saved-params = "pos;size;is-minimized;is-maximized"
		statusbar = false
		can-resize = false

// Hidden native template for reusable, flicker-free TGUI browser shells. Runtime pool
// windows are cloned from this instead of being created by browse(), because
// browse-created popup windows are visible before their page can hide itself.
window "tgui_window_template"
	elem "tgui_window_template"
		type = MAIN
		pos = 0,0
		size = 400x600
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		alpha = 0
		saved-params = ""
		statusbar = false
		can-minimize = false
		can-resize = true
		titlebar = true
	elem "browser"
		type = BROWSER
		pos = 0,0
		size = 400x600
		anchor1 = 0,0
		anchor2 = 100,100
		is-visible = true
		background-color = none
		saved-params = ""

window "prefs_markings_subwindow"

	elem "prefs_markings_subwindow"
		type = MAIN
		pos = 281,0
		size = 400x400
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		is-visible = false
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "Marking Selection Editing"
		statusbar = false
		can-minimize = false
		outer-size = 416x439
		inner-size = 400x400
	elem "prefs_markings_browser"
		type = BROWSER
		pos = 0,0
		size = 400x400
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		saved-params = ""

window "rpane"
	elem "rpane"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 281,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "rpanewindow"
		type = CHILD
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = ""	// not saved: the chat share is a preference (chat_layout_sync), and a share saved for the other end would flip
		splitter = 100	// the chat's pane is the whole column: the column page holds the stat panel, the chat and docked windows (tgui-panel/column)
		show-splitter = false
		left = "outputwindow"
		right = ""
		is-vert = false
	elem "mediapanel"
		type = BROWSER
		pos = 392,25
		size = 1x1
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		is-visible = false
		saved-params = ""

window "ooc_notes"
	elem "ooc_notes"
		type = MAIN
		pos = 25,25
		size = 700x600
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		saved-params = "pos;is-minimized;is-maximized"
		statusbar = false
	elem "ooc_notes_panel"
		type = BROWSER
		pos = 0,0
		size = 700x600
		anchor1 = 0,0
		anchor2 = 80,100
		saved-params = ""

window "text_editor"
	elem "text_editor"
		type = MAIN
		pos = 281,0
		size = 360x488
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-visible = false
		border = sunken
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "Text Editor"
		can-minimize = false
		can-resize = false
	elem "exit"
		type = BUTTON
		pos = 248,456
		size = 104x24
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "is-checked"
		text = "Exit without saving"
		command = ""
	elem "save"
		type = BUTTON
		pos = 128,456
		size = 104x24
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "is-checked"
		text = "Save"
		command = ""
	elem "saveexit"
		type = BUTTON
		pos = 8,456
		size = 104x24
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "is-checked"
		text = "Save + Exit"
		command = ""
	elem "textedit"
		type = INPUT
		pos = 0,0
		size = 360x448
		anchor1 = -1,-1
		anchor2 = -1,-1
		border = line
		saved-params = ""
		multi-line = true

window "statwindow"
	elem "statwindow"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 281,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "statbrowser"
		type = BROWSER
		background-color = #202020
		text-color = #B3CCE6
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		is-visible = false

window "statwindow"
	elem "statwindow"
		type = MAIN
		background-color = #202020
		text-color = #B3CCE6
		pos = 281,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "statbrowser"
		type = BROWSER
		background-color = #202020
		text-color = #B3CCE6
