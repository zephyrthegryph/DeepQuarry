{
  "_comment": "Run over both parsers: /datum/unit_test/inline_language_shared_cases (DM) and tgui-say parseLanguages.test.ts. Language labels: default is the preferred language; s and k are spoken; q is a real language the speaker cannot speak; n is noise; gibberish is the fallback. 5 is bound to a spoken language so 3,5 proves the boundary rule. Prefixes are , # and -. A piece is [language label, text]. whole names a language that takes the entire message.",
  "cases": [
    { "name": "plain", "message": "Hello there", "pieces": [["default", "Hello there"]] },
    { "name": "single prefix", "message": ",s Hello", "pieces": [["s", "Hello"]] },
    { "name": "single prefix without a space", "message": ",sHello", "pieces": [["s", "Hello"]] },
    { "name": "other prefix character", "message": "#k Hello", "pieces": [["k", "Hello"]] },
    { "name": "two languages", "message": ",s Hello ,k friend", "pieces": [["s", "Hello"], ["k", "friend"]] },
    { "name": "unkeyed text first is preferred", "message": "Hello ,k friend", "pieces": [["default", "Hello"], ["k", "friend"]] },
    { "name": "three pieces", "message": ",s a ,k b ,s c", "pieces": [["s", "a"], ["k", "b"], ["s", "c"]] },
    { "name": "normal comma stays text", "message": "Hello, friend", "pieces": [["default", "Hello, friend"]] },
    { "name": "comma with no space before stays text", "message": "well,s then", "pieces": [["default", "well,s then"]] },
    { "name": "decimal comma stays text", "message": "It costs 3,5 credits", "pieces": [["default", "It costs 3,5 credits"]] },
    { "name": "space after the comma is no key", "message": "yes , s no", "pieces": [["default", "yes , s no"]] },
    { "name": "lone comma at the end", "message": "trailing ,", "pieces": [["default", "trailing ,"]] },
    { "name": "unknown key at the start stays text", "message": ",~ Hello", "pieces": [["default", ",~ Hello"]] },
    { "name": "unknown key mid-sentence stays text", "message": "Hello ,~ friend", "pieces": [["default", "Hello ,~ friend"]] },
    { "name": "unknown key before a real one keeps its text", "message": ",~ Hello ,k friend", "pieces": [["default", ",~ Hello"], ["k", "friend"]] },
    { "name": "unspoken language at the start is gibberish", "message": ",q Hello", "pieces": [["gibberish", "Hello"]] },
    { "name": "unspoken language mid-sentence stays text", "message": "Hello ,q friend", "pieces": [["default", "Hello ,q friend"]] },
    { "name": "noise key mid-sentence stays text", "message": "Hello ,n friend", "pieces": [["default", "Hello ,n friend"]] },
    { "name": "switch with no text makes no piece", "message": ",s ,k friend", "pieces": [["k", "friend"]] },
    { "name": "trailing switch makes no piece", "message": "Hello ,k", "pieces": [["default", "Hello"]] },
    { "name": "only a key", "message": ",k", "pieces": [["k", ""]] },
    { "name": "hivemind key takes the whole message", "message": ",h secret", "whole": "h", "text": "secret" },
    { "name": "hivemind key mid-sentence takes the whole message", "message": "Hello ,h secret", "whole": "h", "text": "Hello secret" },
    { "name": "decimal survives a hivemind message", "message": ",h 3,5 units", "whole": "h", "text": "3,5 units" },
    { "name": "formatting stays in its piece", "message": ",s +Hello+ ,k |friend|", "pieces": [["s", "+Hello+"], ["k", "|friend|"]] }
  ]
}
