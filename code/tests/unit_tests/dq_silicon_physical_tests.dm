// The physical contracts use real actor bodies, not remote input authority.
/datum/unit_test/dq_silicon/physical_inventory_and_work
/datum/unit_test/dq_silicon/physical_inventory_and_work/run_gate()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = make_human(T)
	var/mob/living/silicon/robot/R = make_borg(T)
	var/mob/living/silicon/ai/AI = make_ai(T)
	var/obj/item/I = allocate(/obj/item, T)
	TEST_ASSERT_EQUAL(H.wall_plating_duration(), 4 SECONDS, "human plating retains the original duration")
	TEST_ASSERT_EQUAL(R.wall_plating_duration(), 1.5 SECONDS, "borg plating retains its physical speed bonus")
	TEST_ASSERT(!I.mob_can_unequip(H, null), "a human cannot release an item through a nonexistent equipment slot")
	TEST_ASSERT(I.mob_can_unequip(R, null), "a borg can release its slotless gripper item")
	TEST_ASSERT(I.mob_can_unequip(AI, null), "the original silicon slotless admission includes AI")
	set_var(I, nameof(I.canremove), FALSE)
	TEST_ASSERT(!I.mob_can_unequip(R, null), "grippers still obey the item's removal prohibition")
	TEST_ASSERT(!I.mob_can_unequip(AI, null), "AI still obeys the item's removal prohibition")

/datum/unit_test/dq_silicon/physical_flash_guard
/datum/unit_test/dq_silicon/physical_flash_guard/run_gate()
	var/turf/T = test_floor()
	var/mob/living/silicon/robot/R = make_borg(T)
	var/obj/item/flash/F = allocate(/obj/item/flash, T)
	var/list/before = T.contents.Copy()
	var/datum/act/op/A = take(/datum/act/op)
	A.actor = R
	F.interaction_self(A)
	A.release()
	TEST_ASSERT_EQUAL(F.times_used, initial(F.times_used), "the real carbon-only self-flash guard refuses a borg before using charge")
	for(var/atom/movable/overlay/animation in T)
		TEST_ASSERT(animation in before, "a rejected borg does not create the unreachable animation")

/datum/unit_test/dq_silicon/physical_shell_credential
/datum/unit_test/dq_silicon/physical_shell_credential/run_gate()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = make_human(T)
	var/mob/living/silicon/robot/R = make_borg(T)
	var/mob/living/silicon/robot/ai_shell/S = allocate(/mob/living/silicon/robot/ai_shell, T)
	var/obj/item/mmi/inert/ai_remote/remote_brain = allocate(/obj/item/mmi/inert/ai_remote, T)
	var/obj/item/mmi/brain = allocate(/obj/item/mmi, T)
	TEST_ASSERT_NULL(H.robot_assembly_refusal(remote_brain), "a human can assemble a remote shell")
	TEST_ASSERT_NULL(R.robot_assembly_refusal(remote_brain), "an ordinary borg can assemble a remote shell")
	TEST_ASSERT_EQUAL(S.robot_assembly_refusal(remote_brain), span_warning("Your hardware prohibits you from self-replicating."), "a real AI shell retains its hardware refusal text")
	TEST_ASSERT_NULL(S.robot_assembly_refusal(brain), "the shell's restriction does not reject an ordinary MMI")

/datum/unit_test/dq_silicon/physical_restraint_evidence
/datum/unit_test/dq_silicon/physical_restraint_evidence/run_gate()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = make_human(T)
	var/mob/living/carbon/human/V = make_human(T)
	var/mob/living/silicon/robot/R = make_borg(T)
	TEST_ASSERT_EQUAL(H.restraint_evidence(H, TRUE), H, "self restraint bypasses the grab requirement")
	TEST_ASSERT_NULL(H.restraint_evidence(V), "a human without an actual grab has no restraint evidence")
	var/obj/item/grab/G = allocate(/obj/item/grab, H, V)
	H.put_in_active_hand(G)
	TEST_ASSERT_NULL(H.restraint_evidence(V), "a passive real grab is insufficient")
	G.set_state(GRAB_AGGRESSIVE)
	TEST_ASSERT_EQUAL(H.restraint_evidence(V), G, "an aggressive real grab supplies the exact evidence object")
	TEST_ASSERT_EQUAL(R.restraint_evidence(V, TRUE), R, "adjacent borg hardware supplies cuff evidence")
	R.forceMove(get_step(get_step(T, NORTH), NORTH))
	TEST_ASSERT_NULL(R.restraint_evidence(V, TRUE), "distant borg hardware cannot supply cuff evidence")
	TEST_ASSERT_EQUAL(R.restraint_evidence(V), R, "tape retains its distinct distant borg hardware rule")

/datum/unit_test/dq_silicon/physical_storage_dump
/datum/unit_test/dq_silicon/physical_storage_dump/run_gate()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = make_human(T)
	var/mob/living/silicon/robot/R = make_borg(T)
	var/mob/living/silicon/ai/AI = make_ai(T)
	var/obj/item/storage/backpack/S = allocate(/obj/item/storage/backpack, T)
	var/obj/item/pen/P = allocate(/obj/item/pen, T)
	TEST_ASSERT(S.insert_item(P, H, TRUE), "a real item is inserted through storage admission")
	TEST_ASSERT(P in S.stored_items(), "the item is actually in the native storage slot")
	TEST_ASSERT(!S.try_quick_empty(AI), "AI interface cannot dump physical storage")
	TEST_ASSERT_EQUAL(P.loc, S, "AI refusal preserves the contents")
	TEST_ASSERT(S.try_quick_empty(R), "an adjacent borg can dump storage")
	TEST_ASSERT_EQUAL(P.loc, T, "the real item is dropped onto the storage floor")
	TEST_ASSERT(S.insert_item(P, H, TRUE), "the item is reinserted for the human transaction")
	TEST_ASSERT(S.try_quick_empty(H), "an adjacent human can dump storage")
	TEST_ASSERT_EQUAL(P.loc, T, "human dumping preserves the same drop destination")

/datum/unit_test/dq_silicon/physical_railing_ops
/datum/unit_test/dq_silicon/physical_railing_ops/run_gate()
	var/turf/T = test_floor()
	var/mob/living/silicon/robot/R = make_borg(get_step(T, EAST))
	var/mob/living/silicon/ai/AI = make_ai(get_step(T, WEST))
	var/obj/structure/railing/B = allocate(/obj/structure/railing, T)
	B.set_anchored(FALSE)
	var/old_dir = B.dir
	var/datum/op_result/denied = test_menu(AI, B, "rotatable.clockwise")
	TEST_ASSERT(!denied || denied.outcome != ACT_COMMITTED, "AI interface cannot physically rotate the railing")
	TEST_ASSERT_EQUAL(B.dir, old_dir, "AI refusal preserves orientation")
	var/datum/op_result/turned = test_menu(R, B, "rotatable.clockwise")
	TEST_ASSERT_EQUAL(turned?.outcome, ACT_COMMITTED, "a physically adjacent borg rotates the loose railing")
	TEST_ASSERT_EQUAL(B.dir, turn(old_dir, 270), "native rotation preserves the old clockwise direction")
	B.set_anchored(TRUE)
	old_dir = B.dir
	var/datum/op_result/fastened = test_menu(R, B, "rotatable.clockwise")
	TEST_ASSERT(!fastened || fastened.outcome != ACT_COMMITTED, "fastened railing still refuses rotation")
	TEST_ASSERT_EQUAL(B.dir, old_dir, "refused rotation has no effect")
