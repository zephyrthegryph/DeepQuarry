/// Using a technomancer ability (from the Abilities tab) retains its actor through actual core-backed spell creation; only the one who has it can use it.
/datum/unit_test/round2_technomancer_ability_actor/Run()
	test_driver_begin()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/dummy/actor = allocate(/mob/living/carbon/human/dummy, T)
	var/mob/living/carbon/human/dummy/bystander = allocate(/mob/living/carbon/human/dummy, T)
	var/mob/observer/dead/observer = allocate(/mob/observer/dead, T)
	observer.forceMove(T)
	var/obj/item/technomancer_core/universal/core = allocate(/obj/item/technomancer_core/universal, T)
	core.add_spell(/obj/item/spell/warp_strike, "Actor warp", "tech_warpstrike")
	TEST_ASSERT_EQUAL(length(core.spells), 1, "the real core creates one actually owned spell button")
	var/obj/spellbutton/button = core.spells[1]
	TEST_ASSERT_EQUAL(button.core, core, "the actual constructor retains its original core")
	TEST_ASSERT(actor.equip_to_slot_if_possible(core, SLOT_ID_BACK), "real inventory equips the actual universal core")
	TEST_ASSERT_EQUAL(core.wearer, actor, "the real equipped lifecycle records the actual wearer")
	var/datum/action/technomancer_spell/ability = technomancer_ability_of(actor, button)
	TEST_ASSERT(ability && ability.button() == button, "actual equip gives an ability pointing at its original spell button")
	TEST_ASSERT_EQUAL(ability.ability_category, ABILITY_CATEGORY_SPELLS, "a technomancer's spell is in the Spells category")
	var/obj/item/technomancer_core/universal/bystander_core = allocate(/obj/item/technomancer_core/universal, T)
	TEST_ASSERT(bystander.equip_to_slot_if_possible(bystander_core, SLOT_ID_BACK), "real inventory equips the independent human's actual universal core")
	var/energy = core.energy
	var/bystander_energy = bystander_core.energy
	TEST_ASSERT(!observer.use_ability_entry(ability, "tab"), "an actual unsupported observer cannot use the core wearer's ability")
	TEST_ASSERT_NULL(actor.get_active_hand(), "so it cannot create a spell for the core wearer")
	TEST_ASSERT_EQUAL(length(contents_of(observer, /obj/item/spell)), 0, "and creates no observer spell")
	TEST_ASSERT(!bystander.use_ability_entry(ability, "tab"), "another human cannot use an ability that is not theirs")
	TEST_ASSERT_NULL(bystander.get_active_hand(), "so it creates no spell in their hand")
	TEST_ASSERT_NULL(actor.get_active_hand(), "and cannot fill the original core wearer's hand")
	TEST_ASSERT(actor.use_ability_entry(ability, "tab"), "the wearer uses their ability")
	var/obj/item/spell/warp_strike/first = actor.get_active_hand()
	TEST_ASSERT(istype(first), "the ability places a real warp spell in the initiating human's active hand")
	own(first)
	TEST_ASSERT_EQUAL(first.owner_ref(), actor, "actual spell construction preserves the initiating ability actor")
	TEST_ASSERT_EQUAL(first.core, core, "actual spell construction retains the exact worn core")
	TEST_ASSERT(first.run_checks(), "the actual universal core authorizes its real held spell without a fabricated antagonist")
	TEST_ASSERT(actor.unEquip(first), "real inventory releases the actual disposable spell")
	TEST_ASSERT(QDELETED(first), "actual DROPDEL release removes the original spell")
	TEST_ASSERT_NULL(actor.get_active_hand(), "real disposable release frees the initiating hand")
	STATE_SET(actor, cooldowns, next_click, 0) // the next use comes a click later
	TEST_ASSERT(actor.use_ability_entry(ability, "tab"), "using the ability again works")
	var/obj/item/spell/warp_strike/second = actor.get_active_hand()
	TEST_ASSERT(istype(second) && second != first, "repeated activation creates a distinct real held warp spell")
	own(second)
	TEST_ASSERT_EQUAL(second.owner_ref(), actor, "repeated activation retains the initiating actor")
	TEST_ASSERT_EQUAL(second.core, core, "repeated activation retains the original worn core")
	TEST_ASSERT_EQUAL(core.energy, energy, "actual spell-button creation alone does not spend casting energy")
	TEST_ASSERT_EQUAL(bystander_core.energy, bystander_energy, "independent core's energy is untouched")
	TEST_ASSERT_EQUAL(actor.get_equipped_item(SLOT_ID_BACK), core, "activation preserves the original actual back slot")
	TEST_ASSERT_EQUAL(core.spells[1], button, "all success/refusal paths preserve the original owned spell button")
	TEST_ASSERT_EQUAL(technomancer_ability_of(actor, button), ability, "all paths preserve the actual ability identity")
	TEST_ASSERT_NULL(bystander.get_active_hand(), "repeated owner activation leaves the unrelated human's hand unchanged")
	test_driver_end()

/// The technomancer ability of `button` that `user` has, or null.
/datum/unit_test/proc/technomancer_ability_of(mob/user, obj/spellbutton/button)
	for(var/datum/action/technomancer_spell/entry in user.actions)
		if(entry.button() == button)
			return entry
	return null
