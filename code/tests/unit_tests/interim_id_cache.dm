/datum/unit_test/interim_rdconsole_id_cache/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/obj/machinery/computer/rdconsole_tg/first = allocate(/obj/machinery/computer/rdconsole_tg, T)
	var/list/cache = list()
	var/first_id = first.compress_id("interim-first", cache)
	var/second_id = first.compress_id("interim-second", cache)
	TEST_ASSERT_EQUAL(first_id, 1, "compression starts at the payload's first slot")
	TEST_ASSERT_EQUAL(second_id, 2, "distinct payload IDs receive distinct compressed IDs")
	TEST_ASSERT_EQUAL(first.compress_id("interim-first", cache), first_id, "repeated compression keeps its original payload ID")
	TEST_ASSERT_EQUAL(first.compress_id("interim-second", cache), second_id, "deduplication preserves the second payload ID too")
	var/list/other = list()
	TEST_ASSERT_EQUAL(first.compress_id("interim-second", other), 1, "another payload owns an independent compression sequence")
	TEST_ASSERT_EQUAL(length(cache), 2, "another payload's compression cannot mutate the first mapping")
	var/list/static_data = present_tgui_static_data(first, null)
	TEST_ASSERT(length(static_data["static_data"]["id_cache"]) > 0, "the static payload carries its own id cache")
