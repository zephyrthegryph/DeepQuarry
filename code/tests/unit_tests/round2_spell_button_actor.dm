/// A spell's ability invokes the actual spell and retains its caster through timed casting.
/datum/unit_test/round2_spell_button_actor/Run()
	test_driver_begin()
	var/turf/T = test_floor()
	var/turf/other = get_step(get_step(T, EAST), EAST)
	TEST_ASSERT(istype(other, /turf/simulated/floor) && other != T, "the fixture has two real distinct floor locations")
	var/mob/living/carbon/human/dummy/actor = allocate(/mob/living/carbon/human/dummy, T)
	var/mob/living/carbon/human/dummy/bystander = allocate(/mob/living/carbon/human/dummy, other)
	var/datum/spell/aoe_turf/conjure/forcewall/spell = allocate(/datum/spell/aoe_turf/conjure/forcewall)
	TEST_ASSERT(actor.add_spell(spell), "the real public spell-learning API gives the actual spell ability")
	var/datum/action/spell_ability/entry = spell_ability_of(actor, spell)
	TEST_ASSERT(entry && entry.spell() == spell, "actual spell learning links the original spell to its ability")
	TEST_ASSERT_EQUAL(entry.ability_category, ABILITY_CATEGORY_SPELLS, "a spell's ability is in the Spells category")
	TEST_ASSERT(spell in actor.spell_list, "actual spell learning records the original spell in the caster ledger")
	TEST_ASSERT_EQUAL(spell.charge_counter, spell.charge_max, "the actual spell constructor starts ready")
	TEST_ASSERT_EQUAL(entry.ability_cooldown_left(), 0, "a ready spell shows no cooldown")
	TEST_ASSERT_EQUAL(length(turf_contents_of_type(T, /obj/effect/forcefield)), 0, "the actual caster floor starts without a forcewall")
	TEST_ASSERT_EQUAL(length(turf_contents_of_type(other, /obj/effect/forcefield)), 0, "the actual bystander floor starts without a forcewall")
	TEST_ASSERT(actor.use_ability_entry(entry, "tab"), "using the spell's ability casts it")
	test_time(1 SECONDS)
	own_turf_contents(T)
	var/list/walls = turf_contents_of_type(T, /obj/effect/forcefield)
	TEST_ASSERT_EQUAL(length(walls), 1, "casting creates exactly one actual forcewall at the initiating caster")
	var/obj/effect/forcefield/wall = walls[1]
	TEST_ASSERT(wall.density && wall.anchored, "the actual spell creates the canonical anchored dense forcefield")
	TEST_ASSERT_EQUAL(spell.holder(), actor, "actual perform and its timed cast preserve the initiating caster")
	TEST_ASSERT(spell.charge_counter < spell.charge_max, "real casting spends charge and starts actual recharge")
	TEST_ASSERT(entry.ability_cooldown_left() > 0, "and the ability shows the recharge as a cooldown")
	TEST_ASSERT_EQUAL(entry.ability_refusal(), "recharging", "so it is refused as recharging")
	TEST_ASSERT_EQUAL(length(turf_contents_of_type(other, /obj/effect/forcefield)), 0, "casting leaves the unrelated human's floor unchanged")
	STATE_SET(actor, cooldowns, next_click, 0) // the next use comes a click later
	TEST_ASSERT(!actor.use_ability_entry(entry, "tab"), "a recharging spell is refused")
	test_time(1 SECONDS)
	TEST_ASSERT_EQUAL(length(turf_contents_of_type(T, /obj/effect/forcefield)), 1, "a real cooldown refusal cannot duplicate the existing forcewall")
	walls = turf_contents_of_type(T, /obj/effect/forcefield)
	TEST_ASSERT_EQUAL(walls[1], wall, "cooldown refusal preserves the original real forcefield")
	var/datum/spell/aoe_turf/conjure/forcewall/other_spell = allocate(/datum/spell/aoe_turf/conjure/forcewall)
	TEST_ASSERT(bystander.add_spell(other_spell), "the independent real human learns its own spell")
	var/datum/action/spell_ability/other_entry = spell_ability_of(bystander, other_spell)
	TEST_ASSERT(other_entry && other_entry != entry, "independent real learning creates a distinct ability")
	TEST_ASSERT(bystander.use_ability_entry(other_entry, "tab"), "the independent human uses their own spell")
	test_time(1 SECONDS)
	own_turf_contents(other)
	TEST_ASSERT_EQUAL(length(turf_contents_of_type(other, /obj/effect/forcefield)), 1, "the independent use casts its real forcewall on its own floor")
	TEST_ASSERT_EQUAL(other_spell.holder(), bystander, "the independent timed cast retains its own actual initiating human")
	TEST_ASSERT_EQUAL(spell.holder(), actor, "independent casting preserves the original actual caster relation")
	TEST_ASSERT_EQUAL(length(turf_contents_of_type(T, /obj/effect/forcefield)), 1, "independent casting leaves the original forcewall unchanged")
	actor.remove_spell(spell)
	TEST_ASSERT_NULL(spell_ability_of(actor, spell), "forgetting the spell removes its ability")
	test_driver_end()

/// The ability of `spell` that `user` has, or null.
/datum/unit_test/proc/spell_ability_of(mob/user, datum/spell/spell)
	for(var/datum/action/spell_ability/entry in user.actions)
		if(entry.spell() == spell)
			return entry
	return null
