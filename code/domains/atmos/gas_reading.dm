// The reading of a gas mixture on a CH_GAS_* channel, in DM (sensed() reads the band it starts from with it; Rust compares the same channels).

/// The reading of `mixture` on `channel`.
/proc/gas_reading(datum/gas_mixture/mixture, channel)
	switch(channel)
		if(CH_GAS_PRESSURE)
			return mixture.return_pressure()
		if(CH_GAS_TEMPERATURE)
			return mixture.return_temperature()
		if(CH_GAS_MOLES)
			return mixture.total_moles()
		if(CH_GAS_OXYGEN)
			return mixture.get_moles(/datum/gas/oxygen)
		if(CH_GAS_PLASMA)
			return mixture.get_moles(/datum/gas/plasma)
		if(CH_GAS_CARBON_DIOXIDE)
			return mixture.get_moles(/datum/gas/carbon_dioxide)
		if(CH_GAS_NITROGEN)
			return mixture.get_moles(/datum/gas/nitrogen)
		if(CH_GAS_METHANE)
			return mixture.get_moles(/datum/gas/methane)
		if(CH_GAS_O2_KPA, CH_GAS_N2_KPA, CH_GAS_CO2_KPA, CH_GAS_PLASMA_KPA, CH_GAS_N2O_KPA, CH_GAS_CH4_KPA, CH_GAS_FUEL_KPA, CH_GAS_O2_CO2_KPA, CH_GAS_TRACE_KPA)
			return gas_reading_kpa(mixture, channel)
	CRASH("gas_reading: unknown channel [channel]")

/// The partial pressure channels (kPa) of `mixture`, from one sample of it (Rust's channels sum the same gases).
/proc/gas_reading_kpa(datum/gas_mixture/mixture, channel)
	var/datum/gas_sample/S = gas_sample(mixture)
	switch(channel)
		if(CH_GAS_O2_KPA)
			return S.partial_pressure(GAS_O2)
		if(CH_GAS_N2_KPA)
			return S.partial_pressure(GAS_N2)
		if(CH_GAS_CO2_KPA)
			return S.partial_pressure(GAS_CO2)
		if(CH_GAS_PLASMA_KPA)
			return S.partial_pressure(GAS_PHORON)
		if(CH_GAS_N2O_KPA)
			return S.partial_pressure(GAS_N2O)
		if(CH_GAS_CH4_KPA)
			return S.partial_pressure(GAS_CH4)
		if(CH_GAS_FUEL_KPA)
			return S.partial_pressure(GAS_VOLATILE_FUEL)
		if(CH_GAS_O2_CO2_KPA)
			return S.partial_pressure(GAS_O2) + S.partial_pressure(GAS_CO2)
		if(CH_GAS_TRACE_KPA)
			return S.partial_pressure(GAS_N2O) + S.partial_pressure(GAS_VOLATILE_FUEL)
	CRASH("gas_reading_kpa: not a partial pressure channel [channel]")
