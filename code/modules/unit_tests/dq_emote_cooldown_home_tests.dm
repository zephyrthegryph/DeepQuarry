// The mob emote cooldowns use the existing native table; belly cadence is separate.
/datum/unit_test/dq_emote_cooldown_home
/datum/unit_test/dq_emote_cooldown_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/e0_fixture/M = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/simple_mob/e0_fixture/other = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	TEST_ASSERT(!cooldown_started(M, next_emote), "a fresh mob has no active emote cooldown")
	var/datum/decl/emote/visible/nod/E = GLOB.decls_repository.get_decl(/datum/decl/emote/visible/nod)
	TEST_ASSERT_NOTNULL(E, "the real default nod emote exists")
	var/before = world.time
	M.emote("nod", VISIBLE_MESSAGE)
	TEST_ASSERT(cooldown_started(M, next_emote), "executing the real emote starts its cooldown")
	TEST_ASSERT(cooldown_end(M, next_emote) >= before + E.emote_delay && cooldown_end(M, next_emote) <= world.time + E.emote_delay, "the deadline uses the real emote's duration")
	TEST_ASSERT(!cooldown_started(other, next_emote), "one mob's emote does not rate-limit another")
	cooldown_set_end(M, next_emote, world.time)
	TEST_ASSERT(!cooldown_ready(M, next_emote), "the original strict comparison still refuses exactly at the deadline")
	cooldown_set_end(M, next_emote, world.time - (1 DECISECONDS))
	TEST_ASSERT(cooldown_ready(M, next_emote), "the cooldown is ready strictly after its deadline")
	cooldown_start(M, next_emote_refresh, 5 SECONDS)
	TEST_ASSERT(!cooldown_ready(M, next_emote_refresh), "the emote-list refresh has its independent rate limit")
	cooldown_reset(M, next_emote)
	TEST_ASSERT(!cooldown_started(M, next_emote), "reset clears only the ordinary emote deadline")
	TEST_ASSERT(cooldown_started(M, next_emote_refresh), "clearing ordinary emotes preserves refresh admission")
