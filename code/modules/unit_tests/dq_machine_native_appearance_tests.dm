// OLD proof first; exact sprite/layer semantics of the live jukebox family.
/datum/unit_test/dq_jukebox_native_look/proc/overlay_states(atom/O)
	var/list/states = list()
	for(var/overlay in O.overlays)
		var/mutable_appearance/A = new(overlay)
		states += A.icon_state
	return states

/datum/unit_test/dq_jukebox_native_look/Run()
	for(var/path in list(/obj/machinery/media/jukebox, /obj/machinery/media/jukebox/casinojukebox))
		var/obj/machinery/media/jukebox/J = allocate(path, test_floor())
		J.set_anchored(TRUE)
		J.atom_fix()
		J.set_grid_power(TRUE)
		J.set_playing(FALSE)
		J.set_panel_open(FALSE)
		J.set_emagged(FALSE)
		refresh_flush()
		TEST_ASSERT(J.operable(), "The actual native power/intact sources permit the jukebox")
		TEST_ASSERT_EQUAL(J.icon_state, J.state_base, "The actual running family uses its base template")
		J.set_playing(TRUE)
		refresh_flush()
		TEST_ASSERT(("[J.state_base]-running" in overlay_states(J)), "Actual playing state selects the family-specific running layer")
		J.set_panel_open(TRUE)
		refresh_flush()
		TEST_ASSERT(("panel_open" in overlay_states(J)), "Real panel state appends its overlay")
		J.set_emagged(TRUE)
		refresh_flush()
		var/list/emag_layers = overlay_states(J)
		TEST_ASSERT(("[J.state_base]-emagged" in emag_layers), "Real subversion state switches to the family-specific hacked layer")
		TEST_ASSERT(!("[J.state_base]-running" in emag_layers), "The previous running layer does not leak")
		J.atom_break()
		refresh_flush()
		TEST_ASSERT_EQUAL(J.icon_state, "[J.state_base]-broken", "Broken has precedence over no-power")
		TEST_ASSERT(!("panel_open" in overlay_states(J)), "A non-live jukebox hides its panel overlay")
		J.atom_fix()
		J.set_anchored(FALSE)
		refresh_flush()
		TEST_ASSERT_EQUAL(J.icon_state, "[J.state_base]-nopower", "Unbolted jukebox retains the no-power template")

/datum/unit_test/dq_jukebox_native_look/ghost/Run()
	var/obj/machinery/media/jukebox/ghost/G = allocate(/obj/machinery/media/jukebox/ghost, test_floor())
	G.set_playing(FALSE)
	refresh_flush()
	TEST_ASSERT_EQUAL(G.icon_state, "jukebox2-virtual", "The ghost retains its independent mapped sprite")
	G.set_panel_open(TRUE)
	G.set_playing(TRUE)
	refresh_flush()
	TEST_ASSERT_EQUAL(G.icon_state, "jukebox2-virtual", "Playing/panel do not inherit parent keyed sprite")
	var/list/layers = overlay_states(G)
	TEST_ASSERT(!("panel_open" in layers), "Ghost does not inherit the parent's panel layer")
	TEST_ASSERT(!("jukebox-running" in layers), "Ghost does not inherit the parent's music layer")
	G.set_playing(FALSE)
	refresh_flush()
