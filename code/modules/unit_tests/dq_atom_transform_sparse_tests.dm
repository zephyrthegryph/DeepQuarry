// Sparse transform history preserves actual matrix and interaction behavior.
/datum/unit_test/dq_atom_transform_sparse
	abstract_type = /datum/unit_test/dq_atom_transform_sparse

/datum/unit_test/dq_atom_transform_sparse/proc/matrix_matches(matrix/actual, matrix/expected)
	TEST_ASSERT_NOTNULL(actual, "the operation produced an actual matrix")
	TEST_ASSERT_EQUAL(actual.a, expected.a, "matrix a")
	TEST_ASSERT_EQUAL(actual.b, expected.b, "matrix b")
	TEST_ASSERT_EQUAL(actual.c, expected.c, "matrix c")
	TEST_ASSERT_EQUAL(actual.d, expected.d, "matrix d")
	TEST_ASSERT_EQUAL(actual.e, expected.e, "matrix e")
	TEST_ASSERT_EQUAL(actual.f, expected.f, "matrix f")

/datum/unit_test/dq_atom_transform_sparse/partial_updates
/datum/unit_test/dq_atom_transform_sparse/partial_updates/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/A = allocate(/obj, test_floor())
	var/obj/B = allocate(/obj, test_floor())
	TEST_ASSERT_NULL(sparse_get(A, tf_scale_x), "an untouched scale is null")
	TEST_ASSERT_NULL(sparse_get(A, tf_rotation), "an untouched rotation is null")
	A.SetTransform(scale_x = 2, scale_y = 3, offset_x = 4, offset_y = 5)
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), 2, "the first update saves horizontal scale")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_y), 3, "the first update saves vertical scale")
	A.SetTransform(rotation = 90)
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), 2, "an omitted scale retains its own earlier value")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_offset_y), 5, "an omitted offset retains its own earlier value")
	var/matrix/expected = matrix()
	expected.Scale(2, 3)
	expected.Turn(90)
	expected.Translate(4, 5)
	matrix_matches(A.transform, expected)
	TEST_ASSERT_NULL(sparse_get(B, tf_scale_x), "another atom does not inherit the first atom's history")
	B.SetTransform()
	matrix_matches(B.transform, matrix())
	A.SetTransform(scale = 7, scale_x = 8, scale_y = 9)
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), 7, "uniform scale still overrides named horizontal scale")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_y), 7, "uniform scale still overrides named vertical scale")

/datum/unit_test/dq_atom_transform_sparse/zero_and_clear
/datum/unit_test/dq_atom_transform_sparse/zero_and_clear/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/A = allocate(/obj, test_floor())
	A.SetTransform(scale_x = 0, scale_y = 2, rotation = 0, offset_x = 0, offset_y = 0)
	TEST_ASSERT(sparse_has(A, tf_scale_x), "explicit zero remains present rather than becoming unset")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), 0, "zero scale remains numeric zero")
	TEST_ASSERT(sparse_has(A, tf_rotation), "explicit zero rotation remains distinct from null")
	var/matrix/expected = matrix()
	expected.Scale(0, 2)
	matrix_matches(A.transform, expected)
	// The unmigrated image implementation is the old nullable-var contract.
	var/image/control = image()
	control.SetTransform(scale_x = 0, scale_y = 2, rotation = 0, offset_x = 0, offset_y = 0)
	control.SetTransform(scale_x = null)
	A.SetTransform(scale_x = null)
	TEST_ASSERT_EQUAL(control.tf_scale_x, 0, "native explicit null evaluates the existing-value argument default")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), control.tf_scale_x, "the sparse history preserves the actual old image/atom default contract")
	TEST_ASSERT(sparse_has(A, tf_scale_x), "a null argument preserves a present numeric zero")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_y), 2, "defaulting one component preserves the other component")
	matrix_matches(A.transform, control.transform)
	A.SetTransform(scale_x = 3)
	control.SetTransform(scale_x = 3)
	A.SetTransform(scale_x = null)
	control.SetTransform(scale_x = null)
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), 3, "explicit null also preserves a nonzero earlier component")
	TEST_ASSERT_EQUAL(sparse_get(A, tf_scale_x), control.tf_scale_x, "nonzero defaults retain the old implementation's value")
	matrix_matches(A.transform, control.transform)
	A.ClearTransform()
	TEST_ASSERT_NULL(A.transform, "ClearTransform still clears the actual built-in matrix")
	TEST_ASSERT(!sparse_has(A, tf_scale_x) && !sparse_has(A, tf_scale_y) && !sparse_has(A, tf_rotation) && !sparse_has(A, tf_offset_x) && !sparse_has(A, tf_offset_y), "ClearTransform clears every saved component")
	A.SetTransform()
	matrix_matches(A.transform, matrix())

/datum/unit_test/dq_atom_transform_sparse/composition
/datum/unit_test/dq_atom_transform_sparse/composition/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/A = allocate(/obj, test_floor())
	var/matrix/extra = matrix()
	extra.Translate(11, 13)
	var/list/others = list(extra)
	A.SetTransform(scale_x = 2, scale_y = 4, rotation = 90, offset_x = 3, offset_y = 5, others = others)
	var/matrix/expected = matrix()
	expected.Scale(2, 4)
	expected.Turn(90)
	expected.Translate(3, 5)
	expected.Multiply(extra)
	matrix_matches(A.transform, expected)
	TEST_ASSERT_EQUAL(length(others), 1, "composition does not consume its caller's matrix list")
	TEST_ASSERT_EQUAL(others[1], extra, "composition preserves the exact supplied matrix")
	var/matrix/unchanged = matrix()
	unchanged.Translate(11, 13)
	matrix_matches(extra, unchanged)

/datum/unit_test/dq_atom_transform_sparse/squish_consumers
/datum/unit_test/dq_atom_transform_sparse/squish_consumers/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/e0_fixture/M = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/obj/item/squishhammer/H = allocate(/obj/item/squishhammer, test_floor())
	H.attack(M, M)
	TEST_ASSERT_EQUAL(sparse_get(M, tf_scale_x), M.size_multiplier * 1.2, "the actual hammer recognizes an unsquished subject")
	TEST_ASSERT_EQUAL(sparse_get(M, tf_scale_y), M.size_multiplier * 0.5, "the actual hammer sets its vertical component")
	H.attack(M, M)
	TEST_ASSERT_NULL(sparse_get(M, tf_scale_x), "the next real hammer attack clears the same subject's history")
	var/datum/eventkit/player_effects/panel = allocate(/datum/eventkit/player_effects)
	rel_set(panel, nameof(panel.target), M)
	var/datum/act/op/A = allocate(/datum/act/op)
	A.holder = panel
	A.actor = M
	panel.ui_act_squish(A)
	TEST_ASSERT_EQUAL(sparse_get(M, tf_scale_x), M.size_multiplier * 1.2, "the actual admin effect recognizes an unsquished subject")
	panel.ui_act_squish(A)
	TEST_ASSERT_NULL(sparse_get(M, tf_scale_x), "the admin effect toggles the existing saved state off")
