// Internal numeric owner points, not cooldown ends or per-type configuration.
/datum/unit_test/dq_sparse_bump_pressure
/datum/unit_test/dq_sparse_bump_pressure/proc/scope_diagnostics()
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
/datum/unit_test/dq_sparse_bump_pressure/Run()
	scope_diagnostics()
	var/turf/T = test_floor()
	var/obj/item/paper/bumper = allocate(/obj/item/paper, T)
	var/obj/item/paper/target = allocate(/obj/item/paper, T)
	var/obj/item/paper/peer = allocate(/obj/item/paper, T)
	TEST_ASSERT(!sparse_has(target, last_bumped), "never-bumped owner has no timestamp slot")
	bumper.bump_into(target)
	TEST_ASSERT_EQUAL(sparse_get_or(target, last_bumped, 0), EXPIRY_NOW(target, CLOCK_WORLD), "actual generic bump stamps target on host World clock")
	TEST_ASSERT(!sparse_has(bumper, last_bumped), "generic bump does not stamp its actor")
	TEST_ASSERT(!sparse_has(peer, last_bumped), "unrelated owner remains untouched")
	var/id = entity_handle(target)
	qdel(target)
	TEST_ASSERT_NULL(resolve_handle(id), "real owner deletion invalidates handle without external timestamp registry")
	TEST_ASSERT_EQUAL(sparse_get_or(peer, last_bumped, 0), 0, "peer default remains exactly zero")

/datum/unit_test/dq_sparse_bump_pressure/door_actor_throttle
/datum/unit_test/dq_sparse_bump_pressure/door_actor_throttle/Run()
	scope_diagnostics()
	var/turf/T = test_floor()
	var/obj/machinery/door/airlock/D = allocate(/obj/machinery/door/airlock, T)
	var/obj/machinery/door/airlock/other = allocate(/obj/machinery/door/airlock, get_step(T, NORTH))
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/peer = allocate(/mob/living/carbon/human, T)
	TEST_ASSERT(!D.operating && !panel_is_open(D), "real door starts in bump-admissible state")
	sparse_set_or(H, last_bumped, EXPIRY_NOW(H, CLOCK_WORLD) - 1 SECOND, 0)
	var/boundary = sparse_get_or(H, last_bumped, 0)
	TEST_ASSERT(!D.bump_reaches_without_stamp(H), "exact one-second boundary still refuses without stamp")
	TEST_ASSERT(!D.bump_reaches(H), "actual stamping gate also refuses exact boundary")
	TEST_ASSERT_EQUAL(sparse_get_or(H, last_bumped, 0), boundary, "refusal preserves original point")
	sparse_set_or(H, last_bumped, EXPIRY_NOW(H, CLOCK_WORLD) - 1 SECOND - world.tick_lag, 0)
	TEST_ASSERT(D.bump_reaches(H), "actual door admits first instant beyond original strict boundary")
	TEST_ASSERT_EQUAL(sparse_get_or(H, last_bumped, 0), EXPIRY_NOW(H, CLOCK_WORLD), "actual door stamps actor World point")
	TEST_ASSERT(!other.bump_reaches(H), "another door shares the same actor throttle")
	sparse_set_or(peer, last_bumped, EXPIRY_NOW(peer, CLOCK_WORLD) - 2 SECONDS, 0)
	TEST_ASSERT(other.bump_reaches(peer), "independent actor is not throttled by first actor")
	TEST_ASSERT(!sparse_has(D, last_bumped), "actor throttle never aliases the door's own generic bump point")
	var/obj/structure/simple_door/wood/S = allocate(/obj/structure/simple_door/wood, T)
	sparse_set_or(S, last_bumped, EXPIRY_NOW(S, CLOCK_WORLD) - 6 SECONDS, 0)
	TEST_ASSERT_EQUAL(ELAPSED_SINCE(S, sparse_get_or(S, last_bumped, 0), CLOCK_WORLD), 6 SECONDS, "material-door owner retains exact six-second World elapsed units")
	var/state = S.state
	S.TryToSwitchState(H)
	TEST_ASSERT_EQUAL(S.state, state, "actual six-second material-door cutoff leaves state unchanged")
	// Headless actors do not exercise the later client-only open branch; do not fake clients.

/datum/unit_test/dq_sparse_bump_pressure/pressure_cycle
/datum/unit_test/dq_sparse_bump_pressure/pressure_cycle/Run()
	scope_diagnostics()
	var/turf/open/A = test_floor()
	var/turf/open/B = get_step(A, EAST)
	TEST_ASSERT(istype(A) && istype(B) && !B.density, "actual paired test floors permit pressure movement")
	// The corner landmark is a real shared anchored fixture, not an obstacle or
	// a test-owned object. high_pressure_movements skips anchored things.
	var/list/source_fixtures = contents_of(A).Copy()
	for(var/atom/movable/existing as anything in source_fixtures)
		TEST_ASSERT(existing.anchored && !existing.density, "source fixture must be anchored and nonblocking: [existing]")
	for(var/atom/movable/existing in B)
		TEST_ASSERT(!existing.density, "destination has no movement-blocking fixture: [existing]")
	set_var(SSair, nameof(SSair.times_fired), max(SSair.times_fired, 1))
	set_var(A, nameof(A.pressure_difference), 500)
	set_var(A, nameof(A.pressure_direction), EAST)
	var/obj/item/paper/P = allocate(/obj/item/paper, A)
	var/obj/item/paper/peer = allocate(/obj/item/paper, B)
	TEST_ASSERT(!sparse_has(P, last_high_pressure_movement_air_cycle), "new movable allocates no last-cycle slot")
	TEST_ASSERT(!P.anchored && !P.pulled_by_mob(), "real paper is eligible for the turf pressure entry")
	var/datum/type_trait/pressure_response/response = pressure_response_of(P)
	TEST_ASSERT_EQUAL(response.pressure, 1, "real paper keeps low pressure resistance")
	A.high_pressure_movements()
	TEST_ASSERT_EQUAL(P.loc, B, "actual high-pressure entry moves paper along pressure direction")
	TEST_ASSERT_EQUAL(sparse_get_or(P, last_high_pressure_movement_air_cycle, 0), SSair.times_fired, "actual push stores frame number, not time/deadline")
	P.forceMove(A)
	A.high_pressure_movements()
	TEST_ASSERT_EQUAL(P.loc, A, "second entry in same frame refuses repeated movement")
	set_var(SSair, nameof(SSair.times_fired), SSair.times_fired + 1)
	A.high_pressure_movements()
	TEST_ASSERT_EQUAL(P.loc, B, "next actual frame permits movement again")
	TEST_ASSERT_EQUAL(sparse_get_or(P, last_high_pressure_movement_air_cycle, 0), SSair.times_fired, "next push stamps next frame")
	TEST_ASSERT(!sparse_has(peer, last_high_pressure_movement_air_cycle), "different movable does not inherit pushed owner's cycle")
	for(var/atom/movable/existing as anything in source_fixtures)
		TEST_ASSERT_EQUAL(existing.loc, A, "shared anchored source fixture was not moved or deleted")
	var/id = entity_handle(P)
	qdel(P)
	TEST_ASSERT_NULL(resolve_handle(id), "deleted pushed owner is not retained by any frame index")
