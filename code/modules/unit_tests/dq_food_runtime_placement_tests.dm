// Real reagent-change handlers, including the variant branches, update actual placement.
/datum/unit_test/dq_food_runtime_placement
/datum/unit_test/dq_food_runtime_placement/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/reagent_containers/food/condiment/C = allocate(/obj/item/reagent_containers/food/condiment, test_floor())
	C.reagents.clear_reagents()
	C.reagents.add_reagent(REAGENT_ID_SODIUMCHLORIDE, 5)
	C.on_reagent_change()
	TEST_ASSERT_EQUAL(placement_of(C).center_x, 17, "actual salt changes the bottle to its selected horizontal center")
	TEST_ASSERT_EQUAL(placement_of(C).center_y, 11, "actual salt changes the bottle to its selected vertical center")
	C.reagents.clear_reagents()
	C.on_reagent_change()
	TEST_ASSERT_EQUAL(placement_of(C).center_x, 16, "emptying the actual condiment restores its horizontal center")
	TEST_ASSERT_EQUAL(placement_of(C).center_y, 6, "emptying the actual condiment restores its vertical center")
	var/list/types = list(/obj/item/reagent_containers/food/drinks/drinkingglass, /obj/item/reagent_containers/food/drinks/cup, /obj/item/reagent_containers/food/drinks/tall, /obj/item/reagent_containers/food/drinks/grande, /obj/item/reagent_containers/food/drinks/venti, /obj/item/reagent_containers/food/drinks/metaglass, /obj/item/reagent_containers/food/drinks/metaglass/metapint)
	for(var/path in types)
		var/obj/item/reagent_containers/food/drinks/G = allocate(path, test_floor())
		G.reagents.clear_reagents()
		G.set_center_of_mass(2, 3)
		G.reagents.add_reagent(REAGENT_ID_BEER, 5)
		G.on_reagent_change()
		var/datum/reagent/R = G.reagents.get_master_reagent()
		TEST_ASSERT_NOTNULL(R, "the real glass contains its actual beer reagent")
		var/is_glass = istype(G, /obj/item/reagent_containers/food/drinks/drinkingglass) || istype(G, /obj/item/reagent_containers/food/drinks/metaglass)
		var/x = is_glass ? R.glass_center_of_mass_x : R.cup_center_of_mass_x
		var/y = is_glass ? R.glass_center_of_mass_y : R.cup_center_of_mass_y
		if(!(x || y))
			x = 16
			y = is_glass ? 10 : 16
		TEST_ASSERT_EQUAL(placement_of(G).center_x, x, "[path] applies the actual reagent horizontal center or its exact fallback")
		TEST_ASSERT_EQUAL(placement_of(G).center_y, y, "[path] applies the actual reagent vertical center or its exact fallback")
		G.reagents.clear_reagents()
		G.on_reagent_change()
		TEST_ASSERT_EQUAL(placement_of(G).center_x, 16, "[path] real empty-container branch restores horizontal center")
		TEST_ASSERT_EQUAL(placement_of(G).center_y, is_glass ? 10 : 16, "[path] real empty-container branch restores vertical center")
		TEST_ASSERT_EQUAL(placement_of_type(path).center_x, 16, "reagent changes preserve the shared horizontal type default")
	TEST_ASSERT_EQUAL(GLOB.state_batch_depth, 0, "XY writes leave no active publication batch")
	TEST_ASSERT(!GLOB.state_batch_flushing && !length(GLOB.state_batch_pending), "XY writes leave no pending publication delivery")
