// The option record preserves the old per-mob values and the existing preference/copy boundaries.
/datum/unit_test/dq_vore_options_home
/datum/unit_test/dq_vore_options_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT_NOTNULL(H.vore_options, "the profile exists before mob initialization finishes")
	TEST_ASSERT(H.vore_options != other.vore_options, "option records are private to each mob")
	TEST_ASSERT_EQUAL(H.vore_options.weight_gain, 1, "the un-applied gain default is preserved")
	TEST_ASSERT_EQUAL(H.vore_options.weight_loss, 0.5, "the un-applied loss default is preserved")
	TEST_ASSERT_EQUAL(H.vore_options.voice_freq, 42500, "the voice default is preserved")
	TEST_ASSERT_EQUAL(H.vore_options.emote_sound_mode, EMOTE_SOUND_VOICE_FREQ, "the emote default is preserved")
	TEST_ASSERT(!H.vore_options.trash_catching && !H.vore_options.mute_entry && H.vore_options.liquidbelly_visuals, "the session toggle defaults are unchanged")
	TEST_ASSERT(!H.vore_options.adminbus_trash && !H.vore_options.adminbus_eat_minerals, "admin feeding exceptions remain off")
	var/datum/preference/numeric/human/weight_gain/gain = allocate(/datum/preference/numeric/human/weight_gain)
	var/datum/preference/numeric/human/weight_loss/loss = allocate(/datum/preference/numeric/human/weight_loss)
	var/datum/preference/numeric/human/voice_freq/voice = allocate(/datum/preference/numeric/human/voice_freq)
	var/datum/preference/choiced/living/emote_sound_mode/mode = allocate(/datum/preference/choiced/living/emote_sound_mode)
	TEST_ASSERT_EQUAL(gain.savefile_key, "weight_gain", "the serialized gain key does not change")
	TEST_ASSERT_EQUAL(loss.savefile_key, "weight_loss", "the serialized loss key does not change")
	TEST_ASSERT_EQUAL(voice.savefile_key, "voice_freq", "the serialized voice key does not change")
	TEST_ASSERT_EQUAL(mode.savefile_key, "emote_sound_mode", "the serialized emote key does not change")
	gain.apply_to_human(H, 73)
	loss.apply_to_human(H, 19)
	voice.apply_to_human(H, 32000)
	mode.apply_to_living(H, EMOTE_SOUND_NO_FREQ)
	TEST_ASSERT(H.vore_options.weight_gain == 73 && H.vore_options.weight_loss == 19 && H.vore_options.voice_freq == 32000 && H.vore_options.emote_sound_mode == EMOTE_SOUND_NO_FREQ, "real character preference application reaches the option record")
	H.toggle_trash_catching()
	H.mute_entry()
	H.liquidbelly_visuals()
	H.restrict_trasheater()
	TEST_ASSERT(H.vore_options.trash_catching && H.vore_options.mute_entry && !H.vore_options.liquidbelly_visuals && H.vore_options.adminbus_trash, "the real toggle verbs mutate the record")
	TEST_ASSERT(!other.vore_options.trash_catching && !other.vore_options.mute_entry && other.vore_options.liquidbelly_visuals, "toggling one mob leaves another unchanged")
	other.copy_physique_from(H)
	TEST_ASSERT(other.vore_options.weight_gain == 73 && other.vore_options.weight_loss == 19 && other.vore_options.voice_freq == 32000, "physique copying preserves its three original option fields")
	TEST_ASSERT_EQUAL(other.vore_options.emote_sound_mode, EMOTE_SOUND_VOICE_FREQ, "physique copying does not acquire an unrelated emote setting")
	H.apply_voice_freq(0)
	TEST_ASSERT_EQUAL(H.vore_options.voice_freq, 0, "zero remains the explicit no-frequency option")
	H.apply_voice_freq(MAX_VOICE_FREQ + 1)
	TEST_ASSERT_EQUAL(H.vore_options.voice_freq, MAX_VOICE_FREQ, "custom voice input still clamps to the real limit")
	var/mob/living/simple_mob/e0_fixture/target = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	H.copy_vore_prefs_to_mob(target)
	TEST_ASSERT_EQUAL(target.vore_options.weight_gain, 1, "copying consent preferences must not newly copy weight settings")
	TEST_ASSERT_EQUAL(target.vore_options.voice_freq, 42500, "copying consent preferences must not newly copy voice settings")
	TEST_ASSERT(!target.vore_options.trash_catching && !target.vore_options.mute_entry && !target.vore_options.adminbus_trash, "session toggles retain their old transformation-copy boundary")

/datum/unit_test/dq_vore_trait_option_home
/datum/unit_test/dq_vore_trait_option_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/datum/trait/neutral/long_vore/appendage = allocate(/datum/trait/neutral/long_vore)
	var/datum/trait/neutral/stuffing_feeder/feeder = allocate(/datum/trait/neutral/stuffing_feeder)
	var/list/appendage_prefs = list("appendage_color" = "#124578", "appendage_alt_setting" = TRUE)
	appendage.apply(H.species, H, appendage_prefs)
	TEST_ASSERT(H.vore_options.appendage_color == "#124578" && H.vore_options.appendage_alt_setting, "the real trait dispatcher applies the unchanged serialized appendage keys")
	feeder.apply(H.species, H, list("stuffing_feeder" = TRUE))
	TEST_ASSERT(H.vore_options.stuffing_feeder, "the real feeder trait writes its profile option")
	appendage.unapply(H.species, H, appendage_prefs)
	feeder.unapply(H.species, H, list("stuffing_feeder" = TRUE))
	TEST_ASSERT(H.vore_options.appendage_color == "#e03997" && !H.vore_options.appendage_alt_setting && !H.vore_options.stuffing_feeder, "trait removal restores the exact old initial values")
	TEST_ASSERT(!H.apply_vore_option_trait("unrelated_trait_key", TRUE), "unrelated trait keys keep using the original dispatcher")
	TEST_ASSERT(isnull(H.vore_options.skin_reagent) && isnull(H.vore_options.trait_injection_selected) && H.vore_options.trait_injection_amount == 5 && H.vore_options.trait_injection_verb == "bite", "injection and skin option defaults are preserved")
	H.vore_options.set_appendage_color("#abcdef")
	H.vore_options.set_appendage_alt_setting(TRUE)
	H.vore_options.set_trait_injection_selected(REAGENT_ID_TOXIN)
	H.vore_options.set_trait_injection_amount(3)
	H.vore_options.set_trait_injection_verb("sting")
	var/mob/living/simple_mob/e0_fixture/target = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	H.copy_vore_prefs_to_mob(target)
	TEST_ASSERT(target.vore_options.appendage_color == "#abcdef" && target.vore_options.appendage_alt_setting, "transformation copying retains its two original appendage fields")
	TEST_ASSERT(isnull(target.vore_options.trait_injection_selected) && target.vore_options.trait_injection_amount == 5 && target.vore_options.trait_injection_verb == "bite", "transform copying does not newly copy the injection configuration")

/datum/unit_test/dq_voice_sound_list_home
/datum/unit_test/dq_voice_sound_list_home/Run()
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/mob/living/simple_mob/e0_fixture/M = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/simple_mob/e0_fixture/other = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	TEST_ASSERT(islist(M.vore_options.voice_sounds_list) && !length(M.vore_options.voice_sounds_list), "the native starting profile preserves the old empty sound list")
	TEST_ASSERT(M.vore_options.voice_sounds_list != other.vore_options.voice_sounds_list, "starting empty sound lists remain per-mob")
	var/list/voice = DEFAULT_TALK_SOUNDS
	M.vore_options.set_voice_sounds_list(voice)
	TEST_ASSERT(M.vore_options.voice_sounds_list == voice, "whole-list voice selection preserves assigned identity")
	TEST_ASSERT(!length(other.vore_options.voice_sounds_list), "another mob's list is unchanged")
