// Native configuration has real inherited values and COW map/admin edits.
/datum/unit_test/dq_machine_interaction_configuration
/datum/unit_test/dq_machine_interaction_configuration/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	TEST_ASSERT_EQUAL(machine_interaction_config_of_type(/obj/machinery/computer).clicksound, SFX_KEYBOARD, "The actual computer keeps its inherited keyboard sound")
	TEST_ASSERT_NULL(machine_interaction_config_of_type(/obj/machinery/computer/timeclock).clicksound, "Explicit null suppresses inherited keyboard sound")
	TEST_ASSERT_NULL(machine_interaction_config_of_type(/obj/machinery/computer/id_restorer).clicksound, "A second actual null override does not silently inherit")
	var/obj/machinery/dq_maint_machine/A = allocate(/obj/machinery/dq_maint_machine, test_floor())
	var/obj/machinery/dq_maint_machine/B = allocate(/obj/machinery/dq_maint_machine, test_floor())
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT_EQUAL(A.maintenance_wrench_wait(null), 0, "A real existing maintenance fixture retains explicit zero duration")
	TEST_ASSERT_EQUAL(machine_interaction_config_of_type(/obj/machinery).maintenance_weld_time, 2 SECONDS, "The real baseline duration remains in time units")
	TEST_ASSERT_EQUAL(machine_interaction_config_of(A), machine_interaction_config_of(B), "Untouched peers share actual configuration")
	TEST_ASSERT(vars_write(A, "maintenance_wrench_time", 3 SECONDS), "The old map field uses the native trait bridge")
	TEST_ASSERT_EQUAL(A.maintenance_wrench_wait(null), 3 SECONDS, "The actual wait reader sees the map override")
	TEST_ASSERT_EQUAL(B.maintenance_wrench_wait(null), 0, "Map edits preserve the other actual machine")
	A.set_broken_condition(TRUE)
	TEST_ASSERT_EQUAL(A.tgui_status(H), STATUS_CLOSE, "The actual offline UI closes before override")
	TEST_ASSERT(A.vv_edit_var("@machine_interaction_config.interact_offline", TRUE), "Admin editing reaches the actual policy")
	TEST_ASSERT(A.tgui_status(H) > STATUS_CLOSE, "The actual UI reevaluates the changed offline policy")
	TEST_ASSERT(!machine_interaction_config_of(B).interact_offline, "Admin policy edits do not alter peers")

/datum/unit_test/dq_object_break_configuration
/datum/unit_test/dq_object_break_configuration/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/obj/structure/catwalk/C = allocate(/obj/structure/catwalk, T)
	var/list/debris = C.debris_entries()
	TEST_ASSERT_EQUAL(debris[/obj/item/stack/rods], 1, "The real catwalk declares one rod")
	TEST_ASSERT(vars_write(C, "debris_amount", 3), "Historical map debris amount reaches native configuration")
	C.atom_destruction(BRUTE)
	own_turf_contents(T)
	var/obj/item/stack/rods/rods = locate() in T
	TEST_ASSERT(rods && rods.amount == 3, "Actual destruction creates the configured real stack amount")
	var/obj/structure/musician/piano/P = allocate(/obj/structure/musician/piano, T)
	var/obj/structure/musician/piano/minimoog/M = allocate(/obj/structure/musician/piano/minimoog, T)
	P.atom_break(BRUTE)
	M.atom_break(BRUTE)
	TEST_ASSERT_EQUAL(P.icon_state, "pianobroken", "The real break hook selects the piano state")
	TEST_ASSERT_EQUAL(M.icon_state, "minimoogbroken", "A descendant keeps its own break state")
	P.atom_fix()
	TEST_ASSERT_EQUAL(P.icon_state, initial(P.icon_state), "The actual fix restores the original appearance")
	var/obj/plain = allocate(/obj, T)
	TEST_ASSERT_NULL(plain.debris_entries(), "An unconfigured real object invents no debris")
	TEST_ASSERT_NULL(object_break_config_of_type(/obj).debris_type, "Per-object edits leave the shared baseline immutable")

/datum/unit_test/dq_shielding_configuration
/datum/unit_test/dq_shielding_configuration/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	TEST_ASSERT_EQUAL(shielding_config_of_type(/obj/machinery/power/rad_collector).rad_shield_material, MAT_LEAD, "The collector keeps its declared material without inventing an extra setup")
	TEST_ASSERT_EQUAL(shielding_config_of_type(/obj/machinery/door/airlock).rad_shield_material, MAT_STEEL, "Actual doors retain their shielding declaration")
	var/obj/A = allocate(/obj, test_floor())
	var/obj/B = allocate(/obj, test_floor())
	var/original = A.rad_insulation
	TEST_ASSERT(vars_write(A, "rad_shield_material", MAT_LEAD), "The historical material name reaches the native trait")
	TEST_ASSERT(A.vv_edit_var("@shielding_config.rad_shield_thickness_mm", 10), "The actual admin thickness override is accepted")
	A.apply_rad_shield_material()
	TEST_ASSERT_EQUAL(A.rad_insulation, material_rad_insulation(MAT_LEAD, 10, original), "The real existing shielding setter computes actual material transmission")
	TEST_ASSERT_EQUAL(B.rad_insulation, original, "The other actual object keeps its original insulation")
	TEST_ASSERT_NULL(shielding_config_of(B).rad_shield_material, "COW material configuration stays per holder")
	TEST_ASSERT(vars_write(A, "rad_shield_material", "dq_nonexistent_material"), "Unknown material keeps the old accepted input")
	var/prior = A.rad_insulation
	A.apply_rad_shield_material()
	TEST_ASSERT_EQUAL(A.rad_insulation, prior, "Unknown material preserves actual fallback insulation")

/datum/unit_test/dq_speech_presentation_configuration
/datum/unit_test/dq_speech_presentation_configuration/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	TEST_ASSERT_EQUAL(speech_presentation_of_type(/obj/machinery/medical_kiosk).bubble_icon, "medical", "The real kiosk keeps its medical theme")
	TEST_ASSERT_EQUAL(speech_presentation_of_type(/obj/machinery/space_heater).bubble_icon, "engineering", "The real heater keeps its engineering theme")
	var/obj/A = allocate(/obj, test_floor())
	var/obj/B = allocate(/obj, test_floor())
	TEST_ASSERT(vars_write(A, "bubble_icon", "science"), "The old map theme field edits native presentation")
	var/image/I = generate_speech_bubble(A, "[speech_presentation_of(A).bubble_icon][say_test("hello")]")
	TEST_ASSERT_EQUAL(I.icon_state, "science[say_test("hello")]", "The actual image producer receives the overridden state")
	TEST_ASSERT_EQUAL(speech_presentation_of(B).bubble_icon, "normal", "Another actual speaker keeps its default theme")
	TEST_ASSERT(A.vv_edit_var("@speech_presentation.bubble_icon", "engineering"), "The real admin editor supports the presentation trait")
	TEST_ASSERT_EQUAL(speech_presentation_of(A).bubble_icon, "engineering", "A second native edit replaces the actual theme")
