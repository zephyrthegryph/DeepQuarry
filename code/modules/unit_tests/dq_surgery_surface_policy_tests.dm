// Policy migration leaves the actual surgery-surface/floor algorithm unchanged.
/datum/unit_test/dq_surgery_surface_policy
/datum/unit_test/dq_surgery_surface_policy/proc/scope_diagnostics()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)

/datum/unit_test/dq_surgery_surface_policy/Run()
	scope_diagnostics()
	TEST_ASSERT(static_find(static_table_of(/obj), ENTRY_SURGERY_SURFACE), "base object has actual immutable surface policy")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(/obj).cleanliness, 0, "ordinary object retains zero suitability")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(/obj/structure/table).cleanliness, 50, "real table retains fifty")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(/obj/structure/bed/roller).cleanliness, 60, "roller keeps inherited sixty")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(/obj/structure/bed/roller/adv).cleanliness, 75, "advanced subtype override wins despite base block later in source")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(/obj/machinery/optable).cleanliness, 100, "real operating table keeps one hundred")
	var/turf/T = test_floor()
	var/obj/structure/bed/roller/A = allocate(/obj/structure/bed/roller, T)
	var/obj/structure/bed/roller/B = allocate(/obj/structure/bed/roller, T)
	TEST_ASSERT_EQUAL(surgery_surface_of(A), surgery_surface_of(B), "unmodified peers share actual policy datum")
	TEST_ASSERT(!("surgery_cleanliness" in A.vars), "historical alias is not another physical base field")
	TEST_ASSERT(vars_write(A, "surgery_cleanliness", 0), "historical map field accepts explicit zero")
	TEST_ASSERT_EQUAL(surgery_surface_of(A).cleanliness, 0, "explicit zero survives native override inheritance")
	TEST_ASSERT_EQUAL(surgery_surface_of(B).cleanliness, 60, "map override is per instance")
	TEST_ASSERT(surgery_surface_of(A) != surgery_surface_of(B), "legacy write uses real COW")
	TEST_ASSERT(A.vv_edit_var("@surgery_surface.cleanliness", 93), "admin trait edit succeeds")
	TEST_ASSERT_EQUAL(surgery_surface_of(A).cleanliness, 93, "admin edit changes actual surface value")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(A.type).cleanliness, 60, "neither edit changes shared type policy")

/datum/unit_test/dq_surgery_surface_policy/map_preinit
/datum/unit_test/dq_surgery_surface_policy/map_preinit/Run()
	scope_diagnostics()
	SSatoms.map_loader_begin("dq_surgery_surface_policy")
	var/obj/structure/bed/roller/adv/M = new(test_floor())
	var/accepted = vars_write(M, "surgery_cleanliness", 0)
	SSatoms.map_loader_stop("dq_surgery_surface_policy")
	own(M)
	TEST_ASSERT(accepted, "real pre-initialization legacy-name map write resolves native policy")
	SSatoms.InitializeAtoms(list(M))
	TEST_ASSERT(!QDELETED(M), "mapped real advanced roller initializes")
	TEST_ASSERT_EQUAL(surgery_surface_of(M).cleanliness, 0, "map value remains zero after parent initialization")
	TEST_ASSERT_EQUAL(surgery_surface_of_type(M.type).cleanliness, 75, "mapped override leaves inherited advanced default intact")

/datum/unit_test/dq_surgery_surface_policy/actual_algorithm
/datum/unit_test/dq_surgery_surface_policy/actual_algorithm/Run()
	scope_diagnostics()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human, get_step(T, NORTH))
	TEST_ASSERT_NULL(patient.get_surgery_cleanliness(surgeon), "standing non-self patient is still refused, not scored zero")
	TEST_ASSERT(!can_operate(patient, surgeon, I_HELP), "standing patient still fails real surgery posture admission")
	patient.set_allow_self_surgery(TRUE)
	TEST_ASSERT(can_operate(patient, patient, I_HELP), "existing self-surgery policy permits help stance")
	TEST_ASSERT(!can_operate(patient, patient, I_HURT), "self-surgery remains refused on harm stance")
	patient.set_allow_self_surgery(FALSE)
	TEST_ASSERT(!can_operate(patient, patient, I_HELP), "disabling self-surgery policy restores refusal")
	TEST_ASSERT(patient.status_set(STAT_WEAKENED, 2), "actual status puts patient prone")
	TEST_ASSERT(patient.lying && can_operate(patient, surgeon, I_HELP), "real prone patient admits surgery")
	var/obj/structure/table/table = allocate(/obj/structure/table, T)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 50, "the actual table is a surgical surface before cleaner surfaces arrive")
	var/obj/structure/bed/roller/R = allocate(/obj/structure/bed/roller, T)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 60, "real roller is an actual surgery surface")
	var/obj/structure/bed/roller/adv/A = allocate(/obj/structure/bed/roller/adv, T)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 75, "algorithm chooses maximum of competing real surfaces")
	var/obj/machinery/optable/O = allocate(/obj/machinery/optable, T)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 100, "operating table outranks both beds")
	TEST_ASSERT(vars_write(O, "surgery_cleanliness", 0), "real operating table alias accepts zero")
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 75, "zero override removes only that surface's contribution")
	qdel(O)
	qdel(A)
	qdel(R)
	qdel(table)
	set_var(T, nameof(T.germ_level), 90)
	set_var(T, nameof(T.forensic_was_bloodied), FALSE)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 10, "without good surfaces actual floor germ level is used")
	set_var(T, nameof(T.germ_level), 0)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 25, "clean floor clamps to twenty-five")
	set_var(T, nameof(T.germ_level), 120)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 0, "dirty floor clamps to zero")
	set_var(T, nameof(T.germ_level), 0)
	dq_set_was_bloodied(T, TRUE)
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(surgeon), 0, "bloodied floor still overrides low germs")
	patient.status_end(STAT_WEAKENED)
	TEST_ASSERT_NULL(patient.get_surgery_cleanliness(surgeon), "posture recovery restores the original null refusal")
	TEST_ASSERT_EQUAL(patient.get_surgery_cleanliness(patient), 0, "self query keeps original posture bypass and bloodied-floor value")
