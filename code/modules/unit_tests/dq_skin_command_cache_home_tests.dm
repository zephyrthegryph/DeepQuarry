/datum/unit_test/dq_skin_command_cache_home
/datum/unit_test/dq_skin_command_cache_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/mob/living/simple_mob/e0_fixture/M = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/simple_mob/e0_fixture/other = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/obj/item/pen/first = allocate(/obj/item/pen, test_floor())
	var/obj/item/pen/replacement = allocate(/obj/item/pen, test_floor())
	TEST_ASSERT_NULL(M.skincmds, "a mob with no registered skin command allocates no table")
	M.skincmd("absent;payload")
	TEST_ASSERT_NULL(M.skincmds, "an unknown command does not allocate a table")
	SkinCmdRegister(M, "command", first)
	TEST_ASSERT_EQUAL(M.skincmds["command"], first, "real registration retains the actual object")
	SkinCmdRegister(M, "command", replacement)
	TEST_ASSERT_EQUAL(M.skincmds["command"], replacement, "registering the same name replaces its value")
	TEST_ASSERT_EQUAL(length(M.skincmds), 1, "replacement does not append duplicate names")
	TEST_ASSERT_NULL(other.skincmds, "command maps remain per-mob")
	M.skincmd("command;payload")
	TEST_ASSERT_EQUAL(M.skincmds["command"], replacement, "dispatch preserves the registered mapping")
