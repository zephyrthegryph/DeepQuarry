/datum/unit_test/dq_ai_laws_native_order/Run()
	var/datum/ai_laws/L = allocate(/datum/ai_laws)
	L.add_ion_law("Ion one")
	L.add_ion_law("Ion two")
	L.set_zeroth_law("Zero")
	L.add_inherent_law("First")
	L.add_inherent_law("Second")
	L.add_inherent_law("Third")
	L.add_supplied_law(2, "Replacement")
	L.add_supplied_law(5, "Extra")
	var/list/expected = list(L.ion_laws[1], L.ion_laws[2], L.zeroth_law, L.inherent_laws[1], L.inherent_laws[3], L.supplied_laws[2], L.supplied_laws[5])
	var/list/actual = L.all_laws()
	TEST_ASSERT_EQUAL(length(actual), length(expected), "Only real laws appear, including the supplied gap")
	for(var/i in 1 to length(expected))
		TEST_ASSERT_EQUAL(actual[i], expected[i], "Native order preserves the original datum identity at [i]")
	TEST_ASSERT_NOTEQUAL(actual, L.all_laws(), "Each query returns a separate borrowed list")

/datum/unit_test/dq_ai_laws_immediate_unmask/Run()
	var/datum/ai_laws/L = allocate(/datum/ai_laws)
	L.add_inherent_law("Original")
	L.add_supplied_law(1, "Replacement")
	var/datum/ai_law/original = L.inherent_laws[1]
	var/datum/ai_law/replacement = L.supplied_laws[1]
	var/list/warm = L.all_laws()
	TEST_ASSERT_EQUAL(warm[1], replacement, "Supplied law initially masks the inherent law")
	L.delete_law(replacement)
	var/list/actual = L.all_laws()
	TEST_ASSERT_EQUAL(length(actual), 1, "Deleting a supplied law immediately unmasks one inherent law")
	TEST_ASSERT_EQUAL(actual[1], original, "No timer or explicit publication is needed to unmask")

/datum/unit_test/dq_ai_laws_immediate_zero_clear/Run()
	var/datum/ai_laws/L = allocate(/datum/ai_laws)
	L.set_zeroth_law("Zero")
	L.add_inherent_law("First")
	var/datum/ai_law/first = L.inherent_laws[1]
	var/list/warm = L.all_laws()
	TEST_ASSERT_EQUAL(length(warm), 2, "Warm view actually contains the zero law")
	L.clear_zeroth_laws()
	var/list/actual = L.all_laws()
	TEST_ASSERT_EQUAL(length(actual), 1, "Zero law is absent immediately after the real clear API")
	TEST_ASSERT_EQUAL(actual[1], first, "Remaining law identity is preserved")

/datum/unit_test/dq_ai_laws_index_shift/Run()
	var/datum/ai_laws/L = allocate(/datum/ai_laws)
	L.add_inherent_law("First")
	L.add_inherent_law("Second")
	L.add_supplied_law(5, "Extra")
	var/datum/ai_law/first = L.inherent_laws[1]
	var/datum/ai_law/second = L.inherent_laws[2]
	var/datum/ai_law/extra = L.supplied_laws[5]
	L.set_state_law(first, FALSE)
	L.set_state_law(second, TRUE)
	TEST_ASSERT_EQUAL(second.get_index(), 2, "Initial inherent index comes from real custody")
	L.delete_law(first)
	TEST_ASSERT_EQUAL(second.get_index(), 1, "Removing the first law immediately shifts the second index")
	TEST_ASSERT_EQUAL(L.get_state_law(second), TRUE, "The real delete API shifts the matching state flag")
	TEST_ASSERT_EQUAL(extra.get_index(), 5, "Supplied index remains its explicit slot number")
	TEST_ASSERT_EQUAL(owner_of(second), L, "Query-derived index preserves law custody")

/datum/unit_test/dq_ai_laws_result_isolation/Run()
	var/datum/ai_laws/L = allocate(/datum/ai_laws)
	L.add_inherent_law("First")
	L.add_inherent_law("Second")
	var/datum/ai_law/first = L.inherent_laws[1]
	var/list/borrowed = L.all_laws()
	borrowed.Cut()
	var/list/actual = L.all_laws()
	TEST_ASSERT_EQUAL(length(actual), 2, "Editing a returned view cannot corrupt the lawset")
	TEST_ASSERT_EQUAL(actual[1], first, "The original ordered law remains present")
	TEST_ASSERT_EQUAL(owner_of(first), L, "Clearing a borrowed view never releases owned laws")
	var/datum/ai_law/inherent/detached = allocate(/datum/ai_law/inherent, "Detached", 7)
	TEST_ASSERT_EQUAL(detached.get_index(), 7, "An unowned law retains its explicitly supplied fallback index")

/datum/unit_test/dq_ai_laws_native_state_view/Run()
	var/datum/ai_laws/L = allocate(/datum/ai_laws)
	L.add_inherent_law("First")
	L.add_inherent_law("Second")
	var/datum/ai_law/first = L.inherent_laws[1]
	var/datum/ai_law/second = L.inherent_laws[2]
	L.set_state_law(first, TRUE)
	L.set_state_law(second, FALSE)
	var/list/actual = L.laws_to_state()
	TEST_ASSERT_EQUAL(length(actual), 1, "Only enabled statements are included")
	TEST_ASSERT_EQUAL(actual[1], first, "State query retains ordered source identity")
	TEST_ASSERT_NULL(first.index, "Query does not write an inherent law's stored fallback index")
	TEST_ASSERT_EQUAL(first.get_index(), 1, "Public inherent index still reports its actual position")
