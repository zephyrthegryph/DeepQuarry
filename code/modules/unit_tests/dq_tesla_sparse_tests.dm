// Real Tesla entry points and their existing owner-bound reset timers.
/obj/machinery/power/tesla_coil/dq_shock_probe
	var/shock_calls = 0

/obj/machinery/power/tesla_coil/dq_shock_probe/tesla_act(power, explosive = FALSE, current_jumps = current_jumps)
	shock_calls++
	return ..()

/datum/unit_test/dq_tesla_sparse_cooldown
/datum/unit_test/dq_tesla_sparse_cooldown/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/obj/O = allocate(/obj, test_floor())
	var/obj/peer = allocate(/obj, test_floor())
	TEST_ASSERT(!sparse_get_or(O, being_shocked, FALSE), "ordinary objects start outside Tesla recursion")
	O.tesla_act(0)
	TEST_ASSERT(sparse_get_or(O, being_shocked, FALSE), "actual base Tesla entry sets its guard before scheduling reset")
	TEST_ASSERT(!sparse_get_or(peer, being_shocked, FALSE), "an untouched peer never receives the guard")
	test_time(0.5 SECONDS)
	TEST_ASSERT(sparse_get_or(O, being_shocked, FALSE), "the actual one-second cooldown does not finish early")
	test_time(1 SECOND)
	TEST_ASSERT(!sparse_get_or(O, being_shocked, FALSE), "the real timer invokes the original reset handler")
	TEST_ASSERT(!sparse_has(O, being_shocked), "the default reset releases its sparse allocation")
	var/obj/doomed = allocate(/obj, test_floor())
	doomed.tesla_act(0)
	TEST_ASSERT(sparse_get_or(doomed, being_shocked, FALSE), "the deleted-owner case really scheduled a guarded reset")
	qdel(doomed)
	peer.tesla_act(0)
	test_time(2 SECONDS)
	TEST_ASSERT(QDELETED(doomed), "the actual timer owner remains deleted")
	TEST_ASSERT(!sparse_has(peer, being_shocked), "a surviving peer's real timer still resets after neighbor deletion")
	// The unit-test runner fails any attempted callback runtime on the deleted owner.

/datum/unit_test/dq_tesla_sparse_candidate
/datum/unit_test/dq_tesla_sparse_candidate/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/turf/T = test_floor()
	var/turf/adjacent = get_step(T, EAST)
	TEST_ASSERT_NOTNULL(adjacent, "real adjacent turf is available for the Tesla candidate scan")
	TEST_ASSERT(!adjacent.density, "the actual adjacent turf permits the real oview candidate scan")
	var/obj/source = allocate(/obj, T)
	var/obj/machinery/power/tesla_coil/dq_shock_probe/blocked = allocate(/obj/machinery/power/tesla_coil/dq_shock_probe, adjacent)
	var/obj/machinery/power/tesla_coil/dq_shock_probe/free = allocate(/obj/machinery/power/tesla_coil/dq_shock_probe, adjacent)
	blocked.set_anchored(TRUE)
	free.set_anchored(TRUE)
	blocked.set_panel_open(TRUE)
	free.set_panel_open(TRUE)
	blocked.tesla_act(0)
	TEST_ASSERT_EQUAL(blocked.shock_calls, 1, "the actual open-panel coil entry arms its guard")
	TEST_ASSERT(sparse_get_or(blocked, being_shocked, FALSE), "the original coil-specific cooldown is active")
	TEST_ASSERT(!sparse_get_or(free, being_shocked, FALSE), "the second actual coil is initially eligible")
	tesla_zap(source, zap_range = 1, power = 1000)
	TEST_ASSERT_EQUAL(blocked.shock_calls, 1, "the real candidate scan excludes the already-shocked coil")
	TEST_ASSERT_EQUAL(free.shock_calls, 1, "the real candidate scan delivers its zap to the eligible coil")
	TEST_ASSERT(sparse_get_or(free, being_shocked, FALSE), "the selected coil runs its real parent entry and arms its guard")
	test_time(max(blocked.zap_cooldown, free.zap_cooldown) + 1 SECOND)
	TEST_ASSERT(!sparse_has(blocked, being_shocked) && !sparse_has(free, being_shocked), "both real coil-specific timers reset their own guards")
