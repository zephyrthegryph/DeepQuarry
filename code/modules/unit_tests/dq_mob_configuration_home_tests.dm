// Shared immutable configuration and genuine per-holder COW overrides.
/datum/unit_test/dq_voice_configuration_home
/datum/unit_test/dq_voice_configuration_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/vore/wolf/A = allocate(/mob/living/simple_mob/vore/wolf, test_floor())
	var/mob/living/simple_mob/vore/wolf/B = allocate(/mob/living/simple_mob/vore/wolf, test_floor())
	TEST_ASSERT_EQUAL(voice_config_of(A), voice_config_of(B), "Untouched peers share their declared voice configuration")
	TEST_ASSERT_EQUAL(get_gendered_sound(A), "Canine", "The real species-sound selection retains the wolf's type configuration")
	TEST_ASSERT(vars_write(A, "pain_emote_1p", list("test-yelp")), "The historical map field reaches the native trait")
	var/datum/decl/emote/audible/pain/emote = allocate(/datum/decl/emote/audible/pain)
	TEST_ASSERT_EQUAL(emote.get_emote_message_1p(A, null, null), "You test-yelp!", "The real pain emote reads the overridden configuration")
	TEST_ASSERT(voice_config_of(A) != voice_config_of(B), "A holder override splits only that holder's trait")
	TEST_ASSERT_EQUAL(length(voice_config_of(B).pain_emote_1p), 4, "A peer retains its original pain alternatives")
	TEST_ASSERT(A.vv_edit_var("@voice_config.species_sounds", "Feline"), "Admin editing accepts the native voice field")
	TEST_ASSERT_EQUAL(get_gendered_sound(A), "Feline", "The actual sound reader observes the admin edit")
	TEST_ASSERT_EQUAL(get_gendered_sound(B), "Canine", "Admin edits leave the peer unchanged")
	TEST_ASSERT(vars_write(A, "can_pain_emote", FALSE), "The old boolean name accepts explicit false")
	TEST_ASSERT(!voice_config_of(A).can_pain_emote && voice_config_of(B).can_pain_emote, "False overrides do not disappear into inheritance")
	TEST_ASSERT_EQUAL(voice_config_of_type(B.type).species_sounds, "Canine", "Type configuration stays immutable")

/datum/unit_test/dq_butchery_configuration_home
/datum/unit_test/dq_butchery_configuration_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/mob/living/simple_mob/e0_fixture/A = allocate(/mob/living/simple_mob/e0_fixture, T)
	var/mob/living/simple_mob/e0_fixture/B = allocate(/mob/living/simple_mob/e0_fixture, T)
	TEST_ASSERT_EQUAL(butchery_config_of(A), butchery_config_of(B), "Untouched peers share their actual butchery configuration")
	TEST_ASSERT(vars_write(A, "meat_type", /obj/item/reagent_containers/food/snacks/meat), "The historical meat-type field writes the native configuration")
	TEST_ASSERT(vars_write(A, "name_the_meat", FALSE), "The historical naming field accepts false")
	TEST_ASSERT(A.vv_edit_var("@butchery_config.butchery_drops_organs", FALSE), "Admin editing reaches the real organ-drop policy")
	TEST_ASSERT(!butchery_config_of(A).butchery_drops_organs && butchery_config_of(B).butchery_drops_organs, "Organ policy overrides remain isolated")
	set_var(A, "meat_amount", 2)
	var/datum/act/op/action = allocate(/datum/act/op)
	set_var(action, "args", list("cuts" = 2))
	A.harvest_cut(action)
	own_turf_contents(T)
	TEST_ASSERT_EQUAL(A.meat_amount, 1, "The real harvesting effect consumes the independent mutable stock")
	TEST_ASSERT_EQUAL(action.arg("cuts"), 1, "The real harvesting effect advances its operation counter")
	var/obj/item/reagent_containers/food/snacks/meat/cut = locate() in T
	TEST_ASSERT(cut, "The actual configured meat type was constructed")
	TEST_ASSERT_EQUAL(cut.name, initial(cut.name), "Disabling naming preserves the real meat's default name")
	TEST_ASSERT_NULL(butchery_config_of(B).meat_type, "A peer does not inherit the per-holder meat type")
	TEST_ASSERT_NULL(butchery_config_of_type(A.type).meat_type, "The original type policy is unchanged")
