/proc/compiler_probe_fold_ternary(list/rows, list/mismatches)
	var/x
	x = 0
	compiler_probe_row(rows, mismatches, "ternary 0", (0 ? 11 : 22), (x ? 11 : 22))
	x = 1
	compiler_probe_row(rows, mismatches, "ternary 1", (1 ? 11 : 22), (x ? 11 : 22))
	x = (-1)
	compiler_probe_row(rows, mismatches, "ternary -1", (-1 ? 11 : 22), (x ? 11 : 22))
	x = 2
	compiler_probe_row(rows, mismatches, "ternary 2", (2 ? 11 : 22), (x ? 11 : 22))
	x = 3
	compiler_probe_row(rows, mismatches, "ternary 3", (3 ? 11 : 22), (x ? 11 : 22))
	x = 0.5
	compiler_probe_row(rows, mismatches, "ternary 0.5", (0.5 ? 11 : 22), (x ? 11 : 22))
	x = (-2.5)
	compiler_probe_row(rows, mismatches, "ternary -2.5", (-2.5 ? 11 : 22), (x ? 11 : 22))
	x = 255
	compiler_probe_row(rows, mismatches, "ternary 255", (255 ? 11 : 22), (x ? 11 : 22))
	x = 256
	compiler_probe_row(rows, mismatches, "ternary 256", (256 ? 11 : 22), (x ? 11 : 22))
