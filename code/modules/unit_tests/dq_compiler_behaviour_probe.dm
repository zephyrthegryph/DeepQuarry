/// "fold [key] = [constant form] | [variable form]"; a mismatch within one build is a wrong fold.
/proc/compiler_probe_row(list/rows, list/mismatches, key, constant_form, variable_form)
	var/c = compiler_probe_fmt(constant_form)
	var/v = compiler_probe_fmt(variable_form)
	rows += "fold [key] = [c] | [v]"
	if(c != v)
		mismatches += "[key]: constant form [c], variable form [v]"

