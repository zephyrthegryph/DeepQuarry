	compiler_probe_fold_f1_abs(rows, mismatches)
	compiler_probe_fold_f1_sin(rows, mismatches)
	compiler_probe_fold_f1_cos(rows, mismatches)
	compiler_probe_fold_f1_tan(rows, mismatches)
	compiler_probe_fold_f1_arcsin(rows, mismatches)
	compiler_probe_fold_f1_arccos(rows, mismatches)
	compiler_probe_fold_f1_arctan(rows, mismatches)
	compiler_probe_fold_f1_log(rows, mismatches)
	compiler_probe_fold_f2_round(rows, mismatches)
	compiler_probe_fold_f2_min(rows, mismatches)
	compiler_probe_fold_f2_max(rows, mismatches)
	compiler_probe_fold_f2_log(rows, mismatches)
	compiler_probe_fold_f2_arctan(rows, mismatches)
	compiler_probe_fold_f3_clamp(rows, mismatches)
	compiler_probe_fold_ternary(rows, mismatches)

/proc/compiler_probe_fold_branches(list/rows)
	var/n = 0
	if(1)
		n += 1
	if(0)
		n += 2
	else
		n += 4
	while(0)
		n += 8
	n += (3 | 4) ? 16 : 32
	n += (0 && 5) ? 64 : 128
	rows += "branches [n]"

/obj/compiler_probe_a
/obj/compiler_probe_a/compiler_probe_a2
/obj/compiler_probe_b
/mob/compiler_probe_m
/datum/compiler_probe_d

/// Iterator type filters: how many entries each `for(var/T/x in L)` visits.
/proc/compiler_probe_iterators(list/rows)
	var/list/L = list(new /obj/compiler_probe_a, new /mob/compiler_probe_m, new /datum/compiler_probe_d, 5, "s", new /obj/compiler_probe_b, null, new /obj/compiler_probe_a/compiler_probe_a2, new /obj/compiler_probe_a)
	var/n = 0
	n = 0
	for(var/obj/x in L)
		n++
	rows += "iter obj [n]"
	n = 0
	for(var/obj/compiler_probe_a/x in L)
		n++
	rows += "iter obj_a [n]"
	n = 0
	for(var/obj/compiler_probe_a/compiler_probe_a2/x in L)
		n++
	rows += "iter obj_a2 [n]"
	n = 0
	for(var/mob/x in L)
		n++
	rows += "iter mob [n]"
	n = 0
	for(var/datum/x in L)
		n++
	rows += "iter datum [n]"
	n = 0
	for(var/atom/x in L)
		n++
	rows += "iter atom [n]"
	n = 0
	for(var/atom/movable/x in L)
		n++
	rows += "iter movable [n]"
	n = 0
	for(var/turf/x in L)
		n++
	rows += "iter turf [n]"
	n = 0
	for(var/x in L)
		n++
	rows += "iter untyped [n]"
	n = 0
	for(var/obj/x as anything in L)
		n++
	rows += "iter anything [n]"
	n = 0
	for(var/obj/compiler_probe_a/x in L)
		n++
		break
	rows += "iter break [n]"
	n = 0
	for(var/obj/x in L)
		for(var/mob/y in L)
			n++
	rows += "iter nested [n]"
	for(var/datum/compiler_probe_d/x in L)
		rows += "iter datum_d [x.type]"
	for(var/atom/x in L)
		rows += "iter atom_each [x.type]"
	for(var/thing in L)
		if(istype(thing, /datum))
			qdel(thing)

/// Observable orders: typesof(), vars, proc lists.
/proc/compiler_probe_orders(list/rows)
	for(var/T in typesof(/datum))
		rows += "typesof /datum [T]"
	for(var/T in typesof(/atom))
		rows += "typesof /atom [T]"
	for(var/T in typesof(/obj/item))
		rows += "typesof /obj/item [T]"
	for(var/T in typesof(/mob/living/carbon/human))
		rows += "typesof /mob/living/carbon/human [T]"
	for(var/T in typesof(/turf))
		rows += "typesof /turf [T]"
	for(var/T in typesof(/area))
		rows += "typesof /area [T]"
	for(var/T in typesof(/client))
		rows += "typesof /client [T]"
	for(var/T in typesof(/list))
		rows += "typesof /list [T]"
	for(var/T in typesof(/image))
		rows += "typesof /image [T]"
	for(var/T in typesof(/sound))
		rows += "typesof /sound [T]"
	for(var/T in typesof(/icon))
		rows += "typesof /icon [T]"
	for(var/T in typesof(/regex))
		rows += "typesof /regex [T]"
	for(var/T in typesof(/savefile))
		rows += "typesof /savefile [T]"
	for(var/P in typesof(/datum/proc))
		rows += "procs /datum [P]"
	for(var/P in typesof(/atom/proc))
		rows += "procs /atom [P]"
	for(var/P in typesof(/atom/movable/proc))
		rows += "procs /atom/movable [P]"
	for(var/P in typesof(/obj/proc))
		rows += "procs /obj [P]"
	for(var/P in typesof(/obj/item/proc))
		rows += "procs /obj/item [P]"
	for(var/P in typesof(/mob/proc))
		rows += "procs /mob [P]"
	for(var/P in typesof(/mob/living/proc))
		rows += "procs /mob/living [P]"
	for(var/P in typesof(/mob/living/carbon/human/proc))
		rows += "procs /mob/living/carbon/human [P]"
	for(var/P in typesof(/turf/proc))
		rows += "procs /turf [P]"
	for(var/P in typesof(/area/proc))
		rows += "procs /area [P]"
	for(var/P in typesof(/client/proc))
		rows += "procs /client [P]"
	for(var/P in typesof(/mob/verb))
		rows += "verbs /mob [P]"
	for(var/P in typesof(/mob/living/verb))
		rows += "verbs /mob/living [P]"
	for(var/P in typesof(/mob/living/carbon/human/verb))
		rows += "verbs /mob/living/carbon/human [P]"
	for(var/P in typesof(/client/verb))
		rows += "verbs /client [P]"
	var/datum/datum_probe = new /datum
	for(var/v in datum_probe.vars)
		rows += "vars datum [v]"
	qdel(datum_probe)
	var/obj/obj_probe = new /obj
	for(var/v in obj_probe.vars)
		rows += "vars obj [v]"
	qdel(obj_probe)
	var/mob/mob_probe = new /mob
	for(var/v in mob_probe.vars)
		rows += "vars mob [v]"
	qdel(mob_probe)
	var/atom/movable/movable_probe = new /atom/movable
	for(var/v in movable_probe.vars)
		rows += "vars movable [v]"
	qdel(movable_probe)
	for(var/v in world.vars)
		rows += "vars world [v]"
	for(var/v in global.vars)
		rows += "vars global [v]"

/// The file:line a thrown exception and a runtime error carry.
/proc/compiler_probe_lines(list/rows)
	compiler_probe_line_plain(rows)
	compiler_probe_line_after_multiline(rows)
	compiler_probe_line_in_branches(rows)
	compiler_probe_line_runtime_error(rows)
	compiler_probe_line_continuation(rows)

/proc/compiler_probe_catch(list/rows, label, exception/e)
	rows += "line [label] [e.file]:[e.line]"

/proc/compiler_probe_line_plain(list/rows)
	try
		throw new /exception("one")
	catch(var/exception/e)
		compiler_probe_catch(rows, "plain", e)

// A comment line and a blank line before the next procedure.

/proc/compiler_probe_line_after_multiline(list/rows)
	var/list/spread = list(
		"a",
		"b",
		"c")
	try
		rows += "spread [length(spread)]"
		throw new /exception("two")
	catch(var/exception/e)
		compiler_probe_catch(rows, "after_multiline", e)

/proc/compiler_probe_line_in_branches(list/rows)
	for(var/i in 1 to 3)
		try
			if(i == 2)
				throw new /exception("in branch")
			else
				throw new /exception("in else")
		catch(var/exception/e)
			compiler_probe_catch(rows, "branch[i]", e)

/datum/proc/compiler_probe_missing()
	return 1

/proc/compiler_probe_line_runtime_error(list/rows)
	var/datum/nothing = null
	try
		nothing.compiler_probe_missing()
	catch(var/exception/e)
		compiler_probe_catch(rows, "null_call", e)
	try
		var/list/L = list(1)
		rows += "[L[5]]"
	catch(var/exception/e2)
		compiler_probe_catch(rows, "bad_index", e2)

/proc/compiler_probe_line_continuation(list/rows)
	var/text = "a" + \
		"b"
	try
		rows += text
		throw new /exception("after continuation")
	catch(var/exception/e)
		compiler_probe_catch(rows, "continuation", e)

/// The rows a compiler has to reproduce exactly (the pin): one digest per folded operator, and the small sections whole. The tree-sized
/// orders (typesof, procs, vars) are in the dump only: they change with every type the tree gains.
/proc/compiler_probe_pin_rows(list/rows)
	var/list/pins = list()
	var/list/by_op = list()
	for(var/row in rows)
		if(copytext(row, 1, 6) == "fold ")
			var/op = splittext(row, " ")[2]
			var/bar = findtext(row, " | ")
			if(!by_op[op])
				by_op[op] = list()
			var/list/group = by_op[op]
			group += copytext(row, 1, bar)
		else if(copytext(row, 1, 6) == "iter " || copytext(row, 1, 10) == "branches " || copytext(row, 1, 8) == "spread ")
			pins += row
	for(var/op in by_op)
		var/list/group = by_op[op]
		pins += "fold [op] [length(group)] [md5(jointext(group, "\n"))]"
	return pins

/datum/unit_test/dq_compiler_behaviour

/// Compiler behaviour that must match DreamMaker's, pinned from a DreamMaker build of this probe (snapshots/compiler_behaviour.txt;
/// tools/dmb/scripts/pin_behaviour.py rebuilds it from a dump). The full dump goes to data/compiler_behaviour.txt: run the test
/// under DQ_COMPILER=dreammaker and DQ_COMPILER=native and diff the two dumps to see what a failure is about.
/datum/unit_test/dq_compiler_behaviour/Run()
	var/list/rows = list()
	var/list/vm_differs = list()
	compiler_probe_fold_all(rows, vm_differs)
	compiler_probe_fold_branches(rows)
	compiler_probe_iterators(rows)
	compiler_probe_orders(rows)
	compiler_probe_lines(rows)
	fdel("data/compiler_behaviour.txt")
	text2file("[jointext(rows, "\n")]\n", "data/compiler_behaviour.txt")
	var/list/got = compiler_probe_pin_rows(rows)
	var/list/want = splittext(file2text("code/modules/unit_tests/snapshots/compiler_behaviour.txt"), "\n")
	var/list/problems = list()
	for(var/row in got)
		if(!(row in want))
			problems += "got [row]"
	for(var/row in want)
		if(length(row) && copytext(row, 1, 2) != "#" && !(row in got))
			problems += "want [row]"
	log_test("compiler behaviour: [length(vm_differs)] constants differ from the same expression computed by the VM (DreamMaker folds some differently; the pin holds its values)")
	TEST_ASSERT(!length(problems), "[length(problems)] rows differ from the DreamMaker pin: [jointext(problems.Copy(1, min(length(problems) + 1, 21)), "; ")]")

