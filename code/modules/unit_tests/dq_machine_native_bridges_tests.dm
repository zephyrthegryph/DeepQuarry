// Source-only native-key regression draft against master ad04; not run. Requires existing dq_b4_probe helper.
// Wire into _unit_tests.dm only behind UNIT_TESTS when root reviews.
/datum/unit_test/dq_machine_native_bridge_keys/Run()
	var/obj/machinery/ai_slipper/S = allocate(/obj/machinery/ai_slipper, test_floor())
	S.set_cooldown_on(FALSE)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(S, nameof(S.cooldown_on))
	S.set_cooldown_on(TRUE)
	S.set_cooldown_on(TRUE)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 1, "Real dispenser cooldown publishes its native key exactly once")
	S.set_locked(!S.locked)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 1, "A different machine setting does not spuriously publish cooldown")
	S.set_cooldown_on(FALSE)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 2, "Real cooldown release publishes the same native key")

/datum/unit_test/dq_machine_native_bridge_menu/proc/cut_row(list/rows)
	for(var/list/row as anything in rows)
		if(row["key"] == "cut_out")
			return row
	return null

/datum/unit_test/dq_machine_native_bridge_menu/Run()
	set_global(nameof(GLOB.op_menu_builds), GLOB.op_menu_builds)
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/machinery/firealarm/F = allocate(/obj/machinery/firealarm, T)
	var/obj/item/tool/wirecutters/W = allocate(/obj/item/tool/wirecutters, T)
	F.set_panel_open(FALSE)
	var/list/shut = cut_row(op_menu(H, F, W))
	TEST_ASSERT_NOTNULL(shut, "Actual firealarm wire-cutting op appears with real cutters")
	TEST_ASSERT(!shut["enabled"], "Real maintenance requirement refuses shut panel")
	var/builds = GLOB.op_menu_builds
	op_menu(H, F, W)
	TEST_ASSERT_EQUAL(GLOB.op_menu_builds, builds, "Unchanged real machine menu hits the warmed cache")
	F.set_panel_open(TRUE)
	TEST_ASSERT(cut_row(op_menu(H, F, W))["enabled"], "Tracked panel setter invalidates cached refusal")
	F.set_panel_open(FALSE)
	TEST_ASSERT(!cut_row(op_menu(H, F, W))["enabled"], "Closing it invalidates cached allowance")

/datum/unit_test/dq_machine_native_bridge_draw/Run()
	var/obj/machinery/portable_atmospherics/powered/pump/P = allocate(/obj/machinery/portable_atmospherics/powered/pump, test_floor())
	TEST_ASSERT_NOTNULL(P.cell, "The actual portable pump starts with its declared power cell")
	TEST_ASSERT(P.cell.charge > 0, "The actual cell is charged for the draw's on branch")
	P.set_on(FALSE)
	refresh_flush()
	TEST_ASSERT_EQUAL(P.icon_state, "psiphon:0", "Real pump draws off")
	var/off_key = P.rx?.look_key
	P.set_on(TRUE)
	refresh_flush()
	TEST_ASSERT_EQUAL(P.icon_state, "psiphon:1", "Real tracked on setter redraws the powered pump without manual refresh")
	TEST_ASSERT(P.rx?.look_key != off_key, "The warmed actual look invalidates")
	P.set_on(FALSE)
	refresh_flush()
	TEST_ASSERT_EQUAL(P.icon_state, "psiphon:0", "The same actual dependency redraws the off branch")

/datum/unit_test/dq_machine_native_bridge_stat/Run()
	var/obj/machinery/firealarm/F = allocate(/obj/machinery/firealarm, test_floor())
	F.atom_fix()
	var/datum/dq_b4_key_probe/P = dq_b4_probe(F, stat_def_of(STAT_INTACT).stat_key)
	TEST_ASSERT(stat_value(F, STAT_INTACT), "Real machine starts intact")
	F.atom_break()
	rx_drain()
	TEST_ASSERT(!stat_value(F, STAT_INTACT), "Actual damage source contributes broken state")
	TEST_ASSERT_EQUAL(P.hits, 1, "The actual composed stat source publishes to native observers")
	F.atom_fix()
	rx_drain()
	TEST_ASSERT(stat_value(F, STAT_INTACT), "Real repair removes the damage source")
	TEST_ASSERT_EQUAL(P.hits, 2, "Repair publishes the native composed key")
/datum/unit_test/dq_machine_power_mode_native_demand/Run()
	var/obj/machinery/M = allocate(/obj/machinery, test_floor())
	var/area/A = get_area(M)
	TEST_ASSERT_NOTNULL(A, "The actual machine is on an area")
	TEST_ASSERT_EQUAL(M.power_area, A, "The actual machine's demand is linked to that area")
	M.update_power_channel(EQUIP)
	M.set_idle_power_usage(23)
	M.set_active_power_usage(137)
	M.set_use_power(USE_POWER_OFF)
	var/before = stat_value(A, STAT_DEMAND_EQUIP)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(M, nameof(M.use_power))
	TEST_ASSERT(M.set_use_power(USE_POWER_IDLE), "Idle is a real mode change")
	TEST_ASSERT_EQUAL(stat_value(A, STAT_DEMAND_EQUIP), before + 23, "Native tracked mode recomputes real area demand before setter returns")
	M.set_use_power(USE_POWER_IDLE)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 1, "Repeated idle does not publish another mode change")
	M.set_use_power(USE_POWER_ACTIVE)
	TEST_ASSERT_EQUAL(stat_value(A, STAT_DEMAND_EQUIP), before + 137, "Active replaces idle contribution rather than adding twice")
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 2, "Actual active transition publishes once")
	M.set_use_power(USE_POWER_OFF)
	TEST_ASSERT_EQUAL(stat_value(A, STAT_DEMAND_EQUIP), before, "Off removes this machine's demand")

/datum/unit_test/dq_airlock_bolts_native_delivery/Run()
	var/obj/machinery/door/airlock/D = allocate(/obj/machinery/door/airlock, test_floor())
	release(D, STAT_BOLTED, SRC_ALL)
	rx_drain()
	var/datum/stat_def/B = stat_def_of(STAT_BOLTED)
	var/key = (B.name in D.vars) ? B.name : B.stat_key
	var/datum/dq_b4_key_probe/P = dq_b4_probe(D, key)
	TEST_ASSERT(!stat_value(D, STAT_BOLTED), "Actual door begins unbolted")
	var/datum/source = allocate(/datum)
	hold(D, STAT_BOLTED, TRUE, source)
	rx_drain()
	TEST_ASSERT(stat_value(D, STAT_BOLTED), "The actual bolt source lowers the bolts")
	TEST_ASSERT_EQUAL(P.hits, 1, "Native bolt change reaches the published key without legacy mode forwarding")
	release(D, STAT_BOLTED, source)
	rx_drain()
	TEST_ASSERT(!stat_value(D, STAT_BOLTED), "Releasing that source raises the bolts")
	TEST_ASSERT_EQUAL(P.hits, 2, "Bolt release publishes its real state key")
