/// Actual block resets share only the immutable source, never the target mixtures.
/datum/unit_test/dq_block_default_air_source_isolation
/datum/unit_test/dq_block_default_air_source_isolation/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/open/A = test_floor()
	var/turf/open/B = get_step(A, EAST)
	TEST_ASSERT(istype(A) && istype(B), "the actual test template has two open floor targets")
	var/datum/gas_mixture/source = dq_unit_test_block_default_air()
	TEST_ASSERT_EQUAL(dq_unit_test_block_default_air(), source, "the actual copy source is reused instead of allocating disposable native mixtures")
	var/source_temperature = source.return_temperature()
	var/source_volume = source.return_volume()
	var/source_oxygen = source.get_moles(/datum/gas/oxygen)
	var/source_nitrogen = source.get_moles(/datum/gas/nitrogen)
	var/source_phoron = source.get_moles(/datum/gas/plasma)
	var/datum/gas_mixture/target_A = A.air
	var/datum/gas_mixture/target_B = B.air
	TEST_ASSERT(target_A != target_B && target_A != source && target_B != source, "real floor mixtures and template are independent native identities")
	A.air.set_moles(/datum/gas/plasma, 12)
	heat_set(A.air, T20C + 50, HEAT_SOURCE_OTHER)
	unit_test_block_reset_turf(B)
	TEST_ASSERT_EQUAL(A.air.get_moles(/datum/gas/plasma), 12, "resetting the peer never resets or aliases a mutated target")
	TEST_ASSERT_EQUAL(B.air.get_moles(/datum/gas/plasma), source_phoron, "peer resets from the real unmodified template")
	TEST_ASSERT_EQUAL(source.get_moles(/datum/gas/plasma), source_phoron, "target writes never contaminate source moles")
	TEST_ASSERT_EQUAL(source.return_temperature(), source_temperature, "target heat never contaminates source temperature")
	unit_test_block_reset_turf(A)
	TEST_ASSERT_EQUAL(A.air, target_A, "reset copies into the actual original target instead of replacing its identity")
	TEST_ASSERT_EQUAL(B.air, target_B, "peer keeps its own actual original target")
	TEST_ASSERT_EQUAL(A.air.get_moles(/datum/gas/plasma), source_phoron, "actual reset removes target contamination")
	TEST_ASSERT_EQUAL(A.air.get_moles(/datum/gas/oxygen), source_oxygen, "actual reset restores exact source oxygen")
	TEST_ASSERT_EQUAL(A.air.get_moles(/datum/gas/nitrogen), source_nitrogen, "actual reset restores exact source nitrogen")
	TEST_ASSERT_EQUAL(A.air.return_temperature(), source_temperature, "actual reset restores exact source temperature")
	TEST_ASSERT_EQUAL(source.return_volume(), source_volume, "reset did not mutate source volume")
	TEST_ASSERT_EQUAL(source.get_moles(/datum/gas/oxygen), source_oxygen, "reset did not mutate source oxygen")
	TEST_ASSERT_EQUAL(source.get_moles(/datum/gas/nitrogen), source_nitrogen, "reset did not mutate source nitrogen")
