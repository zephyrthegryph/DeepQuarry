/datum/unit_test/dq_init_machine_config
/datum/unit_test/dq_init_machine_config/Run()
	dq_init_machine_config_scope()
	// Copy catalog views, not the shared actual announcement or console objects.
	set_global(nameof(GLOB.req_console_assistance), GLOB.req_console_assistance.Copy())
	set_global(nameof(GLOB.req_console_supplies), GLOB.req_console_supplies.Copy())
	set_global(nameof(GLOB.req_console_information), GLOB.req_console_information.Copy())
	var/department = "Initializer Test \ref[src]"
	SSatoms.map_loader_begin("dq_init_request_department")
	var/obj/machinery/requests_console/A = new(test_floor())
	var/obj/machinery/requests_console/B = new(get_step(test_floor(), EAST))
	set_var(A, nameof(A.department), department)
	set_var(B, nameof(B.department), department)
	set_var(A, nameof(A.departmentType), RC_ASSIST|RC_SUPPLY|RC_INFO)
	set_var(B, nameof(B.departmentType), RC_ASSIST|RC_SUPPLY|RC_INFO)
	SSatoms.map_loader_stop("dq_init_request_department")
	own(A)
	own(B)
	SSatoms.InitializeAtoms(list(A, B))
	TEST_ASSERT_EQUAL(A.name, "[department] requests console", "actual constructor uses mapper-provided department name")
	TEST_ASSERT(A.announcement && B.announcement && A.announcement != B.announcement, "consoles own distinct real announcers")
	TEST_ASSERT_EQUAL(A.announcement.title, "[department] announcement", "actual owned announcer receives department title")
	TEST_ASSERT_EQUAL(A.announcement.newscast, 1, "actual announcer retains newscast mode")
	TEST_ASSERT((department in GLOB.req_console_assistance) && (department in GLOB.req_console_supplies) && (department in GLOB.req_console_information), "actual constructor registers all three independent department categories")
	var/datum/announcement/announcer = A.announcement
	qdel(A)
	TEST_ASSERT(QDELETED(announcer), "console destruction deletes its actual owned announcer")
	TEST_ASSERT((department in GLOB.req_console_assistance) && (department in GLOB.req_console_supplies) && (department in GLOB.req_console_information), "one remaining actual console keeps department registrations alive")
	qdel(B)
	TEST_ASSERT(!(department in GLOB.req_console_assistance) && !(department in GLOB.req_console_supplies) && !(department in GLOB.req_console_information), "last actual console removes its three department memberships")

/datum/unit_test/dq_init_machine_config/cycler_catalogs
/datum/unit_test/dq_init_machine_config/cycler_catalogs/Run()
	dq_init_machine_config_scope()
	// Force a cold type catalog without mutating or deleting shared choice datums.
	set_global(nameof(GLOB.suit_cycler_typecache), list())
	TEST_ASSERT(length(GLOB.suit_cycler_departments) && length(GLOB.suit_cycler_species), "real declared refit catalogs are available")
	var/obj/machinery/suit_cycler/A = allocate(/obj/machinery/suit_cycler, test_floor())
	var/obj/machinery/suit_cycler/B = allocate(/obj/machinery/suit_cycler, get_step(test_floor(), EAST))
	TEST_ASSERT(A.target_department() && A.target_species(), "actual constructor selects both real no-change defaults")
	TEST_ASSERT_EQUAL(A.target_department(), A.departments["No Change"], "actual default department is a real catalog entry")
	TEST_ASSERT_EQUAL(A.target_species(), A.species["No Change"], "actual default species is a real catalog entry")
	TEST_ASSERT_EQUAL(A.departments, B.departments, "warm instance reuses process-owned immutable department catalog")
	TEST_ASSERT_EQUAL(A.species, B.species, "warm instance reuses process-owned immutable species catalog")
	TEST_ASSERT_EQUAL(A.emagged_departments, B.emagged_departments, "warm instance reuses actual emag catalog")
	TEST_ASSERT_NULL(A.limit_departments, "actual constructor releases its no-longer-needed input filter")
	TEST_ASSERT(!A.broken_now(), "valid actual catalog does not break the real cycler")
	var/datum/suit_cycler_choice/department/department = A.target_department()
	var/datum/suit_cycler_choice/species/species = A.target_species()
	qdel(A)
	qdel(B)
	TEST_ASSERT(!QDELETED(department) && !QDELETED(species), "cycler destruction does not own/delete shared choice objects")
	var/list/no_department_default = GLOB.suit_cycler_departments.Copy()
	for(var/datum/suit_cycler_choice/department/noop/D in no_department_default.Copy())
		no_department_default -= D
	var/list/no_species_default = GLOB.suit_cycler_species.Copy()
	for(var/datum/suit_cycler_choice/species/noop/S in no_species_default.Copy())
		no_species_default -= S
	set_global(nameof(GLOB.suit_cycler_departments), no_department_default)
	set_global(nameof(GLOB.suit_cycler_species), no_species_default)
	set_global(nameof(GLOB.suit_cycler_typecache), list())
	var/obj/machinery/suit_cycler/invalid = allocate(/obj/machinery/suit_cycler, test_floor())
	TEST_ASSERT(!invalid.target_department() && !invalid.target_species(), "negative fixture actually removes both no-change catalog entries")
	TEST_ASSERT(invalid.broken_now(), "actual missing-default constructor marks real cycler broken")

/datum/unit_test/dq_init_machine_config/defusal_layout
/datum/unit_test/dq_init_machine_config/defusal_layout/Run()
	dq_init_machine_config_scope()
	var/list/colors = list("Red", "Blue", "Green", "Marigold", "Fuschia", "Black", "Pearl")
	var/obj/machinery/nuclearbomb/A = allocate(/obj/machinery/nuclearbomb, test_floor())
	var/obj/machinery/nuclearbomb/B = allocate(/obj/machinery/nuclearbomb, get_step(test_floor(), EAST))
	TEST_ASSERT(A.wires_list != B.wires_list, "real bombs have independent mutable defusal state")
	for(var/obj/machinery/nuclearbomb/N in list(A, B))
		TEST_ASSERT_EQUAL(length(N.r_code), 5, "actual constructor replaces ADMIN marker with five-digit access code")
		TEST_ASSERT(text2num(N.r_code) >= 10000 && text2num(N.r_code) <= 99999, "actual generated code stays within inclusive legacy range")
		TEST_ASSERT_EQUAL(length(N.wires_list), 7, "actual defusal catalog contains exactly seven colors")
		for(var/i = 1 to length(colors))
			TEST_ASSERT_EQUAL(N.wires_list[i], colors[i], "real defusal catalog retains original presentation order")
			TEST_ASSERT_EQUAL(N.wires_list[colors[i]], 0, "every actual defusal wire starts uncut")
		TEST_ASSERT((N.light_wire in colors) && (N.timing_wire in colors) && (N.safety_wire in colors), "three actual function assignments use real colors")
		TEST_ASSERT(N.light_wire != N.timing_wire && N.light_wire != N.safety_wire && N.timing_wire != N.safety_wire, "function picks remain without replacement")
	A.set_wires_list_at("Red", 1)
	TEST_ASSERT_EQUAL(B.wires_list["Red"], 0, "changing one real wire does not mutate peer bomb state")
