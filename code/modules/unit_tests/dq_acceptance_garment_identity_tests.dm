/obj/item/clothing/suit/armor/pcarrier/dq_identity_preview

CAPABILITIES(/obj/item/clothing/suit/armor/pcarrier/dq_identity_preview)
	op("identity_preview", menu(button = "Preview equipment"), needs(req(PROC_REF(identity_preview_reason))), then(PROC_REF(identity_preview_done)))

/obj/item/clothing/suit/armor/pcarrier/dq_identity_preview/proc/identity_preview_reason(datum/act/op/A)
	return acceptance_reason(src, "equip", src, src, A.actor, A.actor, wearer_is_actor = TRUE)

/obj/item/clothing/suit/armor/pcarrier/dq_identity_preview/proc/identity_preview_done(datum/act/op/A)
	return OP_OK

/datum/unit_test/dq_acceptance_garment_identity/proc/preview(mob/H, obj/item/P)
	for(var/list/row as anything in op_menu(H, P, null))
		if(row["key"] == "identity_preview")
			return row
	return null

/datum/unit_test/dq_acceptance_garment_identity/Run()
	var/builds_before = GLOB.op_menu_builds
	set_global(nameof(GLOB.op_menu_builds), builds_before)
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/item/clothing/suit/armor/pcarrier/dq_identity_preview/P = allocate(/obj/item/clothing/suit/armor/pcarrier/dq_identity_preview, T)
	var/obj/item/clothing/gloves/combat/G = allocate(/obj/item/clothing/gloves/combat, T)
	var/obj/item/clothing/accessory/armor/armguards/C = allocate(/obj/item/clothing/accessory/armor/armguards, T)
	G.set_body_parts_covered(ARMS)
	TEST_ASSERT(H.equip_to_slot_if_possible(G, SLOT_ID_GLOVES, disable_warning = TRUE), "Actual covering gloves occupy the real body slot")
	TEST_ASSERT(P.attempt_attach_accessory(C), "Actual armguard accessory enters the carrier")
	var/list/first = preview(H, P)
	TEST_ASSERT_NOTNULL(first, "The native requirement preview row exists")
	TEST_ASSERT(!first["enabled"], "Actual accessory/glove coverage refuses equipment")
	TEST_ASSERT_EQUAL(first["reason"], "\the [C] and \the [G] are in each other's way", "Old plate refusal text is exact")
	var/builds = GLOB.op_menu_builds
	preview(H, P)
	TEST_ASSERT_EQUAL(GLOB.op_menu_builds, builds, "Unchanged refusal hits the warmed native menu cache")
	TEST_ASSERT(C.vv_edit_var(nameof(C.name), "admin-renamed armguard"), "Actual VV uses the registered name setter")
	TEST_ASSERT_EQUAL(C.name, "admin-renamed armguard", "The admin name is stored exactly, without ownership formatting")
	TEST_ASSERT_EQUAL(preview(H, P)["reason"], "\the [C] and \the [G] are in each other's way", "Actual admin name mutation refreshes the cached refusal")
	TEST_ASSERT_EQUAL(GLOB.op_menu_builds, builds + 1, "The actual cross-object name dependency invalidates the warmed menu")
	var/datum/look/look = allocate(/datum/look)
	look.identity(name = "draw-renamed armguard")
	look.apply_to(C)
	TEST_ASSERT_EQUAL(C.name, "draw-renamed armguard", "Real engine look identity application changes the scoped garment name")
	TEST_ASSERT_EQUAL(preview(H, P)["reason"], "\the [C] and \the [G] are in each other's way", "Engine look application invalidates the actual cached requirement wording")
	TEST_ASSERT_EQUAL(GLOB.op_menu_builds, builds + 2, "Engine registered setter dispatch rebuilds the native menu once")
	TEST_ASSERT(H.unEquip(G, target = T), "Real glove removal clears the blocking occupancy")
	TEST_ASSERT(preview(H, P)["enabled"], "Removing the actual blocker allows the native preview again")

/datum/unit_test/dq_acceptance_garment_identity/semantic_registration/Run()
	var/obj/item/clothing/accessory/badge/B = allocate(/obj/item/clothing/accessory/badge, run_loc_floor_bottom_left)
	B.register_name("Real Badge Owner")
	TEST_ASSERT_EQUAL(B.stored_name, "Real Badge Owner", "Registration retains the badge owner's stored name")
	TEST_ASSERT_EQUAL(B.name, "[initial(B.name)] (Real Badge Owner)", "Badge registration retains its exact formatted display name")
	TEST_ASSERT(B.vv_edit_var(nameof(B.name), "Raw admin badge label"), "VV edits the raw tracked name")
	TEST_ASSERT_EQUAL(B.name, "Raw admin badge label", "VV does not reformat a raw display name as a registered owner")
	TEST_ASSERT_EQUAL(B.stored_name, "Real Badge Owner", "Raw VV name edits preserve owner registration")
	var/obj/item/clothing/accessory/permit/P = allocate(/obj/item/clothing/accessory/permit, B.loc)
	P.register_name("Real Permit Owner")
	TEST_ASSERT(P.owner, "Registration still sets the actual owner flag")
	TEST_ASSERT_EQUAL(P.name, "[initial(P.name)] (Real Permit Owner)", "Permit registration keeps exact formatting")
	TEST_ASSERT_EQUAL(P.desc, "[initial(P.desc)] It belongs to Real Permit Owner.", "Permit registration retains its description")
	TEST_ASSERT(P.vv_edit_var(nameof(P.name), "Raw admin permit label"), "Permit VV uses the low-level setter")
	TEST_ASSERT_EQUAL(P.name, "Raw admin permit label", "Permit raw display edits do not format or rename its owner")
	TEST_ASSERT(P.owner, "Raw VV preserves registered owner state")
	var/obj/item/clothing/accessory/permit/nanotech/N = allocate(/obj/item/clothing/accessory/permit/nanotech, B.loc)
	N.register_name("Real Nanotech Owner")
	TEST_ASSERT(N.owner, "Nanotech registration keeps the actual owner flag")
	TEST_ASSERT_EQUAL(N.name, "[initial(N.name)] (Real Nanotech Owner)", "Subtype registration keeps formatted name")
	TEST_ASSERT_EQUAL(N.registring, "[initial(N.registring)]Real Nanotech Owner", "Subtype registration retains its registrant field")
	TEST_ASSERT(findtext(N.validstring, initial(N.validstring)) == 1 && N.validstring != initial(N.validstring), "Subtype registration produces its real clock-derived validity text")
	var/validity = N.validstring
	TEST_ASSERT(N.vv_edit_var(nameof(N.name), "Raw admin nanotech label"), "Subtype VV edits the low-level display field")
	TEST_ASSERT_EQUAL(N.name, "Raw admin nanotech label", "Subtype raw display edits do not call its registration operation")
	TEST_ASSERT_EQUAL(N.validstring, validity, "Raw display edits retain the registration validity")

/datum/unit_test/dq_acceptance_garment_identity/grammar/Run()
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
	var/obj/item/clothing/suit/armor/vest/S = allocate(/obj/item/clothing/suit/armor/vest, H.loc)
	var/obj/item/clothing/gloves/combat/G = allocate(/obj/item/clothing/gloves/combat, H.loc)
	G.set_body_parts_covered(ARMS)
	S.set_body_parts_covered(ARMS)
	TEST_ASSERT(H.equip_to_slot_if_possible(G, SLOT_ID_GLOVES, disable_warning = TRUE), "Actual blocking glove is worn")
	TEST_ASSERT(G.vv_edit_var(nameof(G.gender), NEUTER), "Actual VV sets singular grammar")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(S, CONSTRAINT_EQUIP, S, H), "\the [G] is in the way", "Singular grammar is exact")
	TEST_ASSERT(G.vv_edit_var(nameof(G.gender), PLURAL), "Actual VV sets plural grammar")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(S, CONSTRAINT_EQUIP, S, H), "\the [G] are in the way", "Plural grammar follows the tracked field")
	TEST_ASSERT(H.unEquip(G, target = H.loc), "The blocking glove is actually removed")
