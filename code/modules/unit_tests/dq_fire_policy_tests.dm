// Real fire_act dispatch; only the declared test callback is non-destructive.
/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe
	var/trigger_calls = 0

CAPABILITIES(/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe)
	configure(fire_policy(reaction = FIRE_REACTION_TRIGGER, trigger_proc = TYPE_PROC_REF(/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe, triggered), trigger_verb = "exploded", heats_body = TRUE))

/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe/proc/triggered()
	trigger_calls++

/datum/unit_test/dq_fire_policy_contract

/datum/unit_test/dq_fire_policy_contract/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	TEST_ASSERT(static_find(static_table_of(/mob/living), ENTRY_FIRE_POLICY), "living types inherit a real native static entry")
	TEST_ASSERT_EQUAL(fire_policy_of_type(/mob/living).reaction, FIRE_REACTION_BURN, "the base living response remains burn")
	TEST_ASSERT(!fire_policy_of_type(/mob/living).heats_body, "base living exposure does not directly heat")
	TEST_ASSERT(fire_policy_of_type(/mob/living/carbon).heats_body, "real carbon inheritance enables the original heat path")
	TEST_ASSERT_EQUAL(fire_policy_of_type(/mob/living/silicon/robot).reaction, FIRE_REACTION_IGNITE, "real robots retain ignite-only policy")
	var/datum/type_trait/fire_policy/feral = fire_policy_of_type(/mob/living/simple_mob/slime/feral/dark_purple)
	TEST_ASSERT_EQUAL(feral.trigger_proc, TYPE_PROC_REF(/mob/living/simple_mob/slime/feral/dark_purple, ignite), "the actual feral trigger remains its exact typed proc")
	var/datum/type_trait/fire_policy/oil = fire_policy_of_type(/mob/living/simple_mob/slime/xenobio/oil)
	TEST_ASSERT_EQUAL(oil.trigger_proc, TYPE_PROC_REF(/mob/living/simple_mob/slime/xenobio/oil, explode), "oil retains its actual typed explosion callback")
	TEST_ASSERT_EQUAL(oil.trigger_verb, "exploded", "oil retains the exact admin log verb")
	var/mob/living/simple_mob/e0_fixture/A = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/simple_mob/e0_fixture/B = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	TEST_ASSERT_EQUAL(fire_policy_of(A), fire_policy_of(B), "unmodified peers share native immutable configuration")
	for(var/name in list("fire_reaction", "fire_trigger_proc", "fire_trigger_verb", "fire_heats_body"))
		TEST_ASSERT(!(name in A.vars), "[name] has no duplicate physical base field")
		TEST_ASSERT(type_trait_field_for_var(A, name), "the actual historical map field routes to the native trait")
	TEST_ASSERT(vars_write(A, "fire_reaction", FIRE_REACTION_NONE), "old map/VV reaction name remains accepted, including zero")
	TEST_ASSERT_EQUAL(fire_policy_of(A).reaction, FIRE_REACTION_NONE, "explicit zero is retained")
	TEST_ASSERT_EQUAL(fire_policy_of(B).reaction, FIRE_REACTION_BURN, "COW does not rewrite another actual mob")
	TEST_ASSERT(A.vv_edit_var("@fire_policy.heats_body", TRUE), "the real admin editor updates the policy")
	TEST_ASSERT(fire_policy_of(A).heats_body && !fire_policy_of(B).heats_body, "admin editing is instance-local")
	TEST_ASSERT(vars_write(A, "fire_trigger_verb", "ignited"), "the original logging field retains by-name editing")
	TEST_ASSERT(vars_write(A, "fire_trigger_proc", TYPE_PROC_REF(/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe, triggered)), "typed callback configuration retains the actual by-name path")
	TEST_ASSERT_EQUAL(fire_policy_of(A).trigger_proc, TYPE_PROC_REF(/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe, triggered), "callback identity is not renamed or wrapped")

/datum/unit_test/dq_fire_policy_entries

/datum/unit_test/dq_fire_policy_entries/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	H.set_bodytemperature(300)
	H.fire_act(null, 100)
	TEST_ASSERT_EQUAL(fire_stacks_of(H), 2, "the real burn null-temperature branch adds its original two stacks")
	TEST_ASSERT(stat_value(H, STAT_ON_FIRE), "the actual status path ignites the real human")
	TEST_ASSERT(abs(H.body_temperature() - 300) < 0.001, "null exposure does not heat the native body")
	vars_write(H, "fire_reaction", FIRE_REACTION_NONE)
	var/stacks = fire_stacks_of(H)
	H.fire_act(2000, 100)
	TEST_ASSERT_EQUAL(fire_stacks_of(H), stacks, "NONE returns without altering real stacks")
	TEST_ASSERT(abs(H.body_temperature() - 300) < 0.001, "NONE returns before carbon body heating")
	vars_write(H, "fire_reaction", FIRE_REACTION_IGNITE)
	H.extinguish_mob()
	H.set_fire_stacks(3)
	H.fire_act(null, 100)
	TEST_ASSERT_EQUAL(fire_stacks_of(H), 3, "IGNITE does not add hotspot fuel")
	TEST_ASSERT(stat_value(H, STAT_ON_FIRE), "IGNITE still uses the actual ignition status effect")
	H.fire_act(null, 100)
	TEST_ASSERT_EQUAL(fire_stacks_of(H), 3, "already burning IGNITE does not add stacks")
	var/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe/P = allocate(/mob/living/simple_mob/e0_fixture/dq_fire_policy_probe, test_floor())
	P.set_bodytemperature(300)
	P.fire_act(2000, 100)
	TEST_ASSERT_EQUAL(P.trigger_calls, 1, "the real entry invokes its exact declared callback once")
	TEST_ASSERT_EQUAL(fire_stacks_of(P), 0, "TRIGGER returns before ordinary burn fuel")
	TEST_ASSERT(abs(P.body_temperature() - 300) < 0.001, "TRIGGER returns before even explicitly enabled body heating")

/datum/unit_test/dq_fire_policy_carbon_heat

/datum/unit_test/dq_fire_policy_carbon_heat/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	H.set_bodytemperature(300)
	var/expected = max(min(BODYTEMP_HEATING_MAX * (1 - H.get_heat_protection()), 2000 - H.body_temperature()), 0)
	TEST_ASSERT(expected > 0, "a real unprotected human permits heating")
	H.fire_act(2000, 100)
	TEST_ASSERT(abs(H.body_temperature() - (300 + expected)) < 0.001, "actual carbon exposure respects the original per-contact cap")
	H.set_bodytemperature(300)
	var/obj/item/clothing/suit/fire/S = allocate(/obj/item/clothing/suit/fire, test_floor())
	TEST_ASSERT(H.equip_to_slot_if_possible(S, SLOT_ID_SUIT, disable_warning = TRUE), "actual thermal clothing is equipped through real inventory")
	var/protection = H.get_heat_protection()
	TEST_ASSERT(protection > 0, "real worn clothing supplies heat protection")
	expected = max(min(BODYTEMP_HEATING_MAX * (1 - protection), 2000 - H.body_temperature()), 0)
	H.fire_act(2000, 100)
	TEST_ASSERT(abs(H.body_temperature() - (300 + expected)) < 0.001, "actual clothing scales the original capped heating expression")
	H.set_bodytemperature(400)
	H.fire_act(350, 100)
	TEST_ASSERT(abs(H.body_temperature() - 400) < 0.001, "fire contact never cools a warmer body")
