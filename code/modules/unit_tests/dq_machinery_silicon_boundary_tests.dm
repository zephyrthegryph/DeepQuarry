// Real physical and remote inputs preserve the selected silicon control paths.

/datum/unit_test/dq_p2_door/silicon/c1_signaler_routes
/datum/unit_test/dq_p2_door/silicon/c1_signaler_routes/run_gate()
	var/obj/machinery/door/airlock/D = make_door()
	var/mob/living/carbon/human/H = make_person(null)
	var/obj/item/assembly/signaler/signaler = give_item(H, /obj/item/assembly/signaler)
	var/datum/op_result/human = test_click(H, D, signaler)
	settle()
	TEST_ASSERT_EQUAL(human?.key, "signaler", "Human's real signaler click selects the physical toggle op")
	TEST_ASSERT(!D.density, "The human's signaler touch opens the accessible powered door")
	D.close()
	settle()
	var/mob/living/silicon/robot/R = make_borg(list(), tile(3, 2))
	var/obj/item/assembly/signaler/module_signaler = give_module(R, /obj/item/assembly/signaler)
	var/datum/op_result/borg = test_click(R, D, module_signaler)
	settle()
	TEST_ASSERT_EQUAL(borg?.key, "signaler_robot", "Cyborg's real module click selects the chassis-specific touch")
	TEST_ASSERT(D.density, "The cyborg's physical signaler does not toggle the door")
	var/mob/living/silicon/ai/AI = placed_ai()
	test_click(AI, D, null, GESTURE_SHIFT)
	settle()
	TEST_ASSERT(!D.density, "AI's remote shift-click still opens the same door")

/datum/unit_test/dq_p2_door/silicon/c1_upload_internals
/datum/unit_test/dq_p2_door/silicon/c1_upload_internals/run_gate()
	var/obj/machinery/computer/aiupload/C = allocate(/obj/machinery/computer/aiupload, tile(2, 2))
	C.set_grid_power(TRUE)
	var/mob/living/carbon/human/H = make_person(null)
	var/datum/op_result/human = test_menu(H, C, "access_internals")
	TEST_ASSERT_EQUAL(human?.outcome, ACT_COMMITTED, "A person can access the upload console internals")
	TEST_ASSERT(C.opened, "Human's menu action opens the actual access panel")
	var/mob/living/silicon/ai/AI = placed_ai()
	AI.forceMove(tile(3, 2))
	var/datum/op_result/remote = test_menu(AI, C, "access_internals")
	TEST_ASSERT(!remote || remote.outcome != ACT_COMMITTED, "AI's remote access cannot open physical internals")
	TEST_ASSERT(C.opened, "Refused AI action does not change the access panel")
	var/mob/living/silicon/robot/R = make_borg(list(), tile(3, 2))
	var/datum/op_result/borg = test_menu(R, C, "access_internals")
	TEST_ASSERT(!borg || borg.outcome != ACT_COMMITTED, "An adjacent cyborg cannot open physical internals either")
	TEST_ASSERT(C.opened, "Refused cyborg action does not change the access panel")

/datum/unit_test/dq_p2_door/silicon/c1_robotics_control
/datum/unit_test/dq_p2_door/silicon/c1_robotics_control/run_gate()
	var/obj/machinery/computer/robotics/C = allocate(/obj/machinery/computer/robotics, tile(2, 2))
	C.set_grid_power(TRUE)
	C.set_req_access(list())
	var/mob/living/carbon/human/H = make_person(null)
	var/mob/living/silicon/ai/AI = placed_ai()
	var/mob/living/silicon/robot/R = make_borg(list(), tile(3, 3))
	R.set_master_ai(null)
	var/initial_lock = !!R.lockcharge
	var/datum/op_result/denied = test_ui(AI, C, "stopbot", list("ref" = REF(R)))
	TEST_ASSERT_EQUAL(denied?.outcome, ACT_REFUSED, "Remote AI may not control an unlinked cyborg")
	TEST_ASSERT_EQUAL(reason_text(denied?.reason), "AIs can only control cyborgs which are linked to them.", "AI link refusal wording remains unchanged")
	TEST_ASSERT_EQUAL(!!R.lockcharge, initial_lock, "Refused remote AI action does not change actual lockdown")
	R.set_master_ai(AI)
	var/datum/op_result/linked = test_ui(AI, C, "stopbot", list("ref" = REF(R)))
	TEST_ASSERT_EQUAL(linked?.outcome, ACT_COMMITTED, "Linked AI may control its cyborg remotely")
	TEST_ASSERT_EQUAL(!!R.lockcharge, !initial_lock, "Linked remote command changes actual lockdown")
	var/datum/op_result/human = test_ui(H, C, "stopbot", list("ref" = REF(R)))
	TEST_ASSERT_EQUAL(human?.outcome, ACT_COMMITTED, "Authorized physical human control remains available")
	TEST_ASSERT_EQUAL(!!R.lockcharge, initial_lock, "Physical human command toggles the same actual lockdown")
	var/datum/op_result/borg = test_ui(R, C, "stopbot", list("ref" = REF(R)))
	TEST_ASSERT(!borg || borg.outcome != ACT_COMMITTED, "Cyborg's original stopbot access restriction remains intact")
	TEST_ASSERT_EQUAL(!!R.lockcharge, initial_lock, "Refused cyborg command leaves lockdown unchanged")

/datum/unit_test/dq_p2_door/silicon/c1_slipper_swipe
/datum/unit_test/dq_p2_door/silicon/c1_slipper_swipe/run_gate()
	var/obj/machinery/ai_slipper/S = allocate(/obj/machinery/ai_slipper, tile(2, 2))
	S.set_grid_power(TRUE)
	var/mob/living/carbon/human/H = make_person(list(ACCESS_AI_UPLOAD))
	var/obj/item/card/id/id = give_item(H, /obj/item/card/id)
	id.set_access(list(ACCESS_AI_UPLOAD))
	var/datum/op_result/human = test_click(H, S, id)
	TEST_ASSERT_EQUAL(human?.key, "ai_slipper_toggle_lock", "Human's ID selects the actual lock op")
	TEST_ASSERT(!S.locked, "Authorized human's plain swipe unlocks the actual dispenser")
	S.set_locked(TRUE)
	var/mob/living/silicon/robot/R = make_borg(list(), tile(3, 2))
	var/obj/item/assembly/signaler/module_item = give_module(R, /obj/item/assembly/signaler)
	var/datum/op_result/borg = test_click(R, S, module_item)
	TEST_ASSERT_EQUAL(borg?.key, "ai_slipper_silicon_swipe", "Cyborg's module swipe selects its distinct touch path")
	TEST_ASSERT(S.locked, "Cyborg's plain swipe leaves the human ID lock unchanged")

/obj/machinery/camera/c1_wire_probe
	var/coverage_checks = 0

/obj/machinery/camera/c1_wire_probe/update_coverage(network_change = 0)
	coverage_checks++
	return ..()

/datum/unit_test/dq_p2_door/silicon/c1_camera_physical_and_remote
/datum/unit_test/dq_p2_door/silicon/c1_camera_physical_and_remote/run_gate()
	var/obj/machinery/camera/c1_wire_probe/C = allocate(/obj/machinery/camera/c1_wire_probe, tile(2, 2))
	C.set_grid_power(TRUE)
	C.set_panel_open(TRUE)
	var/mob/living/carbon/human/H = make_person(null)
	var/obj/item/multitool/tool = give_item(H, /obj/item/multitool)
	var/before = C.coverage_checks
	var/datum/op_result/physical = test_click(H, C, tool)
	TEST_ASSERT_EQUAL(physical?.key, "use_wire_tools", "Physical multitool click selects the real wire operation")
	TEST_ASSERT(C.coverage_checks > before, "Actual wire-tool effect still refreshes camera coverage")
	var/mob/living/silicon/ai/AI = placed_ai()
	var/mob/observer/eye/aiEye/eye = allocate(/mob/observer/eye/aiEye, tile(0, 0))
	TEST_ASSERT(AI.take_eye(eye), "AI has its real active camera eye")
	TEST_ASSERT(AI.has_camera_sight(C), "AI can actually see the target camera before the remote click")
	var/datum/op_result/remote = test_click(AI, C, null)
	TEST_ASSERT_EQUAL(remote?.key, "camera_silicon_look", "Plain remote AI click retains its camera-view op")
	TEST_ASSERT_EQUAL(get_turf(eye), get_turf(C), "Remote camera click moves the actual active AI eye")
