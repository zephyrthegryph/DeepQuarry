// A8 declared jobs: real constructors preserve map contents, links and subtype work.
/datum/unit_test/dq_a8_world_init
	abstract_type = /datum/unit_test/dq_a8_world_init

/datum/unit_test/dq_a8_world_init/New()
	..()
	dview(0, test_floor())
	status_policies()

/datum/unit_test/dq_a8_world_init/mining_markers/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/turf/T = test_floor()
	var/obj/machinery/mineral/input/I = allocate(/obj/machinery/mineral/input, get_step(T, NORTH))
	var/obj/machinery/mineral/output/O = allocate(/obj/machinery/mineral/output, get_step(T, SOUTH))
	var/obj/machinery/mineral/processing_unit/P = allocate(/obj/machinery/mineral/processing_unit, T)
	var/obj/machinery/mineral/stacking_machine/S = allocate(/obj/machinery/mineral/stacking_machine, T)
	var/obj/machinery/mineral/unloading_machine/U = allocate(/obj/machinery/mineral/unloading_machine, T)
	TEST_ASSERT_EQUAL(P.input_marker(), I, "Processing setup binds the actual neighboring input marker")
	TEST_ASSERT_EQUAL(P.output_marker(), O, "Processing setup binds the actual neighboring output marker")
	TEST_ASSERT_EQUAL(S.input_marker(), I, "Stacking setup retains cardinal input lookup")
	TEST_ASSERT_EQUAL(S.output_marker(), O, "Stacking setup retains cardinal output lookup")
	TEST_ASSERT_EQUAL(U.input_marker(), I, "Unloading setup retains cardinal input lookup")
	TEST_ASSERT_EQUAL(U.output_marker(), O, "Unloading setup retains cardinal output lookup")
	TEST_ASSERT(length(P.ores_processing) > 0, "Processing setup actually seeds its ore catalog")
	for(var/ore, value in GLOB.ore_data)
		var/datum/ore/OD = value
		TEST_ASSERT_EQUAL(P.ores_processing[OD.name], 0, "Every actual ore initially has no selected operation")
		TEST_ASSERT_EQUAL(P.ores_stored[OD.name], 0, "Every actual ore initially has no stored amount")
	TEST_ASSERT(length(S.stack_paths) > 0, "Stacking setup actually discovers material stack paths")
	for(var/material in S.stack_paths)
		TEST_ASSERT_EQUAL(S.stack_storage[material], 0, "Each discovered material initially has zero stored sheets")

/datum/unit_test/dq_a8_world_init/console_binding/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/turf/T = test_floor()
	var/obj/machinery/mineral/processing_unit/P = allocate(/obj/machinery/mineral/processing_unit, T)
	var/obj/machinery/mineral/processing_unit_console/PC = allocate(/obj/machinery/mineral/processing_unit_console, get_step(T, EAST))
	var/obj/machinery/mineral/stacking_machine/S = allocate(/obj/machinery/mineral/stacking_machine, T)
	var/obj/machinery/mineral/stacking_unit_console/SC = allocate(/obj/machinery/mineral/stacking_unit_console, get_step(T, WEST))
	TEST_ASSERT_EQUAL(PC.machine(), P, "The processing console discovers its actual machine")
	TEST_ASSERT_EQUAL(P.linked_console(), PC, "The processing machine receives its console backlink")
	TEST_ASSERT_EQUAL(SC.machine(), S, "The stacking console discovers its actual machine")
	TEST_ASSERT_EQUAL(S.linked_console(), SC, "The stacking machine receives its console backlink")

/datum/unit_test/dq_a8_world_init/invalid_console/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/machinery/mineral/processing_unit_console/C = new /obj/machinery/mineral/processing_unit_console
	TEST_ASSERT(QDELETED(C), "The actual constructor still discards a console with no machine")

/datum/unit_test/dq_a8_world_init/fuel_ports/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/structure/fuel_port/P = allocate(/obj/structure/fuel_port, test_floor())
	var/obj/structure/fuel_port/heavy/H = allocate(/obj/structure/fuel_port/heavy, test_floor())
	var/obj/structure/fuel_port/empty/E = allocate(/obj/structure/fuel_port/empty, test_floor())
	TEST_ASSERT(P.loaded && H.loaded, "Real fuel ports mark the constructed tanks as loaded")
	TEST_ASSERT_EQUAL(contents_count(P), 1, "The normal port constructs exactly one tank")
	TEST_ASSERT_EQUAL(contents_count(H), 1, "The heavy port constructs exactly one tank")
	TEST_ASSERT(locate(/obj/item/tank/phoron) in contents_of(P), "The normal port uses its configured tank type")
	TEST_ASSERT(locate(/obj/item/tank/phoron/pressurized) in contents_of(H), "The heavy subtype uses its own configured tank type")
	TEST_ASSERT_EQUAL(contents_count(E), 0, "The mapped empty subtype constructs no tank")
	TEST_ASSERT(!E.loaded && E.opened, "The empty port retains the subtype's mapped open state")

/datum/unit_test/dq_a8_world_init/trail_colors/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/structure/trailblazer/R = allocate(/obj/structure/trailblazer, test_floor())
	var/obj/structure/trailblazer/blue/B = allocate(/obj/structure/trailblazer/blue, test_floor())
	var/obj/structure/trailblazer/yellow/Y = allocate(/obj/structure/trailblazer/yellow, test_floor())
	TEST_ASSERT_EQUAL(R.icon_state, "redtrail_light_on", "The inherited setup initializes the red beacon")
	TEST_ASSERT_EQUAL(B.icon_state, "bluetrail_light_on", "The same setup dispatches to the blue subtype implementation")
	TEST_ASSERT_EQUAL(Y.icon_state, "yellowtrail_light_on", "The same setup dispatches to the yellow subtype implementation")

/datum/unit_test/dq_a8_world_init/mapped_supplies/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/turf/T = test_floor()
	var/obj/item/stack/material/steel/I = allocate(/obj/item/stack/material/steel, T, 1)
	var/obj/machinery/smartfridge/survival_pod/F = allocate(/obj/machinery/smartfridge/survival_pod, T)
	var/datum/stored_item/R = F.find_record(I)
	TEST_ASSERT_NOTNULL(R, "The real survival-pod constructor stocks the item already on its tile")
	TEST_ASSERT_EQUAL(R.get_amount(), 1, "The mapped supply is stocked exactly once")
	TEST_ASSERT(I.loc != T, "Stocking removes the actual supply from its map tile")
