// Real effects and ingestion exercise the sparse state, not just its storage helpers.
/datum/unit_test/dq_base_vars_material_taste
	abstract_type = /datum/unit_test/dq_base_vars_material_taste

/datum/unit_test/dq_base_vars_material_taste/emissions
/datum/unit_test/dq_base_vars_material_taste/emissions/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/I = allocate(/obj/item, H)
	TEST_ASSERT_EQUAL(I.material_luminescence(), 0, "ordinary items start without a material light sample")
	TEST_ASSERT_EQUAL(I.material_radioactivity(), 0, "ordinary items start without a radiation sample")
	TEST_ASSERT_EQUAL(I.material_toxicity(), 0, "ordinary items start without a toxicity sample")
	TEST_ASSERT_NULL(H.body.find_affliction(/datum/affliction/toxic_poisoning), "the actual human starts without the tested poison injury")
	I.configure_material_behaviors(30, 0, 10, "#123456")
	TEST_ASSERT(I.material_emitting(), "toxic material grants the actual periodic emission capability")
	TEST_ASSERT_EQUAL(glow_of(I).range, 1.5, "material setup applies its real light range")
	TEST_ASSERT_EQUAL(I.material_toxicity(), 10, "the exact configured dose survives until the emission tick")
	I.material_emission_step()
	TEST_ASSERT_NOTNULL(H.body.find_affliction(/datum/affliction/toxic_poisoning), "the actual held item injures its real human holder")
	I.configure_material_behaviors()
	TEST_ASSERT(!I.material_emitting(), "inert replacement revokes the actual periodic capability")
	TEST_ASSERT_EQUAL(glow_of(I).range, 0, "inert replacement switches off the previously configured light")
	TEST_ASSERT_EQUAL(I.material_luminescence(), 0, "cleared light samples return the original default")
	TEST_ASSERT_EQUAL(I.material_toxicity(), 0, "cleared poison samples return the original default")

/datum/unit_test/dq_base_vars_material_taste/ingestion
/datum/unit_test/dq_base_vars_material_taste/ingestion/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/datum/reagents/source = allocate(/datum/reagents, 20)
	var/datum/reagents/target = allocate(/datum/reagents, 20)
	source.add_reagent(REAGENT_ID_WATER, 10)
	var/expected = source.generate_taste_message(H)
	TEST_ASSERT(length(expected), "the actual water sample produces a nonempty taste description")
	TEST_ASSERT_EQUAL(H.last_taste_message(), "", "a human that has never ingested anything has no previous taste")
	cooldown_reset(H, taste_cooldown)
	cooldown_reset(H, taste_repeat_cooldown)
	H.ingest(source, target, 1)
	TEST_ASSERT_EQUAL(H.last_taste_message(), expected, "real ingestion retains exactly the actual sampled taste text")
	TEST_ASSERT_EQUAL(target.get_reagent_amount(REAGENT_ID_WATER), 1, "sampling still completes the real one-unit ingestion transfer")
	TEST_ASSERT_EQUAL(source.get_reagent_amount(REAGENT_ID_WATER), 9, "the taste preview never consumes a second sample")
	TEST_ASSERT(cooldown_started(H, taste_repeat_cooldown), "the message still starts its original repeat suppression clock")
