// The existing dq_turf_edges/cliff_blocks_and_releases_edges leaf covers runtime refresh.
/datum/unit_test/dq_turf_edges/init_cliff_mapload_registry/Run()
	dq_init_objects_fixture_scope()
	take_tiles()
	var/turf/simulated/floor/water/deep/D = make_first(/turf/simulated/floor/water/deep)
	make_second(/turf/simulated/floor/water)
	D = first_tile()
	TEST_ASSERT(length(D.edge_spill), "the actual water edge exists before mapload places a cliff")
	SSatoms.map_loader_begin("dq_cliff_context")
	var/obj/structure/cliff/C = new(D)
	SSatoms.map_loader_stop("dq_cliff_context")
	own(C)
	SSatoms.InitializeAtoms(list(C))
	settle()
	TEST_ASSERT(entity_handle_of(C) in D.dangerous_objects, "a cliff initialized with real mapload context registers its actual danger handle")
	TEST_ASSERT(!length(D.edge_spill), "the final map batch removes edges beneath its cliff")
	var/turf/destination = second_tile()
	C.forceMove(destination)
	TEST_ASSERT(!(entity_handle_of(C) in D.dangerous_objects), "movement removes the old turf's actual danger membership")
	TEST_ASSERT(entity_handle_of(C) in destination.dangerous_objects, "movement adds actual membership at the destination")
	qdel(C)
	TEST_ASSERT(!length(destination.dangerous_objects), "destruction unregisters the mapped cliff")
	settle()
	TEST_ASSERT(length(D.edge_spill), "removing the cliff restores the actual water edge")
	put_tiles_back()
