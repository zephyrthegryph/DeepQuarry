/// The queue API preserves append multiplicity and sleep/wake membership semantics.
/datum/unit_test/dq_lighting_boundary/Run()
	set_global("coalesce_runs", GLOB.coalesce_runs)
	set_var(SSlighting, "sources_queue", list())
	set_var(SSlighting, "corners_queue", list())
	set_var(SSlighting, "objects_queue", list())
	set_var(SSlighting, "sunlight_queue", list())
	var/obj/owner = allocate(/obj)
	var/datum/light_source/source = allocate(/datum/light_source, owner, owner)
	// The real source constructor queues its initial update.
	TEST_ASSERT_EQUAL(SSlighting.pending_source_count(), 1, "A new source must enqueue its initial update")
	SSlighting.queue_source(source)
	TEST_ASSERT_EQUAL(SSlighting.pending_source_count(), 2, "Source appends must retain their original multiplicity")
	TEST_ASSERT(SSlighting.has_pending_light_updates(), "Queued sources must keep the propagation pass busy")
	SSlighting.unqueue_source(source)
	TEST_ASSERT_EQUAL(SSlighting.pending_source_count(), 1, "Source removal must remove one queued occurrence, as the original list subtraction did")
	TEST_ASSERT(SSlighting.has_pending_light_updates(), "The remaining queued occurrence must keep propagation busy")
	SSlighting.unqueue_source(source)
	TEST_ASSERT_EQUAL(SSlighting.pending_source_count(), 0, "Removing the second occurrence must empty the source queue")
	TEST_ASSERT(!SSlighting.has_pending_light_updates(), "Removing the only source must leave propagation idle")
	var/datum/lighting_corner/corner = allocate(/datum/lighting_corner/dummy)
	defer_cleanup(null, GLOBAL_PROC_REF(qdel), corner, TRUE)
	SSlighting.queue_corner(corner)
	SSlighting.queue_corner(corner)
	TEST_ASSERT_EQUAL(length(SSlighting.corners_queue), 2, "Corner appends must preserve duplicates")
	TEST_ASSERT(SSlighting.has_pending_light_updates(), "Queued corners must keep propagation busy")
	SSlighting.unqueue_corner(corner)
	TEST_ASSERT_EQUAL(length(SSlighting.corners_queue), 1, "Corner removal must preserve the second queued occurrence")
	TEST_ASSERT(SSlighting.has_pending_light_updates(), "The remaining corner occurrence must keep propagation busy")
	SSlighting.unqueue_corner(corner)
	TEST_ASSERT(!SSlighting.has_pending_light_updates(), "Removing the last corner occurrence must leave propagation idle")
	var/datum/sunlight_handler/sunlight = allocate(/datum/sunlight_handler, test_floor())
	SSlighting.queue_sunlight(sunlight)
	SSlighting.queue_sunlight(sunlight)
	TEST_ASSERT_EQUAL(length(SSlighting.sunlight_queue), 2, "Visibility-change appends must preserve duplicates")
	SSlighting.unqueue_sunlight(sunlight)
	TEST_ASSERT_EQUAL(length(SSlighting.sunlight_queue), 1, "Sunlight removal must remove one appended occurrence")
	SSlighting.unqueue_sunlight(sunlight)
	TEST_ASSERT_EQUAL(length(SSlighting.sunlight_queue), 0, "The second removal must clear sunlight membership")
	SSlighting.queue_sunlight(sunlight, unique = TRUE)
	SSlighting.queue_sunlight(sunlight, unique = TRUE)
	TEST_ASSERT_EQUAL(length(SSlighting.sunlight_queue), 1, "Sleep/wake registration must retain unique membership")
	TEST_ASSERT(!SSlighting.has_pending_light_updates(), "Sunlight membership is not pending light propagation")
	SSlighting.unqueue_sunlight(sunlight)
	set_var(SSlighting, "initialized", FALSE)
	TEST_ASSERT(!SSlighting.is_initialized(), "Readiness must preserve pre-boot false")
	set_var(SSlighting, "initialized", TRUE)
	TEST_ASSERT(SSlighting.is_initialized(), "Readiness must preserve initialized true")
	set_var(SSlighting, "sun_mult", 0.25)
	TEST_ASSERT_EQUAL(SSlighting.sunlight_scale(), 0.25, "Brightness must retain the owner's configured multiplier")
	TEST_ASSERT_EQUAL(SSlighting.completed_steps(), SSlighting.times_fired, "Diagnostics must report the real system cadence")

/// Planet lookup preserves object identity, space fallback and pre-initialization callers.
/datum/unit_test/dq_planet_boundary/Run()
	set_global("coalesce_runs", GLOB.coalesce_runs)
	set_var(SSplanets, "z_to_planet", list())
	set_var(SSplanets, "planets", list())
	var/turf/T = test_floor()
	TEST_ASSERT_NULL(SSplanets.planet_at_z(T.z), "An unmapped z-level must have no planet")
	TEST_ASSERT_EQUAL(SSsolars.get_solar_angle(T), GLOB.sun.angle, "Space panels must continue using the global sun")
	TEST_ASSERT_EQUAL(SSplanets.planet_count(), 0, "The empty planet registry must be distinguishable")
	var/datum/planet/planet = allocate(/datum/planet)
	var/list/by_z = list()
	by_z.len = T.z
	by_z[T.z] = planet
	set_var(SSplanets, "z_to_planet", by_z)
	set_var(SSplanets, "planets", list(planet))
	set_var(SSplanets, "initialized", FALSE)
	TEST_ASSERT(!SSplanets.is_initialized(), "Lighting's boot gate must remain false before initialization")
	TEST_ASSERT_EQUAL(SSplanets.planet_at_z(T.z), planet, "Lookup callers that previously worked before boot must retain that behavior")
	TEST_ASSERT_NULL(SSplanets.planet_at_z(0), "A non-world z-level must have no planet")
	TEST_ASSERT_NULL(SSplanets.planet_at_z(T.z + 1), "A z-level beyond the registry must have no planet")
	TEST_ASSERT_EQUAL(SSplanets.planet_count(), 1, "The API must count registered planets")
	TEST_ASSERT_EQUAL(SSplanets.pick_planet(), planet, "The weather event must choose the registered planet itself")
	TEST_ASSERT_EQUAL(SSsolars.get_solar_angle(T), planet.get_sun_solar_position(), "Mapped solar panels must use the planet's actual day/night angle")
	TEST_ASSERT_EQUAL(using_map.get_zlevel_time(T.z), planet.current_time, "The map clock must retain the planet's actual time datum")
	set_var(SSplanets, "initialized", TRUE)
	TEST_ASSERT(SSplanets.is_initialized(), "Lighting's boot gate must become true after initialization")
