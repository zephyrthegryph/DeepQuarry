// Real mapped canister configuration and explicit inherited fill-before-cold ordering.
/datum/unit_test/dq_portable_canister_order
/datum/unit_test/dq_portable_canister_order/proc/restore_test_air(turf/open/T, datum/gas_mixture/saved)
	T.air.copy_from(saved)
	T.air_update_turf(TRUE, FALSE)

/datum/unit_test/dq_portable_canister_order/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	SSatoms.map_loader_begin("dq_portable_cold_map")
	var/obj/machinery/portable_atmospherics/canister/phoron/cold/C = new(test_floor())
	set_var(C, nameof(C.volume), 700)
	set_var(C, nameof(C.chilled_to), 80)
	SSatoms.map_loader_stop("dq_portable_cold_map")
	own(C)
	SSatoms.InitializeAtoms(list(C))
	var/datum/gas_mixture/control = new /datum/gas_mixture(700)
	own(control)
	gas_fill(control, C.starts_with, C.start_pressure)
	heat_set(control, 80)
	TEST_ASSERT_EQUAL(C.air_contents.return_volume(), 700, "actual mapped volume reaches the original root gas producer")
	TEST_ASSERT_EQUAL(C.air_contents.total_moles(), control.total_moles(), "cold tail retains exact real preset gas quantity")
	TEST_ASSERT_EQUAL(C.air_contents.return_temperature(), 2.72, "cold child force overrides mapper chilled_to after the parent finishes")
	TEST_ASSERT_EQUAL(C.gauge_band, C.pressure_band(control.return_pressure()), "parent gauge was sampled at mapped80K before cold child tail")
	TEST_ASSERT(C.gauge_band != C.pressure_band(), "negative timing control distinguishes parent80K gauge from final2.72K gas")
	var/datum/gas_mixture/owned_air = C.air_contents
	TEST_ASSERT_EQUAL(owner_of(owned_air), C, "actual root mixture keeps declared private-copy owner")
	qdel(C)
	TEST_ASSERT(QDELETED(owned_air), "actual canister destruction releases owned native mixture")

/datum/unit_test/dq_portable_canister_order/room_dump
/datum/unit_test/dq_portable_canister_order/room_dump/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/turf/open/T = test_floor()
	var/turf/open/peer = get_step(T, EAST)
	var/datum/gas_mixture/saved_T = T.air.copy()
	var/datum/gas_mixture/saved_peer = peer.air.copy()
	own(saved_T)
	own(saved_peer)
	defer_cleanup(src, TYPE_PROC_REF(/datum/unit_test/dq_portable_canister_order, restore_test_air), T, saved_T)
	defer_cleanup(src, TYPE_PROC_REF(/datum/unit_test/dq_portable_canister_order, restore_test_air), peer, saved_peer)
	T.air.clear()
	peer.air.clear()
	heat_set(T.air, T20C)
	heat_set(peer.air, T20C)
	TEST_ASSERT_EQUAL(T.air.return_volume(), peer.air.return_volume(), "independent real destination floors have matching volumes")
	SSatoms.map_loader_begin("dq_portable_cold_dump")
	var/obj/machinery/portable_atmospherics/canister/phoron/cold/C = new(T)
	set_var(C, nameof(C.volume), 700)
	set_var(C, nameof(C.chilled_to), 80)
	set_var(C, nameof(C.empties_into_room), TRUE)
	SSatoms.map_loader_stop("dq_portable_cold_dump")
	own(C)
	SSatoms.InitializeAtoms(list(C))
	var/datum/gas_mixture/control = new /datum/gas_mixture(700)
	own(control)
	gas_fill(control, C.starts_with, C.start_pressure)
	heat_set(control, 80)
	gas_dump(control, peer)
	TEST_ASSERT(T.air.get_moles(/datum/gas/plasma) > 0, "actual mapped room filler really transferred plasma onto its turf")
	TEST_ASSERT_EQUAL(T.air.get_moles(/datum/gas/plasma), peer.air.get_moles(/datum/gas/plasma), "room received the exact real parent preset quantity")
	TEST_ASSERT_EQUAL(T.air.return_temperature(), peer.air.return_temperature(), "real dump occurred at mapped parent80K before the cold child ran")
	TEST_ASSERT(T.air.return_temperature() > 2.72, "negative timing assertion rejects moving cold force before the real dump")
	TEST_ASSERT_EQUAL(C.air_contents.return_temperature(), 2.72, "the emptied child still forces its own final cold temperature")
