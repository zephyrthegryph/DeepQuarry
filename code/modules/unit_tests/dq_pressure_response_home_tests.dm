/datum/unit_test/dq_pressure_response_home
/datum/unit_test/dq_pressure_response_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/A = test_floor()
	var/turf/B = get_step(A, EAST)
	TEST_ASSERT(B && !B.density, "real pressure movement needs the adjacent open fixture floor")
	var/obj/item/M = allocate(/obj/item, A)
	var/obj/item/peer = allocate(/obj/item, A)
	TEST_ASSERT_NOTNULL(static_entry_of(/atom/movable, ENTRY_PRESSURE_RESPONSE), "the actual movable root declares native pressure response")
	TEST_ASSERT(!("pressure_resistance" in M.vars) && !("move_resist" in M.vars), "no raw physics fields shadow native policy")
	TEST_ASSERT_EQUAL(pressure_response_of_type(/atom/movable).pressure, 10, "the real movable root keeps its original pressure threshold")
	TEST_ASSERT_EQUAL(pressure_response_of(M).pressure, 5, "actual items keep their inherited lower threshold")
	TEST_ASSERT_EQUAL(pressure_response_of(M).force, 100, "actual items retain the original movement force threshold")
	M.experience_pressure_difference(500, EAST)
	TEST_ASSERT_EQUAL(M.loc, B, "real pressure pushes the actual unanchored item")
	M.forceMove(A)
	TEST_ASSERT(vars_write(M, "move_resist", INFINITY), "historical map force name reaches native policy without clamping infinity")
	M.experience_pressure_difference(500, EAST)
	TEST_ASSERT_EQUAL(M.loc, A, "the real pressure path respects an infinite force threshold")
	TEST_ASSERT(M.vv_edit_var("@pressure_response.force", 0), "real VV keeps an explicit zero force threshold")
	M.set_pressure_resistance(INFINITY)
	M.experience_pressure_difference(500, EAST)
	TEST_ASSERT_EQUAL(M.loc, A, "infinite pressure resistance independently suppresses the real push")
	TEST_ASSERT(vars_write(M, "pressure_resistance", 0), "historical pressure name accepts explicit zero")
	M.experience_pressure_difference(500, EAST)
	TEST_ASSERT_EQUAL(M.loc, B, "zero pressure and force permit the actual step")
	M.forceMove(A)
	M.set_pressure_resistance(null)
	TEST_ASSERT_NULL(pressure_response_of(M).pressure, "the published setter retains actual null rather than silently restoring type default")
	M.experience_pressure_difference(500, EAST)
	TEST_ASSERT_EQUAL(M.loc, B, "null retains old numeric-zero pressure behavior in the real handler")
	TEST_ASSERT_EQUAL(pressure_response_of(peer).pressure, 5, "all public edit routes preserve the independent sibling threshold")
	TEST_ASSERT_EQUAL(pressure_response_of(peer).force, 100, "an independent sibling retains its force resistance")
	TEST_ASSERT_EQUAL(pressure_response_of_type(/obj/machinery/portable_atmospherics/canister).pressure, 7 * ONE_ATMOSPHERE, "real canister pressure units remain unchanged")
