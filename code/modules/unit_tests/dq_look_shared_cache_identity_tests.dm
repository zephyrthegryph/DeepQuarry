/// Shared-cache identity is normalized before baselines, not excluded from hidden-state checks.
/datum/unit_test/dq_look_shared_cache_identity_warmup
/datum/unit_test/dq_look_shared_cache_identity_warmup/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/turf/T = test_floor()
	var/path = /obj/structure/table
	var/obj/structure/table/table = dq_look_allocate(path, T)
	dq_look_settle() // Match the real sampler: settle constructor reactions before made capture.
	TEST_ASSERT_NOTNULL(table.shared_cache_uid, "real look allocation establishes the normal stable shared-cache identity")
	var/uid = SHARED_CACHE_UID(table)
	TEST_ASSERT_EQUAL(SHARED_CACHE_UID(table), uid, "normal cache access retains its exact prewarmed identity")
	var/list/base = dq_look_pin_lines(table)
	var/list/primitives = dq_look_primitive_state(table)
	var/datum/dq_look_result/result = allocate(/datum/dq_look_result)
	TEST_ASSERT(dq_look_probe_reuse(table, path, "flipped", 1, base, result), "the actual flipped=1/back=0 table probe remains genuinely reversible")
	TEST_ASSERT_EQUAL(table.flipped, 0, "the real table state is restored after the probe")
	TEST_ASSERT_EQUAL(SHARED_CACHE_UID(table), uid, "the real flip no longer allocates a new scalar identity during capture")
	TEST_ASSERT(!length(dq_look_primitive_changes(table, primitives)), "the complete scalar guard remains active and finds no hidden changes")
	TEST_ASSERT_EQUAL(jointext(dq_look_pin_lines(table), "\n"), jointext(base, "\n"), "the real table's complete appearance returns to its made rows")
	var/datum/capability_runtime/runtime = capability_runtime(table)
	TEST_ASSERT_EQUAL(capability_runtime_peek(table), runtime, "the actual UID-keyed native runtime belongs to the real subject")
	qdel(table)
	test_time(1 SECOND)
	TEST_ASSERT_NULL(GLOB.capability_runtime_records?[uid], "actual lifecycle cleanup forgets the prewarmed subject's runtime cache")
	var/list/base_vars = dq_look_state_base_vars(/obj, T)
	var/list/plan = list("[path]" = list("flipped"))
	var/datum/dq_look_result/reused = allocate(/datum/dq_look_result)
	var/datum/dq_look_result/fresh = allocate(/datum/dq_look_result)
	dq_look_unit(path, T, base_vars, plan, reused, TRUE, TRUE)
	dq_look_unit(path, T, base_vars, plan, fresh, TRUE, TRUE, TRUE)
	TEST_ASSERT(!length(reused.impure), "actual native identity normalization does not force fresh table allocation")
	TEST_ASSERT_EQUAL(jointext(reused.made, "\n"), jointext(fresh.made, "\n"), "real table made rows remain identical for reused and fresh allocation")
	TEST_ASSERT_EQUAL(jointext(reused.probe_rows, "\n"), jointext(fresh.probe_rows, "\n"), "real flipped table rows remain identical for reused and fresh allocation")
	test_driver_end()
