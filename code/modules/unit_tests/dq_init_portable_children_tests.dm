// Keep root gas creation unchanged; verify actual pump payloads and existing constructor params.
/datum/unit_test/dq_portable_child_init
/datum/unit_test/dq_portable_child_init/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/machinery/portable_atmospherics/powered/pump/A = allocate(/obj/machinery/portable_atmospherics/powered/pump, test_floor())
	var/obj/machinery/portable_atmospherics/powered/pump/filled/B = allocate(/obj/machinery/portable_atmospherics/powered/pump/filled, get_step(test_floor(), EAST), TRUE)
	TEST_ASSERT(istype(A.cell, /obj/item/cell/apc), "actual ordinary pump retains its native default cell")
	TEST_ASSERT_NULL(B.cell, "actual constructor skip_cell positional input still omits the owned cell")
	for(var/obj/machinery/portable_atmospherics/powered/pump/P in list(A, B))
		TEST_ASSERT_EQUAL(P.air_contents.return_volume(), P.volume, "actual root applied final compiled port volume")
		TEST_ASSERT_EQUAL(P.air_contents.return_temperature(), T20C, "actual root heated the port before pump fill")
		var/datum/gas_mixture/control = new /datum/gas_mixture(P.volume)
		own(control)
		gas_fill(control, list(GAS_O2 = O2STANDARD, GAS_N2 = N2STANDARD), P.start_pressure)
		TEST_ASSERT_EQUAL(P.air_contents.get_moles(/datum/gas/oxygen), control.get_moles(/datum/gas/oxygen), "actual ordinary/filled pump gets exact native oxygen at its declared pressure")
		TEST_ASSERT_EQUAL(P.air_contents.get_moles(/datum/gas/nitrogen), control.get_moles(/datum/gas/nitrogen), "actual ordinary/filled pump gets exact native nitrogen at its declared pressure")
		TEST_ASSERT_EQUAL(owner_of(P.air_contents), P, "existing root retained actual private gas ownership")

/datum/unit_test/dq_portable_child_init/proc/restore_pump_counter(obj/machinery/portable_atmospherics/powered/pump/huge/anchor, value)
	if(QDELETED(anchor))
		CRASH("huge-pump counter cleanup anchor ended before deferred cleanup")
	anchor.gid = value

/datum/unit_test/dq_portable_child_init/proc/restore_scrubber_counter(obj/machinery/portable_atmospherics/powered/scrubber/huge/anchor, value)
	if(QDELETED(anchor))
		CRASH("huge-scrubber counter cleanup anchor ended before deferred cleanup")
	anchor.gid = value

/datum/unit_test/dq_portable_child_init/huge_counters
/datum/unit_test/dq_portable_child_init/huge_counters/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	SSatoms.map_loader_begin("dq_portable_huge_order")
	var/obj/machinery/portable_atmospherics/powered/pump/huge/P = new(test_floor(), TRUE)
	var/obj/machinery/portable_atmospherics/powered/pump/huge/anchor_P = new(get_step(test_floor(), EAST), TRUE)
	var/obj/machinery/portable_atmospherics/powered/scrubber/huge/S = new(test_floor(), TRUE)
	var/obj/machinery/portable_atmospherics/powered/scrubber/huge/anchor_S = new(get_step(test_floor(), EAST), TRUE)
	var/pump_before = P.gid
	var/scrubber_before = S.gid
	SSatoms.map_loader_stop("dq_portable_huge_order")
	own(P)
	own(anchor_P)
	own(S)
	own(anchor_S)
	defer_cleanup(src, TYPE_PROC_REF(/datum/unit_test/dq_portable_child_init, restore_pump_counter), anchor_P, pump_before)
	defer_cleanup(src, TYPE_PROC_REF(/datum/unit_test/dq_portable_child_init, restore_scrubber_counter), anchor_S, scrubber_before)
	SSatoms.InitializeAtoms(list(P, anchor_P, S, anchor_S))
	TEST_ASSERT_EQUAL(P.id, pump_before, "actual huge pump takes original shared sequence value")
	TEST_ASSERT_EQUAL(anchor_P.id, pump_before + 1, "actual next pump takes the next shared value")
	TEST_ASSERT_EQUAL(S.id, scrubber_before, "actual huge scrubber has its independent original sequence")
	TEST_ASSERT_EQUAL(anchor_S.id, scrubber_before + 1, "actual next scrubber takes its following sequence value")
	TEST_ASSERT_EQUAL(P.name, "[initial(P.name)] (ID [P.id])", "actual name is assigned exactly once after pump fill")
	TEST_ASSERT_EQUAL(S.name, "[initial(S.name)] (ID [S.id])", "actual scrubber name is assigned exactly once")
	TEST_ASSERT_EQUAL(P.air_contents.return_volume(), 500000, "huge pump keeps real root volume")
	TEST_ASSERT_EQUAL(P.air_contents.return_temperature(), T20C, "huge pump fill sees original root temperature")
	TEST_ASSERT(P.air_contents.total_moles() > 0, "parent actual pump fill completed before final huge machine is returned")
	TEST_ASSERT_EQUAL(S.air_contents.total_moles(), 0, "huge scrubber does not acquire the pump's fill behavior")
	TEST_ASSERT_NULL(P.cell, "huge pump retains actual provided constructor skip-cell argument")
	TEST_ASSERT_NULL(S.cell, "huge scrubber retains actual provided constructor skip-cell argument")
