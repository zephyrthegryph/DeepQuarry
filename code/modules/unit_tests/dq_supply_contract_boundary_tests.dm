/// UI lookups preserve registered object identity without sharing a mutable registry.
/datum/unit_test/dq_contract_boundary/Run()
	set_global("coalesce_runs", GLOB.coalesce_runs)
	var/datum/system/contracts/contracts = allocate(/datum/system/contracts)
	var/datum/contract/contract = allocate(/datum/contract)
	var/list/registry = list("boundary-contract" = contract)
	set_var(contracts, "contracts_by_id", registry)
	TEST_ASSERT_EQUAL(contracts.contract_by_id("boundary-contract"), contract, "The console must receive the registered contract itself")
	TEST_ASSERT_NULL(contracts.contract_by_id("missing"), "An unknown ID must not resolve")
	var/list/ids = contracts.contract_ids()
	TEST_ASSERT_EQUAL(length(ids), 1, "The console must see the single registered key")
	TEST_ASSERT_EQUAL(ids[1], "boundary-contract", "Registry order and keys must be preserved")
	ids.Cut()
	TEST_ASSERT_EQUAL(contracts.contract_by_id("boundary-contract"), contract, "Editing a key snapshot must not mutate the contract registry")
	TEST_ASSERT_EQUAL(length(contracts.contract_ids()), 1, "A subsequent snapshot must still contain the contract")

/// Cargo UI refs are checked against live membership; detached histories retain real datums.
/datum/unit_test/dq_supply_boundary/Run()
	set_global("coalesce_runs", GLOB.coalesce_runs)
	var/datum/system/supply/supply = allocate(/datum/system/supply)
	var/datum/supply_order/order = allocate(/datum/supply_order)
	var/datum/supply_order/outsider = allocate(/datum/supply_order)
	var/datum/exported_crate/receipt = allocate(/datum/exported_crate)
	set_var(supply, "order_history", list(order))
	set_var(supply, "exported_crates", list(receipt))
	var/list/orders = supply.order_history_snapshot()
	var/list/receipts = supply.export_history_snapshot()
	TEST_ASSERT_EQUAL(orders[1], order, "Order snapshots must preserve the real order datum")
	TEST_ASSERT_EQUAL(receipts[1], receipt, "Export snapshots must preserve the real receipt datum")
	orders.Cut()
	receipts.Cut()
	TEST_ASSERT_EQUAL(supply.order_from_ref(REF(order)), order, "Snapshot edits must not remove live order membership")
	TEST_ASSERT_EQUAL(supply.export_from_ref(REF(receipt)), receipt, "Snapshot edits must not remove live receipt membership")
	TEST_ASSERT_NULL(supply.order_from_ref(REF(outsider)), "A valid ref outside order history must remain rejected")
	TEST_ASSERT_NULL(supply.order_from_ref(REF(receipt)), "An export ref must not resolve as an order")
	TEST_ASSERT_NULL(supply.export_from_ref(REF(order)), "An order ref must not resolve as an export")
	var/datum/supply_pack/pack = allocate(/datum/supply_pack)
	set_var(supply, "supply_pack", list("boundary-pack" = pack))
	var/list/names = supply.catalog_names()
	TEST_ASSERT_EQUAL(names[1], "boundary-pack", "Catalog names must preserve the real registration key")
	names.Cut()
	TEST_ASSERT_EQUAL(supply.catalog_pack("boundary-pack"), pack, "Mutating catalog names must not discard a pack")
	TEST_ASSERT_EQUAL(supply.pick_catalog_pack(), pack, "A one-entry shipping catalog must return its actual pack")
	supply.queue_shipping_order(order)
	TEST_ASSERT(order in supply.shoppinglist, "Shipping-error orders must still enter the approved queue")
	TEST_ASSERT_EQUAL(supply.order_from_ref(REF(order)), order, "Queueing a shipping order must not alter order history")
	set_var(supply, "points_per_money", 0.02)
	TEST_ASSERT_EQUAL(supply.money_to_export_points(125), 2.5, "Thaler conversion must preserve the fractional legacy export-point unit")
	set_var(supply, "ordernum", 7)
	TEST_ASSERT_EQUAL(supply.current_order_index(), 7, "Printing must observe the current counter without incrementing it")
	TEST_ASSERT_EQUAL(supply.current_order_index(), 7, "Reading the counter again must not consume an order number")
	set_var(supply, "next_payroll", world.time - 1 SECONDS)
	TEST_ASSERT_EQUAL(supply.time_until_payroll(), 0, "An overdue payroll cycle must remain clamped to zero")
