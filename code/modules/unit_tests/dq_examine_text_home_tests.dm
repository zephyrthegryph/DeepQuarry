/obj/dq_examine_policy
CAPABILITIES(/obj/dq_examine_policy)
	configure(examine_text(fluff = "green", antag = "red"))
/obj/dq_examine_policy/cleared
CAPABILITIES(/obj/dq_examine_policy/cleared)
	configure(examine_text(fluff = TRAIT_NONE))
/datum/unit_test/dq_examine_text_home
/datum/unit_test/dq_examine_text_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/A = allocate(/obj/dq_examine_policy, test_floor())
	var/obj/B = allocate(/obj/dq_examine_policy, test_floor())
	var/obj/C = allocate(/obj/dq_examine_policy/cleared, test_floor())
	TEST_ASSERT_NOTNULL(static_entry_of(/atom, ENTRY_EXAMINE_TEXT), "native text policy is actually declared on atom")
	TEST_ASSERT(!("description_fluff" in A.vars) && !("description_antag" in A.vars), "raw legacy fields no longer shadow native text")
	TEST_ASSERT_EQUAL(A.get_description_fluff(), "green", "actual getter sees type green text")
	TEST_ASSERT_EQUAL(A.get_description_antag(), "red", "actual getter sees type antag text")
	TEST_ASSERT_NULL(C.get_description_fluff(), "explicit null clears inherited green text")
	TEST_ASSERT_EQUAL(C.get_description_antag(), "red", "clearing green retains inherited antag text")
	TEST_ASSERT(vars_write(A, "description_fluff", "map"), "the historical map name edits native policy")
	TEST_ASSERT_EQUAL(A.get_description_fluff(), "map", "actual getter sees map edit")
	TEST_ASSERT(A.vv_edit_var("@examine_text.antag", "admin"), "actual VV native field route accepts text")
	TEST_ASSERT_EQUAL(A.get_description_antag(), "admin", "actual getter sees admin edit")
	A.set_description_fluff(null)
	TEST_ASSERT_NULL(A.get_description_fluff(), "runtime clearing keeps actual null semantics")
	TEST_ASSERT_EQUAL(B.get_description_fluff(), "green", "edits leave peer green text intact")
	TEST_ASSERT_EQUAL(B.get_description_antag(), "red", "edits leave peer antag text intact")
	TEST_ASSERT_EQUAL(examine_text_of_type(/obj/dq_examine_policy).fluff, "green", "instance edits leave compiled defaults intact")
	var/datum/identification/ID = allocate(/datum/identification, B)
	TEST_ASSERT_NULL(B.get_description_fluff(), "actual identification construction hides green text")
	TEST_ASSERT_NULL(B.get_description_antag(), "actual identification construction hides antag text")
	ID.identify(IDENTITY_PROPERTIES)
	TEST_ASSERT_EQUAL(B.get_description_fluff(), "green", "real identification restores the snapshotted green text")
	TEST_ASSERT_EQUAL(B.get_description_antag(), "red", "real identification restores the snapshotted antag text")
	TEST_ASSERT(findtext(examine_text_of_type(/obj/item/reagent_containers/food/drinks/cans/cola).fluff, "Alpha Cola"), "real duplicate cola defaults preserve the later food/cans include, not stale examine-table text")
