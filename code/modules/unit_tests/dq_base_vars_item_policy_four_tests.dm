// Actual item policy construction, COW isolation and VV/map routing.
/obj/item/dq_item_policy
CAPABILITIES(/obj/item/dq_item_policy)
	configure(item_persistence(preserve = TRUE))
	configure(item_tooling(climbing = TRUE, climbing_delay = 2))
	configure(item_combat(no_attack_log = TRUE, no_random_knockdown = TRUE))

/datum/unit_test/dq_base_vars_item_policy_four/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	var/obj/item/A = allocate(/obj/item/dq_item_policy, test_floor())
	var/obj/item/B = allocate(/obj/item/dq_item_policy, test_floor())
	TEST_ASSERT(persistence_of(A).preserve, "the actual type retains declared cryostorage policy")
	TEST_ASSERT(combat_of(A).no_attack_log && combat_of(A).no_random_knockdown, "actual combat flags retain their declared opt-outs")
	TEST_ASSERT_EQUAL(tooling_of(A).climbing_delay, 2, "the actual tool retains its declared climbing delay")
	A.set_preserve_item(FALSE)
	A.set_climbing_delay(3)
	A.set_no_attack_log(FALSE)
	A.set_no_random_knockdown(FALSE)
	TEST_ASSERT(!persistence_of(A).preserve, "actual persistence setters alter only their own item")
	TEST_ASSERT(persistence_of(B).preserve, "a sibling retains its retention default")
	TEST_ASSERT_EQUAL(tooling_of(A).climbing_delay, 3, "the real tooling setter changes the instance")
	TEST_ASSERT_EQUAL(tooling_of(B).climbing_delay, 2, "the sibling's climbing configuration stays unchanged")
	TEST_ASSERT(!combat_of(A).no_attack_log && !combat_of(A).no_random_knockdown, "real combat setters clear the actual instance flags")
	TEST_ASSERT(combat_of(B).no_attack_log && combat_of(B).no_random_knockdown, "a sibling retains its logging and knockdown policy")
	for(var/old_name in list("preserve_item", "climbing_delay", "no_attack_log", "no_random_knockdown"))
		TEST_ASSERT(!(old_name in A.vars), "the old [old_name] field has no physical shadow competing with the native policy")
		var/list/field = type_trait_field_for_var(A, old_name)
		TEST_ASSERT(field && length(field) == 2, "the old map/VV field resolves to a real native policy")
		var/map_value = old_name == "climbing_delay" ? 5 : TRUE
		TEST_ASSERT(vars_write(A, old_name, map_value), "the real by-name map write accepts [old_name]")
		var/datum/type_trait/values = type_trait_of(A, field[1])
		TEST_ASSERT_EQUAL(values.vars[field[2]], map_value, "the actual map route updates the exact native policy")
		var/vv_value = old_name == "climbing_delay" ? 0 : FALSE
		TEST_ASSERT(A.vv_edit_var("@[field[1]].[field[2]]", vv_value), "the real admin editor accepts the native field separately")
		values = type_trait_of(A, field[1])
		TEST_ASSERT_EQUAL(values.vars[field[2]], vv_value, "the actual admin route retains explicit zero or false")
		var/datum/type_trait/peer = type_trait_of(B, field[1])
		var/peer_value = old_name == "climbing_delay" ? 2 : TRUE
		TEST_ASSERT_EQUAL(peer.vars[field[2]], peer_value, "both public edit paths leave the actual sibling policy unchanged")
	var/obj/item/default_item = allocate(/obj/item, test_floor())
	TEST_ASSERT(!persistence_of(default_item).preserve, "ordinary items preserve the original FALSE retention default")
	TEST_ASSERT(!combat_of(default_item).no_attack_log && !combat_of(default_item).no_random_knockdown, "ordinary attacks remain logged and eligible for knockdown")
	TEST_ASSERT_EQUAL(tooling_of(default_item).climbing_delay, 1, "ordinary item climbing delay keeps its old default")

	test_driver_end()
