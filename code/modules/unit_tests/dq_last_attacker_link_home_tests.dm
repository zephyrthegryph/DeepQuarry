/datum/unit_test/dq_last_attacker_link_home
/datum/unit_test/dq_last_attacker_link_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/e0_fixture/target = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/carbon/human/actor = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT_NULL(last_attacker_of(target), "an untouched target has no recorded actor")
	var/obj/item/weapon = allocate(/obj/item, test_floor())
	weapon.set_force(5)
	weapon.attack(target, actor)
	TEST_ASSERT_EQUAL(last_attacker_of(target), actor, "the real weapon attack records its live actor")
	TEST_ASSERT(target in link_list(actor, LK_LAST_ATTACKED), "the non-owning reverse endpoint follows the actual attribution")
	var/obj/item/anodevice/device = allocate(/obj/item/anodevice, test_floor())
	device.attack(target, other)
	TEST_ASSERT_EQUAL(last_attacker_of(target), other, "the real anodevice tap replaces attribution even without a battery")
	TEST_ASSERT(!(target in link_list(actor, LK_LAST_ATTACKED)), "replacement removes the former actor's inverse link")
	set_last_attacker(target, null)
	TEST_ASSERT_NULL(last_attacker_of(target), "explicit clearing removes attribution")
	TEST_ASSERT(!QDELETED(other), "clearing attribution never deletes the actor")
	set_last_attacker(target, other)
	qdel(other)
	TEST_ASSERT_NULL(last_attacker_of(target), "deleting the actor clears its native attribution link")
	TEST_ASSERT(!QDELETED(target), "actor deletion does not delete the target")
