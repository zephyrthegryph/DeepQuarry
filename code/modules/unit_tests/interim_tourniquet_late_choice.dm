/// The Loosen Tourniquet menu op asks which limb, and an answer is checked against the limbs that are cinched when it arrives.
/datum/unit_test/interim_tourniquet_late_choice

/datum/unit_test/interim_tourniquet_late_choice/Run()
	test_driver_begin()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human, T)
	user.enable_godmode()
	patient.enable_godmode()
	var/obj/item/organ/external/left = patient.get_organ(BP_L_ARM)
	var/obj/item/organ/external/right = patient.get_organ(BP_R_ARM)
	var/obj/item/organ/external/leg = patient.get_organ(BP_L_LEG)
	TEST_ASSERT_NOTNULL(left, "The patient has a real left arm")
	TEST_ASSERT_NOTNULL(right, "The patient has a real right arm")
	TEST_ASSERT_NOTNULL(leg, "The patient has a real left leg")
	var/datum/op_result/none = test_menu(user, patient, "loosen_tourniquet_pick")
	TEST_ASSERT_EQUAL(none?.outcome, ACT_REFUSED, "With no tourniquet on, the op refuses")
	var/obj/item/tourniquet/left_strap = allocate(/obj/item/tourniquet, T)
	var/obj/item/tourniquet/right_strap = allocate(/obj/item/tourniquet, T)
	var/obj/item/tourniquet/leg_strap = allocate(/obj/item/tourniquet, T)
	TEST_ASSERT(left.apply_tourniquet(left_strap, user), "The first real strap cinches")
	TEST_ASSERT(right.apply_tourniquet(right_strap, user), "The second real strap cinches")
	TEST_ASSERT(leg.apply_tourniquet(leg_strap, user), "The third real strap cinches")
	test_menu(user, patient, "loosen_tourniquet_pick")
	TEST_ASSERT_EQUAL(left.remove_tourniquet(user), left_strap, "The selected old strap is actually removed before the answer")
	test_answer(user, left.name)
	TEST_ASSERT_EQUAL(right.tourniquet, right_strap, "A stale answer retains the exact second strap")
	TEST_ASSERT_EQUAL(leg.tourniquet, leg_strap, "A stale answer retains the exact third strap")
	TEST_ASSERT_NULL(left.tourniquet, "A stale answer does not recreate the removed strap")
	test_menu(user, patient, "loosen_tourniquet_pick")
	test_answer(user, leg.name)
	test_time(1 SECOND)
	TEST_ASSERT_EQUAL(leg.tourniquet, leg_strap, "The chosen limb is not freed before the removal delay")
	test_time(2 SECONDS)
	TEST_ASSERT_NULL(leg.tourniquet, "The timed op releases the chosen limb")
	TEST_ASSERT_EQUAL(leg_strap.loc, user, "The actor receives that exact strap")
	TEST_ASSERT_EQUAL(right.tourniquet, right_strap, "The other strap stays on")
