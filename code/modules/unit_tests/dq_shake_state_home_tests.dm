// Real shake ticks remember only their own actor's last resting state.
/datum/unit_test/dq_shake_state_home
/datum/unit_test/dq_shake_state_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/e0_fixture/M = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/simple_mob/e0_fixture/other = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	TEST_ASSERT_NULL(sparse_get(M, dizzy_was_resting), "dizzy history starts unset")
	TEST_ASSERT_NULL(sparse_get(M, jittery_was_resting), "jitter history starts unset")
	M.set_resting(TRUE)
	M.dizzy_shake_tick(null)
	TEST_ASSERT_EQUAL(sparse_get(M, dizzy_was_resting), TRUE, "the real dizzy tick records rest")
	TEST_ASSERT_NULL(sparse_get(M, jittery_was_resting), "dizzy work does not create jitter history")
	M.jittery_shake_tick(null)
	TEST_ASSERT_EQUAL(sparse_get(M, jittery_was_resting), TRUE, "the real jitter tick records rest independently")
	M.set_resting(FALSE)
	M.dizzy_shake_tick(null)
	TEST_ASSERT_EQUAL(sparse_get(M, dizzy_was_resting), FALSE, "the real dizzy tick records leaving rest")
	TEST_ASSERT_EQUAL(sparse_get(M, jittery_was_resting), TRUE, "changing one cached state does not silently change the other")
	M.jittery_shake_tick(null)
	TEST_ASSERT_EQUAL(sparse_get(M, jittery_was_resting), FALSE, "the real jitter tick independently observes leaving rest")
	TEST_ASSERT_NULL(sparse_get(other, dizzy_was_resting), "another mob retains no dizzy state")
	TEST_ASSERT_NULL(sparse_get(other, jittery_was_resting), "another mob retains no jitter state")
