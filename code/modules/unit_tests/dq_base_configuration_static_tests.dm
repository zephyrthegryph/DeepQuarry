// A fallback default is not a declaration that configure() can inherit.
/datum/unit_test/dq_base_configuration_static_contract
/datum/unit_test/dq_base_configuration_static_contract/Run()
	var/datum/type_table/atom_table = static_table_of(/atom)
	TEST_ASSERT(static_find(atom_table, ENTRY_LIGHTING_CONFIG), "Lighting declares a real root static entry")
	TEST_ASSERT(static_find(atom_table, ENTRY_DAMAGE_PROFILE), "Damage presentation declares a real root static entry")
	TEST_ASSERT(static_find(atom_table, ENTRY_SHIELDING_CONFIG), "Radiation material configuration has an inherited root")
	TEST_ASSERT(static_find(atom_table, ENTRY_SPEECH_PRESENTATION), "Speech presentation has an inherited root")
	var/datum/type_table/movable_table = static_table_of(/atom/movable)
	TEST_ASSERT(static_find(movable_table, ENTRY_THROWING_CONFIG), "Throw animation policy has a real movable root")
	var/datum/type_table/object_table = static_table_of(/obj)
	TEST_ASSERT(static_find(object_table, ENTRY_OBJECT_BREAK_CONFIG), "Object break configuration has an inherited root")
	TEST_ASSERT(static_find(object_table, ENTRY_OBJECT_COMMUNICATION), "Communication policy has a real object root")
	TEST_ASSERT(static_find(object_table, ENTRY_OBJECT_TRANSFER), "Object transfer policy has a real object root")
	TEST_ASSERT(static_find(object_table, ENTRY_MICRO_ENTRY_POLICY), "Micro entry policy has a real object root")
	TEST_ASSERT(static_find(object_table, ENTRY_OBJECT_FIRE_CONFIG), "Object fire configuration has a real object root")
	var/datum/type_table/machine_table = static_table_of(/obj/machinery)
	TEST_ASSERT(static_find(machine_table, ENTRY_MACHINE_INTERACTION_CONFIG), "Machine interaction configuration has an inherited root")
	var/datum/type_table/item_table = static_table_of(/obj/item)
	TEST_ASSERT(static_find(item_table, ENTRY_ITEM_PERSISTENCE), "Item retention has an inherited root")
	TEST_ASSERT(static_find(item_table, ENTRY_ITEM_TOOLING), "The extended tooling trait retains its real root")
	TEST_ASSERT(static_find(item_table, ENTRY_ITEM_COMBAT), "The extended combat trait retains its real root")
	TEST_ASSERT(static_find(item_table, ENTRY_OPTICAL_VIEW), "Optical device labels have an inherited root")
	TEST_ASSERT(static_find(item_table, ENTRY_ITEM_PLACEMENT), "Item placement has a real item root")
	TEST_ASSERT(static_find(item_table, ENTRY_ITEM_ADMISSION), "Trash admission has a real item root")
	var/datum/type_table/mob_table = static_table_of(/mob)
	TEST_ASSERT(static_find(mob_table, ENTRY_HEAT_SPAWN), "Spawn heat configuration has an inherited root")
	var/datum/type_table/living_table = static_table_of(/mob/living)
	TEST_ASSERT(static_find(living_table, ENTRY_VOICE_CONFIG), "Voice configuration is compiled as an actual static entry")
	TEST_ASSERT(static_find(living_table, ENTRY_BUTCHERY_CONFIG), "Butchery configuration is compiled as an actual static entry")
	TEST_ASSERT(static_find(living_table, ENTRY_SHRED_SETTINGS), "Shredding configuration declares an inherited root entry")
	var/datum/type_trait/shred_settings/human_shred = type_trait_of_type(/mob/living/carbon/human, ENTRY_SHRED_SETTINGS)
	TEST_ASSERT_EQUAL(human_shred.vore_shred_time, 10 SECONDS, "Actual human shredding configuration overrides the inherited duration")
	TEST_ASSERT_EQUAL(lighting_of_type(/obj/item).emissive, EMISSIVE_BLOCK_GENERIC, "The actual item inherits and configures atom lighting")
	TEST_ASSERT_EQUAL(lighting_of_type(/mob/living/simple_mob).emissive, EMISSIVE_BLOCK_UNIQUE, "The actual simple-mob lighting configure is applied")
	TEST_ASSERT_EQUAL(voice_config_of_type(/mob/living/voice).can_pain_emote, FALSE, "The actual voice subtype configures the static voice trait")
	TEST_ASSERT_EQUAL(voice_config_of_type(/mob/living/simple_mob/vore/wolf).species_sounds, "Canine", "Actual subtype voice inheritance remains applied")
