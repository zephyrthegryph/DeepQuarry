/datum/unit_test/dq_vore_drain_state_home
/datum/unit_test/dq_vore_drain_state_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT(!sparse_has(H, absorbing_prey) && !sparse_has(H, drain_finalized), "idle drain actors carry no drain slots")
	TEST_ASSERT_EQUAL(sparse_get_or(H, absorbing_prey, 0), 0, "the inactive value remains exactly zero")
	H.succubus_drain_finalize()
	TEST_ASSERT_EQUAL(sparse_get_or(H, drain_finalized, 0), TRUE, "the actual finalization verb enables the flag")
	TEST_ASSERT_EQUAL(sparse_get_or(other, drain_finalized, 0), 0, "one actor's choice does not affect another")
	H.succubus_drain_finalize()
	TEST_ASSERT(!sparse_has(H, drain_finalized), "toggling off releases the optional slot")
	sparse_set_or(H, absorbing_prey, TRUE, 0)
	sparse_set_or(other, absorbing_prey, TRUE, 0)
	var/datum/act/op/A = allocate(/datum/act/op)
	A.args = list("what" = "drain", "victim" = other)
	H.grab_drain_interrupted(A)
	TEST_ASSERT(!sparse_has(H, absorbing_prey), "the real interruption cleanup releases the drain flag")
	TEST_ASSERT_EQUAL(sparse_get_or(other, absorbing_prey, 0), TRUE, "interruption leaves another actor's drain in progress")
