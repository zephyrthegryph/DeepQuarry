// Real human state retains its original timing and presentation/identity semantics.
#if defined(UNIT_TESTS) || defined(SPACEMAN_DMM)

/datum/unit_test/dq_base_vars_human_homes
	abstract_type = /datum/unit_test/dq_base_vars_human_homes

/datum/unit_test/dq_base_vars_human_homes/profile_preferences/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/peer = allocate(/mob/living/carbon/human)
	var/datum/preference/numeric/human/sensorpref/sensors = allocate(/datum/preference/numeric/human/sensorpref)
	var/datum/preference/text/human/custom_species/species_name = allocate(/datum/preference/text/human/custom_species)
	sensors.apply_to_human(H, 2)
	species_name.apply_to_human(H, "Test identity")
	TEST_ASSERT_EQUAL(H.bio.sensorpref, 2, "the real sensor preference writes the character profile")
	TEST_ASSERT_EQUAL(H.bio.custom_species, "Test identity", "the real species-name preference writes the character profile")
	TEST_ASSERT_EQUAL(peer.bio.sensorpref, 5, "another character keeps its own preference")
	TEST_ASSERT_NULL(peer.bio.custom_species, "the identity override does not leak to a peer")
	var/before = H.bio.nutrition_hidden
	H.hide_nutrition()
	TEST_ASSERT_EQUAL(H.bio.nutrition_hidden, !before, "the actual public verb toggles the profile choice")

/datum/unit_test/dq_base_vars_human_homes/body_writing/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/peer = allocate(/mob/living/carbon/human)
	H.body.set_body_writing_at(BP_L_HAND, "body-specific writing")
	TEST_ASSERT_EQUAL(H.body.body_writing[BP_L_HAND], "body-specific writing", "the actual body owns its organ writing")
	TEST_ASSERT_NULL(peer.body.body_writing, "writing is not shared between bodies")
	H.body.set_markings_len(7)
	TEST_ASSERT_EQUAL(H.body.markings_len, 7, "marking order is real body state")
	H.wash(CLEAN_TYPE_BLOOD)
	TEST_ASSERT(!length(H.body.body_writing), "actual washing clears physical writing")

/datum/unit_test/dq_base_vars_human_homes/hud_refresh_clock/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human)
	cooldown_reset(H, hud_full_refresh_at)
	H.life_hud_full_refresh()
	TEST_ASSERT_EQUAL(cooldown_left(H, hud_full_refresh_at), 1 MINUTES, "the real safety refresh records its original one-minute deadline")
	test_time(10 SECONDS)
	H.life_hud_full_refresh()
	TEST_ASSERT_EQUAL(cooldown_left(H, hud_full_refresh_at), 50 SECONDS, "an early refresh does not extend the deadline")
	test_driver_end()

/datum/unit_test/dq_base_vars_human_homes/heartbeat_counter/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human)
	TEST_ASSERT_NOTNULL(H.organ_in(O_HEART), "a real human provides the actual heart")
	H.set_pulse(PULSE_2FAST)
	H.body.set_heartbeat(0)
	H.life_heartbeat(null)
	TEST_ASSERT_EQUAL(H.body.heartbeat, 1, "the heartbeat advances by one Life cycle rather than elapsed time")
	H.life_heartbeat(null)
	TEST_ASSERT_EQUAL(H.body.heartbeat, 0, "the next actual heartbeat resets the same body's counter")

/datum/unit_test/dq_base_vars_human_homes/flight_preference/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human)
	TEST_ASSERT(!H.vore_options.flight_vore, "flight vore is disabled by default")
	TEST_ASSERT(H.apply_vore_option_trait("flight_vore", TRUE), "the existing serialized trait key reaches its native profile field")
	TEST_ASSERT(H.vore_options.flight_vore, "enabling the real trait preference writes the choice")
	TEST_ASSERT(H.apply_vore_option_trait("flight_vore", null, reset = TRUE), "the same trait reset is supported")
	TEST_ASSERT(!H.vore_options.flight_vore, "removing the trait restores its actual false default")


/datum/unit_test/dq_base_vars_human_homes/body_plan_replacement/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human)
	var/datum/body/previous = H.body
	H.body.set_body_writing_at(BP_L_HAND, "writing stays with this human")
	var/list/writing = H.body.body_writing
	H.body.set_markings_len(7)
	H.body.set_heartbeat(3)
	H.body.set_chemical_darksight(1)
	H.body.set_environment_steady(TRUE)
	H.body.set_nutrition_drained_at(123 SECONDS)
	H.body.set_can_defib(FALSE)
	TEST_ASSERT(H.set_species(SPECIES_PROTEAN), "the real species change completes")
	TEST_ASSERT(H.body != previous && QDELETED(previous), "a real body-plan change replaces and deletes the original body")
	TEST_ASSERT(istype(H.body, /datum/body/humanoid/nanoform), "the actual protean body plan was constructed")
	TEST_ASSERT_EQUAL(H.body.body_writing, writing, "the original writing list retains its identity across the plan change")
	TEST_ASSERT_EQUAL(H.body.body_writing[BP_L_HAND], "writing stays with this human", "the physical writing survives")
	TEST_ASSERT_EQUAL(H.body.markings_len, 7, "the original marking-order counter survives")
	TEST_ASSERT_EQUAL(H.body.heartbeat, 3, "the original Life-cycle heartbeat count survives")
	TEST_ASSERT_EQUAL(H.body.chemical_darksight, 1, "the original applied sight cache survives")
	TEST_ASSERT(H.body.environment_steady, "the original environmental cache survives")
	TEST_ASSERT_EQUAL(H.body.nutrition_drained_at, 123 SECONDS, "the original biological integration point survives")
	TEST_ASSERT(!H.body.can_defib, "changing plans does not silently recover revival eligibility")

#endif
