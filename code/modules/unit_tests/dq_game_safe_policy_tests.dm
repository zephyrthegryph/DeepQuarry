// Real gameplay entry points for native scalar configuration.
/obj/item/dq_policy_throw
	var/spin_calls = 0
/obj/item/dq_policy_throw/SpinAnimation(speed = 10, loops = -1, clockwise = 1, segments = 3)
	spin_calls++

/datum/unit_test/dq_game_safe_policies/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/obj/machinery/camera/C = allocate(/obj/machinery/camera, T)
	TEST_ASSERT_EQUAL(damage_profile_of(C).deflection, 5, "the actual camera retains its declared threshold")
	TEST_ASSERT_EQUAL(C.run_atom_armor(4, BRUTE, MELEE), 0, "a real melee hit below the threshold is deflected")
	TEST_ASSERT(C.run_atom_armor(5, BRUTE, MELEE) > 0, "a real melee hit exactly at the threshold is not deflected")
	C.set_damage_deflection(6)
	TEST_ASSERT_EQUAL(C.run_atom_armor(5, BRUTE, MELEE), 0, "the actual published threshold setter changes admission")
	TEST_ASSERT_EQUAL(damage_profile_of_type(/obj/machinery/camera).deflection, 5, "an instance threshold never changes the actual camera type")
	var/obj/item/dq_policy_throw/spinning = allocate(/obj/item/dq_policy_throw, T)
	var/obj/item/dq_policy_throw/still = allocate(/obj/item/dq_policy_throw, T)
	still.set_does_spin(FALSE)
	TEST_ASSERT(spinning.throw_at(T, 1, 1), "the actual throwing entry point accepts the ordinary item")
	TEST_ASSERT_EQUAL(spinning.spin_calls, 1, "the real throw path invokes the virtual animation when enabled")
	TEST_ASSERT(still.throw_at(T, 1, 1), "the disabled-spin item is still actually thrown")
	TEST_ASSERT_EQUAL(still.spin_calls, 0, "the exact native spin policy suppresses only animation")
	TEST_ASSERT(throwing_config_of(spinning).spin, "another real item retains its type's spin default")
	var/obj/item/toy/plushie/customizable/dragon/plush = allocate(/obj/item/toy/plushie/customizable/dragon, T)
	plush.set_added_overlays_at("durg_underbelly", list("color" = "#123456", "alpha" = 123))
	var/list/ui = plush.ui_data(null)
	var/list/overlays = ui["overlays"]
	TEST_ASSERT_EQUAL(length(overlays), 1, "the actual plushie UI retains its independent populated local overlay list")
	var/list/row = overlays[1]
	TEST_ASSERT_EQUAL(row["icon_state"], "durg_underbelly", "the actual local list retains its selected sprite state")
	TEST_ASSERT_EQUAL(row["color"], "#123456", "the actual local list retains its selected color")
	TEST_ASSERT_EQUAL(row["alpha"], 123, "the actual local list retains its selected alpha")

/datum/unit_test/dq_game_item_placement/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/tool/wirecutters/W = allocate(/obj/item/tool/wirecutters, test_floor())
	TEST_ASSERT_EQUAL(placement_of(W).center_x, 18, "the actual wirecutters retain their real horizontal center")
	TEST_ASSERT_EQUAL(placement_of(W).center_y, 10, "the actual wirecutters retain their real vertical center")
	auto_align(W, "icon-x=0;icon-y=0")
	TEST_ASSERT_EQUAL(W.pixel_x, world.icon_size / 16 - 18, "real alignment applies the configured horizontal center")
	TEST_ASSERT_EQUAL(W.pixel_y, world.icon_size / 16 - 10, "real alignment applies the configured vertical center")
	TEST_ASSERT_EQUAL(W.get_worn_layer(2), BODY_LAYER + 2, "a null native worn-layer override retains the caller's fallback")
	W.set_worn_layer(0)
	TEST_ASSERT_EQUAL(W.get_worn_layer(2), BODY_LAYER, "explicit zero remains distinct from unset")
	W.set_worn_layer(-1)
	TEST_ASSERT_EQUAL(W.get_worn_layer(2), BODY_LAYER - 1, "a real negative instance layer remains supported")
	W.set_worn_layer(null)
	TEST_ASSERT_EQUAL(W.get_worn_layer(2), BODY_LAYER + 2, "clearing the native override restores fallback")
	var/list/field = type_trait_field_for_var(W, "center_of_mass_x")
	TEST_ASSERT(field && field[1] == ENTRY_ITEM_PLACEMENT, "old map/VV center names resolve to their actual native owner")
	TEST_ASSERT(vars_write(W, "center_of_mass_x", 4), "the actual by-name writer accepts the preserved map field")
	auto_align(W, "icon-x=0;icon-y=0")
	TEST_ASSERT_EQUAL(W.pixel_x, world.icon_size / 16 - 4, "actual alignment sees the real map override immediately")

/datum/unit_test/dq_game_object_communication/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/obj/A = allocate(/obj, T)
	var/obj/B = allocate(/obj, T)
	TEST_ASSERT_NULL(communication_of(A).hears, "ordinary objects retain the exact null message default")
	TEST_ASSERT(!communication_of(A).speaks && communication_of(A).shown, "ordinary objects retain speaking and examination policies")
	TEST_ASSERT(vars_write(A, "show_messages", TRUE), "the old map/VV name edits actual message routing")
	var/list/listeners = get_mobs_or_objects_in_view(0, T, FALSE, TRUE)
	TEST_ASSERT(A in listeners, "the actual hearing object selector includes the configured object")
	TEST_ASSERT(!(B in listeners), "the actual selector still excludes an untouched object")
	A.set_show_messages(FALSE)
	listeners = get_mobs_or_objects_in_view(0, T, FALSE, TRUE)
	TEST_ASSERT(!(A in listeners), "real message selection responds to the native setter")
	TEST_ASSERT(vars_write(A, "can_speak", TRUE), "admin brain-container speech policy remains editable")
	TEST_ASSERT(communication_of(A).speaks && !communication_of(B).speaks, "real native speech overrides are holder-local")
	TEST_ASSERT(vars_write(A, "show_examine", FALSE), "admin equipment examination policy remains editable")
	TEST_ASSERT(!communication_of(A).shown && communication_of(B).shown, "actual examination policy is holder-local")
	TEST_ASSERT(vars_write(A, "redgate_allowed", FALSE), "admin gate transfer policy remains editable")
	TEST_ASSERT(!transfer_policy_of(A).redgate && transfer_policy_of(B).redgate, "the actual transfer restriction is isolated")
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/item/pen/P = allocate(/obj/item/pen, T)
	TEST_ASSERT(P.on_trash_eaten(H), "the actual ordinary pen initially passes trash admission")
	P.set_trash_eatable(FALSE)
	TEST_ASSERT(!P.on_trash_eaten(H), "the actual preference setter blocks the real trash admission handler")
	P.set_trash_eatable(TRUE)
	TEST_ASSERT(P.on_trash_eaten(H), "restoring the real permission restores actual admission")
