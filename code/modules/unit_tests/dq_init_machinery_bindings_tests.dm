/datum/unit_test/dq_init_machinery_bindings
/datum/unit_test/dq_init_machinery_bindings/Run()
	dq_init_machinery_bindings_scope()
	var/obj/machinery/embedded_controller/base = allocate(/obj/machinery/embedded_controller, test_floor())
	TEST_ASSERT(!QDELETED(base), "no-op controller Initialize deletion retains actual root construction")
	SSatoms.map_loader_begin("dq_init_docking_view")
	var/obj/machinery/embedded_controller/radio/airlock/docking_port/D = new(test_floor())
	set_var(D, nameof(D.display_name), "Unit Test Dock")
	SSatoms.map_loader_stop("dq_init_docking_view")
	own(D)
	SSatoms.InitializeAtoms(list(D))
	TEST_ASSERT(D.program && D.airlock_program, "actual owned program factories completed")
	TEST_ASSERT_EQUAL(D.docking_program, D.program, "typed docking view is the actual program, not a second allocation")
	TEST_ASSERT_EQUAL(D.docking_program.display_name, "Unit Test Dock", "constructor forwards actual mapped label after real program creation")
	TEST_ASSERT_EQUAL(D.docking_program.airlock_program, D.airlock_program, "real inner controller program is shared with docking state machine")
	var/datum/embedded_program/program = D.program
	var/datum/embedded_program/airlock/docking/airlock = D.airlock_program
	qdel(D)
	TEST_ASSERT(QDELETED(program) && QDELETED(airlock), "actual two owned programs die with controller")

/datum/unit_test/dq_init_machinery_bindings/multi_labels
/datum/unit_test/dq_init_machinery_bindings/multi_labels/Run()
	dq_init_machinery_bindings_scope()
	SSatoms.map_loader_begin("dq_init_multi_labels")
	var/obj/machinery/embedded_controller/radio/docking_port_multi/A = new(test_floor())
	var/obj/machinery/embedded_controller/radio/docking_port_multi/B = new(test_floor())
	set_var(A, nameof(A.child_tags_txt), "alpha;beta")
	set_var(A, nameof(A.child_names_txt), "Outer;Inner")
	set_var(B, nameof(B.child_tags_txt), "alpha;beta")
	set_var(B, nameof(B.child_names_txt), "Only one label")
	SSatoms.map_loader_stop("dq_init_multi_labels")
	own(A)
	own(B)
	SSatoms.InitializeAtoms(list(A, B))
	TEST_ASSERT_EQUAL(A.child_names["alpha"], "Outer", "actual mapped tag/name parallel lists decode first label")
	TEST_ASSERT_EQUAL(A.child_names["beta"], "Inner", "actual mapped tag/name parallel lists preserve second label")
	TEST_ASSERT_EQUAL(length(A.child_names), 2, "decoder creates exactly the mapped two labels")
	TEST_ASSERT(!length(B.child_names), "mismatched list lengths preserve old empty-label behavior")
	var/datum/embedded_program/docking/multi/program = A.program
	TEST_ASSERT(("alpha" in program.children_tags) && ("beta" in program.children_tags), "early program factory still sees original raw tags before late label decode")
	TEST_ASSERT_EQUAL(program.children_override["alpha"], "disabled", "native parent program initialized real child command state")

/datum/unit_test/dq_init_machinery_bindings/magnets
/datum/unit_test/dq_init_machinery_bindings/magnets/Run()
	dq_init_machinery_bindings_scope()
	var/obj/machinery/magnetic_module/M = allocate(/obj/machinery/magnetic_module, test_floor())
	SSatoms.map_loader_begin("dq_init_magnet_controls")
	var/obj/machinery/magnetic_controller/C = new(get_step(test_floor(), EAST))
	set_var(C, nameof(C.frequency), M.freq)
	set_var(C, nameof(C.code), M.code)
	set_var(C, nameof(C.autolink), TRUE)
	set_var(C, nameof(C.path), "N; E&*S W")
	SSatoms.map_loader_stop("dq_init_magnet_controls")
	own(C)
	SSatoms.InitializeAtoms(list(C))
	TEST_ASSERT(M in C.magnets, "real controller constructor autolinks actual matching existing field generator")
	TEST_ASSERT_EQUAL(jointext(C.rpath, ""), "NESW", "real constructor decodes control path while retaining order and separator policy")
	var/datum/radio_frequency/F = C.radio_connection()
	TEST_ASSERT(F && (C in F.devices[RADIO_MAGNETS]), "real controller binds radio membership using mapped frequency")
	qdel(M)
	TEST_ASSERT(!(M in C.magnets), "real generator deletion clears borrowed controller catalog entry")
	qdel(C)
	TEST_ASSERT(QDELETED(F) || !(C in F.devices[RADIO_MAGNETS]), "radio owns and removes real controller membership on destruction")

/datum/unit_test/dq_init_machinery_bindings/turret_area
/datum/unit_test/dq_init_machinery_bindings/turret_area/Run()
	dq_init_machinery_bindings_scope()
	var/area/A = get_area(test_floor())
	var/obj/machinery/turretid/P = allocate(/obj/machinery/turretid, test_floor())
	TEST_ASSERT_EQUAL(P.control_area, A, "actual default panel resolves current area")
	TEST_ASSERT(P in A.turret_controls, "declared reciprocal area link is filled by real constructor")
	qdel(P)
	TEST_ASSERT(!(P in A.turret_controls), "deleting panel removes only its real reciprocal area membership")

/datum/unit_test/dq_init_machinery_bindings/poster
/datum/unit_test/dq_init_machinery_bindings/poster/Run()
	dq_init_machinery_bindings_scope()
	SSatoms.map_loader_begin("dq_init_mapped_poster")
	var/obj/machinery/holoposter/P = new(test_floor())
	set_var(P, nameof(P.icon_forced), TRUE)
	P.set_icon_state("hephaestus")
	SSatoms.map_loader_stop("dq_init_mapped_poster")
	own(P)
	SSatoms.InitializeAtoms(list(P))
	TEST_ASSERT_EQUAL(P.poster, "hephaestus", "actual constructor honors mapped forced advert before random selection")
	TEST_ASSERT_EQUAL(!!P.alerting, !!((P.z in using_map.station_levels) && GLOB.security_level), "actual security presentation follows existing station-level policy")
	TEST_ASSERT(after_pending(P, "holoposter_rotation"), "constructor schedules real keyed rotation even for a forced advert")
	qdel(P)
	TEST_ASSERT(!after_pending(P, "holoposter_rotation"), "real poster deletion cancels its owned rotation timer")

/datum/unit_test/dq_init_machinery_bindings/window
/datum/unit_test/dq_init_machinery_bindings/window/Run()
	dq_init_machinery_bindings_scope()
	SSatoms.map_loader_begin("dq_init_window_access")
	var/obj/machinery/door/window/secure = new(test_floor())
	var/obj/machinery/door/window/public = new(get_step(test_floor(), EAST))
	secure.set_icon_state("rightsecure")
	secure.set_req_access(list(ACCESS_SECURITY))
	public.set_icon_state("right")
	public.set_req_access(null)
	SSatoms.map_loader_stop("dq_init_window_access")
	own(secure)
	own(public)
	SSatoms.InitializeAtoms(list(secure, public))
	TEST_ASSERT_EQUAL(secure.base_state, "rightsecure", "actual secured door stores mapped nondefault access sprite")
	TEST_ASSERT_EQUAL(public.base_state, initial(public.base_state), "public door preserves old branch that does not capture mapped sprite")

/datum/unit_test/dq_init_machinery_bindings/beacon
/datum/unit_test/dq_init_machinery_bindings/beacon/Run()
	dq_init_machinery_bindings_scope()
	var/turf/T = test_floor()
	var/obj/machinery/bluespace_beacon/B = allocate(/obj/machinery/bluespace_beacon, T)
	var/obj/item/radio/beacon/concealed/item = B.Beacon
	TEST_ASSERT(item, "actual nullspace starting beacon exists")
	TEST_ASSERT_EQUAL(item.loc, T, "real machine constructor moves its owned beacon out to final turf")
	TEST_ASSERT_EQUAL(!!B.invisibility, !T.is_plating(), "actual machine uses floor hiding policy after placement")
