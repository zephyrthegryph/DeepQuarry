// Actual UI registry lifecycle and actual Rust-backed pipe-image production.
/datum/unit_test/dq_lazy_open_uis
/datum/unit_test/dq_lazy_open_uis/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/mob/living/carbon/human/source = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/host = allocate(/obj/item, test_floor())
	TEST_ASSERT_NULL(source.tgui_open_uis, "a mob that has never had a UI allocates no open-list")
	TEST_ASSERT_EQUAL(SStgui.close_user_uis(source), 0, "closing an untouched mob's real UI registry is a safe no-op")
	var/datum/tgui/ui = allocate(/datum/tgui, source, host, "LazyRegistry")
	ui.set_state(GLOB.tgui_always_state)
	SStgui.on_open(ui)
	TEST_ASSERT(ui in source.tgui_open_uis, "actual UI registration creates the user's real list")
	TEST_ASSERT_EQUAL(length(source.tgui_open_uis), 1, "the native user link and registration do not duplicate a UI")
	TEST_ASSERT(ui in SStgui.all_uis, "actual registration also reaches the real system roster")
	TEST_ASSERT(SStgui.transfer_ui(ui, target), "the actual transfer changes the real UI participant")
	TEST_ASSERT_EQUAL(ui.user, target, "the real UI now names its actual new user")
	TEST_ASSERT_NULL(source.tgui_open_uis, "transferring the last UI releases the old list")
	TEST_ASSERT_EQUAL(length(target.tgui_open_uis), 1, "the new user's real registry has exactly one UI")
	TEST_ASSERT(ui in target.tgui_open_uis, "the exact transferred UI is registered, not a replacement")
	ui.close(can_be_suspended = FALSE)
	TEST_ASSERT_NULL(target.tgui_open_uis, "actual close releases the new user's last open-list")
	TEST_ASSERT(!(ui in SStgui.all_uis), "actual close removes the system's live registration")
	test_driver_end()

/datum/unit_test/dq_lazy_ventcrawl_images
/datum/unit_test/dq_lazy_ventcrawl_images/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/peer = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT_NULL(H.pipes_shown, "an ordinary mob allocates no pipe-image list")
	H.remove_ventcrawl()
	TEST_ASSERT_NULL(H.pipes_shown, "actual removal before any entry safely retains the lazy empty state")
	var/obj/machinery/atmospherics/pipe/simple/P = allocate(/obj/machinery/atmospherics/pipe/simple, test_floor())
	dq_atmos_test_publish_rust_pipenets(list(P))
	TEST_ASSERT_NOTNULL(P.return_network(P), "the actual pipe has a Rust-backed compatibility network")
	H.add_ventcrawl(P)
	TEST_ASSERT(H.is_ventcrawling, "actual network admission enables ventcrawl mode")
	TEST_ASSERT_NOTNULL(P.pipe_image, "the actual network traversal constructed its real pipe image")
	TEST_ASSERT(P.pipe_image in H.pipes_shown, "the native compatibility network contributes its actual image identity")
	var/count = length(H.pipes_shown)
	TEST_ASSERT(count > 0, "the real image traversal must produce at least one entry")
	H.add_ventcrawl(P)
	TEST_ASSERT_EQUAL(length(H.pipes_shown), count * 2, "lazy append preserves the old duplicate-occurrence semantics")
	TEST_ASSERT_NULL(peer.pipes_shown, "the real peer has no shared image-list allocation")
	H.remove_ventcrawl()
	TEST_ASSERT(!H.is_ventcrawling, "actual exit disables ventcrawl mode")
	TEST_ASSERT_NULL(H.pipes_shown, "actual exit releases the last local list, without deleting pipe-owned images")
	TEST_ASSERT_NOTNULL(P.pipe_image, "removing a viewer never destroys the actual pipe's image")
	H.remove_ventcrawl()
	TEST_ASSERT_NULL(H.pipes_shown, "repeated actual exit remains safe")

/datum/unit_test/dq_lazy_open_uis_bulk_transfer
/datum/unit_test/dq_lazy_open_uis_bulk_transfer/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/mob/living/carbon/human/source = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/peer = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT(!SStgui.on_transfer(source, target), "the actual bulk transfer safely refuses an initially empty source")
	var/obj/item/first_host = allocate(/obj/item, test_floor())
	var/obj/item/second_host = allocate(/obj/item, test_floor())
	var/datum/tgui/first = allocate(/datum/tgui, source, first_host, "LazyFirst")
	var/datum/tgui/second = allocate(/datum/tgui, source, second_host, "LazySecond")
	first.set_state(GLOB.tgui_always_state)
	second.set_state(GLOB.tgui_always_state)
	SStgui.on_open(first)
	SStgui.on_open(second)
	TEST_ASSERT_EQUAL(length(source.tgui_open_uis), 2, "the real old user's list has both distinct actual windows")
	TEST_ASSERT((first in source.tgui_open_uis) && (second in source.tgui_open_uis), "the pre-transfer source contains both exact identities")
	TEST_ASSERT_NULL(target.tgui_open_uis, "the target has no unrelated open-list allocation")
	TEST_ASSERT(SStgui.on_transfer(source, target), "the real bulk path transfers a nonempty source")
	TEST_ASSERT_EQUAL(first.user, target, "bulk iteration transfers the first actual UI")
	TEST_ASSERT_EQUAL(second.user, target, "in-loop removals must not skip the second actual UI")
	TEST_ASSERT_NULL(source.tgui_open_uis, "the real terminal bulk clear releases the source list")
	TEST_ASSERT_EQUAL(length(target.tgui_open_uis), 2, "the new user has exactly the two actual transferred UIs")
	TEST_ASSERT((first in target.tgui_open_uis) && (second in target.tgui_open_uis), "bulk transfer preserves both exact window identities")
	TEST_ASSERT_NULL(peer.tgui_open_uis, "a third real mob never shares either registry")
	first.close(can_be_suspended = FALSE)
	TEST_ASSERT_EQUAL(length(target.tgui_open_uis), 1, "closing the first actual UI retains only its live peer")
	TEST_ASSERT(second in target.tgui_open_uis, "the remaining exact UI stays registered")
	second.close(can_be_suspended = FALSE)
	TEST_ASSERT_NULL(target.tgui_open_uis, "closing both actual UIs releases the target roster")
	TEST_ASSERT_NULL(source.tgui_open_uis, "later native UI teardown does not recreate the old empty roster")
	TEST_ASSERT_NULL(peer.tgui_open_uis, "closing transferred UIs never changes a third mob")
	TEST_ASSERT(!(first in SStgui.all_uis) && !(second in SStgui.all_uis), "both real system registrations are closed")
	test_driver_end()
