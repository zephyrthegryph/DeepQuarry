// Concrete device inputs retain their distinct credential and tool protocols.
/datum/unit_test/dq_silicon/device_credentials
/datum/unit_test/dq_silicon/device_credentials/run_gate()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = make_human(T)
	var/mob/living/silicon/robot/R = make_borg(T)
	var/mob/living/silicon/ai/AI = make_ai(T)
	var/obj/item/card/id/held = allocate(/obj/item/card/id, T)
	H.put_in_active_hand(held)
	TEST_ASSERT_NULL(H.airlock_programming_card(), "A held human card is not the original worn programming credential")
	var/obj/item/clothing/under/uniform = allocate(/obj/item/clothing/under, T)
	TEST_ASSERT(H.equip_to_slot(uniform, SLOT_ID_UNIFORM), "The real uniform supports a worn ID")
	var/obj/item/card/id/worn = allocate(/obj/item/card/id, T)
	TEST_ASSERT(H.equip_to_slot(worn, SLOT_ID_ID), "The real ID is worn")
	TEST_ASSERT_EQUAL(H.airlock_programming_card(), worn, "Programming chooses the worn ID despite a held card")
	TEST_ASSERT_NOTNULL(R.idcard, "The real robot constructor creates its internal credential")
	var/obj/item/implant/restrainingbolt/bolt = allocate(/obj/item/implant/restrainingbolt, R)
	rel_set(R, nameof(R.bolt), bolt)
	TEST_ASSERT_NULL(R.GetIdCard(), "A functional bolt masks the robot's ordinary card provider")
	TEST_ASSERT_EQUAL(R.airlock_programming_card(), R.idcard, "Programming preserves the original internal-card behavior even with a bolt")
	TEST_ASSERT_NOTNULL(AI.idcard, "The real AI constructor creates its internal credential")
	TEST_ASSERT_EQUAL(AI.airlock_programming_card(), AI.idcard, "AI programming uses its actual internal credential")
	TEST_ASSERT_NULL(H.GetPicture(), "Humans do not acquire the silicon stored-camera selector")
	TEST_ASSERT_EQUAL(R.news_byline(), "[R.name] ([R.job])", "The actual chassis identity supplies the news byline")

/datum/unit_test/dq_silicon/device_multitool
/datum/unit_test/dq_silicon/device_multitool/run_gate()
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = make_human(T)
	var/mob/living/silicon/robot/R = make_borg(T)
	var/mob/living/silicon/ai/AI = make_ai(T)
	var/obj/machinery/telecomms/receiver/machine = allocate(/obj/machinery/telecomms/receiver, T)
	var/obj/item/multitool/tool = allocate(/obj/item/multitool, T)
	H.put_in_active_hand(tool)
	TEST_ASSERT_EQUAL(H.multitool_for_machine(machine), tool, "A person supplies the actual held multitool")
	TEST_ASSERT_NOTNULL(AI.aiMulti, "The real AI owns a multitool")
	TEST_ASSERT_EQUAL(AI.multitool_for_machine(machine), AI.aiMulti, "An AI supplies its actual internal multitool")
	if(!R.module)
		rel_set(R, nameof(R.module), new /obj/item/robot_module/robot/standard(R))
	var/obj/item/multitool/module_tool = allocate(/obj/item/multitool, R.module)
	rel_add(R.module, nameof(R.module.modules), module_tool)
	R.activate_module(module_tool)
	R.select_module(R.module_slot_of(module_tool))
	TEST_ASSERT_EQUAL(R.multitool_for_machine(machine), module_tool, "An adjacent borg supplies its actual selected tool")
	R.forceMove(get_step(get_step(T, NORTH), NORTH))
	TEST_ASSERT_NULL(R.multitool_for_machine(machine), "A distant borg retains the original one-tile tool limit")
	TEST_ASSERT_EQUAL(AI.multitool_for_machine(machine), AI.aiMulti, "The AI's internal tool is independent of the borg's distance")
