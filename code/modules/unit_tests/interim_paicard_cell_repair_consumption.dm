/// Actual timed pAI cell repair consumes its original part only at completion.
/datum/unit_test/om/interim_paicard_cell_repair_consumption/run_om(list/made)
	var/turf/T = test_floor()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, T)
	var/obj/item/paicard/device = allocate(/obj/item/paicard, T)
	var/obj/item/paiparts/cell/part = allocate(/obj/item/paiparts/cell, T)
	made += list(user, device, part)
	TEST_ASSERT_EQUAL(device.cell, PP_FUNCTIONAL, "actual pAI card initializes with functional power hardware")
	device.cell = PP_MISSING
	device.panel_open = TRUE
	TEST_ASSERT(user.put_in_active_hand(part), "the actor holds exact original replacement power part")
	TEST_ASSERT(!user.incapacitated(INCAPACITATION_STUNNED | INCAPACITATION_KNOCKOUT), "actual repair actor starts capable")
	perform_op(user, device, "install_cell", part, ORIGIN_CLICK, AUTH_PHYSICAL)
	TEST_ASSERT(test_actor_busy(user), "actual repair entry schedules the real timed task")
	TEST_ASSERT_EQUAL(device.cell, PP_MISSING, "starting repair grants no early functional hardware")
	TEST_ASSERT_EQUAL(user.get_active_hand(), part, "pending repair retains exact original hand")
	scheduler_advance((2 SECONDS) / (1 SECOND))
	TEST_ASSERT_EQUAL(device.cell, PP_MISSING, "actual repair retains missing hardware before its deadline")
	TEST_ASSERT(!QDELETED(part), "actual repair consumes no original part before its deadline")
	scheduler_advance((2 SECONDS) / (1 SECOND))
	TEST_ASSERT(!user.incapacitated(INCAPACITATION_STUNNED | INCAPACITATION_KNOCKOUT), "actual repair actor remains capable at completion")
	TEST_ASSERT(!test_actor_busy(user), "actual repair completes its pending task")
	TEST_ASSERT_EQUAL(device.cell, PP_FUNCTIONAL, "successful actual consumption restores functional power hardware")
	TEST_ASSERT(QDELETED(part), "successful timed repair consumes exact original power part")
	TEST_ASSERT_NULL(user.get_active_hand(), "successful timed consumption clears actual source hand")
