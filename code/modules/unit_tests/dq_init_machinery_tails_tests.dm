// Standalone diagnostics scope: this lane does not depend on the objects lane fixtures.
/datum/unit_test/proc/dq_init_machinery_fixture_scope()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)

// Verified whole-chain tail effects; these tests do not move setup into early cap hooks.
/datum/unit_test/dq_init_machinery_tails
/datum/unit_test/dq_init_machinery_tails/Run()
	dq_init_machinery_fixture_scope()
	var/obj/machinery/cell_charger/C = allocate(/obj/machinery/cell_charger, test_floor())
	TEST_ASSERT(C.efficiency > 0, "cell charger parent initialized its real capacitors")
	TEST_ASSERT_EQUAL(C.use_power, C.usable() ? USE_POWER_IDLE : USE_POWER_OFF, "cell charger constructor settles actual empty power state")
	var/obj/machinery/recharger/R = allocate(/obj/machinery/recharger, test_floor())
	TEST_ASSERT_EQUAL(R.charge_phase, RECHARGER_IDLE, "empty recharger's constructor sets idle charge phase")
	TEST_ASSERT_EQUAL(R.use_power, R.usable() ? USE_POWER_IDLE : USE_POWER_OFF, "device recharger settles real final power state")
	var/obj/machinery/recharger/wallcharger/W = allocate(/obj/machinery/recharger/wallcharger, test_floor())
	TEST_ASSERT_EQUAL(W.charge_phase, RECHARGER_IDLE, "wall subtype inherits constructor settlement")
	TEST_ASSERT_EQUAL(W.use_power, W.usable() ? USE_POWER_IDLE : USE_POWER_OFF, "wall subtype settles with own circuit/power defaults")

	// Map queue lets real map state exist before the real initializer/watch baseline.
	// Neither OFF assertion matches the root type's IDLE default; no helper is overridden.
	SSatoms.map_loader_begin("dq_init_charger_off")
	var/obj/machinery/cell_charger/unbolted_cell = new(test_floor())
	var/obj/machinery/recharger/unbolted_device = new(test_floor())
	unbolted_cell.set_anchored(FALSE)
	unbolted_device.set_anchored(FALSE)
	unbolted_cell.set_use_power(USE_POWER_ACTIVE)
	unbolted_device.set_use_power(USE_POWER_ACTIVE)
	unbolted_device.set_charge_phase(RECHARGER_CHARGED)
	SSatoms.map_loader_stop("dq_init_charger_off")
	own(unbolted_cell)
	own(unbolted_device)
	TEST_ASSERT_EQUAL(unbolted_cell.use_power, USE_POWER_ACTIVE, "queued map state has not already run charger settlement")
	TEST_ASSERT_EQUAL(unbolted_device.use_power, USE_POWER_ACTIVE, "queued map state has not already run device settlement")
	TEST_ASSERT_EQUAL(unbolted_device.charge_phase, RECHARGER_CHARGED, "queued device has deliberately nondefault displayed phase")
	SSatoms.InitializeAtoms(list(unbolted_cell, unbolted_device))
	TEST_ASSERT(!unbolted_cell.usable() && !unbolted_device.usable(), "real unbolted machines cannot work regardless of area power")
	TEST_ASSERT_EQUAL(unbolted_cell.use_power, USE_POWER_OFF, "constructor normalizes mapped active cell charger to OFF while unbolted")
	TEST_ASSERT_EQUAL(unbolted_device.use_power, USE_POWER_OFF, "constructor normalizes mapped active device charger to OFF while unbolted")
	TEST_ASSERT_EQUAL(unbolted_device.charge_phase, RECHARGER_IDLE, "constructor replaces mapped CHARGED display with idle on unusable charger")

/datum/unit_test/dq_init_machinery_tails/parts_arcade
/datum/unit_test/dq_init_machinery_tails/parts_arcade/Run()
	dq_init_machinery_fixture_scope()
	var/obj/machinery/partslathe/L = allocate(/obj/machinery/partslathe, test_floor())
	var/obj/machinery/partslathe/peer = allocate(/obj/machinery/partslathe, test_floor())
	TEST_ASSERT(length(L.partslathe_recipies) > 0, "actual first constructor builds real recipes")
	TEST_ASSERT_EQUAL(L.partslathe_recipies, peer.partslathe_recipies, "later constructor reuses process-owned immutable recipe catalog")
	var/datum/category_item/partslathe/recipe = L.partslathe_recipies[/obj/item/stock_parts/capacitor]
	TEST_ASSERT(recipe && recipe.path == /obj/item/stock_parts/capacitor, "actual tech-one capacitor recipe exists")
	var/obj/item/stock_parts/capacitor/part = allocate(/obj/item/stock_parts/capacitor, test_floor())
	var/list/matter = part.material_totals()
	TEST_ASSERT(length(matter), "actual source capacitor has material resources")
	for(var/material in matter)
		TEST_ASSERT_EQUAL(recipe.resources[material], matter[material] * 1.25, "recipe preserves original real material multiplier")
	var/obj/machinery/computer/arcade/battle/A = allocate(/obj/machinery/computer/arcade/battle, test_floor())
	TEST_ASSERT(A.name != initial(A.name), "actual constructor rolls game title")
	TEST_ASSERT(A.enemy_name != initial(A.enemy_name), "actual constructor rolls enemy name")
	TEST_ASSERT(findtext(A.name, A.enemy_name) > 0, "real enemy and game title derive from same three ordered picks")

/datum/unit_test/dq_init_machinery_tails/pdas
/datum/unit_test/dq_init_machinery_tails/pdas/Run()
	dq_init_machinery_fixture_scope()
	var/obj/machinery/pda_multicaster/M = allocate(/obj/machinery/pda_multicaster, test_floor())
	var/count = 0
	for(var/obj/item/pda/P in contents_of(M))
		count++
		var/datum/data/pda/app/messenger/messenger = P.find_program(/datum/data/pda/app/messenger/multicast)
		TEST_ASSERT(messenger, "every real starting PDA has actual multicast messenger")
		TEST_ASSERT_EQUAL(messenger.toff, !M.on, "constructor reconciles real child PDA with parent state")
	TEST_ASSERT_EQUAL(count, 8, "tail sees all eight declared occupants after materializing them")
	TEST_ASSERT_EQUAL(!!M.on, !!M.operable(), "actual enabled multicaster follows its final power status")
	TEST_ASSERT(M.soundloop, "real owned sound factory ran before settlement")
	TEST_ASSERT_EQUAL(!!M.soundloop.started, !!M.on, "actual sound starts/stops with initialized parent")
	TEST_ASSERT_EQUAL(power_of(M).idle, M.on ? 750 : 0, "actual constructor adjusts domain power demand")

/datum/unit_test/dq_init_machinery_tails/cloning_and_cryo
/datum/unit_test/dq_init_machinery_tails/cloning_and_cryo/Run()
	dq_init_machinery_fixture_scope()
	var/turf/T = test_floor()
	var/obj/machinery/dna_scannernew/scanner = allocate(/obj/machinery/dna_scannernew, get_step(T, NORTH))
	var/obj/machinery/clonepod/pod = allocate(/obj/machinery/clonepod, get_step(T, EAST))
	var/obj/machinery/computer/cloning/C = allocate(/obj/machinery/computer/cloning, T)
	TEST_ASSERT_EQUAL(C.scantemp["text"], "Scanner ready.", "actual console initializes ready text before module discovery")
	TEST_ASSERT_EQUAL(C.scantemp["color"], "good", "actual console initializes ready color")
	TEST_ASSERT_EQUAL(C.scanner(), scanner, "actual adjacent-north scanner wins discovery")
	TEST_ASSERT(pod in C.pods, "actual available pod is linked")
	TEST_ASSERT(C.selected_pod() in C.pods, "actual discovery selects one of its real linked pods")
	qdel(scanner)
	TEST_ASSERT_NULL(C.scanner(), "real scanner lifetime releases borrowed view")
	SSatoms.map_loader_begin("dq_init_cryo_facing")
	var/obj/machinery/atmospherics/unary/cryo_cell/M = new(get_step(T, SOUTH))
	M.set_dir(WEST)
	SSatoms.map_loader_stop("dq_init_cryo_facing")
	own(M)
	SSatoms.InitializeAtoms(list(M))
	TEST_ASSERT_EQUAL(M.initialize_directions, WEST, "mapped final facing is captured after real parent init")
	var/obj/machinery/atmospherics/unary/cryo_cell/R = allocate(/obj/machinery/atmospherics/unary/cryo_cell, get_step(T, SOUTH), EAST)
	TEST_ASSERT_EQUAL(R.dir, EAST, "actual machine constructor consumes keepFALSE facing parameter")
	TEST_ASSERT_EQUAL(R.initialize_directions, EAST, "tail captures resulting direction, not discarded transport param")

/datum/unit_test/dq_init_machinery_tails/floodlight
/datum/unit_test/dq_init_machinery_tails/floodlight/Run()
	dq_init_machinery_fixture_scope()
	var/obj/machinery/floodlight/starts_on/F = allocate(/obj/machinery/floodlight/starts_on, test_floor())
	TEST_ASSERT(F.cell && F.cell.charge >= F.use * CELLRATE, "real declared charged cell exists before startup")
	TEST_ASSERT(F.on, "actual starts-on constructor starts charged light")
	TEST_ASSERT_EQUAL(glow_of(F).range, F.brightness_on, "actual turn_on applies its light range")
	SSatoms.map_loader_begin("dq_init_flood_depleted")
	var/obj/machinery/floodlight/starts_on/empty = new(test_floor())
	var/obj/item/cell/cell = new(empty)
	cell.set_charge(0)
	rel_set(empty, nameof(empty.cell), cell)
	SSatoms.map_loader_stop("dq_init_flood_depleted")
	own(empty)
	SSatoms.InitializeAtoms(list(cell, empty))
	TEST_ASSERT_EQUAL(empty.cell, cell, "actual initializer preserves explicitly supplied owned cell")
	TEST_ASSERT(!empty.on, "same startup transaction refuses real depleted cell")

/datum/unit_test/dq_init_machinery_tails/alarm_registration
/datum/unit_test/dq_init_machinery_tails/alarm_registration/Run()
	dq_init_machinery_fixture_scope()
	var/obj/machinery/computer/station_alert/C = allocate(/obj/machinery/computer/station_alert, test_floor())
	TEST_ASSERT(istype(C.alarm_monitor, /datum/tgui_module/alarm_monitor/engineering), "real root monitor is engineering")
	var/list/handlers = C.alarm_monitor.alarm_handlers()
	TEST_ASSERT(length(handlers), "actual owned monitor has handlers")
	for(var/datum/alarm_handler/H as anything in handlers)
		TEST_ASSERT_EQUAL(H.listeners[C], TYPE_PROC_REF(/obj/machinery/computer/station_alert, update_console_icon), "constructor registered real console callback on every real handler")
	var/datum/tgui_module/alarm_monitor/monitor = C.alarm_monitor
	qdel(C)
	for(var/datum/alarm_handler/H as anything in handlers)
		TEST_ASSERT(!(C in H.listeners), "real destruction unregisters actual console without clearing shared handler")
	TEST_ASSERT(QDELETED(monitor), "console owns and deletes its actual monitor")

/datum/unit_test/dq_init_machinery_tails/proc/restore_news_serial(obj/machinery/newscaster/C, saved)
	// end_test_world runs deferred cleanups BEFORE deleting allocated things.
	// A/B are never deleted by this fixture; fail loudly rather than skip a static restore.
	if(QDELETED(C))
		CRASH("newscaster serial restoration anchor deleted before deferred cleanup")
	C.unit_no_cur = saved
/datum/unit_test/dq_init_machinery_tails/news_serial
/datum/unit_test/dq_init_machinery_tails/news_serial/Run()
	dq_init_machinery_fixture_scope()
	SSatoms.map_loader_begin("dq_init_news_serial")
	var/obj/machinery/newscaster/A = new(test_floor())
	var/obj/machinery/newscaster/B = new(test_floor())
	var/before = A.unit_no_cur
	SSatoms.map_loader_stop("dq_init_news_serial")
	own(A)
	own(B)
	defer_cleanup(src, PROC_REF(restore_news_serial), A, before)
	SSatoms.InitializeAtoms(list(A, B))
	TEST_ASSERT_EQUAL(A.unit_no, before + 1, "first actual queued constructor allocates next serial")
	TEST_ASSERT_EQUAL(B.unit_no, before + 2, "second queued constructor allocates following unique serial")
	TEST_ASSERT_EQUAL(A.ui_title(null), "Newscaster Unit #[A.unit_no]", "actual public title observes stable initial serial")
	TEST_ASSERT_EQUAL(A.unit_no, before + 1, "title read does not allocate another serial")
