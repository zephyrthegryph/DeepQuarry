/datum/unit_test/interim_machine_frame_board_and_wiring/Run()
	var/mob/living/carbon/human/actor = allocate(/mob/living/carbon/human)
	var/obj/structure/frame/frame = allocate(/obj/structure/frame)
	var/obj/item/circuitboard/autolathe/board = allocate(/obj/item/circuitboard/autolathe)
	var/obj/item/stack/cable_coil/cable = allocate(/obj/item/stack/cable_coil, run_loc_floor_bottom_left, 6)
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/anchor), "Frame anchoring failed")
	TEST_ASSERT(frame.anchored && frame.state == FRAME_PLACED, "Anchoring must leave an empty placed frame")
	TEST_ASSERT_EQUAL(frame.accepts_board(actor, frame, board), TRUE, "Machine frame must accept an autolathe board")
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/insert_board, board), "Board insertion failed")
	TEST_ASSERT_EQUAL(frame.state, FRAME_UNFASTENED, "Inserted board must initially be unfastened")
	TEST_ASSERT_EQUAL(frame.circuit, board, "Frame did not retain its inserted board")
	TEST_ASSERT_EQUAL(board.loc, frame, "Inserted board must reside inside the frame")
	TEST_ASSERT(frame.req_components[/obj/item/stock_parts/matter_bin] > 0, "Inserted board did not populate real component requirements")
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/fasten_board), "Board fastening failed")
	TEST_ASSERT_EQUAL(frame.state, FRAME_FASTENED, "Fastening must advance the frame state")
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/wire, cable), "Wiring failed")
	TEST_ASSERT_EQUAL(frame.state, FRAME_WIRED, "Wiring must advance the frame state")
	TEST_ASSERT_EQUAL(cable.get_amount(), 1, "Wiring must consume exactly five cable lengths")
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/unwire), "Unwiring failed")
	own_turf_contents(get_turf(frame))
	TEST_ASSERT_EQUAL(frame.state, FRAME_FASTENED, "Unwiring must return to a fastened board")
	var/returned_cable = 0
	for(var/obj/item/stack/cable_coil/returned as anything in turf_contents_of_type(get_turf(frame), /obj/item/stack/cable_coil))
		returned_cable += returned.get_amount()
	TEST_ASSERT_EQUAL(returned_cable, 6, "Unwiring must return the five consumed lengths alongside the remaining one")
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/unfasten_board), "Board unfastening failed")
	TEST_ASSERT(interim_construction_step(frame, actor, /datum/interaction/construction/frame/remove_board), "Board removal failed")
	TEST_ASSERT_EQUAL(frame.state, FRAME_PLACED, "Removing the board must leave a placed frame")
	TEST_ASSERT_NULL(frame.circuit, "Board removal must clear the owned circuit reference")
	TEST_ASSERT_EQUAL(board.loc, get_turf(frame), "Removed board must return to the floor")
	TEST_ASSERT_NULL(frame.req_components, "Removing the board must clear its component requirements")

