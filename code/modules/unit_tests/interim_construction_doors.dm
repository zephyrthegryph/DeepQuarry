/// Drive completed construction steps directly: no tool delay or scheduler timing is involved.
/datum/unit_test/proc/interim_construction_step(atom/target, mob/actor, edge_type, obj/item/held)
	var/datum/construction_graph/graph = construction_graph_of(target)
	if(!graph)
		return FALSE
	for(var/datum/interaction/construction/edge as anything in graph.edges_for(target))
		if(edge.type == edge_type)
			return edge.traverse(target, actor, held)
	return FALSE

/datum/unit_test/interim_airlock_mechanical_gates/Run()
	var/obj/machinery/door/airlock/door = allocate(/obj/machinery/door/airlock)
	TEST_ASSERT(door.density, "Airlock must start closed")
	TEST_ASSERT(door.can_open(TRUE), "An unlocked closed airlock must permit forced opening")
	TEST_ASSERT(!door.can_close(TRUE), "A closed airlock cannot close again")
	set_bolted(door, TRUE, TRUE)
	TEST_ASSERT(is_bolted(door), "Dropping the bolts did not change their state")
	TEST_ASSERT(!door.can_open(TRUE), "Forced opening must respect bolts")
	set_bolted(door, FALSE, TRUE)
	TEST_ASSERT(!is_bolted(door), "Forced unbolting did not raise the bolts")
	set_welded(door, TRUE)
	TEST_ASSERT(is_welded(door), "Welding did not change the airlock state")
	TEST_ASSERT(!door.can_open(TRUE), "Forced opening must respect welding")
	set_welded(door, FALSE)
	TEST_ASSERT(door.can_open(TRUE), "Removing both mechanical restrictions must allow opening")
	door.set_density(FALSE)
	TEST_ASSERT(!door.can_open(TRUE), "An open airlock cannot open again")
	TEST_ASSERT(door.can_close(TRUE), "An open unrestricted airlock must permit forced closing")
	set_bolted(door, TRUE, TRUE)
	TEST_ASSERT(!door.can_close(TRUE), "Bolts must prevent closing an open airlock")
	set_bolted(door, FALSE, TRUE)
	set_welded(door, TRUE)
	TEST_ASSERT(!door.can_close(TRUE), "Welding must prevent closing an open airlock")

