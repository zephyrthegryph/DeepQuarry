// Constructor-time node admission uses the actual co-located weeds and native map queue.
/datum/unit_test/dq_init_alien_node_preparation
/datum/unit_test/dq_init_alien_node_preparation/Run()
	dq_init_objects_fixture_scope()
	var/turf/T = test_floor()
	var/obj/effect/alien/weeds/old = allocate(/obj/effect/alien/weeds, T)
	var/obj/effect/alien/weeds/node/N = allocate(/obj/effect/alien/weeds/node, T)
	TEST_ASSERT(QDELETED(old), "Node admission removes an already initialized real weed")
	TEST_ASSERT_EQUAL(N.linked_node(), N, "A real node links to itself before its first neighbour-overlay preparation")
	var/obj/effect/alien/weeds/node/second = allocate(/obj/effect/alien/weeds/node, T)
	TEST_ASSERT(QDELETED(N), "A later runtime node replaces the actual previous node")
	TEST_ASSERT_EQUAL(second.linked_node(), second, "The surviving node owns its own spread origin")
	var/turf/U = get_step(T, EAST)
	SSatoms.map_loader_begin(src)
	var/obj/effect/alien/weeds/queued = new /obj/effect/alien/weeds(U)
	var/obj/effect/alien/weeds/node/mapped = new /obj/effect/alien/weeds/node(U)
	SSatoms.map_loader_stop(src)
	own(queued)
	own(mapped)
	SSatoms.InitializeAtoms(list(mapped, queued))
	TEST_ASSERT(QDELETED(queued), "An uninitialized co-located map weed is marked then discarded by its native keeps_if")
	TEST_ASSERT(!QDELETED(mapped), "The actual mapped node survives admission")
	TEST_ASSERT_EQUAL(mapped.linked_node(), mapped, "Map admission preserves the same self-link")
