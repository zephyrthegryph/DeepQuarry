// Real mapped-neighbour topology is linked before the existing after_init pairing callback.
/datum/unit_test/dq_init_portal_line_setup
/datum/unit_test/dq_init_portal_line_setup/Run()
	dq_init_objects_fixture_scope()
	var/turf/T = test_floor()
	var/turf/other = get_step(get_step(get_step(T, NORTH), NORTH), NORTH)
	TEST_ASSERT(other, "the mapped portal fixture has a real counterpart site")
	defer_cleanup(SSatoms, TYPE_PROC_REF(/datum/system/atoms, map_loader_stop), "dq_portal_line_setup")
	SSatoms.map_loader_begin("dq_portal_line_setup")
	var/obj/effect/map_effect/portal/line/L = new(get_step(T, EAST))
	own(L)
	var/obj/effect/map_effect/portal/line/R = new(get_step(T, WEST))
	own(R)
	var/obj/effect/map_effect/portal/line/other_left = new(get_step(other, EAST))
	own(other_left)
	var/obj/effect/map_effect/portal/line/other_right = new(get_step(other, WEST))
	own(other_right)
	var/obj/effect/map_effect/portal/master/side_a/M = new(T)
	own(M)
	var/obj/effect/map_effect/portal/master/side_b/paired = new(other)
	own(paired)
	SSatoms.map_loader_stop("dq_portal_line_setup")
	TEST_ASSERT(vars_write(M, "portal_id", "dq_init_portal_line_setup"), "first mapped portal gets the fixture ID before initialization")
	TEST_ASSERT(vars_write(paired, "portal_id", "dq_init_portal_line_setup"), "counterpart gets the same fixture ID before initialization")
	SSatoms.InitializeAtoms(list(L, R, other_left, other_right, M, paired))
	TEST_ASSERT_EQUAL(M.counterpart, paired, "existing after_init pairing sees both real mapped masters")
	TEST_ASSERT_EQUAL(L.my_master, M, "The real contiguous east line links during construction")
	TEST_ASSERT_EQUAL(R.my_master, M, "The real contiguous west line links during construction")
	TEST_ASSERT_EQUAL(length(M.portal_lines), 2, "Both actual lines join the master's inverse relation exactly once")
	qdel(M)
	TEST_ASSERT(!QDELETED(L) && !QDELETED(R), "Mapped lines remain borrowed, not owned by the master")
	TEST_ASSERT_NULL(L.my_master, "Master deletion clears the actual inverse endpoint")
