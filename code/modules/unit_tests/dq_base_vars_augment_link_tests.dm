/datum/unit_test/dq_base_vars_augment_link

/datum/unit_test/dq_base_vars_augment_link/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/organ/internal/augment/armmounted/shoulder/multiple/A = allocate(/obj/item/organ/internal/augment/armmounted/shoulder/multiple, test_floor())
	var/list/tools = A.all_integrated_tools()
	TEST_ASSERT(length(tools) >= 2, "the actual rotary implant constructs real integrated tools")
	var/obj/item/I = tools[1]
	var/obj/item/other = tools[2]
	for(var/obj/item/tool as anything in tools)
		TEST_ASSERT_EQUAL(item_my_augment(tool), A, "every actual integrated tool retains its exact organ")
		TEST_ASSERT(tool in link_list(A, LK_AUGMENT_ITEMS), "the real reciprocal sparse endpoint lists each configured tool")
		TEST_ASSERT_EQUAL(owner_of(tool), A, "borrowed endpoint declaration does not replace real tool ownership")
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT(H.equip_augment_item(SLOT_ID_HAND_L, I, FALSE, A), "the real augment deployment transaction accepts its actual tool")
	TEST_ASSERT_EQUAL(H.get_equipped_item(SLOT_ID_HAND_L), I, "actual deployment puts the exact tool in the human hand")
	H.drop_from_inventory(I)
	TEST_ASSERT_EQUAL(I.loc, A, "the real inventory drop path returns the tool to its exact organ")
	TEST_ASSERT_EQUAL(owner_of(I), A, "deployment and return preserve the original tool owner")
	qdel(other)
	TEST_ASSERT(!(other in link_list(A, LK_AUGMENT_ITEMS)), "tool deletion clears the organ's reciprocal endpoint")
	qdel(A)
	TEST_ASSERT(QDELETED(I), "deleting the implant still deletes its truly owned tools")

/datum/unit_test/dq_base_vars_augment_link/borrowed_replacement

/datum/unit_test/dq_base_vars_augment_link/borrowed_replacement/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/organ/internal/augment/A = allocate(/obj/item/organ/internal/augment, test_floor())
	var/obj/item/organ/internal/augment/B = allocate(/obj/item/organ/internal/augment, test_floor())
	var/obj/item/tool/crowbar/I = allocate(/obj/item/tool/crowbar, test_floor())
	var/datum/original_owner = owner_of(I)
	TEST_ASSERT(H.equip_augment_item(SLOT_ID_HAND_L, I, FALSE, A), "the real deployment API links an independently owned tool")
	H.drop_from_inventory(I)
	TEST_ASSERT_EQUAL(I.loc, A, "the independently owned tool follows its actual drop-return link")
	TEST_ASSERT_EQUAL(owner_of(I), original_owner, "return association does not adopt an unrelated item")
	I.forceMove(test_floor())
	TEST_ASSERT(H.equip_augment_item(SLOT_ID_HAND_L, I, FALSE, B), "the real API replaces the former return association")
	TEST_ASSERT_EQUAL(item_my_augment(I), B, "replacement selects the new exact organ")
	TEST_ASSERT(!(I in link_list(A, LK_AUGMENT_ITEMS)) && (I in link_list(B, LK_AUGMENT_ITEMS)), "replacement clears only the former reciprocal endpoint")
	H.drop_from_inventory(I)
	I.forceMove(test_floor())
	qdel(B)
	TEST_ASSERT_NULL(item_my_augment(I), "organ deletion clears the borrowed return view")
	TEST_ASSERT(!QDELETED(I) && owner_of(I) == original_owner, "borrowed association never deletes or re-owns the external tool")
	TEST_ASSERT(!QDELETED(A), "replacement never deletes the former organ")
