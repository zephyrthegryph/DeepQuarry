// Shared configuration preserves real damage sinks and map/admin overrides.
/datum/unit_test/dq_base_vars_damage

/datum/unit_test/dq_base_vars_damage/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/structure/grille/A = allocate(/obj/structure/grille)
	var/obj/structure/grille/B = allocate(/obj/structure/grille)
	TEST_ASSERT_EQUAL(damage_profile_of(A), damage_profile_of(B), "untouched objects share immutable damage configuration")
	TEST_ASSERT_EQUAL(damage_profile_of_type(/obj/structure/window).wear, "cracks", "windows retain their declared damage description")
	TEST_ASSERT(damage_profile_of_type(/obj/structure/window).announce, "windows retain damage-band announcements")
	TEST_ASSERT(damage_profile_of_type(/obj/machinery/door).announce, "doors retain damage-band announcements")
	TEST_ASSERT_EQUAL(damage_profile_of_type(/obj/machinery/shipsensors).ionic, 0.2, "ship sensors retain their fractional EMP susceptibility")
	TEST_ASSERT_EQUAL(damage_profile_of_type(/obj/machinery/shield).ionic, 2, "shield tiles retain their double EMP susceptibility")
	TEST_ASSERT_EQUAL(damage_profile_of_type(/obj/machinery/shieldgen).ionic, 1, "shield projectors retain their EMP susceptibility")
	TEST_ASSERT(vars_write(A, "damage_wear", "scratches"), "the historical map variable targets the native profile")
	TEST_ASSERT_EQUAL(A.damage_flavour_text(DAMAGE_BAND_LIGHT), span_notice("It has a few scratches."), "the real examine text reads the per-holder override")
	TEST_ASSERT_EQUAL(damage_profile_of(B).wear, "scrapes and dents", "editing one holder does not mutate another")
	TEST_ASSERT(vars_write(A, "emp_integrity_factor", 0.5), "the historical EMP map variable remains accepted")
	var/a_start = A.get_integrity()
	var/b_start = B.get_integrity()
	var/datum/damage_packet/packet = damage_packet(flags = DAMAGE_PACKET_SILENT | DAMAGE_PACKET_UNARMORED)
	packet.add(DAMAGE_IONIC, 4)
	A.receive_damage(packet)
	B.receive_damage(packet)
	packet.release()
	TEST_ASSERT_EQUAL(A.get_integrity(), a_start - 2, "the real ionic sink applies the holder's fractional susceptibility")
	TEST_ASSERT_EQUAL(B.get_integrity(), b_start, "the default object's zero susceptibility still ignores ionic integrity damage")
	TEST_ASSERT(A.vv_edit_var("@damage_profile.ionic", 0), "admin editing the native trait accepts an explicit zero")
	TEST_ASSERT_EQUAL(damage_profile_of(A).ionic, 0, "zero overrides the previous fractional value")
	TEST_ASSERT_EQUAL(damage_profile_of_type(A.type).ionic, 0, "holder edits leave the type's original damage policy unchanged")
