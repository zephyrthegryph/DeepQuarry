// Observe the real native-roll and actual owns_one factory phases, not a mirrored decision.
/mob/living/simple_mob/mechanical/mecha/dq_voice_recipe_probe
	var/recipe_before_parent
	var/table_after_parent
/mob/living/simple_mob/mechanical/mecha/dq_voice_recipe_probe/Initialize(mapload)
	recipe_before_parent = voice_config_of(src).say_list_type
	. = ..()
	table_after_parent = say_list?.type

/datum/unit_test/dq_voice_recipe_home
/datum/unit_test/dq_voice_recipe_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/A = allocate(/mob/living/simple_mob, test_floor())
	var/mob/living/simple_mob/B = allocate(/mob/living/simple_mob, test_floor())
	TEST_ASSERT(!("say_list_type" in A.vars), "recipe is native voice configuration, not a physical shadow")
	TEST_ASSERT_EQUAL(voice_config_of_type(A.type).say_list_type, /datum/say_list, "compiled default recipe remains the empty base table")
	TEST_ASSERT_NULL(A.say_list, "default recipe still allocates no table")
	for(var/value in list(null, 0, /datum/say_list))
		TEST_ASSERT(vars_write(A, "say_list_type", value), "historical alias preserves empty recipe forms")
		TEST_ASSERT_EQUAL(voice_config_of(A).say_list_type, value, "no null/zero/type coercion")
		TEST_ASSERT_NULL(A.make_say_list(null), "actual existing starts callback still skips empty/base recipe")
	A.set_say_list_type(/datum/say_list/merc)
	TEST_ASSERT_EQUAL(A.make_say_list(null), /datum/say_list/merc, "actual starts callback returns the configured path")
	TEST_ASSERT_NULL(A.say_list, "late recipe edits do not silently rebuild the existing owned slot")
	var/list/recipe_array = list(/datum/say_list/merc = 2)
	TEST_ASSERT(vars_write(A, "say_list_type", recipe_array), "existing untyped recipe accepts a list without schema coercion")
	TEST_ASSERT_EQUAL(A.make_say_list(null), recipe_array, "factory preserves exact recipe-array reference and shape")
	TEST_ASSERT_EQUAL(recipe_array[/datum/say_list/merc], 2, "factory does not mutate recipe-array multiplicities")
	TEST_ASSERT_EQUAL(voice_config_of(B).say_list_type, /datum/say_list, "recipe COW does not change a sibling")
	TEST_ASSERT_EQUAL(voice_config_of_type(A.type).say_list_type, /datum/say_list, "instance array never overwrites compiled initial")

/datum/unit_test/dq_voice_recipe_mecha
/datum/unit_test/dq_voice_recipe_mecha/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/mechanical/mecha/dq_voice_recipe_probe/drone = allocate(/mob/living/simple_mob/mechanical/mecha/dq_voice_recipe_probe, test_floor())
	TEST_ASSERT_EQUAL(drone.recipe_before_parent, /datum/say_list/malf_drone, "uncrewed mecha retains compiled drone recipe before parent")
	TEST_ASSERT_EQUAL(drone.table_after_parent, /datum/say_list/malf_drone, "real owns_one starts creates the drone table")
	var/datum/say_list/owned_table = drone.say_list
	qdel(drone)
	TEST_ASSERT(QDELETED(owned_table), "table remains genuinely owned and deleted with the mecha")
	defer_cleanup(SSatoms, TYPE_PROC_REF(/datum/system/atoms, map_loader_stop), "dq_voice_recipe_mecha")
	for(var/recipe in list("compiled", null, 0, /datum/say_list, /datum/say_list/count))
		SSatoms.map_loader_begin("dq_voice_recipe_mecha")
		var/mob/living/simple_mob/mechanical/mecha/dq_voice_recipe_probe/M = new(test_floor())
		SSatoms.map_loader_stop("dq_voice_recipe_mecha")
		own(M)
		TEST_ASSERT(vars_write(M, "pilot_type", /mob/living/simple_mob/humanoid/merc/ranged), "real mapped pilot activates the existing mecha roll condition")
		if(recipe != "compiled")
			TEST_ASSERT(vars_write(M, "say_list_type", recipe), "map recipe override is written through the historical alias before rolls")
		SSatoms.InitializeAtoms(list(M))
		if(recipe == "compiled")
			TEST_ASSERT_EQUAL(M.recipe_before_parent, /datum/say_list/merc, "existing crewed_as roll updates native recipe before parent Initialize")
			TEST_ASSERT_EQUAL(M.table_after_parent, /datum/say_list/merc, "real starts factory sees the rolled mercenary recipe")
		else
			TEST_ASSERT_EQUAL(M.recipe_before_parent, recipe, "mapped recipe wins over pilot roll with exact falsey/type value")
			if(recipe == /datum/say_list/count)
				TEST_ASSERT_EQUAL(M.table_after_parent, /datum/say_list/count, "real starts constructs explicitly mapped nondefault table")
			else
				TEST_ASSERT_NULL(M.say_list, "mapped empty/base recipe keeps the table absent even for a crewed mecha")

