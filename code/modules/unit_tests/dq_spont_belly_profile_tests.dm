// Exercises the actual name preference, panel backend and transfer APIs.
// The connected-client-only panel input gate is source-audited, not emulated.
/datum/unit_test/dq_spont_belly_profile
/datum/unit_test/dq_spont_belly_profile/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human, test_floor())
	var/datum/vore_look/panel = allocate(/datum/vore_look, H)
	var/datum/vore_preferences/saved = allocate(/datum/vore_preferences)
	TEST_ASSERT(H.vore_prefs != other.vore_prefs, "preferences belong to each real mob")
	H.vore_prefs.set_spont_belly_front(html_encode("A & B"))
	H.vore_prefs.set_spont_belly_rear(null)
	H.vore_prefs.set_spont_belly_left("")
	H.vore_prefs.set_spont_belly_right("Right pocket")
	TEST_ASSERT(isnull(H.vore_prefs.spont_belly_rear), "the selected-belly sentinel remains null")
	TEST_ASSERT_EQUAL(H.vore_prefs.spont_belly_left, "", "empty text is not collapsed to null")
	var/list/prefs = panel.get_preference_data(H)
	TEST_ASSERT_EQUAL(prefs["spont_belly_front"], html_encode("A & B"), "the unchanged UI key exposes the encoded name")
	record_export(H.vore_prefs, saved)
	TEST_ASSERT_EQUAL(saved.spont_belly_front, H.vore_prefs.spont_belly_front, "the old save-format key still carries the name")
	TEST_ASSERT(isnull(saved.spont_belly_rear) && saved.spont_belly_left == "", "save export preserves null versus empty")
	record_import(other.vore_prefs, saved)
	TEST_ASSERT_EQUAL(other.vore_prefs.spont_belly_front, H.vore_prefs.spont_belly_front, "native import preserves a non-null encoded target")
	TEST_ASSERT_EQUAL(other.vore_prefs.spont_belly_right, "Right pocket", "native import retains all four target fields")
	H.copy_vore_prefs_to_mob(other)
	TEST_ASSERT_EQUAL(other.vore_prefs.spont_belly_front, H.vore_prefs.spont_belly_front, "the actual transformation preference path copies names")
	other.vore_prefs.set_spont_belly_front("Other target")
	TEST_ASSERT_EQUAL(H.vore_prefs.spont_belly_front, html_encode("A & B"), "editing the copy cannot change its source")

/datum/unit_test/dq_spont_belly_profile/lookup
/datum/unit_test/dq_spont_belly_profile/lookup/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/prey = allocate(/obj/item, get_step(test_floor(), NORTH))
	var/obj/belly/fallback = allocate(/obj/belly, H)
	var/obj/belly/front = allocate(/obj/belly, H)
	var/obj/belly/right = allocate(/obj/belly, H)
	fallback.name = "Default pocket"
	front.name = html_encode("A & B")
	right.name = "Right pocket"
	set_vore_selected(H, fallback)
	H.set_dir(NORTH)
	H.vore_prefs.set_spont_belly_front(front.name)
	H.vore_prefs.set_spont_belly_right(right.name)
	TEST_ASSERT_EQUAL(H.get_current_spont_belly(prey), front, "real relative-front lookup resolves a saved encoded name")
	prey.forceMove(get_step(test_floor(), EAST))
	TEST_ASSERT_EQUAL(H.get_current_spont_belly(prey), right, "relative-right selection preserves the old direction calculation")
	prey.forceMove(get_step(test_floor(), SOUTH))
	TEST_ASSERT_EQUAL(H.get_current_spont_belly(prey), fallback, "null rear preference uses the actual selected belly")
	prey.forceMove(get_step(test_floor(), NORTH))
	qdel(front)
	TEST_ASSERT_EQUAL(H.vore_prefs.spont_belly_front, html_encode("A & B"), "deleting a belly does not delete a saved name preference")
	TEST_ASSERT_EQUAL(H.get_current_spont_belly(prey), fallback, "an absent named belly falls back to the real selected belly")
	var/obj/belly/replacement = allocate(/obj/belly, H)
	replacement.name = html_encode("A & B")
	TEST_ASSERT_EQUAL(H.get_current_spont_belly(prey), replacement, "recreating a belly of that name restores the name-based choice")
