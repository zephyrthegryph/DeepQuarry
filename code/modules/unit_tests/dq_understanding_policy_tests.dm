/datum/unit_test/dq_understanding_policy_home
/datum/unit_test/dq_understanding_policy_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/A = allocate(/mob/living/simple_mob, test_floor())
	var/mob/living/simple_mob/B = allocate(/mob/living/simple_mob, test_floor())
	var/mob/living/carbon/human/speaker = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT(!("universal_understand" in A.vars), "no base-field shadow remains")
	TEST_ASSERT_EQUAL(kind_of_type(/mob).understands_all, 0, "compiled default remains numeric zero")
	TEST_ASSERT(!A.say_understands(speaker), "real non-related mob types do not understand an unspecified foreign language")
	TEST_ASSERT(vars_write(A, "universal_understand", 1), "historical map alias enables understanding")
	TEST_ASSERT(A.say_understands(speaker), "actual speech understanding honors native policy")
	TEST_ASSERT(!B.say_understands(speaker), "another instance remains unchanged")
	TEST_ASSERT_EQUAL(kind_of_type(A.type).understands_all, 0, "runtime edits do not alter compiled defaults")
	TEST_ASSERT(A.vv_edit_var("@mob_kind.understands_all", null), "real VV accepts explicit null")
	TEST_ASSERT_NULL(kind_of(A).understands_all, "null is preserved")
	TEST_ASSERT(!A.say_understands(speaker), "explicit null disables understanding")
	A.set_universal_understand("enabled")
	TEST_ASSERT_EQUAL(kind_of(A).understands_all, "enabled", "truthy historical values are not coerced")
	TEST_ASSERT(A.say_understands(speaker), "actual speech path retains truthy scalar behavior")
	A.set_universal_understand(0)
	TEST_ASSERT(!A.say_understands(speaker), "public setter restores exact disabled policy")
	var/obj/item/paper/P = allocate(/obj/item/paper, test_floor())
	P.show_content(A)
	TEST_ASSERT(!P.can_read_view, "ordinary simple mob cannot read the actual paper view")
	A.set_universal_understand(TRUE)
	P.show_content(A)
	TEST_ASSERT(P.can_read_view, "actual paper entry honors understanding without changing human/silicon fallbacks")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/observer/blob).understands_all, TRUE, "compiled language permission /mob/observer/blob")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/carbon/alien/diona).understands_all, 0, "compiled language permission /mob/living/carbon/alien/diona")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/silicon/robot/drone).understands_all, 1, "compiled language permission /mob/living/silicon/robot/drone")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/silicon/robot/drone/swarm).understands_all, 1, "compiled language permission /mob/living/silicon/robot/drone/swarm")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/vore/bigdragon).understands_all, 1, "compiled language permission /mob/living/simple_mob/vore/bigdragon")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/vore/alienanimals/dustjumper).understands_all, 1, "compiled language permission /mob/living/simple_mob/vore/alienanimals/dustjumper")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/borer).understands_all, TRUE, "compiled language permission /mob/living/simple_mob/animal/borer")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/captive_brain).understands_all, 1, "compiled language permission /mob/living/captive_brain")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/passive/mouse).understands_all, 1, "compiled language permission /mob/living/simple_mob/animal/passive/mouse")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/passive/opossum).understands_all, TRUE, "compiled language permission /mob/living/simple_mob/animal/passive/opossum")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/sif/kururak).understands_all, 1, "compiled language permission /mob/living/simple_mob/animal/sif/kururak")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/sif/leech).understands_all, 1, "compiled language permission /mob/living/simple_mob/animal/sif/leech")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/sif/sakimm).understands_all, 1, "compiled language permission /mob/living/simple_mob/animal/sif/sakimm")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/space/mouse_army).understands_all, 1, "compiled language permission /mob/living/simple_mob/animal/space/mouse_army")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob/animal/space/space_worm).understands_all, 1, "compiled language permission /mob/living/simple_mob/animal/space/space_worm")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/carbon/brain/caught_soul).understands_all, TRUE, "compiled language permission /mob/living/carbon/brain/caught_soul")
