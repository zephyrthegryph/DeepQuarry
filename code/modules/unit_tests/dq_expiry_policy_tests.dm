// Real parent-owned constructor observes that normal starts precede movable expiry arming.
/obj/effect/dq_expiry_parent_observer
	var/saw_timer
/obj/effect/dq_expiry_parent_observer/Initialize(mapload)
	saw_timer = after_pending(loc, "lifecycle_lifetime_timer")
	return ..()

/obj/effect/dq_expiry_phase_probe
	var/obj/effect/dq_expiry_parent_observer/observer
	var/before_parent_timer
	var/after_parent_timer
CAPABILITIES(/obj/effect/dq_expiry_phase_probe)
	expiry_policy(delay = 2 SECONDS)
	owns_one(nameof(observer), /obj/effect/dq_expiry_parent_observer, starts = /obj/effect/dq_expiry_parent_observer)
/obj/effect/dq_expiry_phase_probe/Initialize(mapload)
	before_parent_timer = after_pending(src, "lifecycle_lifetime_timer")
	. = ..()
	after_parent_timer = after_pending(src, "lifecycle_lifetime_timer")

/datum/unit_test/dq_expiry_policy_home
/datum/unit_test/dq_expiry_policy_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/effect/A = allocate(/obj/effect, test_floor())
	var/obj/effect/B = allocate(/obj/effect, test_floor())
	TEST_ASSERT_NOTNULL(static_entry_of(/atom/movable, ENTRY_EXPIRY_POLICY), "actual movable root owns expiry configuration")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/atom/movable).delay, 0, "root default means no automatic expiry")
	TEST_ASSERT(!("lifecycle_lifetime" in A.vars), "native configuration has no raw base-field shadow")
	TEST_ASSERT(vars_write(A, "lifecycle_lifetime", 0), "historical map/VV alias accepts explicit zero")
	TEST_ASSERT_EQUAL(expiry_policy_of(A).delay, 0, "zero is not replaced by default")
	TEST_ASSERT(A.vv_edit_var("@expiry_policy.delay", -5), "actual VV accepts old negative value")
	TEST_ASSERT_EQUAL(expiry_policy_of(A).delay, -5, "native config preserves negative without clamping")
	A.set_lifecycle_lifetime(null)
	TEST_ASSERT_NULL(expiry_policy_of(A).delay, "native setter preserves true null")
	TEST_ASSERT_EQUAL(expiry_policy_of(B).delay, 0, "instance edits are copy-on-write")
	A.set_lifecycle_lifetime(2 SECONDS)
	TEST_ASSERT(!after_pending(A, "lifecycle_lifetime_timer"), "late configuration does NOT silently arm runtime expiry")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/atom/movable).delay, 0, "COW never rewrites compiled root")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/effect/sparks).delay, 5 SECONDS, "compiled lifetime for /obj/effect/effect/sparks is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/effect/teleport_greyscale).delay, 2 SECONDS, "compiled lifetime for /obj/effect/effect/teleport_greyscale is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/expl_particles).delay, 1.5 SECONDS, "compiled lifetime for /obj/effect/expl_particles is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/explosion).delay, 1 SECOND, "compiled lifetime for /obj/effect/explosion is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/overlay/beam).delay, 1 SECOND, "compiled lifetime for /obj/effect/overlay/beam is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/portal).delay, 30 SECONDS, "compiled lifetime for /obj/effect/portal is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/effect/water).delay, 15 SECONDS, "compiled lifetime for /obj/effect/effect/water is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/decal/cleanable/greenglow).delay, 2 MINUTES, "compiled lifetime for /obj/effect/decal/cleanable/greenglow is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/item/cell/standin).delay, 20 SECONDS, "compiled lifetime for /obj/item/cell/standin is preserved")
	TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/slug_glue).delay, 5 MINUTES, "compiled lifetime for /obj/effect/slug_glue is preserved")

/datum/unit_test/dq_expiry_policy_phase_and_timer
/datum/unit_test/dq_expiry_policy_phase_and_timer/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	SSatoms.map_loader_begin("dq_expiry_policy_phase")
	var/obj/effect/dq_expiry_phase_probe/S = new(test_floor())
	SSatoms.map_loader_stop("dq_expiry_policy_phase")
	own(S)
	TEST_ASSERT(vars_write(S, "lifecycle_lifetime", 3 SECONDS), "mapped lifetime alias is applied before real init")
	SSatoms.InitializeAtoms(list(S))
	TEST_ASSERT(!S.before_parent_timer, "subtype pre-parent sees no automatic timer")
	TEST_ASSERT(!S.observer.saw_timer, "actual parent-owned child is constructed before movable timer arm")
	TEST_ASSERT(S.after_parent_timer, "subtype post-parent sees automatic timer already armed")
	TEST_ASSERT(after_pending(S, "lifecycle_lifetime_timer"), "mapped lifetime uses exact old keyed timer")
	test_time(2 SECONDS)
	TEST_ASSERT(!QDELETED(S), "mapped three-second lifetime survives two seconds")
	S.expire(5 SECONDS)
	test_time(2 SECONDS)
	TEST_ASSERT(!QDELETED(S), "explicit rearm replaces automatic timer, instead of coexisting with it")
	S.expire(null)
	TEST_ASSERT(!after_pending(S, "lifecycle_lifetime_timer"), "null cancels automatic/rearmed timer by same key")
	test_time(10 SECONDS)
	TEST_ASSERT(!QDELETED(S), "cancelled lifetime never fires later")
	var/datum/dq_ending_detail/L = allocate(/datum/dq_ending_detail)
	observe(S, /datum/notice/ended, L, then(TYPE_PROC_REF(/datum/dq_ending_detail, heard)))
	S.expire(1 SECOND)
	test_time(2 SECONDS)
	rx_drain()
	TEST_ASSERT(QDELETED(S), "actual keyed expiry ends real owner")
	TEST_ASSERT_EQUAL(L.cause, END_EXPIRED, "native config retains exact old expiry cause")
	TEST_ASSERT(!after_pending(S, "lifecycle_lifetime_timer"), "deleted owner leaves no keyed timer")
	test_driver_end()

/datum/unit_test/dq_expiry_policy_nonpositive_init
/datum/unit_test/dq_expiry_policy_nonpositive_init/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	for(var/value in list(0, null, -5))
		SSatoms.map_loader_begin("dq_expiry_policy_nonpositive")
		var/obj/effect/dq_expiry_phase_probe/S = new(test_floor())
		SSatoms.map_loader_stop("dq_expiry_policy_nonpositive")
		own(S)
		TEST_ASSERT(vars_write(S, "lifecycle_lifetime", value), "real queued map input accepts nonpositive/null override")
		SSatoms.InitializeAtoms(list(S))
		TEST_ASSERT_EQUAL(expiry_policy_of(S).delay, value, "init preserves exact mapped nonpositive/null configuration")
		TEST_ASSERT(!S.after_parent_timer && !after_pending(S, "lifecycle_lifetime_timer"), "nonpositive/null input never arms an automatic timer")
		TEST_ASSERT_EQUAL(expiry_policy_of_type(/obj/effect/dq_expiry_phase_probe).delay, 2 SECONDS, "map edit leaves compiled positive default intact")
