// Existing owner-specific config changes actual entry points without moving lifecycle phases.
/obj/dq_deconstruct_policy
	var/deconstruction_calls = 0
/obj/dq_deconstruct_policy/atom_deconstruct(disassembled)
	deconstruction_calls++

/datum/unit_test/dq_object_flag_policies/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/dq_deconstruct_policy/O = allocate(/obj/dq_deconstruct_policy, test_floor())
	TEST_ASSERT_EQUAL(object_break_config_of(O).flags, CAN_BE_HIT, "the entire original bitfield default is retained")
	O.handle_deconstruct()
	TEST_ASSERT_EQUAL(O.deconstruction_calls, 1, "the real default deconstruct entry reaches the actual virtual consequence")
	var/flags = CAN_BE_HIT | UNIQUE_RENAME | NO_DEBRIS_AFTER_DECONSTRUCTION
	TEST_ASSERT(vars_write(O, "obj_flags", flags), "the historical VV/map bitfield name reaches native configuration")
	TEST_ASSERT_EQUAL(object_break_config_of(O).flags, flags, "unrelated rename/hit bits are preserved rather than collapsed to a boolean")
	O.handle_deconstruct()
	TEST_ASSERT_EQUAL(O.deconstruction_calls, 1, "the real no-debris bit blocks that consequence")
	O.set_obj_flags(CAN_BE_HIT | UNIQUE_RENAME)
	O.handle_deconstruct()
	TEST_ASSERT_EQUAL(O.deconstruction_calls, 2, "clearing just the real no-debris bit restores normal dispatch")
	TEST_ASSERT_EQUAL(object_break_config_of_type(O.type).flags, CAN_BE_HIT, "runtime edits never mutate the shared type bitfield")
	var/obj/machinery/dq_maint_machine/M = allocate(/obj/machinery/dq_maint_machine, test_floor())
	TEST_ASSERT(M.maint_offers_panel(null) && M.maint_offers_frame(null), "the actual maintenance machine retains its declared offered work")
	TEST_ASSERT(vars_write(M, "maintenance_flags", MACHINE_MAINT_WRENCH), "historical maintenance editing uses the native trait route")
	TEST_ASSERT(!M.maint_offers_panel(null) && !M.maint_offers_frame(null), "the actual panel and frame conditions see the changed flags")
	TEST_ASSERT(M.maint_offers_wrench(null) && !M.maint_offers_repair(null), "the actual work conditions preserve their separate bits")

/datum/unit_test/dq_micro_entry_policy/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/structure/micro_tunnel/T = allocate(/obj/structure/micro_tunnel, test_floor())
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT(micro_policy_of(T).enterable, "the actual micro tunnel inherits its declared enterability")
	TEST_ASSERT(granted(T, granted_verb(/obj/proc/micro_interact)), "the original constructor phase still grants its real micro verb")
	TEST_ASSERT(H.mob_size > MOB_TINY, "this real human exercises the scale comparison rather than the tiny bypass")
	var/scale = H.get_effective_size(TRUE)
	TEST_ASSERT(scale > 0, "the actual human supplies a positive effective scale")
	T.set_micro_accepted_scale(scale)
	TEST_ASSERT(micro_tunnel_fits(T, H), "the actual admission helper accepts equality at the configured boundary")
	T.set_micro_accepted_scale(scale / 2)
	TEST_ASSERT(!micro_tunnel_fits(T, H), "the real human is refused when its current size exceeds the configured boundary")
	T.set_micro_target(FALSE)
	TEST_ASSERT(!micro_policy_of(T).enterable, "the historical editable enterability remains real holder-local configuration")
	TEST_ASSERT(granted(T, granted_verb(/obj/proc/micro_interact)), "a late policy edit preserves the original one-time constructor grant contract")
	TEST_ASSERT_EQUAL(micro_policy_of_type(T.type).scale, 0.5, "instance scale edits leave the actual type default unchanged")

/datum/unit_test/dq_object_fire_configuration/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/paper/P = allocate(/obj/item/paper, test_floor())
	var/obj/item/paper/peer = allocate(/obj/item/paper, test_floor())
	TEST_ASSERT_NULL(P.custom_fire_overlay(), "the real default getter retains the unconfigured null fallback")
	TEST_ASSERT_NULL(object_fire_of(P).particles, "rule ignition retains its explicit null particle argument")
	var/mutable_appearance/overlay = mutable_appearance('icons/effects/fire.dmi', "fire")
	TEST_ASSERT(vars_write(P, "custom_fire_overlay", overlay), "the old map/VV appearance name writes native configuration")
	TEST_ASSERT_EQUAL(P.custom_fire_overlay(), overlay, "the preserved virtual getter returns the actual configured appearance")
	P.rule_ignite()
	TEST_ASSERT(P.is_burning(), "the actual ignition rule starts the real burning capability")
	TEST_ASSERT_EQUAL(P.burn_overlay, overlay, "the real burning activation receives the configured appearance")
	TEST_ASSERT_NULL(P.burn_particle_type, "the original explicit null particle argument does not create default particles")
	P.extinguish()
	TEST_ASSERT(!P.is_burning(), "normal extinguishing still ends the actual burning capability")
	TEST_ASSERT_NULL(peer.custom_fire_overlay(), "the peer retains its own original null fallback")
	TEST_ASSERT_NULL(object_fire_of_type(P.type).overlay, "instance overrides never change the shared original fire configuration")
