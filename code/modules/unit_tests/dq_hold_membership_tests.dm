// Real hold-source membership edges, including masked stats, deadlines and cached op requirements.
/datum/unit_test/dq_hold_membership_masked/Run()
	var/obj/e3_machine/M = allocate(/obj/e3_machine)
	var/obj/e3_source/A = allocate(/obj/e3_source)
	var/obj/e3_source/B = allocate(/obj/e3_source)
	hold(M, STAT_E3_OPERABLE, FALSE, A)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(M, HOLD_MEMBERS_KEY)
	hold(M, STAT_E3_OPERABLE, FALSE, B)
	rx_drain()
	TEST_ASSERT(!M.e3_operable, "Other source already masks the composed stat")
	TEST_ASSERT(held_by_source(M, STAT_E3_OPERABLE, B), "Second source is really present despite the unchanged composed value")
	TEST_ASSERT_EQUAL(P.hits, 1, "First source row publishes membership once")
	hold(M, STAT_E3_OPERABLE, FALSE, B)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 1, "Reapply does not change membership")
	release(M, STAT_E3_OPERABLE, B)
	rx_drain()
	TEST_ASSERT(!M.e3_operable, "Other source still masks recovery")
	TEST_ASSERT(!held_by_source(M, STAT_E3_OPERABLE, B), "Released source membership is really absent")
	TEST_ASSERT_EQUAL(P.hits, 2, "Last source row publishes membership exit once")
	release(M, STAT_E3_OPERABLE, B)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 2, "Repeated release is not an edge")

/datum/unit_test/dq_hold_membership_keyed/Run()
	var/obj/e3_rules/R = allocate(/obj/e3_rules)
	var/obj/e3_source/S = allocate(/obj/e3_source)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(R, HOLD_MEMBERS_KEY)
	hold(R, STAT_E3_KEYED, 2, S, key = "first")
	hold(R, STAT_E3_KEYED, 3, S, key = "second")
	rx_drain()
	TEST_ASSERT_EQUAL(R.e3_keyed["first"], 2, "First keyed contribution exists")
	TEST_ASSERT_EQUAL(R.e3_keyed["second"], 3, "Second keyed contribution exists")
	TEST_ASSERT_EQUAL(P.hits, 1, "Several keys enter one source membership")
	release(R, STAT_E3_KEYED, S, key = "first")
	rx_drain()
	TEST_ASSERT(held_by_source(R, STAT_E3_KEYED, S), "Second keyed row preserves membership")
	TEST_ASSERT_EQUAL(P.hits, 1, "Removing a non-last key does not publish membership")
	release(R, STAT_E3_KEYED, S, key = "second")
	rx_drain()
	TEST_ASSERT(!held_by_source(R, STAT_E3_KEYED, S), "Last keyed row really leaves")
	TEST_ASSERT_EQUAL(P.hits, 2, "Last keyed row publishes one exit")

/datum/unit_test/dq_hold_membership_source_death/Run()
	test_driver_begin()
	var/obj/e3_machine/M = allocate(/obj/e3_machine)
	var/obj/e3_source/S = allocate(/obj/e3_source)
	var/key = stat_source_member_key(STAT_E3_DRAW, S)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(M, HOLD_MEMBERS_KEY)
	hold(M, STAT_E3_DRAW, 7, S, lasts = 2 SECONDS, clock = HOLD_CLOCK_WORLD, outlives_source = TRUE)
	rx_drain()
	TEST_ASSERT_EQUAL(M.e3_draw, 9, "The actual timed hold contributes before source death")
	TEST_ASSERT(LAZYACCESS(M.rx.stats.source_members, key), "The source member is present before its death")
	TEST_ASSERT_EQUAL(P.hits, 1, "Live source enters")
	qdel(S)
	rx_drain()
	TEST_ASSERT_EQUAL(M.e3_draw, 9, "Outliving contribution survives source death")
	TEST_ASSERT(!LAZYACCESS(M.rx.stats.source_members, key), "Original source membership ends when its source is forgotten")
	TEST_ASSERT_EQUAL(P.hits, 2, "Source teardown publishes one membership exit")
	test_time(3 SECONDS)
	rx_drain()
	TEST_ASSERT_EQUAL(M.e3_draw, 2, "Surviving contribution expires on its own deadline")
	TEST_ASSERT_EQUAL(P.hits, 2, "Later expiry does not duplicate source exit")
	test_driver_end()

/datum/unit_test/dq_hold_membership_expiry/Run()
	test_driver_begin()
	var/obj/e3_machine/M = allocate(/obj/e3_machine)
	var/obj/e3_source/S = allocate(/obj/e3_source)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(M, HOLD_MEMBERS_KEY)
	hold(M, STAT_E3_DRAW, 7, S, lasts = 1 SECONDS, clock = HOLD_CLOCK_WORLD)
	rx_drain()
	TEST_ASSERT_EQUAL(M.e3_draw, 9, "The actual timed contribution exists before its deadline")
	TEST_ASSERT(held_by_source(M, STAT_E3_DRAW, S), "The expiring member starts present")
	TEST_ASSERT_EQUAL(P.hits, 1, "Timed source enters")
	test_time(2 SECONDS)
	rx_drain()
	TEST_ASSERT(!held_by_source(M, STAT_E3_DRAW, S), "Deadline really removes the source")
	TEST_ASSERT_EQUAL(M.e3_draw, 2, "Expired contribution is removed")
	TEST_ASSERT_EQUAL(P.hits, 2, "Expiry publishes one source exit")
	test_driver_end()

/obj/machinery/dq_hold_membership_fixture
	var/membership_commits = 0
CAPABILITIES(/obj/machinery/dq_hold_membership_fixture)
	op("membership_gate", menu(button = "Membership gate"), needs(req(PROC_REF(no_emp))), then(PROC_REF(commit_membership)))
/obj/machinery/dq_hold_membership_fixture/proc/no_emp(datum/act/A)
	return emp_held() ? "The machine is disabled by an EMP." : null
/obj/machinery/dq_hold_membership_fixture/proc/commit_membership(datum/act/A)
	membership_commits++

/datum/unit_test/dq_e2/hold_membership_menu

/datum/unit_test/dq_e2/hold_membership_menu/run_gate()
	var/mob/living/simple_mob/e0_fixture/user = actor()
	var/obj/machinery/dq_hold_membership_fixture/M = allocate(/obj/machinery/dq_hold_membership_fixture, test_floor())
	var/obj/e3_source/other = allocate(/obj/e3_source)
	hold(M, STAT_OPERABLE, FALSE, other)
	var/list/before = action_options(user, M, null)
	var/found = FALSE
	for(var/list/row in before)
		if(row["key"] == "membership_gate")
			found = TRUE
			TEST_ASSERT(row["enabled"], "An unrelated OPERABLE veto is not an EMP refusal")
	TEST_ASSERT(found, "The actual menu row exists before EMP")
	hold(M, STAT_OPERABLE, FALSE, SRC_EMP)
	var/list/blocked = action_options(user, M, null)
	found = FALSE
	for(var/list/row in blocked)
		if(row["key"] == "membership_gate")
			found = TRUE
			TEST_ASSERT(!row["enabled"], "EMP membership invalidates the previously allowed menu despite a masked stat")
			TEST_ASSERT_EQUAL(row["reason"], "The machine is disabled by an EMP.", "The real requirement supplies the refusal")
	TEST_ASSERT(found, "The refused menu row stays discoverable")
	var/datum/op_result/blocked_result = test_menu(user, M, "membership_gate")
	TEST_ASSERT_EQUAL(blocked_result?.outcome, ACT_REFUSED, "Real execution refuses while EMP holds")
	TEST_ASSERT_EQUAL(M.membership_commits, 0, "Refusal prevents the effect")
	release(M, STAT_OPERABLE, SRC_EMP)
	TEST_ASSERT(!stat_value(M, STAT_OPERABLE), "Other veto still masks recovery")
	var/list/recovered = action_options(user, M, null)
	found = FALSE
	for(var/list/row in recovered)
		if(row["key"] == "membership_gate")
			found = TRUE
			TEST_ASSERT(row["enabled"], "Source exit invalidates the refused cached menu while OPERABLE stays false")
	TEST_ASSERT(found, "The recovered menu row still exists")
	var/datum/op_result/recovered_result = test_menu(user, M, "membership_gate")
	TEST_ASSERT_EQUAL(recovered_result?.outcome, ACT_COMMITTED, "Real execution recovers on membership exit")
	TEST_ASSERT_EQUAL(M.membership_commits, 1, "Recovered effect really runs once")
	var/list/reads = stat_generated_reads(M, TYPE_PROC_REF(/obj/machinery/dq_hold_membership_fixture, no_emp))
	TEST_ASSERT(HOLD_MEMBERS_KEY in reads, "Generated dependency follows real source membership through the EMP wrapper")

/datum/unit_test/dq_hold_membership_conservative/Run()
	var/obj/e3_rules/R = allocate(/obj/e3_rules)
	var/obj/e3_source/A = allocate(/obj/e3_source)
	var/obj/e3_source/B = allocate(/obj/e3_source)
	var/datum/dq_b4_key_probe/P = dq_b4_probe(R, HOLD_MEMBERS_KEY)
	hold(R, STAT_E3_SUM, 4, A)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 1, "One source member is one collection publication")
	TEST_ASSERT(!held_by_source(R, STAT_E3_ALL, B), "Different-stat/source query remains false")
	hold(R, STAT_E3_SUM, 6, A)
	rx_drain()
	TEST_ASSERT_EQUAL(R.e3_sum, 6, "A reapply really changes the contribution")
	TEST_ASSERT_EQUAL(P.hits, 1, "Changing value does not change membership")
	hold(R, STAT_E3_ALL, FALSE, B)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 2, "A different source/stat really changes the same collection")
	TEST_ASSERT(!R.e3_all, "The second source really vetoes its own composed stat")
	TEST_ASSERT(held_by_source(R, STAT_E3_SUM, A), "Conservative invalidation preserves the other query's true result")
	qdel(B)
	rx_drain()
	TEST_ASSERT_EQUAL(P.hits, 3, "Normal source death publishes one collection exit")
	TEST_ASSERT(R.e3_all, "Normal source death removes its actual veto")
	TEST_ASSERT(held_by_source(R, STAT_E3_SUM, A), "Normal death does not remove unrelated membership")
