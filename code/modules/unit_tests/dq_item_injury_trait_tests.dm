// Native combat configuration reaches real packet entry points and retains activation isolation.
/datum/unit_test/dq_item_injury_trait/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/actor = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/melee/energy/axe/axe = allocate(/obj/item/melee/energy/axe, test_floor())
	var/obj/item/melee/energy/axe/peer = allocate(/obj/item/melee/energy/axe, test_floor())
	var/obj/machinery/dq_damage_probe/probe = allocate(/obj/machinery/dq_damage_probe, test_floor())
	TEST_ASSERT_EQUAL(combat_of(axe).injury_kind, INJURY_CUT, "the actual unlit axe preserves its declared cutting kind")
	TEST_ASSERT_NULL(combat_of(axe).injury_kinds, "the actual unlit axe starts without a mixed distribution")
	axe.activate(actor)
	TEST_ASSERT_NOTNULL(combat_of(axe).injury_kinds, "real activation installs the actual mixed immutable distribution")
	TEST_ASSERT_EQUAL(combat_of(axe).injury_kinds[INJURY_BURN], 1/3, "activation retains the exact burn share")
	TEST_ASSERT_EQUAL(combat_of(axe).injury_kinds[INJURY_CUT], 2/3, "activation retains the exact cut share")
	TEST_ASSERT_NULL(combat_of(peer).injury_kinds, "activating one real axe never changes its peer")
	probe.receive_weapon_hit(axe, actor, 30)
	TEST_ASSERT_EQUAL(probe.received, 1, "the real weapon entry delivers exactly one actual packet")
	TEST_ASSERT(dq_near(probe.last.amounts[DAMAGE_THERMAL], 10, 0.01) && dq_near(probe.last.amounts[DAMAGE_SHARP], 20, 0.01), "the native distribution reaches actual thermal/sharp packet amounts")
	axe.deactivate(actor)
	TEST_ASSERT_NULL(combat_of(axe).injury_kinds, "real deactivation clears only the activated instance's split")
	TEST_ASSERT_EQUAL(combat_of(axe).injury_kind, combat_of_type(axe.type).injury_kind, "real deactivation restores the actual type default")
	probe.receive_weapon_hit(axe, actor, 30)
	TEST_ASSERT_EQUAL(probe.received, 2, "the restored weapon delivers a second real packet")
	TEST_ASSERT(probe.last.only(DAMAGE_SHARP, 30), "the restored actual axe inflicts only its original cutting kind")
	TEST_ASSERT(vars_write(axe, "injury_kind", INJURY_PAIN), "the preserved map/VV field reaches the native combat setter route")
	probe.receive_weapon_hit(axe, actor, 30)
	TEST_ASSERT(probe.last.only(DAMAGE_PAIN, 30), "the real by-name edit changes the next actual hit")
	TEST_ASSERT_EQUAL(combat_of(peer).injury_kind, INJURY_CUT, "the type and peer retain their original kind after admin editing")

/datum/unit_test/dq_projectile_injury_trait/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/projectile/bullet/magnetic/heated/round = allocate(/obj/item/projectile/bullet/magnetic/heated, test_floor())
	var/obj/machinery/dq_damage_probe/probe = allocate(/obj/machinery/dq_damage_probe, test_floor())
	TEST_ASSERT_EQUAL(combat_of(round).injury_kind, INJURY_BLUNT, "the actual heated projectile retains its declared primary kind")
	TEST_ASSERT_EQUAL(combat_of(round).injury_kinds[INJURY_BURN], 1/3, "the actual projectile retains its immutable thermal share")
	probe.bullet_act(round)
	TEST_ASSERT_EQUAL(probe.received, 1, "the actual projectile entry delivers its packet")
	TEST_ASSERT(dq_near(probe.last.amounts[DAMAGE_THERMAL], round.damage / 3, 0.01) && dq_near(probe.last.amounts[DAMAGE_BLUNT], round.damage * 2 / 3, 0.01), "the inherited projectile split reaches the actual packet entry")
	round.set_injury_kind(INJURY_PIERCE)
	round.set_injury_kinds(null)
	probe.bullet_act(round)
	TEST_ASSERT_EQUAL(probe.received, 2, "changing native combat values affects a second actual projectile hit")
	TEST_ASSERT(probe.last.only(DAMAGE_PIERCE, round.damage), "clearing the split restores single-kind dispatch")
	TEST_ASSERT_NOTNULL(combat_of_type(round.type).injury_kinds, "the runtime projectile edit never clears the shared type split")
