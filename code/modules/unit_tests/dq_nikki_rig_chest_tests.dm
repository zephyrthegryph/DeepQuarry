/datum/unit_test/dq_nikki_rig_chest_ownership/Run()
	var/obj/item/rig/nikki/R = allocate(/obj/item/rig/nikki, run_loc_floor_bottom_left)
	TEST_ASSERT_NOTNULL(R.chest, "Real Nikki RIG initialization creates its configured cape")
	var/obj/item/clothing/suit/cape = R.chest
	TEST_ASSERT_EQUAL(cape.type, /obj/item/clothing/suit/fluff/nikki, "The owned chest is the actual Nikki cape, not a replacement space suit")
	TEST_ASSERT_EQUAL(cape.type, R.chest_type, "Configured chest type and actual owned component match")
	TEST_ASSERT_EQUAL(cape.loc, R, "The configured cape is physically contained by its real RIG controller")
	TEST_ASSERT_NULL(cape.master_rig(), "Stored cape has no deployed-wearer backlink; initialization does not fabricate one")
	TEST_ASSERT(!QDELETED(cape), "Successful declaration admission leaves the cape alive")
	var/obj/item/rig/control = allocate(/obj/item/rig, run_loc_floor_bottom_left)
	TEST_ASSERT(istype(control.chest, /obj/item/clothing/suit/space/rig), "Ordinary RIG retains its original space-rig chest")
	qdel(R)
	TEST_ASSERT(QDELETED(cape), "Real controller teardown deletes its owned cape")

/datum/unit_test/dq_nikki_rig_module_hit/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/item/rig/nikki/R = allocate(/obj/item/rig/nikki, T)
	TEST_ASSERT_EQUAL(R.chest.type, /obj/item/clothing/suit/fluff/nikki, "Real configured ordinary cape survives declaration admission")
	var/obj/item/rig_module/mounted/sizegun/M = allocate(/obj/item/rig_module/mounted/sizegun, R)
	rel_add(R, nameof(R.installed_modules), M)
	M.installed(R)
	TEST_ASSERT(M in R.installed_modules, "Real mounted module is in owned registry")
	TEST_ASSERT_EQUAL(M.holder, R, "Real installed callback binds module holder")
	// A real wearer relation exercises notification; it does not claim the
	// named owner's authenticated equipment permission was satisfied.
	rel_set(R, nameof(R.wearer), H)
	TEST_ASSERT_EQUAL(R.wearer(), H, "Controller resolves real wearer relation")
	R.take_hit(50, "test impact", FALSE)
	TEST_ASSERT_EQUAL(M.damage, 1, "Zero cape breach resistance gives deterministic100percent damage chance")
	TEST_ASSERT_EQUAL(R.chest.type, /obj/item/clothing/suit/fluff/nikki, "Damage does not replace cape with space suit")
	var/obj/item/rig/control = allocate(/obj/item/rig, T)
	var/obj/item/rig_module/mounted/sizegun/C = allocate(/obj/item/rig_module/mounted/sizegun, control)
	rel_add(control, nameof(control.installed_modules), C)
	C.installed(control)
	var/obj/item/clothing/suit/space/space_chest = control.chest
	TEST_ASSERT(istype(space_chest), "Control retains genuine space chest")
	control.take_hit(space_chest.breach_threshold, "threshold impact", FALSE)
	TEST_ASSERT_EQUAL(C.damage, 0, "Normal space-rig threshold still blocks equal damage")
	control.take_hit(space_chest.breach_threshold + 50, "large impact", FALSE)
	TEST_ASSERT_EQUAL(C.damage, 1, "Normal chest still damages module above threshold")
