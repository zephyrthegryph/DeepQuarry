// The real cache owns an overlay shared by two independently linked viewers.
/datum/unit_test/dq_managed_vis_sparse_links
/datum/unit_test/dq_managed_vis_sparse_links/proc/cleanup_overlay(obj/effect/overlay/vis/O)
	if(!QDELETED(O))
		qdel(O)

/datum/unit_test/dq_managed_vis_sparse_links/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/obj/item/A = allocate(/obj/item, test_floor())
	var/obj/item/B = allocate(/obj/item, test_floor())
	var/obj/effect/overlay/vis/O = A.add_vis_overlay('icons/obj/items.dmi', "dq_managed_vis_sparse_test", layer = 1, plane = 1, dir = SOUTH)
	defer_cleanup(src, PROC_REF(cleanup_overlay), O)
	TEST_ASSERT_NOTNULL(O, "the actual cache created its real overlay")
	TEST_ASSERT_EQUAL(owner_of(O), SSvis_overlays, "the actual global cache remains the sole overlay owner")
	TEST_ASSERT_EQUAL(B.add_vis_overlay('icons/obj/items.dmi', "dq_managed_vis_sparse_test", layer = 1, plane = 1, dir = SOUTH), O, "a second real viewer reuses the exact cached object")
	TEST_ASSERT_EQUAL(A.add_vis_overlay('icons/obj/items.dmi', "dq_managed_vis_sparse_test", layer = 1, plane = 1, dir = SOUTH), O, "repeat attachment reuses the original cache entry")
	TEST_ASSERT_EQUAL(length(link_list(A, LK_MANAGED_VIS)), 1, "the first actual viewer has no duplicate roster entry")
	TEST_ASSERT_EQUAL(length(link_list(O, LK_VIS_VIEWERS)), 2, "the shared overlay has both exact native viewer endpoints")
	TEST_ASSERT((O in A.vis_contents) && (O in B.vis_contents), "native roster migration preserves the real visible attachments")
	A.remove_vis_overlay(O)
	TEST_ASSERT(!(O in A.vis_contents) && (O in B.vis_contents), "actual removal changes only the requested viewer's visible contents")
	TEST_ASSERT_EQUAL(length(link_list(A, LK_MANAGED_VIS)), 0, "the removed viewer's native roster is empty")
	TEST_ASSERT_EQUAL(length(link_list(O, LK_VIS_VIEWERS)), 1, "the shared overlay retains only the actual surviving viewer")
	TEST_ASSERT(!QDELETED(O) && owner_of(O) == SSvis_overlays, "removing a viewer never deletes or transfers the cached object")
	A.add_vis_overlay('icons/obj/items.dmi', "dq_managed_vis_sparse_test", layer = 1, plane = 1, dir = SOUTH)
	qdel(A)
	TEST_ASSERT_EQUAL(length(link_list(O, LK_VIS_VIEWERS)), 1, "actual viewer destruction removes its sparse endpoint")
	TEST_ASSERT(B in link_list(O, LK_VIS_VIEWERS), "destroying one viewer retains the exact live peer")
	TEST_ASSERT((O in B.vis_contents) && !QDELETED(O), "viewer teardown leaves the surviving real attachment and cache alive")
	SSvis_overlays.remove_vis_overlay(B, link_list(B, LK_MANAGED_VIS))
	TEST_ASSERT_EQUAL(length(link_list(B, LK_MANAGED_VIS)), 0, "the real cogbar-style clear-all call removes the entire viewer roster")
	TEST_ASSERT(!(O in B.vis_contents), "real clear-all removes the actual visible attachment")
	// Finish a pre-existing yielded snapshot before testing a fresh cache sweep.
	var/result = SSvis_overlays.expire_overlays(0)
	for(var/pass in 1 to 100000)
		if(result != STEP_YIELD)
			break
		result = SSvis_overlays.expire_overlays(0)
	TEST_ASSERT_EQUAL(result, STEP_DONE, "any previous real cache snapshot finishes before expiry is staged")
	EXPIRY_SET(O, unused, -3 MINUTES, CLOCK_WORLD)
	result = SSvis_overlays.expire_overlays(0)
	for(var/pass in 1 to 100000)
		if(result != STEP_YIELD)
			break
		result = SSvis_overlays.expire_overlays(0)
	TEST_ASSERT_EQUAL(result, STEP_DONE, "the actual cache expiry completes its native resumable sweep")
	TEST_ASSERT(QDELETED(O), "the real cache evicts its expired unviewed object")
	var/obj/effect/overlay/vis/replacement = B.add_vis_overlay('icons/obj/items.dmi', "dq_managed_vis_sparse_test", layer = 1, plane = 1, dir = SOUTH)
	defer_cleanup(src, PROC_REF(cleanup_overlay), replacement)
	TEST_ASSERT_NOTNULL(replacement, "the actual cache recreates an entry after eviction")
	TEST_ASSERT_NOTEQUAL(replacement, O, "eviction never returns the deleted cached identity")
	qdel(replacement)
	TEST_ASSERT_EQUAL(length(link_list(B, LK_MANAGED_VIS)), 0, "actual overlay-endpoint deletion removes the viewer's borrowed link")
	test_driver_end()
