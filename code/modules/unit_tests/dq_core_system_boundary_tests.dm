GLOBAL_LIST_EMPTY(dq_b5_resolver_calls)

/proc/dq_b5_resolver_probe(atom/loc, path, list/edits)
	GLOB.dq_b5_resolver_calls += list(list(loc, path, edits))

/datum/unit_test/dq_air_boundary/Run()
	var/datum/system/air/air = allocate(/datum/system/air)
	var/datum/pipe_network/network = allocate(/datum/pipe_network)
	air.start_processing_pipenet(network)
	air.start_processing_pipenet(network)
	TEST_ASSERT_EQUAL(length(air.networks), 1, "Starting an already-processing pipenet must not duplicate it")
	TEST_ASSERT(network.datum_flags & DF_ISPROCESSING, "Pipenet start must preserve its processing flag")
	set_var(air, "currentrun", list(network))
	air.stop_processing_pipenet(network)
	TEST_ASSERT_EQUAL(length(air.networks), 0, "Stopping must remove the network from the live roster")
	TEST_ASSERT_EQUAL(length(air.currentrun), 0, "Stopping must also remove the resumed-run entry")
	TEST_ASSERT(!(network.datum_flags & DF_ISPROCESSING), "Stopping must clear the processing flag")
	air.note_gas_event()
	air.note_gas_reaction()
	air.note_gas_visual()
	air.note_gas_pressure()
	var/list/stats = air.performance_snapshot()
	TEST_ASSERT_EQUAL(stats["gas_events_last"], 1, "The numeric snapshot must include the dispatched event")
	TEST_ASSERT_EQUAL(stats["gas_reactions_last"], 1, "The snapshot must retain reaction counts")
	TEST_ASSERT_EQUAL(stats["gas_visuals_last"], 1, "The snapshot must retain visual counts")
	TEST_ASSERT_EQUAL(stats["gas_pressure_last"], 1, "The snapshot must retain spacewind counts")
	stats["gas_events_last"] = 900
	TEST_ASSERT_EQUAL(air.performance_snapshot()["gas_events_last"], 1, "Editing a diagnostic snapshot must not mutate the owner's counters")
	air.toggle_processing()
	TEST_ASSERT(!air.processing_enabled(), "The admin toggle must disable the real work gate")
	air.toggle_processing()
	TEST_ASSERT(air.processing_enabled(), "The next toggle must restore the real work gate")

/datum/unit_test/dq_atoms_boundary/Run()
	set_global("dq_b5_resolver_calls", list())
	var/datum/system/atoms/atoms = allocate(/datum/system/atoms)
	atoms.begin_materialize_suppression()
	atoms.begin_materialize_suppression()
	TEST_ASSERT_EQUAL(atoms.materialize_suppressed, 2, "Sandbox suppression must preserve nested depth")
	atoms.end_materialize_suppression()
	atoms.end_materialize_suppression()
	TEST_ASSERT_EQUAL(atoms.materialize_suppressed, 0, "Unwinding both sandboxes must restore suppression")
	var/prior = atoms.system_initialization_state()
	var/saved = atoms.begin_immediate_initialization()
	TEST_ASSERT_EQUAL(saved, prior, "Immediate initialization must preserve the exact inherited state")
	TEST_ASSERT_EQUAL(atoms.system_initialization_state(), INITIALIZATION_INNEW_MAPLOAD, "Immediate creation must expose the original temporary state")
	atoms.end_immediate_initialization(saved)
	TEST_ASSERT_EQUAL(atoms.system_initialization_state(), prior, "The macro's restore must recover its previous state")
	var/turf/T = test_floor()
	var/list/edits = list("name" = "boundary resolver")
	atoms.defer_map_resolver(GLOBAL_PROC_REF(dq_b5_resolver_probe), T, /obj, edits)
	TEST_ASSERT_EQUAL(length(GLOB.dq_b5_resolver_calls), 0, "A boot/mapload resolver must remain deferred")
	var/list/batch = atoms.take_resolver_batch()
	TEST_ASSERT_EQUAL(length(batch), 1, "Taking a batch must hand over every queued resolver")
	TEST_ASSERT_NULL(atoms.take_resolver_batch(), "The old batch must be cleared before nested callbacks can queue another")
	var/list/row = batch[1]
	TEST_ASSERT_EQUAL(resolve_handle(row[2]), T, "Deferred resolution must retain the real location through its handle")
	TEST_ASSERT_EQUAL(row[4], edits, "The resolver must retain its actual var-edit list")
	set_var(atoms, "atom_initialized", INITIALIZATION_INNEW_REGULAR)
	atoms.defer_map_resolver(GLOBAL_PROC_REF(dq_b5_resolver_probe), T, /obj, edits)
	TEST_ASSERT_EQUAL(length(GLOB.dq_b5_resolver_calls), 1, "Outside a load, the same resolver must execute immediately")
	var/list/call_row = GLOB.dq_b5_resolver_calls[1]
	TEST_ASSERT_EQUAL(call_row[1], T, "The immediate resolver must receive the actual location")
	TEST_ASSERT_EQUAL(call_row[3], edits, "The immediate resolver must receive the same var edits")

/datum/unit_test/dq_mapping_boundary/Run()
	var/datum/system/mapping/mapping = allocate(/datum/system/mapping)
	mapping.ensure_multiz_capacity(3)
	TEST_ASSERT_EQUAL(length(mapping.multiz_levels), 3, "Atmos synchronization must grow the owner's level table")
	var/list/traits = new /list(Z_LEVEL_DOWN)
	traits[Z_LEVEL_UP] = TRUE
	mapping.set_multiz_atmos_traits(2, traits)
	TEST_ASSERT_EQUAL(mapping.multiz_levels[2], traits, "Setting a level must preserve the authored trait list itself")
	mapping.ensure_multiz_capacity(1)
	TEST_ASSERT_EQUAL(length(mapping.multiz_levels), 3, "A smaller request must not discard unrelated authored levels")
	var/datum/map_template/template = allocate(/datum/map_template, null, "boundary template")
	mapping.register_uploaded_template(template)
	TEST_ASSERT_EQUAL(mapping.map_templates[template.name], template, "The admin upload must register the real template under its actual name")

/datum/unit_test/dq_garbage_boundary/Run()
	var/datum/system/garbage/garbage = allocate(/datum/system/garbage)
	var/list/reference = list("queue record")
	var/list/queue = list(reference)
	set_var(garbage, "queues", list(queue))
	TEST_ASSERT(garbage.queue_contains_reference(reference), "The reference tracker must recognize the queued record by identity")
	TEST_ASSERT(!garbage.queue_contains_reference(list("queue record")), "An equal-looking list outside the queue must not be ignored")
	garbage.set_collection_enabled(FALSE)
	TEST_ASSERT(!garbage.can_fire, "Reference-search suspension must affect the actual collector")
	garbage.set_collection_enabled(TRUE)
	TEST_ASSERT(garbage.can_fire, "Finishing reference search must restore the collector")
	var/datum/qdel_item/item = allocate(/datum/qdel_item, /obj)
	set_var(garbage, "items", list(/obj = item))
	var/list/types = garbage.deletion_types()
	TEST_ASSERT_EQUAL(types[1], /obj, "Deletion reporting must preserve the table's actual type keys")
	types.Cut()
	TEST_ASSERT_EQUAL(garbage.deletion_statistics(/obj), item, "Editing diagnostic type keys must not discard live statistics")

/datum/unit_test/dq_machine_boundary/Run()
	var/datum/system/machines/machines = allocate(/datum/system/machines)
	TEST_ASSERT_EQUAL(machines.next_detached_grid_id(), -1, "Detached power IDs must retain their negative sequence")
	TEST_ASSERT_EQUAL(machines.next_detached_grid_id(), -2, "Each detached grid must consume the next ID")
	machines.note_dead_gas_watch()
	TEST_ASSERT_EQUAL(machines.gas_dead_last, 1, "Dead gas-watch delivery must retain its diagnostic count")
	var/area/A = get_area(test_floor())
	machines.queue_area_power_load(A)
	machines.queue_area_power_load(A)
	TEST_ASSERT_EQUAL(length(machines.power_dirty_areas), 1, "Repeated area load changes must retain keyed-set membership")
	TEST_ASSERT(machines.power_dirty_areas[A], "The real changed area must remain queued")
