// Native per-type defaults and per-holder changes both preserve the real mob ordering path.
/datum/unit_test/dq_base_vars_sorting
/datum/unit_test/dq_base_vars_sorting/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/mob/living/carbon/human/ordinary = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/monkey/M = allocate(/mob/living/carbon/human/monkey, T)
	TEST_ASSERT(!human_abilities_of(ordinary).low_sorting_priority, "ordinary humans retain their original false default")
	TEST_ASSERT(human_abilities_of(M).low_sorting_priority, "the actual monkey subtype retains its original true default")
	var/list/order = sort_mobs()
	TEST_ASSERT(order.Find(M) && order.Find(ordinary), "the real global ordering contains both actual registered humans")
	TEST_ASSERT(order.Find(M) < order.Find(ordinary), "the original low-priority bucket precedes unconnected ordinary humans")
	set_trait(ordinary, ENTRY_HUMAN_ABILITIES, "low_sorting_priority", TRUE)
	set_trait(M, ENTRY_HUMAN_ABILITIES, "low_sorting_priority", FALSE)
	order = sort_mobs()
	TEST_ASSERT(order.Find(ordinary) < order.Find(M), "real per-holder overrides move the exact humans between the original buckets")
	var/datum/type_trait/human_abilities/base_defaults = type_trait_of_type(/mob/living/carbon/human, ENTRY_HUMAN_ABILITIES)
	var/datum/type_trait/human_abilities/monkey_defaults = type_trait_of_type(/mob/living/carbon/human/monkey, ENTRY_HUMAN_ABILITIES)
	TEST_ASSERT(!base_defaults.low_sorting_priority, "changing an instance never mutates ordinary type defaults")
	TEST_ASSERT(monkey_defaults.low_sorting_priority, "changing an instance never mutates monkey type defaults")
