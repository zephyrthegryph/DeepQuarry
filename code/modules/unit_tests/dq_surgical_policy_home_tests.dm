/datum/unit_test/dq_surgical_policy_home
/datum/unit_test/dq_surgical_policy_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/tool/crowbar/A = allocate(/obj/item/tool/crowbar, test_floor())
	var/obj/item/tool/crowbar/B = allocate(/obj/item/tool/crowbar, test_floor())
	var/datum/surgical_step/S = surgical_step(/datum/surgical_step/place_item)
	TEST_ASSERT_NOTNULL(static_entry_of(/obj/item, ENTRY_ITEM_SURGERY), "the actual item root declares surgical policy")
	TEST_ASSERT(!("cavity_implantable" in A.vars), "native admission has no raw shadow field")
	TEST_ASSERT_EQUAL(S.tool_quality(A), 0, "the actual surgical admission refuses excluded tools")
	TEST_ASSERT(vars_write(A, "cavity_implantable", TRUE), "map-by-name edits reach the native policy")
	TEST_ASSERT(S.tool_quality(A) > 0, "the actual surgical step observes the edited admission")
	TEST_ASSERT_EQUAL(S.tool_quality(B), 0, "map editing one instance does not alter its sibling")
	TEST_ASSERT(A.vv_edit_var("@item_surgery.cavity_implantable", FALSE), "the real VV route accepts explicit false")
	TEST_ASSERT_EQUAL(S.tool_quality(A), 0, "VV false restores refusal in the real surgical caller")
	A.set_cavity_implantable(TRUE)
	TEST_ASSERT(S.tool_quality(A) > 0 && !surgery_of(B).cavity_implantable, "the real setter remains COW")
	var/obj/item/coin/C = allocate(/obj/item/coin, test_floor())
	TEST_ASSERT(S.tool_quality(C) > 0, "ordinary small items retain old default admission")
	TEST_ASSERT(!surgery_of_type(/obj/item/tool/crowbar).cavity_implantable, "instance edits do not mutate compiled subtype policy")
