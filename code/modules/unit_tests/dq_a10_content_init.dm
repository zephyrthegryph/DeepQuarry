// A10 actual constructor outcomes for declared initialization jobs.
/datum/unit_test/dq_a10_content_init
	abstract_type = /datum/unit_test/dq_a10_content_init

/datum/unit_test/dq_a10_content_init/New()
	..()
	dview(0, test_floor())
	status_policies()

/datum/unit_test/dq_a10_content_init/meat_contents/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/item/reagent_containers/food/snacks/meat/chicken/C = allocate(/obj/item/reagent_containers/food/snacks/meat/chicken, test_floor())
	var/obj/item/reagent_containers/food/snacks/xenomeat/spidermeat/S = allocate(/obj/item/reagent_containers/food/snacks/xenomeat/spidermeat, test_floor())
	TEST_ASSERT_EQUAL(C.reagents.get_reagent_amount(REAGENT_ID_TRIGLYCERIDE), 0, "Chicken construction removes its inherited triglyceride")
	TEST_ASSERT(C.reagents.total_volume > 0, "Removing chicken fat preserves its actual other reagents")
	TEST_ASSERT_EQUAL(S.reagents.get_reagent_amount(REAGENT_ID_PACID), 6, "Spider construction removes six acid units exactly once, despite the former duplicate definition")
	TEST_ASSERT_EQUAL(S.reagents.get_reagent_amount(REAGENT_ID_SPIDERTOXIN), 12, "The subtype's declared toxin remains after setup")

/datum/unit_test/dq_a10_content_init/cooking_insertions/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/item/reagent_containers/cooking_container/oven/O = allocate(/obj/item/reagent_containers/cooking_container/oven, test_floor())
	var/obj/item/reagent_containers/cooking_container/grill/G = allocate(/obj/item/reagent_containers/cooking_container/grill, test_floor())
	TEST_ASSERT(/obj/item/organ/internal/brain in O.insertable, "An actual oven dish admits the specialty brain ingredient")
	TEST_ASSERT(/obj/item/reagent_containers/food/snacks in O.insertable, "The oven keeps its inherited ordinary-food admission")
	TEST_ASSERT(/obj/item/organ/internal/brain in G.insertable, "An actual grill admits the specialty brain ingredient")
	TEST_ASSERT(/obj/item/robot_parts/head in G.insertable, "The grill still admits robot heads")
	TEST_ASSERT(/obj/item/stack/rods in G.insertable, "The grill still admits rods")
	TEST_ASSERT(!(/obj/item/robot_parts/head in O.insertable), "Subtype setup does not mutate another dish's list")

/datum/unit_test/dq_a10_content_init/mixer_selection/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/machinery/appliance/mixer/candy/M = allocate(/obj/machinery/appliance/mixer/candy, test_floor())
	var/datum/cooking_item/CI = LAZYACCESS(M.cooking_objs, 1)
	TEST_ASSERT_NOTNULL(CI, "Declared mixer contents exist before its selection job")
	TEST_ASSERT(M.selected_option in M.output_options, "The real mixer selects an actual output option")
	TEST_ASSERT_EQUAL(CI.combine_target, M.selected_option, "The existing cooking item receives the selected option")
	TEST_ASSERT(!M.cooking, "Both parent and subtype initialization leave the mixer idle")

/datum/unit_test/dq_a10_content_init/hypo_catalog/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/item/reagent_containers/borghypo/H = allocate(/obj/item/reagent_containers/borghypo, test_floor())
	var/list/ids = TYPE_TABLE_GET(H, borghypo_reagent_ids)
	TEST_ASSERT(length(ids) > 0, "The real hypo has a declared reagent catalog")
	TEST_ASSERT_EQUAL(length(H.reagent_names), length(ids), "Setup records one chemical name per declared reagent")
	for(var/id in ids)
		TEST_ASSERT_EQUAL(H.reagent_volumes[id], H.volume, "Each declared reagent starts with the hypo's actual configured volume")

/datum/unit_test/dq_a10_content_init/tray_scratch/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/machinery/portable_atmospherics/hydroponics/T = allocate(/obj/machinery/portable_atmospherics/hydroponics, test_floor())
	TEST_ASSERT_NOTNULL(T.temp_chem_holder, "The real tray owns its scratch child before setup")
	TEST_ASSERT_NOTNULL(T.temp_chem_holder.reagents, "Setup equips the existing scratch child with its reagent holder")
	TEST_ASSERT_EQUAL(T.temp_chem_holder.reagents.maximum_volume, 10, "The scratch child keeps the actual ten-unit capacity")

/datum/unit_test/dq_a10_content_init/reagent_sockets/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/structure/reagent_dispensers/watertank/T = allocate(/obj/structure/reagent_dispensers/watertank, test_floor())
	TEST_ASSERT_EQUAL(length(T.get_hose_connectors(/datum/hose_connector/input)), 1, "Tank setup creates one actual input socket")
	TEST_ASSERT_EQUAL(length(T.get_hose_connectors(/datum/hose_connector/output)), 1, "Tank setup creates one actual output socket")

/datum/unit_test/dq_a10_content_init/wax_recipes/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/item/stack/material/wax/W = allocate(/obj/item/stack/material/wax, test_floor(), 1)
	TEST_ASSERT(length(W.recipes) > 0, "Actual wax construction installs its crafting recipes")
	TEST_ASSERT_EQUAL(W.recipes, GLOB.wax_recipes, "The declared job retains the original shared recipe catalog")

/datum/unit_test/dq_a10_content_init/gibber_plate/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/turf/T = test_floor()
	var/turf/N = get_step(T, NORTH)
	var/obj/machinery/mineral/input/I = allocate(/obj/machinery/mineral/input, N)
	var/obj/machinery/gibber/autogibber/G = allocate(/obj/machinery/gibber/autogibber, T)
	TEST_ASSERT_EQUAL(G.input_plate(), N, "The actual autogibber captures the neighboring plate's turf")
	TEST_ASSERT_EQUAL(G.gib_throw_dir, NORTH, "The plate's actual direction is retained")
	TEST_ASSERT(QDELETED(I), "The constructor consumes the actual input marker after recording its turf")

/datum/unit_test/dq_a10_content_init/vial_and_blood/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/item/reagent_containers/hypospray/vial/H = allocate(/obj/item/reagent_containers/hypospray/vial, test_floor())
	TEST_ASSERT_NOTNULL(H.loaded_vial, "The declared starting vial exists before its setup job")
	TEST_ASSERT_EQUAL(H.volume, H.loaded_vial.volume, "The actual hypospray inherits the starting vial's volume")
	TEST_ASSERT_EQUAL(H.reagents.maximum_volume, H.loaded_vial.reagents.maximum_volume, "The actual hypospray copies the starting vial's reagent capacity")
	TEST_ASSERT_EQUAL(H.icon_state, initial(H.icon_state), "Setup preserves the old reset to the type's sprite")
	var/obj/item/reagent_containers/blood/OPlus/B = allocate(/obj/item/reagent_containers/blood/OPlus, test_floor())
	TEST_ASSERT_EQUAL(B.label_text, "O+", "The actual stock blood pack receives its type's label")
	TEST_ASSERT_EQUAL(B.base_name, initial(B.name), "Base-name capture still occurs before the label job")
	TEST_ASSERT_EQUAL(B.name, "[B.base_name] (O+)", "The real label job updates the visible pack name")
