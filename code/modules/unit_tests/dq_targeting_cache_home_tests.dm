/datum/unit_test/dq_targeting_cache_home
/datum/unit_test/dq_targeting_cache_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/mob/living/simple_mob/e0_fixture/actor = allocate(/mob/living/simple_mob/e0_fixture, T)
	var/mob/living/simple_mob/e0_fixture/target = allocate(/mob/living/simple_mob/e0_fixture, get_step(T, EAST))
	TEST_ASSERT_NULL(target.aimed, "an untargeted mob allocates no incoming-aim list")
	var/obj/aiming_overlay/O = allocate(/obj/aiming_overlay, actor)
	var/obj/item/pen/tool = allocate(/obj/item/pen, T)
	TEST_ASSERT_EQUAL(O.owner(), actor, "the real overlay adopts its explicit living owner")
	O.aim_at(target, tool)
	TEST_ASSERT_EQUAL(O.aiming_at, target, "the real aim transaction targets the actual mob")
	TEST_ASSERT(O in target.aimed, "native reverse membership materializes when the actual aim starts")
	O.cancel_aiming(TRUE)
	TEST_ASSERT(!LAZYLEN(target.aimed), "canceling the real aim removes its reverse membership")
	TEST_ASSERT_NULL(O.aiming_at, "the original target relation is cleared too")
