#if defined(UNIT_TESTS) || defined(SPACEMAN_DMM)

/datum/unit_test/dq_portable_cell_redraw/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	for(var/machine_type in list(/obj/machinery/portable_atmospherics/powered/pump, /obj/machinery/portable_atmospherics/powered/scrubber))
		var/obj/machinery/portable_atmospherics/powered/M = allocate(machine_type, test_floor())
		var/obj/item/cell/C = M.cell
		TEST_ASSERT(C, "Portable machine did not create its real starting cell")
		C.set_charge(C.maxcharge)
		M.set_on(TRUE)
		test_drain()
		var/on_state = M.icon_state
		TEST_ASSERT(findtext(on_state, ":1"), "Charged running machine did not draw its on state")
		C.set_charge(0)
		test_drain()
		TEST_ASSERT(findtext(M.icon_state, ":0"), "Real cell setter did not redraw the warmed machine")
		C.set_charge(C.maxcharge)
		test_drain()
		TEST_ASSERT_EQUAL(M.icon_state, on_state, "Charge restoration did not restore the real machine look")

/datum/unit_test/dq_stored_cell_redraw/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	for(var/holder_type in list(/obj/machinery/cell_charger, /obj/machinery/floodlight, /obj/machinery/space_heater))
		var/obj/machinery/M = allocate(holder_type, test_floor())
		var/slot_name = istype(M, /obj/machinery/cell_charger) ? "charging" : "cell"
		var/obj/item/cell/C = M.vars[slot_name]
		if(!C)
			C = allocate(/obj/item/cell, M)
			rel_set(M, slot_name, C)
		TEST_ASSERT_EQUAL(M.vars[slot_name], C, "Charge probe must use the real bay occupant")
		C.set_charge(0)
		test_drain()
		TEST_ASSERT(("b_st_0" in dq_overlay_states(C)), "Actual stored cell did not draw its empty charge overlay")
		C.give(C.maxcharge)
		test_drain()
		TEST_ASSERT(("b_st_100" in dq_overlay_states(C)), "Real give() did not redraw the stored cell")
		TEST_ASSERT(!("b_st_0" in dq_overlay_states(C)), "Old cell charge overlay survived the native redraw")

/datum/unit_test/dq_recharger_energy_native_redraw/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/obj/machinery/recharger/R = allocate(/obj/machinery/recharger, test_floor())
	var/obj/item/gun/energy/laser/G = allocate(/obj/item/gun/energy/laser, R)
	var/obj/item/cell/C = G.power_supply
	TEST_ASSERT(C, "Real laser did not create its actual power supply")
	rel_set(R, nameof(R.charging), G)
	C.set_charge(C.maxcharge)
	test_drain()
	var/full_state = G.icon_state
	C.set_charge(0)
	test_drain()
	TEST_ASSERT_NOTEQUAL(G.icon_state, full_state, "Emptying the stored laser's actual cell did not redraw its meter")
	C.give(C.maxcharge)
	test_drain()
	TEST_ASSERT_EQUAL(G.icon_state, full_state, "Real recharge did not restore the stored laser's meter")

#endif
