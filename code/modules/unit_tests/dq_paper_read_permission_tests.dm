// Paper is admitted by an actual native reading permission, independent of universal language comprehension.
/datum/unit_test/dq_paper_read_permission
/datum/unit_test/dq_paper_read_permission/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	TEST_ASSERT(!kind_of_type(/mob).reads_paper, "generic mob has no paper-reading permission")
	TEST_ASSERT(!kind_of_type(/mob/observer).reads_paper, "observer parent is not the dead-observer predicate")
	TEST_ASSERT(!kind_of_type(/mob/observer/blob).reads_paper, "nondead blob observer does not gain inherent paper permission")
	TEST_ASSERT(kind_of_type(/mob/observer/blob).understands_all, "blob's independent universal understanding still admits it")
	TEST_ASSERT(kind_of_type(/mob/observer/dead).reads_paper, "exact isobserver root has paper permission")
	TEST_ASSERT(kind_of_type(/mob/living/carbon/human).reads_paper, "human root has paper permission")
	TEST_ASSERT(kind_of_type(/mob/living/carbon/human/dummy).reads_paper, "human subtype inherits even when its HUD policy differs")
	TEST_ASSERT(kind_of_type(/mob/living/silicon).reads_paper, "silicon root has paper permission")
	TEST_ASSERT(kind_of_type(/mob/living/silicon/robot/drone).reads_paper, "silicon subtype retains inherent paper permission")
	var/obj/item/paper/P = allocate(/obj/item/paper, test_floor())
	var/mob/living/simple_mob/A = allocate(/mob/living/simple_mob, test_floor())
	var/mob/living/simple_mob/B = allocate(/mob/living/simple_mob, test_floor())
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	P.show_content(H)
	TEST_ASSERT(P.can_read_view, "actual human paper entry is allowed")
	P.show_content(A)
	TEST_ASSERT(!P.can_read_view, "actual ordinary simple-mob entry remains garbled")
	A.set_reads_paper(TRUE)
	TEST_ASSERT(!kind_of(A).understands_all, "paper literacy does not confer universal language comprehension")
	P.show_content(A)
	TEST_ASSERT(P.can_read_view, "actual native reading permission admits a nonhuman independently")
	P.show_content(B)
	TEST_ASSERT(!P.can_read_view, "native permission edit remains instance-local")
	TEST_ASSERT(!kind_of_type(A.type).reads_paper, "compiled parent permission remains unchanged")
	A.set_reads_paper(null)
	TEST_ASSERT_NULL(kind_of(A).reads_paper, "explicit null remains null")
	P.show_content(A)
	TEST_ASSERT(!P.can_read_view, "null reading permission is falsey")
	A.set_universal_understand(TRUE)
	P.show_content(A)
	TEST_ASSERT(P.can_read_view, "independent universal understanding preserves the original fallback")
	A.set_universal_understand(0)
	P.show_content(A, "forced")
	TEST_ASSERT(P.can_read_view, "truthy forceshow still overrides both permissions")
	P.show_content(null, TRUE)
	TEST_ASSERT(P.can_read_view, "forceshow remains safe with a null reader")
	P.show_content(null)
	TEST_ASSERT(!P.can_read_view, "null reader without force remains denied")
