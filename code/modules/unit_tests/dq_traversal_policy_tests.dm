/datum/unit_test/dq_traversal_policy_home
/datum/unit_test/dq_traversal_policy_home/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/A = test_floor()
	var/turf/B = get_step(A, EAST)
	TEST_ASSERT(B && !B.density, "real traversal needs adjacent open fixture floor")
	var/obj/obstacle = allocate(/obj, B)
	var/obj/peer = allocate(/obj, B)
	obstacle.set_density(TRUE)
	TEST_ASSERT_NOTNULL(static_entry_of(/atom, ENTRY_TRAVERSAL_POLICY), "the actual atom root supplies traversal policy, including turfs")
	TEST_ASSERT_EQUAL(traversal_policy_of_type(/atom).throwpass, 0, "compiled atom default retains numeric zero")
	TEST_ASSERT_EQUAL(traversal_policy_of_type(/turf).throwpass, 0, "turfs inherit the same root rather than a movable-only replacement")
	TEST_ASSERT_EQUAL(traversal_policy_of_type(/obj/structure/table).throwpass, 1, "real table compiled default remains passable")
	TEST_ASSERT(!("throwpass" in obstacle.vars), "no raw atom field shadows native policy")
	var/link_before = LinkBlocked(A, B)
	TEST_ASSERT_EQUAL(B.ClickCross(WEST, FALSE), 0, "dense zero-policy object blocks actual click crossing")
	TEST_ASSERT(vars_write(obstacle, "throwpass", 1), "the real historical map field name routes to native policy")
	TEST_ASSERT_EQUAL(B.ClickCross(WEST, FALSE), 1, "historical map edit permits actual click crossing immediately")
	TEST_ASSERT_EQUAL(LinkBlocked(A, B), link_before, "airspace LinkBlocked has always been independent of throwpass")
	TEST_ASSERT_EQUAL(traversal_policy_of(peer).throwpass, 0, "map edit is copy-on-write")
	TEST_ASSERT(obstacle.vv_edit_var("@traversal_policy.throwpass", 0), "actual VV accepts explicit zero")
	TEST_ASSERT_EQUAL(B.ClickCross(WEST, FALSE), 0, "VV zero blocks actual crossing again")
	obstacle.set_throwpass(null)
	TEST_ASSERT_NULL(traversal_policy_of(obstacle).throwpass, "setter preserves null separately from numeric zero")
	TEST_ASSERT_EQUAL(B.ClickCross(WEST, FALSE), 0, "old null falsey interpretation is preserved")
	obstacle.set_throwpass("opaque truthy policy")
	TEST_ASSERT_EQUAL(traversal_policy_of(obstacle).throwpass, "opaque truthy policy", "arbitrary old values are never coerced to boolean")
	TEST_ASSERT_EQUAL(B.ClickCross(WEST, FALSE), 1, "arbitrary truthy old policy still passes")
	var/obj/item/projectile = allocate(/obj/item, A)
	var/datum/thrownthing/flight = allocate(/datum/thrownthing, projectile, B, EAST, 1, 1, null, FALSE, 1, TRUE)
	TEST_ASSERT(!flight.hitcheck(B), "actual thrown contact skips truthy-policy dense object")
	obstacle.set_throwpass(0)
	TEST_ASSERT(flight.hitcheck(B), "actual thrown contact hits same object immediately after zero setter")
	TEST_ASSERT(QDELETED(flight), "real hit finalizes its flight")

/datum/unit_test/dq_traversal_policy_map_zero
/datum/unit_test/dq_traversal_policy_map_zero/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/structure/table/T = allocate(/obj/structure/table, test_floor())
	var/obj/structure/table/peer = allocate(/obj/structure/table, test_floor())
	TEST_ASSERT(vars_write(T, "throwpass", 0), "map override zero is explicit, never replaced by truthy type default")
	TEST_ASSERT_EQUAL(traversal_policy_of(T).throwpass, 0, "map zero overrides a real default-one type")
	TEST_ASSERT_EQUAL(traversal_policy_of(peer).throwpass, 1, "another real default-one table retains shared configuration")
	TEST_ASSERT_EQUAL(traversal_policy_of_type(/obj/structure/table).throwpass, 1, "COW never mutates compiled type default")

// Observe real throw finalization without replacing its contact/selection behavior.
/obj/item/dq_traversal_projectile
	var/atom/last_impact
/obj/item/dq_traversal_projectile/throw_impact(atom/hit_atom)
	last_impact = hit_atom
	return ..()

/datum/unit_test/dq_traversal_throw_layer_isolation
/datum/unit_test/dq_traversal_throw_layer_isolation/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = test_floor()
	var/turf/destination = get_step(T, EAST)
	var/obj/low = allocate(/obj, destination)
	var/obj/high = allocate(/obj, destination)
	low.set_density(TRUE)
	high.set_density(TRUE)
	set_var(low, "layer", OBJ_LAYER)
	set_var(high, "layer", OBJ_LAYER + 1)
	high.set_throwpass(TRUE)
	var/obj/item/dq_traversal_projectile/one = allocate(/obj/item/dq_traversal_projectile, T)
	var/datum/thrownthing/first = allocate(/datum/thrownthing, one, destination, EAST, 1, 1, null, FALSE, 1, TRUE)
	TEST_ASSERT(first.hitcheck(destination), "actual throw finds lower dense non-passing peer")
	TEST_ASSERT_EQUAL(one.last_impact, low, "passing top layer does not hide lower blocking peer")
	TEST_ASSERT(QDELETED(first), "actual hit finishes first flight")
	high.set_throwpass(0)
	var/obj/item/dq_traversal_projectile/two = allocate(/obj/item/dq_traversal_projectile, T)
	var/datum/thrownthing/second = allocate(/datum/thrownthing, two, destination, EAST, 1, 1, null, FALSE, 1, TRUE)
	TEST_ASSERT(second.hitcheck(destination), "actual throw finds restored blocking peer")
	TEST_ASSERT_EQUAL(two.last_impact, high, "highest eligible layer still wins")
	TEST_ASSERT_EQUAL(traversal_policy_of(low).throwpass, 0, "editing high peer never changes low peer's policy")
