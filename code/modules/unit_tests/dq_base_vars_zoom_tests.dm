// Actual native view lifetimes and endpoints; no fabricated clients or overridden start().
/datum/unit_test/dq_base_vars_zoom

/datum/unit_test/dq_base_vars_zoom/proc/owned_view(mob/H, obj/item/I)
	var/datum/remote_view/item_zoom/V = new(H)
	link_set_one(V, LK_ZOOM_ITEM, I)
	rel_set(H, nameof(H.remote_view), V)
	return V

/datum/unit_test/dq_base_vars_zoom/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/binoculars/I = allocate(/obj/item/binoculars, test_floor())
	var/obj/item/binoculars/other = allocate(/obj/item/binoculars, test_floor())
	var/datum/remote_view/item_zoom/V = owned_view(H, I)
	TEST_ASSERT_EQUAL(owner_of(V), H, "real ownership remains on the viewing mob")
	TEST_ASSERT(item_zoom_active(I) && !item_zoom_active(other), "actual association activates only the exact device")
	TEST_ASSERT_EQUAL(link_get(I, LK_ITEM_ZOOM_VIEW), V, "reciprocal endpoint names the exact actual view")
	qdel(V)
	TEST_ASSERT(!item_zoom_active(I) && !QDELETED(I) && !QDELETED(H), "view destruction clears state without deleting borrowed endpoints")
	V = owned_view(H, I)
	V.forget_host()
	qdel(V)
	TEST_ASSERT(!item_zoom_active(I), "forget_host then real destruction clears zoom without a remaining host reference")

/datum/unit_test/dq_base_vars_zoom/replacement_and_host_death

/datum/unit_test/dq_base_vars_zoom/replacement_and_host_death/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	var/obj/item/binoculars/I = allocate(/obj/item/binoculars, test_floor())
	var/datum/remote_view/item_zoom/old = owned_view(H, I)
	var/datum/remote_view/item_zoom/replacement = owned_view(H, I)
	TEST_ASSERT(QDELETED(old), "actual ownership replacement deletes the old view")
	TEST_ASSERT(item_zoom_active(I) && link_get(I, LK_ITEM_ZOOM_VIEW) == replacement, "old cleanup cannot clear its replacement's actual item endpoint")
	var/datum/remote_view/plain = H.begin_remote_view(/datum/remote_view, H, null, /datum/remote_view_config)
	TEST_ASSERT(plain && QDELETED(replacement), "actual generic begin_remote_view replaces the item view")
	TEST_ASSERT(!item_zoom_active(I), "a non-item view leaves no stale optical state")
	var/datum/remote_view/item_zoom/final_view = owned_view(H, I)
	qdel(H)
	TEST_ASSERT(QDELETED(final_view), "viewer destruction deletes its truly owned view")
	TEST_ASSERT(!item_zoom_active(I) && !QDELETED(I), "viewer destruction clears only the borrowed item association")

/datum/unit_test/dq_base_vars_zoom/config_and_public_refusal

/datum/unit_test/dq_base_vars_zoom/config_and_public_refusal/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/obj/item/binoculars/A = allocate(/obj/item/binoculars, test_floor())
	var/obj/item/binoculars/B = allocate(/obj/item/binoculars, test_floor())
	var/obj/item/gun/energy/monorifle/G = allocate(/obj/item/gun/energy/monorifle, test_floor())
	TEST_ASSERT_NULL(optical_view_of(A).device_name, "actual binoculars retain null name fallback")
	TEST_ASSERT_EQUAL(optical_view_of(G).device_name, "scope", "the actual gun retains its scope label")
	TEST_ASSERT_EQUAL(optical_view_of(A), optical_view_of(B), "unchanged types share immutable native configuration")
	set_trait(A, ENTRY_OPTICAL_VIEW, "device_name", "range finder")
	TEST_ASSERT_EQUAL(optical_view_of(A).device_name, "range finder", "actual config setter applies an item override")
	TEST_ASSERT_NULL(optical_view_of(B).device_name, "copy-on-write leaves the other device unchanged")
	set_trait(A, ENTRY_OPTICAL_VIEW, "device_name", null)
	TEST_ASSERT_NULL(optical_view_of(A).device_name, "the actual config writer can restore null fallback")
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, test_floor())
	TEST_ASSERT_NULL(H.client, "public refusal control is explicitly headless")
	TEST_ASSERT(H.put_in_active_hand(A), "the actual human holds the device")
	TEST_ASSERT_EQUAL(A.zoom(H), FALSE, "public zoom still refuses without an actual client")
	TEST_ASSERT(!item_zoom_active(A) && !H.is_remote_viewing(), "refusal creates neither optical association nor view")
