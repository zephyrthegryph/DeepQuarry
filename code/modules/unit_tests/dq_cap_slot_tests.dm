// The slot capability and capability examine lines (code/datums/capabilities/slot.dm, holder.dm).

/obj/item/cap_slot_probe
	name = "slot probe"
	var/obj/item/cell/cell
	var/obj/item/tool/screwdriver/driver
	var/steady = TRUE
	var/inserted_count = 0
	var/ejected_count = 0

/obj/item/cap_slot_probe/capabilities()
	. = ..()
	. += cap_slot(nameof(cell), /obj/item/cell, needs = PROC_REF(is_steady), else_say = "hold it steady", eject_via = SLOT_VIA_ALT|SLOT_VIA_USE, examine_held = "It holds %I%.", examine_empty = "It has no cell.", slot_type = /datum/capability/slot/probe_cell)
	. += cap_slot(nameof(driver), /obj/item/tool/screwdriver, name = "Stow driver", eject_via = SLOT_VIA_NONE)

/obj/item/cap_slot_probe/proc/is_steady(mob/user, obj/item/held)
	return steady

/// The probe's cell slot: its hooks are procs of a slot subtype taking the holder (no proc on /atom).
/datum/capability/slot/probe_cell

/datum/capability/slot/probe_cell/refusal(obj/item/cap_slot_probe/holder, obj/item/item, mob/user)
	if(istype(item, /obj/item/cell/device))
		return "Too small."
	return ..()

/datum/capability/slot/probe_cell/inserted(obj/item/cap_slot_probe/holder, obj/item/item, mob/user)
	holder.inserted_count++

/datum/capability/slot/probe_cell/ejected(obj/item/cap_slot_probe/holder, obj/item/item, mob/user)
	holder.ejected_count++

/obj/item/cap_slot_probe/examine_lines(mob/user)
	. = ..()
	. += "Bespoke line."

/obj/item/cap_slot_probe/child/capabilities()
	. = ..()
	. = without(., "slot:[nameof(driver)]")

/// capabilities() is cached per type; slot() builds its interactions; without() removes an entry.
/datum/unit_test/dq_cap_slot_declaration

/datum/unit_test/dq_cap_slot_declaration/Run()
	var/turf/T = test_floor()
	var/obj/item/cap_slot_probe/probe = allocate(/obj/item/cap_slot_probe, T)
	var/obj/item/cap_slot_probe/other = allocate(/obj/item/cap_slot_probe, T)
	TEST_ASSERT(caps_of(probe) == caps_of(other), "one list per type")
	var/datum/capability/slot/cell_cap = slot_capability(probe, nameof(probe.cell))
	TEST_ASSERT_EQUAL(length(cell_cap.interactions(probe)), 3, "insert plus an eject per SLOT_VIA flag")
	var/datum/capability/slot/driver_cap = slot_capability(probe, nameof(probe.driver))
	TEST_ASSERT_EQUAL(length(driver_cap.interactions(probe)), 1, "SLOT_VIA_NONE generates no eject")
	TEST_ASSERT_EQUAL(driver_cap.name, "Stow driver", "a named arg")
	TEST_ASSERT_EQUAL(cell_cap.full_msg, "%T% already holds %I%.", "messages are generated by default")
	var/obj/item/cap_slot_probe/child/child = allocate(/obj/item/cap_slot_probe/child, T)
	TEST_ASSERT_NULL(slot_capability(child, nameof(child.driver)), "without() removes an inherited entry")
	var/list/entries = cap_built_entries(cell_cap, probe)
	var/datum/interaction/capability/insert = entries[1]
	TEST_ASSERT(locate(/datum/interaction/capability/slot_insert) in interaction_candidates(probe), "the resolver offers capability interactions")
	TEST_ASSERT_EQUAL(insert.cap, cell_cap, "an entry names its capability")

/// Insert and eject: capacity, hooks, needs, ownership, examine and UI data.
/datum/unit_test/dq_cap_slot_insert_eject

/datum/unit_test/dq_cap_slot_insert_eject/Run()
	var/turf/T = test_floor()
	var/obj/item/cap_slot_probe/probe = allocate(/obj/item/cap_slot_probe, T)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/item/cell/first = allocate(/obj/item/cell, T)
	var/obj/item/cell/second = allocate(/obj/item/cell, T)
	var/datum/capability/slot/cap = slot_capability(probe, nameof(probe.cell))
	var/list/entries = cap_built_entries(cap, probe)
	var/datum/interaction/insert = entries[1]
	var/datum/interaction/eject_alt = entries[2]

	TEST_ASSERT(!eject_alt.applies_to(probe), "eject is not offered while empty")
	TEST_ASSERT(sys_cap_index(probe.examine(H), "It has no cell."), "the empty examine line")
	H.put_in_active_hand(first)
	probe.steady = FALSE
	TEST_ASSERT_EQUAL(insert.why_not(H, probe, first), "hold it steady", "needs refuses with else_say")
	probe.steady = TRUE
	TEST_ASSERT(insert.perform(H, probe, first), "inserting runs")
	TEST_ASSERT(probe.cell == first && first.loc == probe, "moved in and held")
	TEST_ASSERT(!H.is_in_hands(first), "out of the actor's hands")
	TEST_ASSERT_EQUAL(probe.inserted_count, 1, "slot_inserted() ran once")
	var/list/lines = probe.examine(H)
	TEST_ASSERT(sys_cap_index(lines, "It holds"), "the held examine line")
	TEST_ASSERT(sys_cap_index(lines, "Bespoke line.") > sys_cap_index(lines, "It holds"), "a bespoke override follows the capability lines")
	var/list/data = list()
	caps_ui_data(probe, H, data)
	TEST_ASSERT_EQUAL(data["caps"]?[nameof(probe.cell)]?["item"]?["ref"], REF(first), "UI data names the item, nested under caps")
	TEST_ASSERT_NULL(data[nameof(probe.cell)], "no top-level key (M11)")

	H.put_in_active_hand(second)
	TEST_ASSERT(insert.perform(H, probe, second), "a full slot answers with a refusal")
	TEST_ASSERT(probe.cell == first && H.is_in_hands(second), "and keeps its item")

	TEST_ASSERT(eject_alt.perform(H, probe, null), "ejecting runs")
	TEST_ASSERT_NULL(probe.cell, "the var is cleared")
	TEST_ASSERT(first.loc != probe, "the item left")
	TEST_ASSERT_EQUAL(probe.ejected_count, 1, "slot_ejected() ran once")

	var/obj/item/cell/device/small = allocate(/obj/item/cell/device, T)
	H.drop_item()
	H.put_in_active_hand(small)
	TEST_ASSERT(insert.perform(H, probe, small), "a hook refusal answers")
	TEST_ASSERT_NULL(probe.cell, "slot_refusal() keeps it out")

	var/obj/item/tool/wrench/wrench = allocate(/obj/item/tool/wrench, T)
	TEST_ASSERT(!slot_insert(probe, nameof(probe.cell), wrench, H), "slot_insert(src) refuses a type it doesn't accept")
	TEST_ASSERT(slot_insert(probe, nameof(probe.cell), second, H), "slot_insert(src) from code")
	TEST_ASSERT(slot_eject(probe, nameof(probe.cell), H) == second, "slot_eject(src) from code")
	TEST_ASSERT_NULL(slot_ui(null), "slot_ui() of nothing")

/proc/sys_cap_index(list/lines, text)
	for(var/i in 1 to length(lines))
		if(findtext(lines[i], text))
			return i
	return 0
