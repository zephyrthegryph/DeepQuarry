// A5: real subtype constructors prove ordered lifecycle jobs.
/datum/unit_test/dq_a5_mob_init
	abstract_type = /datum/unit_test/dq_a5_mob_init

/datum/unit_test/dq_a5_mob_init/New()
	..()
	dview(0, test_floor())
	status_policies()

/datum/unit_test/dq_a5_mob_init/digital_views/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/obj/item/mmi/digital/base = allocate(/obj/item/mmi/digital, test_floor())
	var/obj/item/mmi/digital/robot/robot = allocate(/obj/item/mmi/digital/robot, test_floor())
	var/obj/item/mmi/digital/posibrain/posi = allocate(/obj/item/mmi/digital/posibrain, test_floor())
	for(var/obj/item/mmi/digital/MMI in list(base, robot, posi))
		var/mob/living/carbon/brain/view = MMI.get_occupant()
		TEST_ASSERT_NOTNULL(view, "The actual digital constructor boots its empty brain view")
		TEST_ASSERT(!QDELETED(view), "The booted view is alive")
		TEST_ASSERT_NULL(view.host_tissue(), "Digital hosts boot without organic tissue")
		TEST_ASSERT_EQUAL(stat_value(view, STAT_MUTED), 0, "The booted view is not muted")
	var/mob/living/carbon/brain/R = robot.get_occupant()
	var/mob/living/carbon/brain/P = posi.get_occupant()
	TEST_ASSERT(findtext(R.real_name, "-"), "The robot subtype names its parent's already booted view")
	TEST_ASSERT_EQUAL(R.name, R.real_name, "Robot view name follows the generated designation")
	TEST_ASSERT_EQUAL(R.identity().real_name, R.real_name, "Robot designation reaches the actual identity")
	TEST_ASSERT(findtext(robot.name, R.name), "The robotic MMI receives the same view designation")
	TEST_ASSERT(findtext(P.real_name, "-"), "The posibrain subtype names its parent's already booted view")
	TEST_ASSERT_EQUAL(P.identity().real_name, P.real_name, "Posibrain designation reaches the actual identity")

/datum/unit_test/dq_a5_mob_init/visualnets/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/mob/observer/eye/aiEye/AI = allocate(/mob/observer/eye/aiEye, test_floor())
	var/mob/observer/eye/maskEye/cult = allocate(/mob/observer/eye/maskEye, test_floor())
	TEST_ASSERT_EQUAL(AI.visualnet, GLOB.cameranet, "AI eye joins the actual camera network before materializing")
	TEST_ASSERT_EQUAL(cult.visualnet, GLOB.cultnet, "Cult eye joins the actual cult network before materializing")

/datum/unit_test/dq_a5_mob_init/plane_filters/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/atom/movable/screen/plane_master/lighting/light = allocate(/atom/movable/screen/plane_master/lighting, test_floor())
	var/atom/movable/screen/plane_master/emissive/emissive = allocate(/atom/movable/screen/plane_master/emissive, test_floor())
	var/atom/movable/screen/plane_master/openspace/openspace = allocate(/atom/movable/screen/plane_master/openspace, test_floor())
	TEST_ASSERT(light.get_filter("emissives"), "Lighting plane masks emissives")
	TEST_ASSERT(light.get_filter("object_lighting"), "Lighting plane masks object lighting")
	TEST_ASSERT(emissive.get_filter("em_block_masking"), "Emissive plane applies its color-matrix mask")
	TEST_ASSERT(openspace.get_filter("first_stage_openspace"), "Openspace plane has its first shadow stage")
	TEST_ASSERT(openspace.get_filter("second_stage_openspace"), "Openspace plane has its second shadow stage")

/datum/unit_test/dq_a5_mob_init/worm_chain/proc/unlink_fixture_worms(list/worms)
	for(var/mob/living/simple_mob/animal/space/space_worm/W as anything in worms)
		if(!QDELETED(W))
			rel_clear(W, nameof(W.previous))
			rel_clear(W, nameof(W.next))

/datum/unit_test/dq_a5_mob_init/worm_chain/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/turf/T = test_floor()
	var/list/before = contents_of(T, /mob/living/simple_mob/animal/space/space_worm)
	var/mob/living/simple_mob/animal/space/space_worm/head/short/H = allocate(/mob/living/simple_mob/animal/space/space_worm/head/short, T)
	var/list/worms
	for(var/mob/living/simple_mob/animal/space/space_worm/W as anything in contents_of(T, /mob/living/simple_mob/animal/space/space_worm))
		if(W in before)
			continue
		own(W)
		LAZYADD(worms, W)
	defer_cleanup(src, PROC_REF(unlink_fixture_worms), worms)
	TEST_ASSERT_EQUAL(length(worms), 4, "The actual short head builds its three body segments")
	var/mob/living/simple_mob/animal/space/space_worm/current = H
	for(var/i in 1 to 3)
		var/mob/living/simple_mob/animal/space/space_worm/segment = current.previous
		TEST_ASSERT_NOTNULL(segment, "Each selected body segment is linked from the preceding original segment")
		TEST_ASSERT_EQUAL(segment.next, current, "The segment links back to the actual preceding segment")
		TEST_ASSERT_EQUAL(segment.faction, H.faction, "The segment inherits its real head's faction")
		current = segment
	TEST_ASSERT_NULL(current.previous, "The third body segment is the end of the original short chain")
	var/mob/living/simple_mob/animal/space/space_worm/head/severed/severed = allocate(/mob/living/simple_mob/animal/space/space_worm/head/severed, T)
	TEST_ASSERT_NULL(severed.previous, "A severed head's real zero-count setting suppresses segment construction")

/datum/unit_test/dq_a5_mob_init/construct_spells/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/mob/living/simple_mob/construct/juggernaut/C = allocate(/mob/living/simple_mob/construct/juggernaut, test_floor())
	TEST_ASSERT_EQUAL(length(C.spell_list), length(C.construct_spells), "The actual construct receives every configured spell")
	for(var/path in C.construct_spells)
		var/found = FALSE
		for(var/datum/spell/S as anything in C.spell_list)
			if(S.type == path)
				found = TRUE
		TEST_ASSERT(found, "The configured spell [path] is an instantiated spell on its construct")

/datum/unit_test/dq_a5_mob_init/multibelt_tools/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	var/mob/living/silicon/robot/R = allocate(/mob/living/silicon/robot, test_floor())
	var/obj/item/robotic_multibelt/belt = allocate(/obj/item/robotic_multibelt, R.module)
	TEST_ASSERT(length(belt.integrated_tools_by_name), "The actual belt prepares its tool-name index")
	for(var/path in belt.cyborg_integrated_tools)
		var/obj/item/tool = belt.integrated_tool_at(path)
		TEST_ASSERT(tool && !QDELETED(tool), "Every configured integrated tool is a real live item")
		TEST_ASSERT_EQUAL(tool.loc, belt, "Each actual tool is inside its belt")
		TEST_ASSERT(tool.name in belt.integrated_tools_by_name, "The prepared menu index includes each tool's name")
		TEST_ASSERT_NOTNULL(belt.integrated_tool_images[tool.name], "The prepared radial menu contains each tool's image")

/datum/unit_test/dq_a5_mob_init/woof_population/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.woof_current), GLOB.woof_current)
	set_global(nameof(GLOB.woof_maximum), GLOB.woof_maximum)
	var/initial_count = GLOB.woof_current
	var/mob/living/simple_mob/vore/woof/hostile/aweful/W = allocate(/mob/living/simple_mob/vore/woof/hostile/aweful, test_floor())
	TEST_ASSERT_EQUAL(GLOB.woof_current, initial_count + 1, "The actual woof constructor joins the population exactly once")
	qdel(W)
	TEST_ASSERT_EQUAL(GLOB.woof_current, initial_count, "Actual deletion reverses the population contribution")
