// Real seat-policy consumers, including mutable runtime and legacy input contracts.
/datum/unit_test/dq_seat_policy
/datum/unit_test/dq_seat_policy/proc/scope_diagnostics()
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
/datum/unit_test/dq_seat_policy/Run()
	scope_diagnostics()
	var/datum/type_trait/seat_policy/base = seat_policy_of_type(/atom/movable)
	TEST_ASSERT_EQUAL(base.movable, 0, "base seat does not carry riders")
	TEST_ASSERT_EQUAL(base.direction, 0, "zero uses holder direction")
	TEST_ASSERT_EQUAL(base.lying, -1, "minus one preserves existing posture")
	TEST_ASSERT_EQUAL(base.require_restraints, 0, "base does not require cuffs")
	TEST_ASSERT_EQUAL(base.capacity, 1, "base capacity remains one")
	TEST_ASSERT_EQUAL(seat_policy_of_type(/obj/structure/bed).lying, 1, "actual beds force prone")
	TEST_ASSERT_EQUAL(seat_policy_of_type(/obj/structure/bed/chair).lying, 0, "actual chairs force seated posture")
	TEST_ASSERT_EQUAL(seat_policy_of_type(/obj/structure/bed/chair/office).movable, 1, "actual office chair carries its rider")
	TEST_ASSERT_EQUAL(seat_policy_of_type(/obj/machinery/atmospherics/pipe).lying, -1, "actual pipes preserve posture")
	TEST_ASSERT(seat_policy_of_type(/obj/machinery/atmospherics/pipe).lying, "minus one remains truthy for augment admission")
	TEST_ASSERT_EQUAL(seat_policy_of_type(/obj/machinery/atmospherics/pipe).require_restraints, 1, "actual pipe requires cuffs")
	var/obj/structure/bed/chair/office/A = allocate(/obj/structure/bed/chair/office, test_floor())
	var/obj/structure/bed/chair/office/B = allocate(/obj/structure/bed/chair/office, test_floor())
	TEST_ASSERT_EQUAL(seat_policy_of(A), seat_policy_of(B), "unchanged peers share immutable declared policy")
	TEST_ASSERT(vars_write(A, "buckle_movable", 0), "historical mapper alias accepts explicit zero")
	TEST_ASSERT_EQUAL(seat_policy_of(A).movable, 0, "zero overrides inherited true")
	TEST_ASSERT_EQUAL(seat_policy_of(B).movable, 1, "peer remains true")
	TEST_ASSERT(seat_policy_of(A) != seat_policy_of(B), "actual legacy-name mutation uses COW")
	TEST_ASSERT(A.vv_edit_var("@seat_policy.capacity", 2), "real admin trait edit accepts capacity")
	TEST_ASSERT_EQUAL(seat_policy_of(A).capacity, 2, "admin changes actual admission value")
	TEST_ASSERT_EQUAL(seat_policy_of(B).capacity, 1, "admin leaves peer capacity untouched")
	TEST_ASSERT_EQUAL(seat_policy_of_type(A.type).capacity, 1, "type default stays immutable")
	for(var/key in list("buckle_movable", "buckle_dir", "buckle_lying", "buckle_require_restraints", "max_buckled_mobs"))
		TEST_ASSERT(!(key in A.vars), "[key] has no shadow physical base field")

/datum/unit_test/dq_seat_policy/map_aliases
/datum/unit_test/dq_seat_policy/map_aliases/Run()
	scope_diagnostics()
	SSatoms.map_loader_begin("dq_seat_policy")
	var/obj/structure/bed/chair/office/S = new(test_floor())
	var/list/values = list("buckle_movable" = 0, "buckle_dir" = EAST, "buckle_lying" = -1, "buckle_require_restraints" = TRUE, "max_buckled_mobs" = 0)
	var/all_accepted = TRUE
	for(var/key in values)
		all_accepted = vars_write(S, key, values[key]) && all_accepted
	SSatoms.map_loader_stop("dq_seat_policy")
	own(S)
	SSatoms.InitializeAtoms(list(S))
	TEST_ASSERT(all_accepted && !QDELETED(S), "all five actual legacy aliases apply before mapped parent init")
	var/datum/type_trait/seat_policy/P = seat_policy_of(S)
	TEST_ASSERT_EQUAL(P.movable, 0, "mapped zero survives initialization")
	TEST_ASSERT_EQUAL(P.direction, EAST, "mapped direction survives initialization")
	TEST_ASSERT_EQUAL(P.lying, -1, "mapped negative sentinel survives initialization")
	TEST_ASSERT(P.require_restraints, "mapped restraints survives initialization")
	TEST_ASSERT_EQUAL(P.capacity, 0, "mapped zero capacity survives initialization")
	var/mob/living/simple_mob/e0_fixture/M = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	TEST_ASSERT(!S.can_buckle_check(M, TRUE), "actual forced admission still respects zero capacity")

/datum/unit_test/dq_seat_policy/actual_buckle
/datum/unit_test/dq_seat_policy/actual_buckle/Run()
	scope_diagnostics()
	var/turf/T = test_floor()
	var/obj/structure/bed/chair/C = allocate(/obj/structure/bed/chair, T)
	var/mob/living/carbon/human/one = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/two = allocate(/mob/living/carbon/human, T)
	C.set_dir(EAST)
	TEST_ASSERT(C.buckle_mob(one), "actual chair buckles first human")
	TEST_ASSERT_EQUAL(one.buckled_to(), C, "native rider relation points at actual chair")
	TEST_ASSERT_EQUAL(one.dir, EAST, "zero direction follows actual holder")
	TEST_ASSERT(!one.lying, "chair zero forces seated posture")
	TEST_ASSERT(!C.can_buckle_check(two), "capacity one refuses a second actual human")
	TEST_ASSERT(vars_write(C, "max_buckled_mobs", 2), "legacy alias increases capacity at runtime")
	TEST_ASSERT(C.buckle_mob(two), "native runtime capacity admits second human")
	TEST_ASSERT_EQUAL(length(C.buckled_mob_list()), 2, "native relation has exactly two riders")
	C.unbuckle_mob(one)
	C.unbuckle_mob(two)
	TEST_ASSERT(vars_write(C, "buckle_dir", SOUTH), "legacy direction override applies")
	TEST_ASSERT(C.buckle_mob(one), "same real chair accepts recovered rider")
	TEST_ASSERT_EQUAL(one.dir, SOUTH, "explicit direction overrides holder EAST")
	C.unbuckle_mob(one)
	var/obj/structure/bed/B = allocate(/obj/structure/bed, T)
	TEST_ASSERT(B.buckle_mob(one), "actual bed admits patient")
	TEST_ASSERT(one.lying, "bed one forces prone")
	B.unbuckle_mob(one)
	qdel(B)
	var/mob/living/simple_mob/e0_fixture/free = allocate(/mob/living/simple_mob/e0_fixture, T)
	var/mob/living/simple_mob/e0_fixture/lib_cuffed/cuffed = allocate(/mob/living/simple_mob/e0_fixture/lib_cuffed, T)
	TEST_ASSERT(vars_write(C, "buckle_require_restraints", TRUE), "runtime restraints override accepted")
	TEST_ASSERT(!C.can_buckle_check(free), "real free actor refused by restraint policy")
	TEST_ASSERT(C.can_buckle_check(cuffed), "real restrained actor admitted by same policy")
	TEST_ASSERT(C.buckle_mob(cuffed), "actual link transaction accepts restrained actor")
	qdel(C)
	TEST_ASSERT_NULL(cuffed.buckled_to(), "seat destruction releases real rider edge")

/datum/unit_test/dq_seat_policy/teleport_type_reset
/datum/unit_test/dq_seat_policy/teleport_type_reset/Run()
	scope_diagnostics()
	var/turf/T = test_floor()
	var/turf/destination = get_step(T, EAST)
	var/obj/structure/bed/chair/office/S = allocate(/obj/structure/bed/chair/office, T)
	TEST_ASSERT(vars_write(S, "buckle_movable", FALSE), "actual runtime override disables carriage")
	TEST_ASSERT(do_teleport(S, destination, no_effects = TRUE, forced = TRUE), "actual teleporter moves real office chair")
	TEST_ASSERT_EQUAL(S.loc, destination, "actual destination reached")
	TEST_ASSERT_EQUAL(seat_policy_of(S).movable, 1, "teleport restores TYPE initial true, not previous COW false")
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, destination)
	TEST_ASSERT(S.buckle_mob(H), "actual office chair still admits human after reset")
	var/turf/next = get_step(destination, SOUTH)
	S.Move(next, SOUTH)
	TEST_ASSERT_EQUAL(H.loc, next, "actual mobile seat carries rider after teleport reset")
	TEST_ASSERT_EQUAL(H.buckled_to(), S, "rider still belongs to same real seat")

/datum/unit_test/dq_seat_policy/runtime_providers
/datum/unit_test/dq_seat_policy/runtime_providers/Run()
	scope_diagnostics()
	set_global(nameof(GLOB.test_prompts), list())
	test_driver_begin()
	defer_cleanup(null, GLOBAL_PROC_REF(test_driver_end))
	var/turf/T = test_floor()
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/structure/bonfire/F = allocate(/obj/structure/bonfire, T)
	var/obj/item/stack/rods/R = allocate(/obj/item/stack/rods, T)
	R.set_amount(2)
	var/before = R.get_amount()
	TEST_ASSERT_EQUAL(before, 2, "real rod stack has a spare rod so consumption does not delete the subject")
	H.put_in_active_hand(R)
	var/datum/op_result/start = test_click(H, F, R)
	TEST_ASSERT_EQUAL(start?.key, "build", "actual rod click selects native bonfire construction")
	TEST_ASSERT_EQUAL(length(GLOB.test_prompts), 1, "actual construction asks exactly one choice")
	TEST_ASSERT_NULL(test_prompt_answer(GLOB.test_prompts[1], "Stake"), "actual stake answer is accepted")
	TEST_ASSERT_EQUAL(start.outcome, ACT_COMMITTED, "native operation commits after the accepted actual prompt answer")
	TEST_ASSERT(!QDELETED(R), "real two-rod stack survives one-rod stake consumption")
	TEST_ASSERT_EQUAL(R.get_amount(), before - 1, "real stake transaction consumes exactly one rod")
	TEST_ASSERT(F.can_buckle && seat_policy_of(F).require_restraints, "real stake transaction publishes restraint policy")
	var/mob/living/silicon/robot/borg = allocate(/mob/living/silicon/robot, get_step(T, EAST))
	TEST_ASSERT_NULL(borg.robot_belly, "real base robot has no module and no preexisting belly")
	TEST_ASSERT(vars_write(borg, "buckle_movable", FALSE), "prepare opposite runtime carriage policy")
	TEST_ASSERT(vars_write(borg, "buckle_lying", TRUE), "prepare opposite runtime posture policy")
	TEST_ASSERT(vars_write(borg, "max_buckled_mobs", 0), "prepare opposite runtime capacity policy")
	var/datum/robot_belly/belly = borg.add_robot_belly()
	TEST_ASSERT_EQUAL(borg.robot_belly, belly, "actual admission API installs belly in robot ownership relation")
	TEST_ASSERT_EQUAL(borg.add_robot_belly(), belly, "repeated actual entry reuses same owned belly instead of duplicate constructor")
	TEST_ASSERT_EQUAL(belly.owner, borg, "real robot-belly constructor binds actual robot")
	TEST_ASSERT(seat_policy_of(borg).movable, "actual robot-belly entry restores carriage")
	TEST_ASSERT_EQUAL(seat_policy_of(borg).lying, FALSE, "actual robot-belly entry restores seated posture")
	TEST_ASSERT_EQUAL(seat_policy_of(borg).capacity, 1, "actual robot-belly entry restores one rider")
	qdel(borg)
	TEST_ASSERT(QDELETED(belly), "actual robot destruction tears down its owned belly exactly once")
	test_driver_end()

/datum/unit_test/dq_seat_policy/native_slots_independent
/datum/unit_test/dq_seat_policy/native_slots_independent/Run()
