	var/mob/living/simple_mob/e0_fixture/B = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	var/mob/living/simple_mob/e0_fixture/C = allocate(/mob/living/simple_mob/e0_fixture, test_floor())
	test_drag(A, A, S)
