/datum/unit_test/dq_machinery_timed_material_pin/breaker_toggle
/datum/unit_test/dq_machinery_timed_material_pin/breaker_toggle/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/power/breakerbox/M = allocate(/obj/machinery/power/breakerbox, H.loc)
	begin_pin(H, M, null, 5 SECONDS)
	test_time(4 SECONDS)
	TEST_ASSERT(!M.on && !M.update_locked, "the real breaker stays off and unlocked while work is pending")
	test_time(1.1 SECONDS)
	TEST_ASSERT(M.on && M.update_locked, "completion switches the breaker and applies its update lock")
	TEST_ASSERT_EQUAL(M.icon_state, M.icon_state_on, "the actual switch presents its enabled state")
	TEST_ASSERT_NULL(running(H), "the toggle's timed action ends")

/datum/unit_test/dq_machinery_timed_material_pin/breaker_cancel_and_claim
/datum/unit_test/dq_machinery_timed_material_pin/breaker_cancel_and_claim/run_pin()
	var/mob/living/carbon/human/H = person()
	var/mob/living/carbon/human/other = person(H.loc)
	var/obj/machinery/power/breakerbox/M = allocate(/obj/machinery/power/breakerbox, H.loc)
	var/datum/job = begin_pin(H, M, null, 5 SECONDS)
	test_click(other, M, null)
	TEST_ASSERT_NULL(running(other), "a second actual actor cannot start work on the claimed breaker")
	TEST_ASSERT_EQUAL(running(H), job, "the first actor's original action retains its claim")
	H.forceMove(get_step(H, EAST))
	test_time(6 SECONDS)
	TEST_ASSERT(!M.on && !M.update_locked, "moving away leaves the real breaker off without an update lock")
	TEST_ASSERT(was_cancelled(job, H), "the claiming action actually cancels")

/datum/unit_test/dq_machinery_timed_material_pin/camera_repair
/datum/unit_test/dq_machinery_timed_material_pin/camera_repair/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/camera/M = allocate(/obj/machinery/camera, H.loc)
	M.set_broken_condition(TRUE)
	var/obj/item/camera_assembly/assembly = own(M.assembly)
	var/obj/item/weldingtool/W = lit_welder(H)
	var/fuel = W.get_fuel()
	begin_pin(H, M, W, 10 SECONDS)
	test_time(9 SECONDS)
	TEST_ASSERT(!QDELETED(M) && M.assembly == assembly, "the exact broken camera and assembly persist before completion")
	test_time(1.1 SECONDS)
	TEST_ASSERT(QDELETED(M), "completion removes the repaired camera holder")
	TEST_ASSERT_EQUAL(assembly.loc, H.loc, "the original repaired assembly is on the actual floor")
	TEST_ASSERT_EQUAL(assembly.state, 2, "repair yields the original welded assembly state")
	TEST_ASSERT(assembly.anchored, "the repaired original assembly stays anchored")
	TEST_ASSERT_EQUAL(W.get_fuel(), fuel, "legacy camera welding has zero explicit fuel cost")

/datum/unit_test/dq_machinery_timed_material_pin/camera_cancel_and_claim
/datum/unit_test/dq_machinery_timed_material_pin/camera_cancel_and_claim/run_pin()
	var/mob/living/carbon/human/H = person()
	var/mob/living/carbon/human/other = person(H.loc)
	var/obj/machinery/camera/M = allocate(/obj/machinery/camera, H.loc)
	M.set_broken_condition(TRUE)
