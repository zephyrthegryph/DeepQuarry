	H.forceMove(get_step(H, EAST))
	test_time(3 SECONDS)
	TEST_ASSERT_EQUAL(M.state, 1, "cancellation leaves the real assembly unwelded")
	TEST_ASSERT_EQUAL(W.power_supply.charge, charge, "cancellation commits no electric per-use charge")
	TEST_ASSERT(was_cancelled(job, H), "the electric welding action actually cancels")
