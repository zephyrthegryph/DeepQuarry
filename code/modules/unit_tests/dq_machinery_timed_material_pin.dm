// Old-code pins: custody, stack costs, real delays and claiming tool work.
/datum/unit_test/dq_machinery_timed_material_pin
	parent_type = /datum/unit_test/dq_timed_pin
	abstract_type = /datum/unit_test/dq_machinery_timed_material_pin

/datum/unit_test/dq_machinery_timed_material_pin/Run()
	dq_latency_isolate_diagnostics()
	return ..()

/datum/unit_test/dq_machinery_timed_material_pin/proc/equip(mob/living/carbon/human/H, obj/item/I)
	H.drop_item()
	TEST_ASSERT(H.put_in_active_hand(I), "the real input is held by the actual actor")

/datum/unit_test/dq_machinery_timed_material_pin/proc/begin_pin(mob/H, atom/target, obj/item/I, duration)
	test_click(H, target, I)
	var/datum/job = running(H)
	TEST_ASSERT(job, "the real input starts timed work")
	TEST_ASSERT(isnull(declared_duration(job)) || declared_duration(job) == duration, "the legacy job declares the pinned duration")
	return job

/datum/unit_test/dq_machinery_timed_material_pin/proc/lit_welder(mob/living/carbon/human/H, path = /obj/item/weldingtool)
	var/obj/item/weldingtool/W = allocate(path, H.loc)
	W.reagents.add_reagent(REAGENT_ID_FUEL, W.max_fuel)
	W.no_passive_burn = TRUE // isolate the action cost from the welder's independent idle burner
	W.setWelding(TRUE)
	equip(H, W)
	return W

/datum/unit_test/dq_machinery_timed_material_pin/bioprinter_load
/datum/unit_test/dq_machinery_timed_material_pin/bioprinter_load/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/organ_printer/flesh/M = allocate(/obj/machinery/organ_printer/flesh, H.loc)
	var/obj/item/reagent_containers/glass/beaker/B = allocate(/obj/item/reagent_containers/glass/beaker, H.loc)
	B.reagents.add_reagent(REAGENT_ID_BIOMASS, 12)
	equip(H, B)
	begin_pin(H, M, B, 1 SECOND)
	TEST_ASSERT_NULL(M.container, "loading does not move the beaker before the delay")
	TEST_ASSERT_EQUAL(B.loc, H, "the exact input remains in the real hand while waiting")
	test_time(0.5 SECONDS)
	TEST_ASSERT_NULL(M.container, "half a second is insufficient to load")
	test_time(0.6 SECONDS)
	TEST_ASSERT_EQUAL(M.container, B, "completion loads the original beaker relation")
	TEST_ASSERT_EQUAL(B.loc, M, "completion moves the original beaker inside the printer")
	TEST_ASSERT_EQUAL(B.reagents.get_reagent_amount(REAGENT_ID_BIOMASS), 12, "loading spends no biomass")
	TEST_ASSERT_NULL(running(H), "loading leaves no timed action")

/datum/unit_test/dq_machinery_timed_material_pin/bioprinter_cancel
/datum/unit_test/dq_machinery_timed_material_pin/bioprinter_cancel/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/organ_printer/flesh/M = allocate(/obj/machinery/organ_printer/flesh, H.loc)
	var/obj/item/reagent_containers/glass/beaker/B = allocate(/obj/item/reagent_containers/glass/beaker, H.loc)
	equip(H, B)
	var/datum/job = begin_pin(H, M, B, 1 SECOND)
	H.forceMove(get_step(H, EAST))
	test_time(2 SECONDS)
	TEST_ASSERT_NULL(M.container, "moving cancels actual beaker insertion")
	TEST_ASSERT_EQUAL(B.loc, H, "cancellation preserves the original held beaker")
	TEST_ASSERT(was_cancelled(job, H), "the timed insertion actually cancels")

/datum/unit_test/dq_machinery_timed_material_pin/clonepod_load
/datum/unit_test/dq_machinery_timed_material_pin/clonepod_load/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/clonepod/M = allocate(/obj/machinery/clonepod, H.loc)
	var/obj/item/reagent_containers/glass/beaker/B = allocate(/obj/item/reagent_containers/glass/beaker, H.loc)
	B.reagents.add_reagent(REAGENT_ID_BIOMASS, 9)
	equip(H, B)
	begin_pin(H, M, B, 1 SECOND)
	TEST_ASSERT(!(B in M.containers), "the pod holds no input container before completion")
	test_time(0.5 SECONDS)
	TEST_ASSERT_EQUAL(B.loc, H, "the actual beaker remains held during the loading delay")
	test_time(0.6 SECONDS)
	TEST_ASSERT(B in M.containers, "completion adds the exact beaker to the pod's relation")
	TEST_ASSERT_EQUAL(B.loc, M, "the input becomes physically contained by the pod")
	TEST_ASSERT_EQUAL(B.reagents.get_reagent_amount(REAGENT_ID_BIOMASS), 9, "loading spends no liquid biomass")

/datum/unit_test/dq_machinery_timed_material_pin/clonepod_cancel
/datum/unit_test/dq_machinery_timed_material_pin/clonepod_cancel/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/clonepod/M = allocate(/obj/machinery/clonepod, H.loc)
	var/obj/item/reagent_containers/glass/beaker/B = allocate(/obj/item/reagent_containers/glass/beaker, H.loc)
	equip(H, B)
	var/datum/job = begin_pin(H, M, B, 1 SECOND)
	H.drop_item()
	test_time(2 SECONDS)
	TEST_ASSERT(!(B in M.containers), "dropping the input cancels actual pod loading")
	TEST_ASSERT_EQUAL(B.loc, H.loc, "the dropped beaker stays on the real floor")
	TEST_ASSERT(was_cancelled(job, H), "the pod load actually cancels")

