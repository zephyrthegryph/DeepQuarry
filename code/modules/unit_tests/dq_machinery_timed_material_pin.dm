// Native wire subscriptions stop work as soon as its dismantling admission disappears.
/datum/unit_test/dq_machinery_timed_material_pin/camera_mending_interrupts
/datum/unit_test/dq_machinery_timed_material_pin/camera_mending_interrupts/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/machinery/camera/M = allocate(/obj/machinery/camera, H.loc)
	M.set_broken_condition(FALSE)
	var/obj/item/camera_assembly/assembly = own(M.assembly)
	TEST_ASSERT(wires_cut_all(M) > 0 && wires_all_cut(M), "the healthy real camera has all of its actual wires cut")
	var/obj/item/weldingtool/W = lit_welder(H)
	begin_pin(H, M, W, 10 SECONDS)
	test_time(1 SECOND)
	TEST_ASSERT(running(H), "the real dismantling op is still waiting before the wire repair")
	TEST_ASSERT(wires_mend_all(M) > 0 && !wires_all_cut(M), "the actual wires are mended through their published API")
	TEST_ASSERT_NULL(running(H), "the published wire change immediately interrupts the now-ineligible op")
	TEST_ASSERT(!QDELETED(M) && M.assembly == assembly, "immediate interruption preserves the actual healthy camera and original assembly")
	test_time(10 SECONDS)
	TEST_ASSERT(!QDELETED(M) && assembly.loc == M, "the interrupted operation never dismantles the restored camera later")

// Native-only variant proof: a zero-unit fuel reservation still commits the
// electric welder's real per-use charge, exactly as its legacy remove_fuel(0).
/datum/unit_test/dq_machinery_timed_material_pin/assembly_electric_charge
/datum/unit_test/dq_machinery_timed_material_pin/assembly_electric_charge/run_pin()
	var/mob/living/carbon/human/H = person()
	var/obj/item/camera_assembly/M = allocate(/obj/item/camera_assembly, H.loc)
	M.set_state(1)
	M.set_anchored(TRUE)
	var/obj/item/weldingtool/electric/W = lit_welder(H, /obj/item/weldingtool/electric)
	TEST_ASSERT(W.power_supply, "the actual electric welder has its real initial power cell")
	W.power_supply.give(W.power_supply.maxcharge)
	var/charge = W.power_supply.charge
	var/expected_charge = charge - W.charge_cost / W.power_supply.material_delivery_efficiency(W.charge_cost)
	TEST_ASSERT(charge > W.charge_cost, "the actual cell holds enough energy for the real per-use cost")
	begin_pin(H, M, W, 2 SECONDS)
	test_time(1 SECOND)
	TEST_ASSERT_EQUAL(W.power_supply.charge, charge, "the electric action spends no charge before completion")
	test_time(1.1 SECONDS)
	TEST_ASSERT_EQUAL(M.state, 2, "the real electric welder completes assembly welding")
	TEST_ASSERT_EQUAL(W.power_supply.charge, expected_charge, "the native zero-unit fuel reservation pays exactly one electric per-use charge including the real cell's material delivery loss")

/datum/unit_test/dq_machinery_timed_material_pin/assembly_electric_cancel
/datum/unit_test/dq_machinery_timed_material_pin/assembly_electric_cancel/run_pin()
