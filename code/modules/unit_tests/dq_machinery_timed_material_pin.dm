	var/obj/item/weldingtool/W = lit_welder(H)
	var/obj/item/weldingtool/other_W = lit_welder(other)
	var/datum/job = begin_pin(H, M, W, 10 SECONDS)
	test_click(other, M, other_W)
	TEST_ASSERT_NULL(running(other), "a second actual welder cannot claim the busy camera")
	H.forceMove(get_step(H, EAST))
	test_time(11 SECONDS)
	TEST_ASSERT(!QDELETED(M) && M.assembly == assembly, "cancellation preserves the real camera and original assembly")
	TEST_ASSERT_EQUAL(assembly.loc, M, "cancellation keeps the actual assembly contained")
	TEST_ASSERT(was_cancelled(job, H), "the claiming camera action actually cancels")

