// Insulation PROPERTY has always been type-only despite an editable instance field.
/datum/unit_test/dq_thermal_shell_type_only
/datum/unit_test/dq_thermal_shell_type_only/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/turf/T = dq_containment_floor()
	var/obj/structure/closet/A = allocate(/obj/structure/closet, T)
	var/obj/structure/closet/B = allocate(/obj/structure/closet, T)
	var/obj/item/dq_path_probe/P = allocate(/obj/item/dq_path_probe, T)
	TEST_ASSERT_EQUAL(dq_type_property(/obj, PROP_INSULATION), 0, "root property retains type zero")
	TEST_ASSERT_EQUAL(dq_type_property(/obj/item/folder, PROP_INSULATION), 0.1, "folder retains its actual card-stock insulation")
	TEST_ASSERT_EQUAL(dq_type_property(/obj/item/dq_path_probe/padded, PROP_INSULATION), 0.5, "padded probe retains its actual covering insulation")
	TEST_ASSERT_EQUAL(dq_type_property(/obj/structure/closet, PROP_INSULATION), 0.5, "closet retains declared type insulation")
	TEST_ASSERT_EQUAL(dq_type_property(/obj/structure/closet/dq_path_freezer, PROP_INSULATION), 0.9, "test freezer retains actual inherited type override")
	TEST_ASSERT_EQUAL(PROPERTY(A, PROP_INSULATION), 0.5, "actual instance begins with type property")
	TEST_ASSERT(move_into(A, null, P), "real probe is actually contained")
	TEST_ASSERT(vars_write(A, "insulation", 0), "historical alias accepts instance zero")
	TEST_ASSERT_EQUAL(thermal_shell_of(A).insulation, 0, "mapped editable value really changed")
	TEST_ASSERT_EQUAL(thermal_shell_of(B).insulation, 0.5, "instance edit is isolated COW")
	TEST_ASSERT_EQUAL(PROPERTY(A, PROP_INSULATION), 0.5, "instance edit deliberately does NOT change PROPERTY, matching old initial semantics")
	TEST_ASSERT(A.vv_edit_var("@thermal_shell.insulation", 1), "actual admin alias edit succeeds")
	TEST_ASSERT_EQUAL(thermal_shell_of(A).insulation, 1, "admin edit is visible in actual native editable value")
	TEST_ASSERT_EQUAL(PROPERTY(A, PROP_INSULATION), 0.5, "admin edit also remains ignored by type-only property")
	TEST_ASSERT_EQUAL(dq_path_step(A, P, PATH_EFFECT_HEAT), 0.5, "live containment attenuation still reads declared half insulation")
	TEST_ASSERT_EQUAL(P.heat_path_conductance(2), 1, "real heat coupling uses same declared half attenuation")
	var/ambient = dq_heat_path_ambient(A)
	A.fire_act(ambient + 1000, CELL_VOLUME)
	TEST_ASSERT(abs(P.hottest_fire - (ambient + 500)) < 0.01, "real fire propagation preserves type-only half exposure after admin edit")
	var/datum/property_provider/type_var/insulation/provider = dq_property_registry().base_provider(A.type, PROP_INSULATION)
	TEST_ASSERT(istype(provider), "actual registry chooses the real insulation provider")
	TEST_ASSERT_NULL(provider.state_var, "old instance state override remains disabled")
	TEST_ASSERT_NULL(provider.variant_var, "old variant override remains disabled")
	TEST_ASSERT_EQUAL(provider.type_value(A.type, list("insulation" = 0.99)), 0.5, "variant dictionary cannot change old type-only property")
	TEST_ASSERT_EQUAL(thermal_shell_of_type(A.type).insulation, 0.5, "COW and admin edits never mutate type default")

/datum/unit_test/dq_thermal_shell_type_only/map_alias
/datum/unit_test/dq_thermal_shell_type_only/map_alias/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	SSatoms.map_loader_begin("dq_thermal_shell_map")
	var/obj/structure/closet/M = new(dq_containment_floor())
	var/accepted = vars_write(M, "insulation", 0)
	SSatoms.map_loader_stop("dq_thermal_shell_map")
	own(M)
	SSatoms.InitializeAtoms(list(M))
	TEST_ASSERT(accepted && !QDELETED(M), "old-name mapped zero is accepted before parent initialization")
	TEST_ASSERT_EQUAL(thermal_shell_of(M).insulation, 0, "native editable mapped value is preserved")
	TEST_ASSERT_EQUAL(PROPERTY(M, PROP_INSULATION), 0.5, "mapped value stays ignored by actual PROPERTY as before")
