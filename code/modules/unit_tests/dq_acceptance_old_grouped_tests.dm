// Old-code acceptance boundary proof. Run before any declaration conversion.
// All subjects are real content; no fake clients, bodytype overrides or adapters.
/datum/unit_test/dq_acceptance_old_grouped
	abstract_type = /datum/unit_test/dq_acceptance_old_grouped

/datum/unit_test/dq_acceptance_old_grouped/proc/human_at(turf/T)
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	H.set_species(SPECIES_HUMAN)
	TEST_ASSERT(H.species, "Actual human has a species")
	TEST_ASSERT_EQUAL(H.species.get_bodytype(H), SPECIES_HUMAN, "Real species selects Human bodytype")
	return H

/datum/unit_test/dq_acceptance_old_grouped/fits/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = human_at(T)
	TEST_ASSERT(H, "Positive real human fixture")
	var/obj/item/clothing/glasses/aerogelgoggles/I = allocate(/obj/item/clothing/glasses/aerogelgoggles, T)
	I.restrict_fit(list(SPECIES_TESHARI))
	TEST_ASSERT_EQUAL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, H), "it only fits Teshari", "Short inclusive fit reason is exact")
	I.restrict_fit(list(SPECIES_TESHARI, SPECIES_VOX))
	TEST_ASSERT_EQUAL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, H), "it only fits Teshari or Vox", "Two-name inclusive fit reason preserves order")
	I.restrict_fit(list("exclude", SPECIES_HUMAN))
	TEST_ASSERT_EQUAL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, H), "it doesn't fit a Human", "Exclusive fit refuses actual listed shape")
	I.restrict_fit(list("exclude", SPECIES_TESHARI))
	TEST_ASSERT_NULL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, H), "Exclusive fit allows actual unlisted shape")
	I.restrict_fit(list(SPECIES_TESHARI, SPECIES_VOX, SPECIES_WEREBEAST, SPECIES_UNATHI))
	TEST_ASSERT_EQUAL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, H), "it isn't made for a Human", "Long inclusive fit reason is exact")
	var/mob/living/simple_mob/animal/passive/mouse/M = allocate(/mob/living/simple_mob/animal/passive/mouse, T)
	TEST_ASSERT(!ishuman(M), "Actual mouse supplies nonhuman actor case")
	TEST_ASSERT_NULL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, M), "Old fit consumer allows a nonhuman actor")
	var/datum/species/original = H.species
	set_var(H, nameof(H.species), null)
	var/missing_species = isnull(H.species)
	var/missing_species_reason = dq_constraint_refusal(I, CONSTRAINT_FIT, I, H)
	set_var(H, nameof(H.species), original)
	TEST_ASSERT(missing_species, "Missing-species boundary is genuine")
	TEST_ASSERT_NULL(missing_species_reason, "Old fit consumer allows missing human species")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(I, CONSTRAINT_FIT, I, H), "it isn't made for a Human", "Restored actual species restores refusal")

/datum/unit_test/dq_acceptance_old_grouped/wearer_and_mover/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/wearer = human_at(T)
	var/mob/living/carbon/human/mover = human_at(T)
	TEST_ASSERT(wearer && mover && wearer != mover, "Holder/wearer and mover are distinct real humans")
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey, T)
	TEST_ASSERT(mover.equip_to_slot(uniform, SLOT_ID_UNIFORM), "Only mover really wears uniform")
	TEST_ASSERT_NULL(wearer.get_equipped_item(SLOT_ID_UNIFORM), "Wearer genuinely lacks uniform")
	var/obj/item/pen/I = allocate(/obj/item/pen, T)
	var/datum/relation_definition/slot/body/pocket/left/D = dq_slot_def(/datum/relation_definition/slot/body/pocket/left)
	TEST_ASSERT_EQUAL(D.refusal(wearer, I, mover), "you need a jumpsuit first", "Physical body acceptance reads wearer, not mover")
	TEST_ASSERT_NULL(D.refusal(mover, I, wearer), "Physical body acceptance allows dressed wearer with naked mover")
	TEST_ASSERT_EQUAL(I.equip_refusal(wearer, SLOT_ID_POCKET_L, TRUE), "you need a jumpsuit first", "Direct equip reports same first refusal")
	TEST_ASSERT(mover.equip_to_slot(I, SLOT_ID_POCKET_L), "Allowed direct equip performs real insertion")
	TEST_ASSERT_EQUAL(mover.get_equipped_item(SLOT_ID_POCKET_L), I, "Actual slot contains candidate")
	TEST_ASSERT_EQUAL(I.loc, mover, "Actual custody matches wearer")
	TEST_ASSERT(mover.unEquip(I), "Real removal succeeds")
	TEST_ASSERT_NULL(mover.get_equipped_item(SLOT_ID_POCKET_L), "Actual slot is empty after removal")

/datum/unit_test/dq_acceptance_old_grouped/hold_size_and_order/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/obj/item/storage/wallet/B = allocate(/obj/item/storage/wallet, T)
	var/obj/item/pen/exact = allocate(/obj/item/pen, T)
	var/obj/item/pen/above = allocate(/obj/item/pen, T)
	var/obj/item/tool/wrench/wrong_type = allocate(/obj/item/tool/wrench, T)
	// Set actual input before its first property read. These are test-owned edits.
	exact.set_w_class(ITEMSIZE_SMALL)
	above.set_w_class(ITEMSIZE_NORMAL)
	wrong_type.set_w_class(ITEMSIZE_NORMAL)
	TEST_ASSERT_EQUAL(dq_property(exact, PROP_SIZE_CLASS), ITEMSIZE_SMALL, "Exact boundary uses actual size-class provider")
	TEST_ASSERT_EQUAL(dq_property(above, PROP_SIZE_CLASS), ITEMSIZE_NORMAL, "Above-boundary provider really differs")
	var/datum/property_def/size_def = dq_property_registry().defs[PROP_SIZE_CLASS]
	TEST_ASSERT(size_def, "Actual registry defines size property")
	TEST_ASSERT_EQUAL(size_def.unit, PROP_UNIT_SIZE_CLASS, "Limit uses actual declared numeric unit")
	B.set_native_constraint(CONSTRAINT_HOLD, acceptance(CONSTRAINT_HOLD, req_acceptance_type(list(/obj/item/pen), because = "it doesn't take that"), req_acceptance_max_size(SIZE_CLASS(ITEMSIZE_SMALL)), mode = ACCEPTANCE_REPLACE))
	TEST_ASSERT_EQUAL(dq_constraint_refusal(B, CONSTRAINT_HOLD, wrong_type, null), "it doesn't take that", "First type refusal wins even when size also fails")
	TEST_ASSERT_NULL(dq_constraint_refusal(B, CONSTRAINT_HOLD, exact, null), "Inclusive <= allows exact numeric threshold")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(B, CONSTRAINT_HOLD, above, null), "too big: size 3 > size 2", "Matching type exposes exact subsequent size reason")
	B.set_native_constraint(CONSTRAINT_HOLD, acceptance(CONSTRAINT_HOLD, req_acceptance_max_size(SIZE_CLASS(ITEMSIZE_SMALL)), req_acceptance_type(list(/obj/item/pen), because = "it doesn't take that"), mode = ACCEPTANCE_REPLACE))
	TEST_ASSERT_EQUAL(dq_constraint_refusal(B, CONSTRAINT_HOLD, wrong_type, null), "too big: size 3 > size 2", "Reversing declaration order changes first real refusal")
	B.restrict_hold(list(/obj/item/pen), ITEMSIZE_SMALL)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(B, CONSTRAINT_HOLD, above, null), "too big: size 3 > size 2", "The actual hold restriction helper preserves the unit-aware default refusal too")

/datum/unit_test/dq_acceptance_old_grouped/suit_storage/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = human_at(T)
	TEST_ASSERT(H, "Positive real wearer")
	var/obj/item/clothing/suit/space/void/S = allocate(/obj/item/clothing/suit/space/void, T)
	var/obj/item/pda/P = allocate(/obj/item/pda, T)
	var/obj/item/tool/wrench/W = allocate(/obj/item/tool/wrench, T)
	TEST_ASSERT_EQUAL(P.equip_refusal(H, SLOT_ID_SUIT_STORAGE, TRUE), "you need a suit first", "Missing holder precedes PDA exemption")
	TEST_ASSERT(H.equip_to_slot(S, SLOT_ID_SUIT), "Real suit occupies real wearer slot")
	TEST_ASSERT_EQUAL(H.get_equipped_item(SLOT_ID_SUIT), S, "Worn holder is actual suit")
	S.set_native_constraint(CONSTRAINT_SUIT_STORAGE, acceptance(CONSTRAINT_SUIT_STORAGE, req_acceptance_type(list(/obj/item/pen), because = "it doesn't take that"), mode = ACCEPTANCE_REPLACE))
	TEST_ASSERT(dq_constraint_present(S, CONSTRAINT_SUIT_STORAGE), "Restrictive storage declaration is genuinely present")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(S, CONSTRAINT_SUIT_STORAGE, W, H), "it doesn't take that", "Real holder rejects ordinary candidate")
	TEST_ASSERT_NULL(P.equip_refusal(H, SLOT_ID_SUIT_STORAGE, TRUE), "Present storage allows real PDA exemption")
	TEST_ASSERT(H.equip_to_slot(P, SLOT_ID_SUIT_STORAGE), "Exempt PDA really inserts")
	TEST_ASSERT_EQUAL(H.get_equipped_item(SLOT_ID_SUIT_STORAGE), P, "Actual storage contains PDA")
	TEST_ASSERT(H.unEquip(P), "Real PDA removal succeeds")
	S.set_native_constraint(CONSTRAINT_SUIT_STORAGE, acceptance(CONSTRAINT_SUIT_STORAGE, mode = ACCEPTANCE_EMPTY))
	TEST_ASSERT(!dq_constraint_present(S, CONSTRAINT_SUIT_STORAGE), "Explicit absent channel is genuinely absent")
	TEST_ASSERT_EQUAL(P.equip_refusal(H, SLOT_ID_SUIT_STORAGE, TRUE), "\the [S] has no suit storage", "Absent channel refuses before PDA exemption")
	S.set_native_constraint(CONSTRAINT_SUIT_STORAGE, acceptance(CONSTRAINT_SUIT_STORAGE, list(), mode = ACCEPTANCE_REPLACE))
	TEST_ASSERT_EQUAL(P.equip_refusal(H, SLOT_ID_SUIT_STORAGE, TRUE), "\the [S] has no suit storage", "Explicit empty also refuses before PDA exemption")

/datum/unit_test/dq_acceptance_old_grouped/tags_and_real_slot/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/obj/item/folder/F = allocate(/obj/item/folder, T)
	var/obj/item/paper/P = allocate(/obj/item/paper, T)
	var/obj/item/tool/wrench/W = allocate(/obj/item/tool/wrench, T)
	TEST_ASSERT(HAS_TAG(P, TAG_PAPERWORK), "Actual paper supplies property tag")
	TEST_ASSERT(!HAS_TAG(W, TAG_PAPERWORK), "Actual wrench lacks property tag")
	TEST_ASSERT_EQUAL(dq_ledger_refusal(W, F, CONTAINER_SLOT_PAGES, null), "only paper, photos and bundles fit", "Actual slot tag consumer preserves exact refusal")
	TEST_ASSERT_NULL(dq_ledger_refusal(P, F, CONTAINER_SLOT_PAGES, null), "Actual tagged paper is allowed")
	TEST_ASSERT(move_into(F, CONTAINER_SLOT_PAGES, P), "Actual tagged candidate moves into folder")
	TEST_ASSERT_EQUAL(P.loc, F, "Actual transfer commits physical custody")
	TEST_ASSERT(P in F.slot_contents(CONTAINER_SLOT_PAGES), "Real slot ledger records tagged resident")
/datum/unit_test/dq_acceptance_old_grouped/overrides_and_sprite_fallback/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = human_at(T)
	var/mob/living/carbon/human/special = allocate(/mob/living/carbon/human, T)
	special.set_species(SPECIES_TESHARI)
	TEST_ASSERT_EQUAL(special.species.get_bodytype(special), SPECIES_TESHARI, "Real special species supplies sprite-sensitive shape")
	var/obj/item/clothing/glasses/aerogelgoggles/target = allocate(/obj/item/clothing/glasses/aerogelgoggles, T)
	var/obj/item/clothing/glasses/aerogelgoggles/source = allocate(/obj/item/clothing/glasses/aerogelgoggles, T)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(target, CONSTRAINT_FIT, target, H), "it only fits Teshari", "Actual inherited content table refuses human")
	target.restrict_fit(null)
	TEST_ASSERT_NULL(dq_constraint_refusal(target, CONSTRAINT_FIT, target, H), "Explicit empty instance override allows")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(source, CONSTRAINT_FIT, source, H), "it only fits Teshari", "Other instance remains unchanged")
	target.clear_constraint(CONSTRAINT_FIT)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(target, CONSTRAINT_FIT, target, H), "it only fits Teshari", "Clear restores actual inherited declaration")
	target.adopt_constraint(CONSTRAINT_FIT, source)
	source.restrict_fit(null)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(target, CONSTRAINT_FIT, target, H), "it only fits Teshari", "Adopt stores snapshot independent of later source edits")
	target.adopt_constraint(CONSTRAINT_FIT, source)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(target, CONSTRAINT_FIT, target, H), "it only fits Teshari", "Adopting absent source is old no-op")
	var/obj/item/clothing/gloves/ring/R = allocate(/obj/item/clothing/gloves/ring, T)
	R.restrict_fit(list(SPECIES_HUMAN))
	R.set_sprite_sheets(null)
	TEST_ASSERT_NULL(dq_constraint_refusal(R, CONSTRAINT_FIT, R, H), "Exact listed shape allows before sprite fallback")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(R, CONSTRAINT_FIT, R, special), "it only fits Human", "Unlisted special shape without sprite refuses")
	R.set_sprite_sheets(list(SPECIES_TESHARI = 'icons/inventory/eyes/mob_teshari.dmi'))
	TEST_ASSERT_NULL(dq_constraint_refusal(R, CONSTRAINT_FIT, R, special), "Actual matching sprite allows unlisted special-shape fallback")

// IGNORED mixed-phase runtime integration tests; no legacy REQ macros added.
/datum/unit_test/dq_acceptance_mixed_snapshots/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/teshari = allocate(/mob/living/carbon/human, T, SPECIES_TESHARI)
	var/obj/item/clothing/glasses/aerogelgoggles/native_target = allocate(/obj/item/clothing/glasses/aerogelgoggles, T)
	var/obj/item/clothing/suit/radiation/teshari/legacy_source = allocate(/obj/item/clothing/suit/radiation/teshari, T)
	TEST_ASSERT(acceptance_declared(native_target, CONSTRAINT_FIT), "Closed cohort really migrated goggles")
	TEST_ASSERT(acceptance_declared(legacy_source, CONSTRAINT_FIT), "Radiation suit now has its native fit declaration")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(legacy_source, CONSTRAINT_FIT, legacy_source, H), "it only fits Teshari", "Legacy source still refuses human exactly")
	// Adoption now snapshots the actual native declaration of the converted suit.
	native_target.restrict_fit(null)
	TEST_ASSERT(!dq_constraint_present(native_target, CONSTRAINT_FIT), "Native explicit empty has no fit requirement")
	native_target.adopt_constraint(CONSTRAINT_FIT, legacy_source)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(native_target, CONSTRAINT_FIT, native_target, H), "it only fits Teshari", "Legacy source snapshot overrides native target's explicit empty")
	TEST_ASSERT_NULL(dq_constraint_refusal(native_target, CONSTRAINT_FIT, native_target, teshari), "Adopted legacy snapshot allows real Teshari")
	legacy_source.restrict_fit(null)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(native_target, CONSTRAINT_FIT, native_target, H), "it only fits Teshari", "Source refit cannot mutate adopted snapshot")
	native_target.adopt_constraint(CONSTRAINT_FIT, legacy_source)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(native_target, CONSTRAINT_FIT, native_target, H), "it only fits Teshari", "Adopt explicit empty remains a no-op")

	var/obj/item/clothing/glasses/aerogelgoggles/native_source = allocate(/obj/item/clothing/glasses/aerogelgoggles, T)
	var/obj/item/clothing/suit/radiation/teshari/legacy_target = allocate(/obj/item/clothing/suit/radiation/teshari, T)
	TEST_ASSERT_EQUAL(teshari.get_species(), SPECIES_TESHARI, "Refusal actor is a real Teshari")
	// Human fit accepts alternate supported sheets; remove that independent
	// permission so this assertion measures the adopted fit snapshot itself.
	legacy_target.set_sprite_sheets(null)
	native_source.restrict_fit(list(SPECIES_HUMAN))
	legacy_target.adopt_constraint(CONSTRAINT_FIT, native_source)
	TEST_ASSERT_NULL(dq_constraint_refusal(legacy_target, CONSTRAINT_FIT, legacy_target, H), "Native snapshot supersedes legacy target table")
	TEST_ASSERT_EQUAL(dq_constraint_refusal(legacy_target, CONSTRAINT_FIT, legacy_target, teshari), "it only fits Human", "Native snapshot retains exact refusal")
	native_source.restrict_fit(null)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(legacy_target, CONSTRAINT_FIT, legacy_target, teshari), "it only fits Human", "Native adopt is immutable source snapshot")
	legacy_target.clear_constraint(CONSTRAINT_FIT)
	TEST_ASSERT_EQUAL(dq_constraint_refusal(legacy_target, CONSTRAINT_FIT, legacy_target, H), "it only fits Teshari", "Clearing native override restores real legacy declaration")

/datum/unit_test/dq_acceptance_native_slot_runtime/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human, T)
	var/mob/living/carbon/human/loader = allocate(/mob/living/carbon/human, T)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey, T)
	TEST_ASSERT(loader.equip_to_slot(uniform, SLOT_ID_UNIFORM), "Loader actually wears uniform")
	var/obj/item/pen/pen = allocate(/obj/item/pen, T)
	var/datum/relation_definition/slot/body/pocket/left/pocket = dq_slot_def(/datum/relation_definition/slot/body/pocket/left)
	TEST_ASSERT_EQUAL(pocket.refusal(wearer, pen, loader), "you need a jumpsuit first", "Body slot checks wearer, not clothed mover")
	TEST_ASSERT(!move_into(wearer, SLOT_ID_POCKET_L, pen, loader), "Real insertion is refused")
	TEST_ASSERT_EQUAL(pen.loc, T, "Refused insertion leaves custody unchanged")
	TEST_ASSERT_NULL(wearer.get_equipped_item(SLOT_ID_POCKET_L), "Refused pocket remains empty")
	var/obj/item/clothing/under/color/grey/wearer_uniform = allocate(/obj/item/clothing/under/color/grey, T)
	TEST_ASSERT(wearer.equip_to_slot(wearer_uniform, SLOT_ID_UNIFORM), "Wearer gets a real uniform")
	TEST_ASSERT_NULL(pocket.refusal(wearer, pen, loader), "Native slot requirement now allows")
	TEST_ASSERT(move_into(wearer, SLOT_ID_POCKET_L, pen, loader), "Actual native insertion succeeds")
	TEST_ASSERT_EQUAL(wearer.get_equipped_item(SLOT_ID_POCKET_L), pen, "Ledger holds inserted pen")
	TEST_ASSERT_EQUAL(pen.loc, wearer, "Inserted pen has real wearer custody")
	TEST_ASSERT(wearer.slot_remove(pen, T, wearer), "Real removal succeeds")
	TEST_ASSERT_EQUAL(pen.loc, T, "Removed pen reaches turf")
	TEST_ASSERT_NULL(wearer.get_equipped_item(SLOT_ID_POCKET_L), "Removal clears ledger occupancy")

// The remaining legacy table callback must observe native suit channels too.
/datum/unit_test/dq_acceptance_legacy_native_suit/Run()
	var/turf/T = run_loc_floor_bottom_left
	var/mob/living/carbon/human/H = allocate(/mob/living/carbon/human, T)
	var/obj/item/clothing/suit/space/void/mining/S = allocate(/obj/item/clothing/suit/space/void/mining, T)
	var/obj/item/pen/P = allocate(/obj/item/pen, T)
	var/obj/item/clothing/under/color/grey/wrong = allocate(/obj/item/clothing/under/color/grey, T)
	TEST_ASSERT(acceptance_declared(S, CONSTRAINT_SUIT_STORAGE), "Fixture has a native restrictive suit channel")
	TEST_ASSERT(acceptance_plan_for(S, CONSTRAINT_SUIT_STORAGE), "Fixture selects an actual resolved native channel")
	TEST_ASSERT_EQUAL(dq_native_equip_slot_reason(H, SLOT_ID_SUIT_STORAGE, P, H), "you need a suit first", "Missing actual worn holder refuses before exemption")
	TEST_ASSERT(H.equip_to_slot(S, SLOT_ID_SUIT), "Actual native suit occupies wearer slot")
	TEST_ASSERT_NULL(dq_native_equip_slot_reason(H, SLOT_ID_SUIT_STORAGE, P, H), "Legacy callback allows pen on genuine native suit")
	TEST_ASSERT_EQUAL(dq_native_equip_slot_reason(H, SLOT_ID_SUIT_STORAGE, wrong, H), "it doesn't take that", "Legacy callback preserves native exact rejection")
	S.set_native_constraint(CONSTRAINT_SUIT_STORAGE, acceptance(CONSTRAINT_SUIT_STORAGE, req_acceptance_type(list(/obj/item/pen), because = "native override rejects this candidate"), mode = ACCEPTANCE_REPLACE))
	TEST_ASSERT_EQUAL(dq_native_equip_slot_reason(H, SLOT_ID_SUIT_STORAGE, wrong, H), "native override rejects this candidate", "Actual evaluator reaches native override, not the coexisting legacy table")
	S.set_native_constraint(CONSTRAINT_SUIT_STORAGE, acceptance(CONSTRAINT_SUIT_STORAGE, mode = ACCEPTANCE_EMPTY))
	TEST_ASSERT_EQUAL(dq_native_equip_slot_reason(H, SLOT_ID_SUIT_STORAGE, P, H), "\the [S] has no suit storage", "Explicit native absence still refuses before pen exemption")
