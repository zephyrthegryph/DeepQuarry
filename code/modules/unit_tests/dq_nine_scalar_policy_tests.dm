/mob/living/simple_mob/dq_nine_policy_no_vore
CAPABILITIES(/mob/living/simple_mob/dq_nine_policy_no_vore)
	configure(vore_embodiment(no_vore = TRUE))

// Source-only draft; root wires after policy definitions and existing vore helpers.
/mob/living/simple_mob/dq_nine_policy_eyes
	icon_living = "policy"
	has_eye_glow = TRUE

/datum/unit_test/dq_nine_policy_homes
/datum/unit_test/dq_nine_policy_homes/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/A = allocate(/mob/living/simple_mob, test_floor())
	var/mob/living/simple_mob/B = allocate(/mob/living/simple_mob, test_floor())
	TEST_ASSERT_NOTNULL(static_entry_of(/mob, ENTRY_VORE_EMBODIMENT), "mob owns the real static policy")
	TEST_ASSERT_EQUAL(movement_of_type(/mob).vent_crawl_time, 4.5 SECONDS, "base animation duration")
	TEST_ASSERT_EQUAL(movement_of_type(/mob/living/simple_mob/animal/borer).vent_crawl_time, 3 SECONDS, "borer keeps thirty deciseconds")
	TEST_ASSERT(kind_of_type(/mob/living/carbon/human).has_huds, "compiled human HUD policy")
	TEST_ASSERT(!kind_of_type(/mob/living/carbon/human/dummy).has_huds, "dummy suppresses inherited HUD")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/bot).no_vore, TRUE, "compiled no_vore on /mob/living/bot")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/silicon).has_huds, TRUE, "compiled has_huds on /mob/living/silicon")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/simple_mob).has_huds, TRUE, "compiled has_huds on /mob/living/simple_mob")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/voice).no_vore, TRUE, "compiled no_vore on /mob/living/voice")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/carbon/brain).no_vore, TRUE, "compiled no_vore on /mob/living/carbon/brain")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/carbon/human).has_huds, TRUE, "compiled has_huds on /mob/living/carbon/human")
	TEST_ASSERT_EQUAL(kind_of_type(/mob/living/carbon/human/dummy).has_huds, FALSE, "compiled has_huds on /mob/living/carbon/human/dummy")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/carbon/human/dummy).no_vore, TRUE, "compiled no_vore on /mob/living/carbon/human/dummy")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/vore/aggressive/dragon/virgo3b).vore_eyes, TRUE, "compiled vore_eyes on /mob/living/simple_mob/vore/aggressive/dragon/virgo3b")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/vore/aggressive/dragon/space).vore_eyes, TRUE, "compiled vore_eyes on /mob/living/simple_mob/vore/aggressive/dragon/space")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/vore/aggressive/rat/labrat/genetics).faction_bump_vore, 1, "compiled faction_bump_vore on /mob/living/simple_mob/vore/aggressive/rat/labrat/genetics")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/vore/seagull).belly_size_multiplier, 2.5, "compiled belly_size_multiplier on /mob/living/simple_mob/vore/seagull")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/vore/sect_drone).vore_eyes, TRUE, "compiled vore_eyes on /mob/living/simple_mob/vore/sect_drone")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/vore/sect_queen).vore_eyes, TRUE, "compiled vore_eyes on /mob/living/simple_mob/vore/sect_queen")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/animal/synx).parasitic, TRUE, "compiled parasitic on /mob/living/simple_mob/animal/synx")
	TEST_ASSERT_EQUAL(movement_of_type(/mob/living/simple_mob/animal/borer).vent_crawl_time, 3 SECONDS, "compiled vent_crawl_time on /mob/living/simple_mob/animal/borer")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/animal/passive/mouse).restrict_vore_ventcrawl, TRUE, "compiled restrict_vore_ventcrawl on /mob/living/simple_mob/animal/passive/mouse")
	TEST_ASSERT_EQUAL(movement_of_type(/mob/living/simple_mob/animal/space/alien/hunterling).force_max_speed, 1, "compiled force_max_speed on /mob/living/simple_mob/animal/space/alien/hunterling")
	TEST_ASSERT_EQUAL(vore_embodiment_of_type(/mob/living/simple_mob/animal/passive/snake).faction_bump_vore, 1, "compiled faction_bump_vore on /mob/living/simple_mob/animal/passive/snake")
	var/list/fields = list("no_vore", "restrict_vore_ventcrawl", "parasitic", "belly_size_multiplier", "vore_eyes", "faction_bump_vore")
	for(var/field in fields)
		TEST_ASSERT(!(field in A.vars), "[field] has no base-field shadow")
		TEST_ASSERT(vars_write(A, field, 0), "historical zero alias [field]")
		TEST_ASSERT_EQUAL(vore_embodiment_of(A).vars[field], 0, "zero preserved [field]")
		TEST_ASSERT(A.vv_edit_var("@vore_embodiment.[field]", null), "native VV null [field]")
		TEST_ASSERT_NULL(vore_embodiment_of(A).vars[field], "null preserved [field]")
		TEST_ASSERT(vars_write(A, field, "mapped value"), "historical arbitrary scalar [field]")
		TEST_ASSERT_EQUAL(vore_embodiment_of(A).vars[field], "mapped value", "no coercion [field]")
		TEST_ASSERT_EQUAL(vore_embodiment_of(B).vars[field], vore_embodiment_of_type(B.type).vars[field], "COW isolation [field]")
	TEST_ASSERT(vars_write(A, "force_max_speed", TRUE), "historical speed alias")
	TEST_ASSERT_EQUAL(A.movement_delay(), -3, "actual movement consumer honors maximum speed")
	A.set_force_max_speed(movement_of_type(A.type).force_max_speed)
	TEST_ASSERT_EQUAL(movement_of(A).force_max_speed, 0, "compiled initial reset ignores edited copy")
	TEST_ASSERT(A.movement_delay() != -3, "actual movement consumer returns to normal")
	A.set_vent_crawl_time(null)
	TEST_ASSERT_NULL(movement_of(A).vent_crawl_time, "nullable animation argument remains null")
	TEST_ASSERT_EQUAL(movement_of(B).vent_crawl_time, 4.5 SECONDS, "duration isolation")
	A.set_has_huds(null)
	TEST_ASSERT_NULL(kind_of(A).has_huds, "HUD policy preserves null")
	TEST_ASSERT(kind_of(B).has_huds, "HUD edit is isolated")

/datum/unit_test/dq_nine_policy_parasitic_digest
/datum/unit_test/dq_nine_policy_parasitic_digest/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/list/pair = vore_test_pair()
	var/mob/living/carbon/human/pred = pair[1]
	var/mob/living/carbon/human/prey = pair[2]
	var/obj/belly/B = vore_rate_belly(pair, DM_DIGEST)
	B.set_digest_brute(2)
	B.set_digest_burn(3)
	pred.set_nutrition(100)
	prey.set_nutrition(100)
	prey.set_parasitic(TRUE)
	var/datum/digest_mode/DM = GLOB.digest_modes["[DM_DIGEST]"]
	TEST_ASSERT_NOTNULL(DM, "real registered digestion processor")
	DM.process_mob(B, prey, 1)
	TEST_ASSERT_EQUAL(nutrition_of(pred), 95, "real parasitic path drains owner")
	TEST_ASSERT_EQUAL(nutrition_of(prey), 105, "real parasitic path feeds prey")
	prey.set_parasitic(FALSE)
	var/before = _vore_test_total_injury(prey)
	DM.process_mob(B, prey, 1)
	TEST_ASSERT(_vore_test_total_injury(prey) > before, "turning policy off reaches actual digestion damage")

/datum/unit_test/dq_nine_policy_eyes_live
/datum/unit_test/dq_nine_policy_eyes_live/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/dq_nine_policy_eyes/M = allocate(/mob/living/simple_mob/dq_nine_policy_eyes, test_floor())
	M.set_vore_active(TRUE)
	M.set_vore_icons(SA_ICON_LIVING)
	M.set_vore_fullness(1)
	M.set_vore_eyes(FALSE)
	refresh_flush()
	TEST_ASSERT(("policy-eyes" in dq_overlay_states(M)), "ordinary glowing eyes use base life state")
	M.set_vore_eyes(TRUE)
	refresh_flush()
	TEST_ASSERT(("policy-1-eyes" in dq_overlay_states(M)), "native trait edit invalidates pure draw without manual redraw")
	TEST_ASSERT(!("policy-eyes" in dq_overlay_states(M)), "old eye state is replaced")

/datum/unit_test/dq_nine_policy_belly_creation_and_fullness
/datum/unit_test/dq_nine_policy_belly_creation_and_fullness/Run()
	set_global(nameof(GLOB.coalesce_runs), GLOB.coalesce_runs)
	set_global(nameof(GLOB.coalesce_absorbed), GLOB.coalesce_absorbed)
	set_global(nameof(GLOB.act_taken), GLOB.act_taken)
	var/mob/living/simple_mob/dq_nine_policy_no_vore/M = allocate(/mob/living/simple_mob/dq_nine_policy_no_vore, test_floor())
	M.init_vore(TRUE)
	TEST_ASSERT(!length(M.vore_organs), "real simple-mob initialization honors no-vore policy even when forced")
	M.set_no_vore(FALSE)
	M.init_vore(TRUE)
	TEST_ASSERT(length(M.vore_organs), "removing policy allows the actual belly factory")
	var/list/pair = vore_test_pair()
	var/mob/living/carbon/human/pred = pair[1]
	var/mob/living/carbon/human/prey = pair[2]
	var/obj/belly/B = vore_selected_of(pred)
	B.set_affects_vore_sprites(TRUE)
	B.set_vore_sprite_flags(DM_FLAG_VORESPRITE_BELLY)
	B.set_belly_sprite_to_affect("stomach")
	B.nom_atom(prey, pred)
	TEST_ASSERT_EQUAL(prey.loc, B, "fullness uses a real contained prey")
	pred.set_belly_size_multiplier(1)
	var/list/base = pred.update_fullness()
	TEST_ASSERT(base["stomach"] > 0, "actual physical contents contribute fullness")
	pred.set_belly_size_multiplier(2)
	var/list/doubled = pred.update_fullness()
	TEST_ASSERT_EQUAL(doubled["stomach"], base["stomach"] * 2, "real fullness computation reads instance policy")
