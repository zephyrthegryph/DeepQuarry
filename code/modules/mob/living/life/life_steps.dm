/mob/living/carbon/human/life_steps()
	. = ..()
	if(life_set & LIFE_SET_LIVING)
		. += seq_step(PROC_REF(life_type_pre), after = LIFE_INPUT, should_run = PROC_REF(life_type_pre_due))
		. += seq_step(PROC_REF(life_breathing), after = list(LIFE_INPUT, "life_light"), when = list("placed", "!in_stasis", "alive"), reads = CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT, should_run = PROC_REF(life_breathing_due), rewake = PROC_REF(life_breathing_rewake))
		. += seq_step(PROC_REF(life_mutations), after = list(LIFE_INPUT, "life_breathing"), when = list("placed", "!in_stasis", "alive"), reads = CHANGE_MOB_STATUS, should_run = PROC_REF(life_mutations_due))
		if(life_radiation_applies())
			. += seq_step(PROC_REF(life_radiation), after = list(LIFE_INPUT, "life_mutations"), when = list("placed", "!in_stasis", "alive"), should_run = PROC_REF(life_radiation_due), rewake = PROC_REF(life_radiation_rewake), woken_by = "its rewake (radiation is written raw)")
		. += seq_step(PROC_REF(life_random_events), after = LIFE_BODY, when = list("placed", "!in_stasis", "alive"), reads = CHANGE_MOB_STATUS, should_run = PROC_REF(life_random_events_due))
		. += seq_step(PROC_REF(life_chemicals), after = list(LIFE_BODY, "life_afk"), when = list("placed", "!in_stasis"), reads = CHANGE_MOB_HEALTH, should_run = PROC_REF(life_chemicals_due), rewake = PROC_REF(life_chemicals_rewake))
		. += seq_step(PROC_REF(life_status), after = LIFE_BODY, when = "placed", reads = CHANGE_MOB_HEALTH | CHANGE_MOB_STATUS | CHANGE_MOB_STAT | CHANGE_MOB_EQUIPMENT | CHANGE_MOB_CLIENT, should_run = PROC_REF(life_status_due), rewake = PROC_REF(life_status_rewake), woken_by = "injure/mend and body invalidate; status setters (sleep, blindness, drowsiness); set_stat; equipment (blindfolds, rig visors); Login/Logout (SSD); its rewake for raw fear/tiredness writes")
		. += seq_step(PROC_REF(life_voice), after = LIFE_TAIL, reads = CHANGE_MOB_HEALTH | CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT, once = TRUE, rewake = PROC_REF(life_voice_rewake), woken_by = "equipment; body invalidate; set_stat; Moved; its own timer")
		. += seq_step(PROC_REF(life_stasis_sleep), after = list(LIFE_TAIL, "life_voice"), reads = CHANGE_MOB_HEALTH, should_run = PROC_REF(life_stasis_sleep_due))
		. += seq_step(PROC_REF(life_fall), after = list(LIFE_TAIL, "life_stasis_sleep"), reads = CHANGE_MOB_STATUS | CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT, once = TRUE, rewake = PROC_REF(life_fall_rewake))
		. += seq_step(PROC_REF(life_changeling), after = list(LIFE_TAIL, "life_fall"), when = list("!in_stasis", "alive"), reads = CHANGE_MOB_CLIENT, should_run = PROC_REF(life_changeling_due), rewake = PROC_REF(life_changeling_rewake), woken_by = "login (HUD); its rewake (becoming a changeling)")
		. += seq_step(PROC_REF(life_thermoregulation), after = list(LIFE_TAIL, "life_changeling"), when = list("!in_stasis", "alive"), reads = CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT | CHANGE_MOB_STAT, should_run = PROC_REF(life_thermoregulation_due), rewake = PROC_REF(life_thermoregulation_rewake), woken_by = "movement; equipment; set_stat; its rewake for raw body temperature writes")
		. += seq_step(PROC_REF(life_weight), after = LIFE_TAIL, when = list("!in_stasis", "alive"), should_run = PROC_REF(life_weight_due), rewake = PROC_REF(life_weight_rewake), woken_by = "its rewake (nutrition is written raw everywhere)")
		. += seq_step(PROC_REF(life_shock), after = list(LIFE_TAIL, "life_weight"), when = list("!in_stasis", "alive"), reads = CHANGE_MOB_HEALTH, should_run = PROC_REF(life_shock_due), rewake = PROC_REF(life_shock_rewake), woken_by = "injure/mend and body invalidate (pain, analgesia); adjust_shock()/set_shock()")
		. += seq_step(PROC_REF(life_medical), after = list(LIFE_TAIL, "life_shock"), when = list("!in_stasis", "alive"), reads = CHANGE_MOB_HEALTH, should_run = PROC_REF(life_medical_due), rewake = PROC_REF(life_medical_rewake), woken_by = "body invalidate (conditions, chems, factors, oxygen debt via tissue hypoxia); its rewake for raw temperature/radiation writes")
		. += seq_step(PROC_REF(life_heartbeat), after = list(LIFE_TAIL, "life_medical"), when = list("!in_stasis", "alive"), reads = CHANGE_MOB_HEALTH | CHANGE_MOB_LOC | CHANGE_MOB_CLIENT, should_run = PROC_REF(life_heartbeat_due), rewake = PROC_REF(life_heartbeat_rewake), woken_by = "body invalidate; movement (space); login; its rewake for raw pulse writes")
		. += seq_step(PROC_REF(life_nif), after = list(LIFE_TAIL, "life_heartbeat"), when = list("!in_stasis", "alive"), should_run = PROC_REF(life_nif_due), rewake = PROC_REF(life_nif_rewake), woken_by = "its rewake (a NIF installed)")
		. += seq_step(PROC_REF(life_phobias), after = list(LIFE_TAIL, "life_nif"), when = list("!in_stasis", "alive"), should_run = PROC_REF(life_phobias_due), rewake = PROC_REF(life_phobias_rewake), woken_by = "its rewake (phobias gained)")
		. += seq_step(PROC_REF(life_npc), after = list(LIFE_TAIL, "life_phobias"), when = list("!in_stasis", "alive"), reads = CHANGE_MOB_CLIENT | CHANGE_MOB_STAT, should_run = PROC_REF(life_npc_due), rewake = PROC_REF(life_npc_rewake), woken_by = "login/logout; set_stat; its rewake")
		. += seq_step(PROC_REF(life_species_components), after = list(LIFE_TAIL, "life_npc"))
		. += seq_step(PROC_REF(life_visible_name), after = list(LIFE_TAIL, "life_species_components"), reads = CHANGE_MOB_HEALTH | CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT, once = TRUE, rewake = PROC_REF(life_visible_name_rewake), woken_by = "equipment; body invalidate (disfigurement); set_stat; its own timer")
		. += seq_step(PROC_REF(life_pulse), after = list(LIFE_TAIL, "life_visible_name"), reads = CHANGE_MOB_HEALTH, once = TRUE)

