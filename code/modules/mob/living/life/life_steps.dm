// Life steps (doc/rewrite/life_sequences.md, doc/rewrite/om_retirement.md L1).
//
// Each mob type declares the Life steps it runs. A step is a proc on the mob type (life_<step>(F)), overridden by
// subtypes; `after =` edges reproduce the old stage order (derived by tools/dx/codemods/life_stage_steps.py; the
// solver breaks ties by key). `when =` names the frame conditions (/datum/sequence/life/conditions()), `reads =` the
// change channels that wake a sleeping step, `should_run =` says it has work, `rewake =` wakes it anyway after a
// delay. A later declaration of the same step on a subtype replaces the parent's. A step runs only for the Life set
// (life_set) it serves: preview dummies and delisted mobs keep none of the living steps.

/mob/living/life_steps()
	. = ..()
	if(life_set & LIFE_SET_DELIST)
		. += seq_step(PROC_REF(life_delist), after = LIFE_INPUT, reads = CHANGE_MOB_LOC | CHANGE_MOB_CONDITIONS)
	if(life_set & LIFE_SET_LIVING)
		. += seq_step(PROC_REF(life_upkeep), after = LIFE_INPUT, reads = CHANGE_MOB_LOC | CHANGE_MOB_CONDITIONS, should_run = PROC_REF(life_upkeep_due), woken_by = "Moved; ghosts following; spells learned")
		. += seq_step(PROC_REF(life_light), after = list(LIFE_INPUT, "life_instability"), when = "placed", reads = CHANGE_MOB_LOC | CHANGE_MOB_CONDITIONS, should_run = PROC_REF(life_light_due), woken_by = "refresh_glow(); instability")
		. += seq_step(PROC_REF(life_mutations), after = list(LIFE_INPUT, "life_breathing"), when = list("placed", "alive"), reads = CHANGE_MOB_STATUS, should_run = PROC_REF(life_mutations_due))
		if(life_radiation_applies())
			. += seq_step(PROC_REF(life_radiation), after = list(LIFE_INPUT, "life_mutations"), when = list("placed", "alive"), should_run = PROC_REF(life_radiation_due), rewake = PROC_REF(life_radiation_rewake))
		. += seq_step(PROC_REF(life_afk), after = list(LIFE_BODY, "life_random_events"), when = list("placed", "alive"), once = TRUE, rewake = PROC_REF(life_afk_rewake), woken_by = "Login, Logout; its own timer")
		. += seq_step(PROC_REF(life_environment), after = list(LIFE_BODY, "life_chemicals"), when = "placed", reads = CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT, should_run = PROC_REF(life_environment_due), rewake = PROC_REF(life_environment_rewake))
		. += seq_step(PROC_REF(life_ambience), after = list(LIFE_BODY, "life_environment"), when = "placed", once = TRUE, rewake = PROC_REF(life_ambience_rewake), woken_by = "Login; its own timer")
		. += seq_step(PROC_REF(life_movement), after = list(LIFE_BODY, "life_ambience"), when = "placed", reads = CHANGE_MOB_STATUS | CHANGE_MOB_LOC | CHANGE_MOB_EQUIPMENT, should_run = PROC_REF(life_movement_due), rewake = PROC_REF(life_movement_rewake), woken_by = "Moved; start_pulling; equipping a grab; status setters")
		if(life_physiology_applies())
			. += seq_step(PROC_REF(life_physiology), after = list(LIFE_BODY, "life_movement"), when = list("placed", "!in_stasis", "alive"), reads = CHANGE_MOB_HEALTH, should_run = PROC_REF(life_physiology_due), rewake = PROC_REF(life_physiology_rewake))
		. += seq_step(PROC_REF(life_status), after = LIFE_BODY, when = "placed", reads = CHANGE_MOB_HEALTH, should_run = PROC_REF(life_status_due), rewake = PROC_REF(life_status_rewake), woken_by = "injure, mend, afflictions, factors and reagents (body invalidate); set_stat")
		. += seq_step(PROC_REF(life_disabilities), after = LIFE_MIND, when = list("placed", "status_ok"), reads = CHANGE_MOB_STATUS, should_run = PROC_REF(life_disabilities_due), woken_by = "status changes (blindness starting or ending); set_stat; body invalidate")
		. += seq_step(PROC_REF(life_tf_holder), after = LIFE_OUTPUT, when = "placed", reads = CHANGE_MOB_LOC | CHANGE_MOB_CONDITIONS, should_run = PROC_REF(life_tf_holder_due))
		. += seq_step(PROC_REF(life_vr_derez), after = LIFE_OUTPUT, when = "placed", reads = CHANGE_MOB_LOC | CHANGE_MOB_CONDITIONS, should_run = PROC_REF(life_vr_derez_due), woken_by = "Moved (a VR mob can only leave the VR area by moving)")
	if(life_set & (LIFE_SET_LIVING | LIFE_SET_ROBOT))
		. += seq_step(PROC_REF(life_instability), after = list(LIFE_INPUT, "life_type_pre", "life_robot_cycle", "life_trait_burninlight", "life_robot_senses", "life_trait_crowd_detection", "life_trait_diabetic", "life_trait_drippy", "life_trait_forms", "life_trait_gargoyle", "life_trait_nutrition_size_change", "life_trait_photosynth", "life_trait_promethean_biology", "life_trait_radiation_glow", "life_trait_schizophrenia", "life_trait_shadekin", "life_trait_using_machine_shim", "life_trait_weaver", "life_upkeep"), reads = CHANGE_MOB_LOC | CHANGE_MOB_CONDITIONS, should_run = PROC_REF(life_instability_due), woken_by = "adjust_instability()")

