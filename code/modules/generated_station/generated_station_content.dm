/// Cosmetic filler options used after a room definition's functional features.
/// Infrastructure machinery is excluded because the topology pass owns it.
/proc/generated_room_cosmetic_palette(department_id, module_role)
	switch("[department_id]/[module_role]")
		if("command/reception", "security/reception", "medical/reception", "logistics/reception", "docking/reception")
			return list(/obj/structure/flora/pottedplant, /obj/structure/filingcabinet)
		if("command/meeting", "command/briefing", "command/liaison")
			return list(/obj/structure/flora/pottedplant, /obj/structure/filingcabinet, /obj/structure/bed/chair/office, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("medical/pharmacy", "medical/exam", "medical/recovery")
			return list(/obj/structure/closet/secure_closet/medical1, /obj/structure/filingcabinet, /obj/structure/table/standard, /obj/structure/bed/chair)
		if("engineering/workshop", "engineering/equipment", "engineering/tool-room", "engineering/maintenance")
			return list(/obj/structure/closet/secure_closet/engineering_electrical, /obj/structure/closet/crate/engineering/electrical, /obj/structure/table/standard, /obj/structure/table/rack)
		if("logistics/warehouse", "logistics/sorting", "logistics/inventory", "logistics/storage")
			return list(/obj/structure/closet/crate, /obj/structure/closet/secure_closet/cargotech, /obj/structure/table/standard, /obj/structure/table/rack)
		if("logistics/dispatch")
			return list(/obj/structure/table/standard, /obj/structure/bed/chair/office, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded, /obj/structure/filingcabinet, /obj/structure/closet/crate)
		if("docking/lounge")
			return list(/obj/structure/flora/pottedplant, /obj/structure/bed/chair, /obj/structure/filingcabinet)
		if("docking/berth")
			return list(/obj/structure/table/standard, /obj/structure/bed/chair, /obj/structure/flora/pottedplant, /obj/structure/filingcabinet)
	switch(department_id)
		if("command")
			return list(/obj/structure/filingcabinet, /obj/structure/flora/pottedplant, /obj/structure/closet/crate/internals, /obj/structure/table/standard, /obj/structure/bed/chair/office, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("ai")
			return list(/obj/structure/closet/crate/engineering/electrical, /obj/structure/filingcabinet, /obj/structure/closet/crate/internals, /obj/structure/table/standard, /obj/structure/bed/chair/office, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("security")
			return list(/obj/structure/closet/secure_closet/security, /obj/structure/filingcabinet/security, /obj/structure/closet/crate/internals, /obj/structure/table/standard, /obj/structure/bed/chair/office, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("medical")
			return list(/obj/structure/closet/secure_closet/medical1, /obj/structure/filingcabinet, /obj/structure/closet/crate/medical, /obj/structure/table/standard, /obj/structure/bed/chair, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("engineering")
			return list(/obj/structure/closet/secure_closet/engineering_electrical, /obj/structure/filingcabinet, /obj/structure/closet/crate/engineering/electrical, /obj/structure/closet/crate/engineering, /obj/structure/table/standard, /obj/structure/table/rack, /obj/structure/bed/chair, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("logistics")
			return list(/obj/structure/closet/secure_closet/cargotech, /obj/structure/closet/crate, /obj/structure/filingcabinet, /obj/structure/closet/crate/engineering, /obj/structure/table/standard, /obj/structure/table/rack, /obj/structure/bed/chair, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
		if("docking")
			return list(/obj/structure/closet/crate/internals, /obj/structure/flora/pottedplant, /obj/structure/filingcabinet, /obj/structure/table/standard, /obj/structure/bed/chair, /obj/structure/bed/chair/comfy, /obj/structure/bed/chair/comfy/rounded)
	return list(/obj/structure/filingcabinet, /obj/structure/closet/crate)

/datum/generated_station_materializer/proc/department_id_for_module(datum/generated_station_module/module)
	if(!nodes_by_id || !module)
		return null
	var/datum/generated_station_layout_node/node = nodes_by_id[module.department_node_id]
	if(!node)
		return null
	var/datum/generated_station_department_instance/department = department_for_node(node)
	return department?.definition?.id
