#define HARDSUIT_CLICK_MIDDLE "middle-click"
#define HARDSUIT_CLICK_ALT "alt-click"
#define HARDSUIT_CLICK_CONTROL "control-click"

/// The INPUT_ACTION_* each hardsuit click setting stands for.
#define HARDSUIT_CLICK_ACTIONS list(HARDSUIT_CLICK_MIDDLE = INPUT_ACTION_SWAP_HANDS, HARDSUIT_CLICK_ALT = INPUT_ACTION_ALTERNATE, HARDSUIT_CLICK_CONTROL = INPUT_ACTION_PULL)
