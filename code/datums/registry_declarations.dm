/// Cameras keep the order camera consoles list them in: joined in map-load order
/// until the first sorted view, then inserted in name order.
/datum/registry/cameras
	id = REGISTRY_CAMERAS
	var/sorted = FALSE

/datum/registry/cameras/add(atom/member)
	if(!sorted || !SSticker)
		sorted = FALSE
		return ..()
	dd_insertObjectList(members, member)

/// Sorts in place: REGISTRY_MEMBERS() hands out this very list.
/datum/registry/cameras/proc/sort()
	if(sorted)
		return
	var/list/in_order = dd_sortedObjectList(members.Copy())
	members.Cut()
	members += in_order
	sorted = TRUE
