/// The tier of a reagent (a building block, intermediate or process chemical is tier 1), or null for one that has none.
/proc/chem_tier_of(reagent_id)
	var/tier = GLOB.chem_tiers[reagent_id]
	if(tier)
		return tier
	if((reagent_id in GLOB.chem_building_blocks) || length(chem_agents_of(reagent_id)))
		return CHEM_TIER_STAPLE
	return null
