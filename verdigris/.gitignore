# Generated by Cargo — workspace target dir is at verdigris/target/
# Worktrees point CARGO_TARGET_DIR at a per-worktree dir (target-wt, etc.) to
# share sccache output without colliding; ignore any target* variant.
debug/
target/
target-wt/

# Cargo.lock is COMMITTED for verdigris (we produce a final cdylib, reproducibility matters).
# See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
