* text=auto

## Enforce text mode and LF line breaks
*.bat text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.dm text eol=lf
*.dme text eol=lf
*.dmf text eol=lf
*.htm text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

## Enforce binary mode
*.bmp binary
*.dll binary
*.dmb binary
*.exe binary
*.gif binary
*.jpg binary
*.png binary
*.so binary
*.zip binary

## Merger hooks, run tools/hooks/install.bat or install.sh to set up
*.dmm text eol=lf merge=dmm
*.dmi binary merge=dmi

## Force tab indents on dm files
*.dm whitespace=indent-with-non-tab

## deepquarry.dme is generated (tools/build/gen_dme.py): a merge never resolves its text. The dq-dme driver (tools/build/dme_merge_driver.sh,
## supplied by tools/dq_git_safe.sh like dq-baseline) merges the three include sets and writes them in the spec's order; the merge tools
## then regenerate it from the merged files. A plain `git merge` without the driver: git config merge.dq-dme.driver
## "bash tools/build/dme_merge_driver.sh %O %A %B %P". doc/rewrite/agent_workflow.md section 3.
deepquarry.dme merge=dq-dme
## The unit-test include list is still kept by hand: parallel branches each append #include lines at the same spot, and a union merge
## keeps both sides' lines instead of conflicting (a duplicate #include is harmless).
code/modules/unit_tests/_unit_tests.dm merge=union

## Shrink-only ratchet baselines (tools/ci/*_baseline.txt and tools/ci/sys_baseline/*.txt): both sides only drop rows / lower ceilings, so merge to the intersection (tools/ci/baseline_merge_driver.sh;
## the driver is supplied by tools/dq_git_safe.sh, which every merge tool sources; `git merge` by hand: git config merge.dq-baseline.driver "bash tools/ci/baseline_merge_driver.sh %O %A %B %P").
tools/ci/*_baseline.txt merge=dq-baseline
tools/ci/sys_baseline/*.txt merge=dq-baseline

# Diagnostics corpus case whose bytes are the point: a backslash before CRLF inside a string.
tools/dmb/fixtures/diagnostics/cases/string_backslash_crlf.dm -text
tools/dmb/fixtures/diagnostics/cases/string_backslash_crlf_block.dm -text

# Independent generator encoding fixtures retain their literal BOM/CRLF bytes.
tools/analyze/fixtures/actions-whole/code/edge.dm -text whitespace=cr-at-eol
tools/analyze/fixtures/actions-whole/code/first.dm -text whitespace=cr-at-eol
tools/analyze/fixtures/actions-whole/deepquarry.dme -text whitespace=cr-at-eol
tools/analyze/fixtures/stats-whole/code/edge.dm -text whitespace=cr-at-eol
tools/analyze/fixtures/stats-whole/code/first.dm -text whitespace=cr-at-eol
tools/analyze/fixtures/stats-whole/deepquarry.dme -text whitespace=cr-at-eol
# Mixed indentation is intentional input to the legacy membership matcher.
tools/analyze/fixtures/stats-whole/code/second.dm whitespace=-indent-with-non-tab
# Frozen independent declaration-generator oracle and literal CRLF fixtures.
tools/analyze/examples/support/declare_ids_original.rs -text whitespace=cr-at-eol
tools/analyze/fixtures/declare-ids-whole/** -text whitespace=cr-at-eol,-indent-with-non-tab
## tools/ci/lint_scopes.toml: ceilings only go down, and adjacent lowered ceilings must not conflict (tools/ci/lint_scopes_merge_driver.sh,
## supplied by tools/dq_git_safe.sh like dq-baseline; by hand: git config merge.dq-lint-scopes.driver "bash tools/ci/lint_scopes_merge_driver.sh %O %A %B %P").
tools/ci/lint_scopes.toml merge=dq-lint-scopes
tools/build/dme_moves.txt merge=union

# Independent original declare oracle and intentional byte-encoding fixtures.
tools/analyze/examples/support/declare_original.rs -text whitespace=cr-at-eol
tools/analyze/fixtures/declare-whole/** -text whitespace=cr-at-eol

# Original ui_types oracle/encoding probes retain their exact bytes.
tools/analyze/examples/support/ui_types_original.rs -text whitespace=cr-at-eol
tools/analyze/fixtures/ui-types-whole/** -text whitespace=cr-at-eol

# Exact independently captured multi-target checker fixture/oracle bytes.
tools/dmb/fixtures/unified_checks/effect_multi_target/**/probe.dme -text
tools/dmb/fixtures/unified_checks/effect_multi_target/**/checker.toml -text
tools/dmb/fixtures/unified_checks/effect_multi_target/**/reference-*.stderr -text whitespace=-blank-at-eof

# Frozen independent tracked-list generator oracle.
tools/analyze/examples/support/tracked_lists_original.rs -text whitespace=cr-at-eol
# Leading spaces exercise the original nested-proc lookalike matcher.
tools/analyze/fixtures/native_tracked_lists/code/probe.dm whitespace=-indent-with-non-tab

# Frozen original write-policy bytes and intentional nested oracle indentation.
tools/analyze/examples/support/writes_original.rs -text whitespace=-blank-at-eof
tools/analyze/fixtures/native-global-classifier/code/calls.dm whitespace=-indent-with-non-tab
